        @section Scripts {
            <script>

                function handleFileUpload(input, previewDivId, iframeId, fileNameId, errorId, itemId, isMandatory) {
                    const file = input.files[0];

                    const errorEl = document.getElementById(errorId);
                    const fileNameEl = document.getElementById(fileNameId);
                    const previewDiv = document.getElementById(previewDivId);
                    const iframe = document.getElementById(iframeId);
                    const hiddenInput = document.getElementById("file-name-hidden-" + itemId);

                    const maxSize = 2 * 1024 * 1024; // 2MB

                    // Reset preview and values
                    previewDiv.style.display = "none";
                    iframe.removeAttribute("src");
                    fileNameEl.innerText = "";
                    hiddenInput.value = "";
                    errorEl.style.display = "none";

                    // No file selected
                    if (!file) {
                        if (isMandatory) {
                            errorEl.textContent = "هذا الملف مطلوب";
                            errorEl.style.display = "block";
                        }
                        input.value = "";
                        return;
                    }

                    // Invalid file type
                    if (file.type !== "application/pdf") {
                        errorEl.textContent = "يجب اختيار ملف بصيغة PDF فقط";
                        errorEl.style.display = "block";
                        input.value = "";
                        return;
                    }

                    // File size exceeds limit
                    if (file.size > maxSize) {
                        errorEl.textContent = "حجم الملف يجب ألا يتجاوز 2 ميجابايت";
                        errorEl.style.display = "block";
                        input.value = "";
                        return;
                    }

                    // Set file name and attach ID and label for server
                    fileNameEl.innerText = file.name;
                    hiddenInput.value = itemId + "|" + file.name + "|" + hiddenInput.dataset.label;

                    // Preview PDF
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        iframe.src = e.target.result;
                        previewDiv.style.display = "block";
                    };
                    reader.readAsDataURL(file);
                }



                function clearPdfPreview(previewDivId, inputId, fileNameId, iframeId, hiddenInputId) {
                    document.getElementById(previewDivId).style.display = "none";
                    document.getElementById(fileNameId).innerText = "";
                    document.getElementById(iframeId).removeAttribute("src");
                    document.getElementById(hiddenInputId).value = "";
                    document.getElementById(inputId).value = "";
                }


                function clearPdfPreview(previewDivId, inputId, fileNameId, iframeId, hiddenInputId) {
                    document.getElementById(previewDivId).style.display = "none";
                    document.getElementById(fileNameId).innerText = "";
                    document.getElementById(iframeId).removeAttribute("src");
                    document.getElementById(hiddenInputId).value = "";
                    document.getElementById(inputId).value = "";
                }



                function clearPdfPreview(previewDivId, inputId, fileNameId, iframeId, hiddenInputId) {
                    document.getElementById(previewDivId).style.display = "none";
                    document.getElementById(fileNameId).innerText = "";
                    document.getElementById(iframeId).src = "";
                    document.getElementById(hiddenInputId).value = "";
                    document.getElementById(inputId).value = "";
                }



                // function handleFileUpload(input, previewDivId, iframeId, fileNameId, errorId, itemId) {
                //     const file = input.files[0];
                //     const errorEl = document.getElementById(errorId);
                //     const fileNameEl = document.getElementById(fileNameId);
                //     const previewDiv = document.getElementById(previewDivId);
                //     const iframe = document.getElementById(iframeId);
                //     const hiddenInput = document.getElementById("file-name-hidden-" + itemId);

                //     if (!file || file.type !== "application/pdf") {
                //         errorEl.style.display = "block";
                //         fileNameEl.innerText = "";
                //         previewDiv.style.display = "none";
                //         iframe.src = "";
                //         hiddenInput.value = "";
                //         return;
                //     }

                //     errorEl.style.display = "none";
                //     fileNameEl.innerText = file.name;
                //     hiddenInput.value = file.name;

                //     const reader = new FileReader();
                //     reader.onload = function (e) {
                //         iframe.src = e.target.result;
                //         previewDiv.style.display = "block";
                //     };
                //     reader.readAsDataURL(file);
                // }

                function clearPdfPreview(previewDivId, inputId, fileNameId, iframeId, hiddenInputId) {
                    document.getElementById(previewDivId).style.display = "none";
                    document.getElementById(fileNameId).innerText = "";
                    document.getElementById(iframeId).src = "";
                    document.getElementById(hiddenInputId).value = "";
                    document.getElementById(inputId).value = "";
