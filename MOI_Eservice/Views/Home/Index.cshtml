@model HomePageViewModel


@{
    //var empJson = Context.Session.GetString("MoiUser");
    //AspNetUser emp = string.IsNullOrEmpty(empJson) ? null : JsonConvert.DeserializeObject<AspNetUser>(empJson);

    var userId = Context.Session.GetString("UserId");
    var userName = Context.Session.GetString("UserUserName");
    var civilId = Context.Session.GetString("UserCivilId");
    var fullName = Context.Session.GetString("UserFullName");
    var accountTypeId = Convert.ToInt32(Context.Session.GetString("UserAccouuntTypeId"));
    var isApplicant = Context.Session.GetString("UserIsApplicant");
    var isDelegate = Context.Session.GetString("UserIsDelegate") ;
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
    var NavLinksContact = Model.SystemOptionVMs.FirstOrDefault(x => x.CategoryNameEn == "NavLinksContact");
    var NavLinksHome = Model.SystemOptionVMs.FirstOrDefault(x => x.CategoryNameEn == "NavLinksHome");
    var TitleMinistryEle = Model.SystemOptionVMs.FirstOrDefault(x => x.CategoryNameEn == "TitleMinistryEle");

    string selectedUrl = "#";
    string urlInitials = "";
    var bannerImage = Model.SystemOptionVMs.FirstOrDefault(x => x.CategoryNameEn == "MainBanner")?.Value;


}

