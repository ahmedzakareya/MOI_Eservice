                                    <div class="help-block with-errors"></div>
                                </div>
                            </div>

                            <div class="col-lg-6 col-md-6">
                                <div class="form-group">
                                    <input type="tel" class="form-control" placeholder="رقم الهاتف " required data-error="أدخل رقم هاتف صحيح للتواصل">
                                    <div class="help-block with-errors"></div>
                                </div>
                            </div>



                            <div class="col-lg-12 col-md-12">
                                <div class="form-group">
                                    <textarea placeholder="الرسالة " class="form-control" required data-error="قم بكتابة رسالتك"></textarea>
                                    <div class="help-block with-errors"></div>
                                </div>
                            </div>



