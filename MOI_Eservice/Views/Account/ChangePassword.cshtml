@model ChangePasswordVM

@{
    ViewData["Title"] = "تغيير كلمة المرور";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Adjust based on your layout
}

<!-- Breadcrumb -->
<div class="breadcrumb-area">
    <ol class="breadcrumb">
        <li class="item">
            <a href="@Url.Action("MyAccount", "Home")">الرئيسية</a>
        </li>
        <li class="item">@ViewData["Title"]</li>
    </ol>
</div>

<!-- Page Title -->
<div class="my-profile-box">
    <h3>@ViewData["Title"]</h3>

    <form asp-action="ChangePassword" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="row">
            <!-- Old Password -->
            <div class="form-group col-md-4 mb-3">
                <label asp-for="OldPassword" class="form-label">كلمة المرور الحالية</label>
                <input asp-for="OldPassword" class="form-control" type="password" />
                <span asp-validation-for="OldPassword" class="text-danger"></span>
            </div>

            <!-- New Password -->
            <div class="form-group col-md-4 mb-3">
                <label asp-for="NewPassword" class="form-label">كلمة المرور الجديدة</label>
                <input asp-for="NewPassword" class="form-control" type="password" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <!-- Confirm Password -->
            <div class="form-group col-md-4 mb-3">
                <label asp-for="ConfirmPassword" class="form-label">تأكيد كلمة المرور</label>
                <input asp-for="ConfirmPassword" class="form-control" type="password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
        </div>

        <!-- Buttons -->
        <div class="form-group mt-4">
            <button type="submit" class="btn btn-primary">حفظ <i class="flaticon-plus"></i></button>
            <a href="@Url.Action("Index", "Requests")" class="btn btn-secondary ms-2">إلغاء <i class="ri-close-fill"></i></a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
