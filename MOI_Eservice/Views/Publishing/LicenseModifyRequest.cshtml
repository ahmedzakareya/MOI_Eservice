        function collectChangeManagerTransVM() {
            return {
                ManagerNewcivilid: getValueByNamesOrIds(['ChangeManagerTransVM.ManagerNewcivilid'], 'ManagerNewcivilid'),
                ManagerNewname: getValueByNamesOrIds(['ChangeManagerTransVM.ManagerNewname'], 'ManagerNewname'),
