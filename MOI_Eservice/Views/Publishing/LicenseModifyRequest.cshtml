    <script>
        // ---- Utility: read OldPaciNo from text node or input ----
        function readOldPaciNo() {
            const el = document.getElementById('OldPaciNo');
            if (!el) return '';
            // If it's an input/textarea, read .value; otherwise read textContent
            const raw = ('value' in el) ? el.value : el.textContent;
            return (raw || '').trim();
        }

        // ---- Fetch & draw for map2 (clone of get_Amount, but read-only + map2) ----
        async function showOldAddressOnMap2(explicitId) {
            const ID = (explicitId && String(explicitId).trim()) || readOldPaciNo();
            if (!ID) return; // nothing to do

            // Optional: show a very light inline loader in the map area (no Swal on load)
            // const map2 = document.getElementById('map2');
            // if (map2) map2.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100%;color:#64748b;font-size:14px;">جاري تحميل موقع العنوان القديم…</div>';

            try {
                const resp = await $.ajax({
                    type: 'GET',
                    dataType: 'json',
                    url: '@Url.Action("GetAddressDataFromPaci", "Account", new { area = "Admin" })',
                    data: { id: ID }
                });

                if (!resp) {
                    if (map2) map2.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100%;color:#ef4444;">تعذّر جلب بيانات العنوان القديم</div>';
                    return;
                }

                // Use your existing ArcGIS drawer
                retrieveCoordinates(resp.lon, resp.lat, 'map2');
            } catch (e) {
                if (map2) map2.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100%;color:#ef4444;">فشل الاتصال بالخدمة</div>';
                console.error(e);
            }
        }

        // ---- Try on page load even if OldPaciNo arrives late ----
        function tryInitOldMap2(attempt = 0) {
            const id = readOldPaciNo();
            if (id) {
                showOldAddressOnMap2(id);
                return;
            }
            // If #OldPaciNo is injected later, keep polling a little
            if (attempt < 12) { // ~6 seconds total
                setTimeout(() => tryInitOldMap2(attempt + 1), 500);
            }
        }

        // Kick off after DOM is ready
        document.addEventListener('DOMContentLoaded', tryInitOldMap2);

        // ---- Optional: expose a manual trigger (e.g., from a button) ----
        window.showOldAddressOnMap2 = showOldAddressOnMap2;
    </script>





    <script>
        /* Partners table + robust trade-data validation
           - Re-resolves trade inputs on every validation (handles dynamic markup)
           - Supports names: Transactions.*, transactions.*, transaction.*
           - Supports ids generated by asp-for: transactions_MotletterNo / _MotletterDate
           - Delegated listeners so it works even if fields are injected later
        */
        document.addEventListener('DOMContentLoaded', function () {
            // ================== PARTNERS TABLE (existing) ==================
            const table = document.getElementById('partnersTable');
            const cbAll = table?.querySelector('.pt-cb-all') || null;
            const totalEl = document.getElementById('pt-total');
            const selEl = document.getElementById('pt-selected');

            const addRow = document.getElementById('pt-add-row');
            const addInput = document.getElementById('pt-add-input');
            const addBtn = document.getElementById('pt-add-btn');
            const addIcon = document.querySelector('.pt-add-icon');

            const getRows = () =>
                Array.from(table?.querySelectorAll('.pt-row') || [])
                    .filter(r => !r.classList.contains('pt-head')
                        && !r.classList.contains('pt-add')
                        && !r.classList.contains('pt-empty'));

            const isNewRow = (row) => row.classList.contains('pt-new');
            const getRemovableRows = () => getRows().filter(r => !isNewRow(r));

            const escapeHtml = (s) => (s || '').replace(/[&<>"']/g, m =>
                ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m]));

            const refreshTotal = () => { if (totalEl) totalEl.textContent = getRows().length.toString(); };
            const refreshCounts = () => {
                const rows = getRemovableRows();
                const selected = rows.filter(r => r.querySelector('.pt-cb')?.checked).length;
                if (selEl) selEl.textContent = selected.toString();
                if (cbAll) {
                    cbAll.checked = selected > 0 && selected === rows.length && rows.length > 0;
                    cbAll.indeterminate = selected > 0 && selected < rows.length;
                    if (rows.length === 0) { cbAll.checked = false; cbAll.indeterminate = false; }
                }
            };

            const setRowState = (row, removed) => {
                if (isNewRow(row)) return;
                const cb = row.querySelector('.pt-cb');
                const state = row.querySelector('.pt-state');
                const text = row.querySelector('.pt-state-text');

                if (cb) cb.checked = removed;
                row.classList.toggle('pt-removed', removed);

                if (state && text) {
                    state.classList.remove('pt-state--active', 'pt-state--removed');
                    if (removed) {
                        state.classList.add('pt-state--removed');
                        text.textContent = state.getAttribute('data-removed-text') || 'محذوف';
                    } else {
                        state.classList.add('pt-state--active');
                        text.textContent = state.getAttribute('data-active-text') || 'نشط';
                    }
                }
            };

            const ensureEmptyPlaceholder = () => {
                if (getRows().length === 0 && !table?.querySelector('.pt-empty')) {
                    const empty = document.createElement('div');
                    empty.className = 'pt-empty text-muted';
                    empty.textContent = 'لا يوجد شركاء مسجلون.';
                    table?.appendChild(empty);
                }
            };
            const removeEmptyPlaceholderIfAny = () => {
                const empty = table?.querySelector('.pt-empty');
                if (empty) empty.remove();
            };

            const attachDeleteHandler = (row) => {
                const del = row.querySelector('.pt-del');
                if (!del) return;
                del.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const newId = row.getAttribute('data-id');
                    row.remove();
                    document.querySelectorAll(`[data-new-id="${newId}"]`).forEach(el => el.remove());
                    refreshTotal();
                    refreshCounts();
                    ensureEmptyPlaceholder();
                });
            };

            const attachRowHandlers = (row) => {
                const cb = row.querySelector('.pt-cb');

                if (isNewRow(row) && cb) {
                    cb.checked = false;
                    cb.disabled = true;
                    cb.setAttribute('aria-disabled', 'true');
                    cb.title = 'لا يمكن تحديد الشريك الجديد للخروج — احذفه من زر الحذف.';
                }

                row.addEventListener('click', (e) => {
                    const t = e.target;
                    if (t.closest('input, label, a, button') || row.classList.contains('pt-head')) return;
                    if (!cb || cb.disabled) return;
                    setRowState(row, !cb.checked);
                    refreshCounts();
                });

                if (cb && !cb.disabled) {
                    cb.addEventListener('change', () => {
                        setRowState(row, cb.checked);
                        refreshCounts();
                    });
                }

                attachDeleteHandler(row);
            };

            getRows().forEach(attachRowHandlers);

            if (cbAll) {
                cbAll.addEventListener('change', () => {
                    getRemovableRows().forEach(r => setRowState(r, cbAll.checked));
                    refreshCounts();
                });
            }

            let dynamicIndex = getRows().length;

            const createPartnerRow = (name) => {
                dynamicIndex += 1;
                const newId = 'new-' + dynamicIndex;

                const row = document.createElement('div');
                row.className = 'pt-row pt-new';
                row.setAttribute('data-id', newId);

                row.innerHTML = `
                <div class="pt-cell pt-check">
                  <input type="checkbox"
                         class="form-check-input pt-cb"
                         id="pt_cb_${dynamicIndex}"
                         value="${newId}"
                         disabled aria-disabled="true"
                         title="لا يمكن تحديد الشريك الجديد للخروج — احذفه من زر الحذف." />
                  <label for="pt_cb_${dynamicIndex}" class="visually-hidden">Select partner</label>
                </div>

                <div class="pt-cell pt-name">
                  <div class="pt-primary-name">${escapeHtml(name)}</div>
                  <input type="hidden" name="NewPartnersNames"
                         value="${escapeHtml(name)}"
                         data-new-id="${newId}" />
                </div>

                <div class="pt-cell pt-status">
                  <span class="pt-state pt-state--active pt-state--new"
                        data-active-text="نشط"
                        data-removed-text="محذوف">
                    <i class="pt-dot" aria-hidden="true"></i>
                    <span class="pt-state-text">جديد</span>
                  </span>

                  <button type="button" class="pt-del" title="حذف" aria-label="حذف">
                    <i class="ri-close-line" aria-hidden="true"></i>
                  </button>
                </div>
              `;
                return row;
            };

            const nameExists = (candidate) => {
                const want = candidate.trim().toLowerCase();
                if (!want) return false;
                return getRows().some(r => {
                    const n = r.querySelector('.pt-primary-name')?.textContent?.trim().toLowerCase() || '';
                    return n === want;
                });
            };

            // ================== TRADE DATA VALIDATION (improved) ==================
            const TRADE_NO_NAMES = ['Transactions.MotletterNo', 'transactions.MotletterNo', 'transaction.MotletterNo'];
            const TRADE_DATE_NAMES = ['Transactions.MotletterDate', 'transactions.MotletterDate', 'transaction.MotletterDate'];

            // Try to resolve <input> by possible name or by equivalent id with underscores
            function resolveInput(candidates, idSuffix) {
                // By name
                for (let i = 0; i < candidates.length; i++) {
                    const el = document.querySelector(`input[name="${candidates[i]}"]`);
                    if (el) return el;
                }
                // By exact id generated by asp-for (dots become underscores)
                if (idSuffix) {
                    const ids = candidates.map(n => n.replace(/\./g, '_'));
                    for (let i = 0; i < ids.length; i++) {
                        const el = document.getElementById(ids[i]);
                        if (el) return el;
                    }
                    // Generic fallback: any input whose id ends with the suffix
                    const el2 = document.querySelector(`input[id$="_${idSuffix}"]`);
                    if (el2) return el2;
                }
                // Last fallback: first input whose name ends with ".suffix"
                const el3 = document.querySelector(`input[name$=".${idSuffix}"]`);
                return el3 || null;
            }

            function getTradeNoInput() { return resolveInput(TRADE_NO_NAMES, 'MotletterNo'); }
            function getTradeDateInput() { return resolveInput(TRADE_DATE_NAMES, 'MotletterDate'); }

            function ensureErrorNode(input) {
                if (!input) return null;
                const container = input.closest('.info-value') || input.parentElement;
                if (!container) return null;
                let err = container.querySelector('.invalid-feedback');
                if (!err) {
                    err = document.createElement('div');
                    err.className = 'invalid-feedback d-block';
                    container.appendChild(err);
                }
                return err;
            }

            function setFieldError(input, message) {
                if (!input) return;
                const err = ensureErrorNode(input);
                if (message) {
                    input.classList.add('is-invalid');
                    if (err) err.textContent = message;
                } else {
                    input.classList.remove('is-invalid');
                    if (err) err.textContent = '';
                }
            }

            function parseLocalDateYYYYMMDD(s) {
                if (!s) return null;
                const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(s);
                if (!m) return null;
                const y = +m[1], mo = +m[2] - 1, d = +m[3];
                const dt = new Date(y, mo, d, 12, 0, 0, 0); // noon to avoid DST edges
                return isNaN(dt.getTime()) ? null : dt;
            }

            function validateTradeData() {
                let ok = true;

                const tradeNoInput = getTradeNoInput();
                const tradeDateInput = getTradeDateInput();

                const noVal = (tradeNoInput?.value || '').trim();
                const dateVal = (tradeDateInput?.value || '').trim();

                // Reset errors
                setFieldError(tradeNoInput, '');
                setFieldError(tradeDateInput, '');

                // Mutual requirement
                if (noVal && !dateVal) {
                    setFieldError(tradeDateInput, 'يجب إدخال تاريخ كتاب التجارة عند إدخال رقمه.');
                    ok = false;
                }
                if (dateVal && !noVal) {
                    setFieldError(tradeNoInput, 'يجب إدخال رقم كتاب التجارة عند إدخال تاريخه.');
                    ok = false;
                }

                

                return ok;
            }

            // Delegated listeners (work for dynamically added inputs)
            document.addEventListener('input', function (e) {
                const n = e.target?.name || '';
                if (TRADE_NO_NAMES.includes(n) || TRADE_DATE_NAMES.includes(n)) {
                    validateTradeData();
                }
            });
            document.addEventListener('change', function (e) {
                const n = e.target?.name || '';
                if (TRADE_NO_NAMES.includes(n) || TRADE_DATE_NAMES.includes(n)) {
                    validateTradeData();
                }
            });
            document.addEventListener('blur', function (e) {
                const n = e.target?.name || '';
                if (TRADE_NO_NAMES.includes(n) || TRADE_DATE_NAMES.includes(n)) {
                    validateTradeData();
                }
            }, true); // capture phase to catch blur

            // Hook into form submit as a safety net
            const form = document.getElementById('myform') || document.getElementById('licenseForm');
            if (form) {
                form.addEventListener('submit', function (e) {
                    if (!validateTradeData()) {
                        e.preventDefault();
                        e.stopPropagation();
                        (getTradeNoInput() || getTradeDateInput())?.focus();
                    }
                });
            }

            // ================== ADD PARTNER (checks trade first) ==================
            const addPartnerFromInput = () => {
                if (!validateTradeData()) {
                    (getTradeNoInput() || getTradeDateInput() || addInput)?.focus();
                    return;
                }
                const raw = (addInput?.value || '').trim();
                if (!raw) return;
                if (nameExists(raw)) { addInput.select(); addInput.focus(); return; }

                removeEmptyPlaceholderIfAny();
                const row = createPartnerRow(raw);
                table?.insertBefore(row, addRow?.nextSibling || null);

                attachRowHandlers(row);
                refreshTotal();
                refreshCounts();

                addInput.value = '';
                addInput.focus();
            };

            if (addBtn) addBtn.addEventListener('click', addPartnerFromInput);
            if (addInput) {
                addInput.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter') { e.preventDefault(); addPartnerFromInput(); }
                });
            }
            if (addIcon && addInput) addIcon.addEventListener('click', () => addInput.focus());

            // Initial render/validation
            refreshTotal();
            refreshCounts();
            validateTradeData();
        });
    </script>






    <script>
        // Focus the input when clicking the circular add icon
        document.addEventListener('DOMContentLoaded', function () {
            const trigger = document.querySelector('.pt-add-icon');
            const input = document.getElementById('pt-add-input');
            if (trigger && input) {
                trigger.addEventListener('click', () => input.focus());
            }
        });
