                                                               placeholder="ادخل الرقم المدني للمدير الجديد" />
                                                        <img src="~/assets/images/KNMID_Logo.png" alt="أيقونة"
                                                             style="position:absolute; left:10px; top:50%; transform:translateY(-50%); width:28px; height:28px;" />
                                                    </div>
                                                </div>

                                                <!-- Name -->
                                                <div class="col">
