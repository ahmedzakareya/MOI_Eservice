        /* ==================== NEW: old manager snapshot from DOM ==================== */
        function collectOldManagerFromDom() {
            const pane = document.getElementById('oldManagerPane');
            if (!pane) return {
                OldCivilId: null, OldName: null, OldBirthDate: null,
                OldNationality: null, OldQualification: null, OldQualificationCountry: null
            };

            const pickByLabel = (labelText) => {
                const rows = pane.querySelectorAll('.kv-grid .info-kv');
                for (const row of rows) {
                    const lbl = (row.querySelector('.info-label')?.textContent || '').trim();
                    if (lbl === labelText) {
                        return (row.querySelector('.info-value')?.textContent || '').trim() || null;
                    }
                }
                return null;
            };

            return {
                OldCivilId: pickByLabel('الرقم المدني للمدير القديم'),
                OldName: pickByLabel('اسم المدير القديم'),
                OldBirthDate: pickByLabel('تاريخ الميلاد للمدير القديم'),
                OldNationality: pickByLabel('جنسية المدير القديم'),
                OldQualification: pickByLabel('المؤهل الدراسي للمدير القديم'),
                OldQualificationCountry: pickByLabel('جنسية المؤهل الدراسي للمدير القديم')
            };
        }

        /* ==================== Pre-Upload (FormData → UploadTempFiles) ==================== */
        async function preUploadSameAction() {
            if (!hasAnyAttachments()) return { ok: true, tempKey: null, attachInfo: [] };

            const fd = new FormData();
            fd.append('phase', 'pre');

            document.querySelectorAll('input[type="file"][name="UploadedFiles"]').forEach(inp => {
                if (inp.files && inp.files.length > 0) { const f = inp.files[0]; fd.append('UploadedFiles', f, f.name); }
            });

            const infos = [];
            document.querySelectorAll('input[type="hidden"][name="AttachInfo"]').forEach(h => {
                const v = (h.value || '').trim(); if (v) infos.push(v);
            });

            const token = $('input[name="__RequestVerificationToken"]').val() || '';
            if (token) fd.append('__RequestVerificationToken', token);

            const resp = await fetch('@Url.Action("UploadTempFiles", "Mosanafat")', { method: 'POST', body: fd, headers: token ? { 'RequestVerificationToken': token } : {} });

            if (!resp.ok) { const t = await resp.text().catch(() => ''); throw new Error('PreUpload failed: ' + resp.status + ' ' + t); }
            const json = await resp.json();
            if (!json.ok) throw new Error('Server responded with ok=false during PreUpload');

            return { ok: true, tempKey: json.tempKey || null, attachInfo: infos };
        }

        /* ==================== Sender (main) ==================== */
        function buildPayloadForSave() {
            const liceRaw = (function () { const byName = $('input[name="LiceID"]').val(); if (byName) return byName; const byId = $('#LiceID').val(); if (byId) return byId; return '@(Model?.LiceID ?? 0)'; })();
            let liceParsed = parseInt(liceRaw, 10); if (isNaN(liceParsed)) liceParsed = 0;
            return {
                LiceID: liceParsed,
                LicNo: $("#LicNo").val() || null,
                Name: $("#Name").val() || null,
                FeesByTypeId: collectFeesByTypeId(),
                TypeIds: collectSelectedTypeIds(),
                ChangeOldPartnerTransVM: collectOldPartners(),
                changeNewPartnerTransVM: collectNewPartners(),
                Transactions: collectTransactions(),
                CompanyNameChangeTransactionVM: collectCompanyNameChange(),
                CommercialNameChangeTransactionVm: collectCommercialNameChange(),
                ActivityChangeTransVM: collectActivityChange(),
                AddressChangeTransactionVM: collectAddressChangeTransaction(),
                renouncementTransactionVM: collectRenouncementTransaction(),
                ReasonID: collectEndingReason(),

                /* === Only new additions below === */
                ChangeManagerTransVM: collectChangeManagerTransVM(),   // new manager fields
                ChangeManagerOldVM: collectOldManagerFromDom()        // old manager snapshot
            };
        }

        async function submitLicenseJson($form) {
            const token = $('input[name="__RequestVerificationToken"]').val();
            const $btn = $('#btnSave').prop('disabled', true);
            if (typeof $form.valid === 'function' && !$form.valid()) { $btn.prop('disabled', false); return; }

            const payload = buildPayloadForSave();
            showWaitingSwal();

            try {
                // 1) pre-upload
                let tempBundle = { ok: true, tempKey: null, attachInfo: [] };
                try { tempBundle = await preUploadSameAction(); }
                catch (preErr) { closeAnySwal(); showErrorSwal('تعذر رفع المرفقات مؤقتًا.'); $btn.prop('disabled', false); return; }

                // 2) save JSON with ASCII-safe header (Base64)
                const rawAttachInfoJson = JSON.stringify(tempBundle.attachInfo || []);
                const attachInfoJson64 = btoa(unescape(encodeURIComponent(rawAttachInfoJson)));

                $.ajax({
                    url: window.SaveUrl,
                    type: 'POST',
                    data: JSON.stringify(payload),
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',
                    processData: false,
                    global: false,
                    headers: {
                        'Accept': 'application/json',
                        'RequestVerificationToken': token,
                        'X-Requested-With': 'XMLHttpRequest',
                        'X-Attach-TempKey': tempBundle.tempKey || '',
                        'X-Attach-Info-Json64': attachInfoJson64
                    },
                    complete: function () { $btn.prop('disabled', false); },
                    success: function (res) {
                        closeAnySwal();
                        if (res && res.ok) {
                            const reqNo = extractReqNo(res);
                            showSuccessWithReqNo(reqNo, function () { window.location.href = window.AfterSaveRedirectUrl; });
                        } else {
                            showErrorSwal((res && (res.message || 'فشلت العملية')) || 'فشلت العملية');
                        }
                    },
                    error: function (xhr) {
                        closeAnySwal();
                        showErrorSwal(xhr.status === 415 ? 'نوع المحتوى غير مدعوم (415). تأكد أن الأكشن يقبل application/json.' : 'خطأ من الخادم أو مشكلة في الشبكة');
                    }
                });

            } catch (outer) {
                closeAnySwal(); showErrorSwal('تعذر إتمام العملية.'); $btn.prop('disabled', false);
            }
        }

        /* ==================== Boot ==================== */
        $(function () {
            const $form = $('#myform').length ? $('#myform') : $('#licenseForm');

            if ($.fn.select2) { $('#ActivityTypeId').select2({ dir: 'rtl', width: '100%', placeholder: 'اختر النشاط', allowClear: true }); }
            if ($form.length && $.validator && $.validator.unobtrusive) { $.validator.unobtrusive.parse($form); }

            $form.off('submit.ajaxSave').on('submit.ajaxSave', function (e) { e.preventDefault(); submitLicenseJson($form); });
            $(document).off('click.ajaxSave', '#btnSave').on('click.ajaxSave', '#btnSave', function (e) { e.preventDefault(); $form.trigger('submit'); });
        });
    </script>




    <script>
        (function () {
            function syncCardState($card) {
                var hidden = $card.find('input[type="hidden"][name="AttachInfo"]')[0];
                var filled = hidden && (hidden.value || '').trim() !== '';
                $card.toggleClass('is-filled', filled)
                    .toggleClass('is-empty', !filled);
            }
            function syncAll() {
                $('#myform .pdf-card').each(function () { syncCardState($(this)); });
            }
            $(syncAll);

            $(document).on('change', '#myform .pdf-card input[type="file"][name="UploadedFiles"]', function () {
                var $card = $(this).closest('.pdf-card');
                setTimeout(function () { syncCardState($card); }, 60);
            });

            $(document).on('click', '.pdf-card [onclick*="clearPdfPreview"]', function () {
                var $card = $(this).closest('.pdf-card');
                setTimeout(function () { syncCardState($card); }, 30);
            });

            $(document).on('attachments:grouped content:updated', syncAll);
        })();
    </script>


        <script>
            /* ===================== Attachments => Swal builder ===================== */
            /* Build attachmentsHtml from the current form state */
            function buildAttachmentsHtmlFromForm() {
                var html = [];

                $('#myform .pdf-card').each(function () {
                    var $card = $(this);

                    // 1) Determine uploaded/empty state using your same rule (hidden AttachInfo)
                    var hidden = $card.find('input[type="hidden"][name="AttachInfo"]')[0];
                    var isUploaded = hidden && (hidden.value || '').trim() !== '';

                    // 2) Extract a readable title for the row
                    // Try data-title, then an element with .pdf-title, then any label-like element, else fallback
                    var title =
                        $card.data('title') ||
                        $card.find('.pdf-title').text().trim() ||
                        $card.find('label, .title, .name, .form-label').first().text().trim() ||
                        'مرفق بدون اسم';

                    // 3) Choose icon per state
                    var iconClass = isUploaded ? 'ri-check-line' : 'ri-error-warning-line';

                    // 4) Optional badge (if you have a flag). Change to suit your DOM if needed.
                    var requiredBadge = '';
                    var isRequired = $card.is('[data-required="true"]') || $card.find('.badge-required').length > 0;
                    if (isRequired) {
                        requiredBadge = '<span class="badge bg-danger-subtle text-danger fw-bold" style="margin-inline-start:auto">مطلوب</span>';
                    } else {
                        requiredBadge = '<span class="badge bg-primary-subtle text-primary fw-bold" style="margin-inline-start:auto">اختياري</span>';
                    }

                    // 5) Build the card row HTML (flat classes: is-uploaded / is-missing)
                    html.push(
                        '<div class="att-item ' + (isUploaded ? 'is-uploaded' : 'is-missing') + '">' +
                        '<i class="' + iconClass + '"></i>' +
                        '<span class="title">' + title + '</span>' +
                        requiredBadge +
                        '</div>'
                    );
                });

                return html.join('');
            }
    </script>





