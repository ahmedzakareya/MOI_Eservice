@model Business.ViewModel.LicenseModifyModel
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "~/Views/Shared/_LayoutEservice.cshtml";
}
<link href="~/assets/css/requeststyle.css" rel="stylesheet" />

<style>
    input:not(:placeholder-shown) {
        background-color: #3A5795 !important;
        border: none !important;
    }

    .info-value{
        font-size:12px;
    }

    .select2-container--default .select2-search--dropdown .select2-search__field {
        background-color: white !important;
    }
    
</style>


<div class="my-profile-box">
    <div class="gov-head gov-head--flat" dir="rtl">
        <div class="gov-head__title">
            <!-- Beautiful, crisp icon (Remix Icon) -->
            <i class="ri-award-line gov-head__icon" aria-hidden="true"></i>
            <span class="gov-head__heading">طلب تعديل علي الترخيص</span>
        </div>

        <img class="gov-head__seal"
             src="~/assets/images/MOI-ORIGINAL.png"
             alt="ترخيص" />
    </div>


    <form id="myform" method="post" enctype="multipart/form-data" action="@Url.Action("LicenseModifyRequest", "Mosanafat")">

        @Html.AntiForgeryToken()
        <input type="hidden" id="LiceID" name="LiceID" value="@Model.LiceID" />


        <div class="row align-items-center">

            <div class="basic-card">
                <div class="basic-card__header">
                    <div class="basic-card__icon">
                        <i class="ri-information-line" aria-hidden="true"></i>
                    </div>
                    <div class="basic-card__title">البيانات الأساسية للترخيص</div>

                    <!-- Lightweight UI meta (not a badge) -->
                    <span class="basic-card__meta" aria-label="ترخيص رقم ">
                        <span class="meta-dot" aria-hidden="true"></span>
                        @Model.LicenceDetailsVM.LicNo
                    </span>
                </div>


                <div class="basic-card__body">
                    <div class="row align-items-center">

                        <div class="col-12 mt-3">
                            <section class="info-sheet" dir="rtl" aria-labelledby="basicSheetTitle">
                                <div class="dt-card__head">
                                    <i class="ri-file-list-3-line basic-card__icon" aria-hidden="true"></i>
                                    <span class="dt-card__title">  بيانات الترخيص </span>
                                </div>
                                <input id="LiceID" asp-for="LiceID" type="hidden" value="LiceID" />
                                <div class="info-rows">
                                    <div class="info-kv">
                                        <div class="info-label">رقم الترخيص</div>
                                        <div class="info-value">@Model.LicenceDetailsVM.LicNo</div>
                                    </div>

                                    <div class="info-kv">
                                        <div class="info-label">إسم الترخيص</div>
                                        <div class="info-value">@Model.LicenceDetailsVM.LicName</div>
                                    </div>
                                    <div class="info-kv">
                                        <div class="info-label">مالك  الترخيص</div>
                                        <div class="info-value">@Model.LicenceDetailsVM?.Applicant?.Name1</div>
                                    </div>
                             
                                    <div class="info-kv">
                                        <div class="info-label">النشاط</div>
                                        <div class="info-value">@Model.LicenceDetailsVM?.ActivityTypeName</div>
                                    </div>


                                    <div class="info-kv">
                                        <div class="info-label">تاريخ الترخيص</div>
                                        <div class="info-value">
                                            @(Model.LicenceDetailsVM?.IssueDate?.ToString("yyyy/MM/dd", new System.Globalization.CultureInfo("ar-KW")) ?? "—")
                                        </div>
                                    </div>

                                    @{
                                        var ci = new System.Globalization.CultureInfo("ar-KW");
                                        DateTime? exp = Model.LicenceDetailsVM?.ExpireDate;

                                        string expText = exp?.ToString("yyyy/MM/dd", ci) ?? "—";
                                        string expClass = ""; // default (no color)

                                        if (exp.HasValue)
                                        {
                                            var today = DateTime.Today;
                                            if (exp.Value.Date < today)
                                            {
                                                expClass = "text-expired-flat";      // red
                                            }
                                            else if (exp.Value.Date <= today.AddMonths(3))
                                            {
                                                expClass = "text-expiring-flat";     // amber
                                            }
                                        }
                                    }


                                    <div class="info-kv">
                                        <div class="info-label">تاريخ انتهاء الترخيص</div>
                                        <div class="info-value @expClass">@expText</div>
                                    </div>

                                   
                                </div>
                            </section>
                        </div>




                        




                        <div class="col-12 mt-3">
                            <section class="info-sheet" dir="rtl" aria-labelledby="basicSheetTitle">
                                <div class="dt-card__head">
                                                <span class="info-company-avatar">
                                        <img src="@Url.Content("~/admin/assets/images/moci.png")"
                                                         alt="Company logo"
                                                         onerror="this.src='/images/placeholders/company.png';" />
                                                </span>
                                                <span class="dt-card__title">  بيانات التجارة</span>
                                            </div>

                                <div class="row g-3" dir="rtl">
                                    <div class="col-12 col-md-6">
                                        <div class="info-kv">
                                            <div class="info-label">رقم كتاب التجارة</div>
                                            <div class="info-value">
                                                <input asp-for="transactions.MotletterNo" name="transaction.MotletterNo"
                                                       type="text" class="form-control shadow-sm" placeholder="">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-12 col-md-6">
                                        <div class="info-kv">
                                            <div class="info-label">تاريخ كتاب التجارة</div>
                                            <div class="info-value">
                                                <input type="date" class="form-control shadow-sm" placeholder="تاريخ الكتاب"
                                                       asp-for="transactions.MotletterDate" name="transaction.MotletterDate">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </section>
                        </div>
                       
                        @foreach (var id in Model.TypeIds)
                        {
                            <input type="hidden" name="TypeIds" value="@id" />
                        }
                        @foreach (var item in Model.TypeIds)
                        {
                            

                            if (item == 17)
