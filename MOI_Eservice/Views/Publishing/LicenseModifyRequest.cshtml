                                                    <input asp-for="ChangeManagerTransVM.ManagerNewname"
                                                           name="ChangeManagerTransVM.ManagerNewname"
                                                           type="text"
                                                           class="form-control shadow-sm"
                                                           placeholder="ادخل اسم المدير الجديد" />
                                                </div>

                                                <!-- Birthdate -->
                                                <div class="col">
