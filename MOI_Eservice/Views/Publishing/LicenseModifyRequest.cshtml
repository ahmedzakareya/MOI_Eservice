 @section Scripts {
    <script>
        // === تعبئة الحقل الخفي AttachInfo عند اختيار ملف ===
        function handleFileUpload(input, previewDivId, iframeId, fileNameId, errorId, attachRuleId, isMandatory) {
            const file = input.files && input.files[0];
            const $error = document.getElementById(errorId);
            const $name = document.getElementById(fileNameId);
            const $previewWrap = document.getElementById(previewDivId);
            const $iframe = document.getElementById(iframeId);
            const hiddenId = input.id.replace(/^file-/, 'file-name-hidden-');
            const $hidden = document.getElementById(hiddenId);

            const maxBytes = 2 * 1024 * 1024;
            const showErr = (m) => { if ($error) { $error.textContent = m; $error.style.display = ''; } };

            if ($error) $error.style.display = 'none';
            if ($name) $name.textContent = '';
            if ($previewWrap) $previewWrap.style.display = 'none';
            if ($iframe) $iframe.removeAttribute('src');

            if (!file) { if (isMandatory) showErr('الملف مطلوب'); if ($hidden) $hidden.value = ''; return; }
            if ((file.name.split('.').pop() || '').toLowerCase() !== 'pdf') { showErr('يجب اختيار PDF'); input.value = ''; if ($hidden) $hidden.value = ''; return; }
            if (file.size > maxBytes) { showErr('الحد الأقصى 2MB'); input.value = ''; if ($hidden) $hidden.value = ''; return; }

            if ($name) $name.textContent = file.name;
            if ($previewWrap && $iframe) {
                const url = URL.createObjectURL(file);
                $iframe.src = url; $previewWrap.style.display = '';
                setTimeout(() => URL.revokeObjectURL(url), 60000);
            }

            if ($hidden) {
                const label = ($hidden.dataset.label || '').trim();
                const typeId = ($hidden.dataset.transtype || '').trim(); // قد تكون فارغة للمرفقات العامة
                $hidden.value = [attachRuleId, file.name, label, typeId].join('|');
                $hidden.dataset.filename = file.name;
            }
        }

        function clearPdfPreview(previewDivId, inputId, fileNameId, iframeId, hiddenId) {
            const $preview = document.getElementById(previewDivId);
            const $input = document.getElementById(inputId);
            const $name = document.getElementById(fileNameId);
            const $iframe = document.getElementById(iframeId);
            const $hidden = document.getElementById(hiddenId);
            if ($preview) $preview.style.display = 'none';
            if ($iframe) $iframe.removeAttribute('src');
            if ($name) $name.textContent = '';
            if ($input) $input.value = '';
            if ($hidden) $hidden.value = '';
        }

        function hasAnyAttachments() {
            const inputs = document.querySelectorAll('input[type="file"][name="UploadedFiles"]');
            for (const i of inputs) if (i.files && i.files.length) return true;
            return false;
        }

        function buildAttachmentsFormData(apiRes) {
            const fd = new FormData();

            const reqno = (apiRes && (apiRes.reqno || apiRes.Reqno)) || '';
            const defaultRequestId = (apiRes && (apiRes.requestId || apiRes.RequestId)) || 0;
            const map = (apiRes && (apiRes.requestIdsByTypeId || apiRes.RequestIdsByTypeId)) || {};

            fd.append('Reqno', reqno);
            fd.append('DefaultRequestId', defaultRequestId);
            fd.append('RequestIdsJson', JSON.stringify(map));

            const fileInputs = document.querySelectorAll('input[type="file"][name="UploadedFiles"]');
            for (const inp of fileInputs) {
                if (inp.files && inp.files.length) {
                    fd.append('UploadedFiles', inp.files[0], inp.files[0].name);
                }
            }

            const hiddenInfos = document.querySelectorAll('input[type="hidden"][name="AttachInfo"]');
            for (const h of hiddenInfos) {
                const val = (h.value || '').trim();
                if (!val) continue; // أرسل فقط البطاقات التي اختير لها ملف
                fd.append('AttachInfo', val);
            }

            return fd;
        }

        async function uploadAttachmentsToSameAction(apiResult) {
            if (!hasAnyAttachments()) return { ok: true, uploaded: 0 };
            const fd = buildAttachmentsFormData(apiResult);
            // نفس الأكشن
            const resp = await fetch('/Mosanafat/UploadLicenseModifyAttachments', { method: 'POST', body: fd });
            if (!resp.ok) {
                const t = await resp.text().catch(() => '');
                throw new Error('Upload failed: ' + resp.status + ' ' + t);
            }
            return await resp.json().catch(() => ({ ok: true }));
        }
    </script>




    <script>
        // يستخرج الحقل المخفي داخل نفس الكارت بغض النظر عن البادئات في الـ id
        function findHiddenAttachInfoInput(fileInput, itemId) {
            var $card = $(fileInput).closest('.pdf-card');
            if ($card.length) {
                // داخل نفس الكارت
                var $hidden = $card.find('input[type="hidden"][name="AttachInfo"][id*="file-name-hidden-"]');
                if ($hidden.length) return $hidden.first();
            }
            // احتياطي: بالشكل القديم file-name-hidden-{itemId}
            var $fallback = $('#file-name-hidden-' + itemId);
            if ($fallback.length) return $fallback.first();
            // احتياطي إضافي: أي عنصر يحتوي على suffix الـ itemId
            $fallback = $('input[type="hidden"][name="AttachInfo"][id$="file-name-hidden-' + itemId + '"]');
            if ($fallback.length) return $fallback.first();
            return $(); // فشل إيجاد العنصر
        }

        // نفس الفكرة لعنصر عرض اسم الملف
        function findFileNameTarget(fileInput, fileNameId) {
            var $target = $('#' + fileNameId);
            if ($target.length) return $target.first();
            var $card = $(fileInput).closest('.pdf-card');
            if ($card.length) {
                // يوجد داخل الكارت div صغير لعرض الاسم
                var $alt = $card.find('.small.text-muted').first();
                if ($alt.length) return $alt;
            }
            return $(); // احتياطي
        }

        // ====== استبدال الدالة: handleFileUpload ======
        function handleFileUpload(input, previewDivId, iframeId, fileNameId, errorId, itemId, isMandatory) {
            var file = input.files && input.files[0];
            var $error = $('#' + errorId);
            var $preview = $('#' + previewDivId);
            var $iframe = $('#' + iframeId);
            var $fileName = findFileNameTarget(input, fileNameId);
            var $hidden = findHiddenAttachInfoInput(input, itemId);

            // تأكدنا إننا ربطنا كل عناصر الكارت
            if (!$hidden.length) {
                console.warn('AttachInfo hidden input not found for itemId:', itemId);
            }

            // لا ملف مختار
            if (!file) {
                if ($fileName.length) $fileName.text('');
                if ($iframe.length) $iframe.attr('src', '');
                if ($preview.length) $preview.hide();
                if ($error.length) $error.hide();
                if ($hidden.length) $hidden.val(''); // امسح القيمة
                return;
            }

            // فحص الامتداد والحجم (PDF فقط و 2MB حد أقصى)
            var name = file.name || '';
            var ext = name.toLowerCase().slice(name.lastIndexOf('.'));
            if (ext !== '.pdf') {
                if ($error.length) { $error.text('الرجاء اختيار ملف PDF.').show(); }
                input.value = ''; // امسح الاختيار
                return;
            }
            var max = 2 * 1024 * 1024; // 2MB
            if (file.size > max) {
                if ($error.length) { $error.text('الحجم يتجاوز 2MB.').show(); }
                input.value = '';
                return;
            }

            if ($error.length) $error.hide();

            // عرض الاسم
            if ($fileName.length) $fileName.text(name);

            // إعداد قيمة AttachInfo بالشكل القديم: attachId|originalFileName|label
            // سنقرأ اسم الملصق من data-label إن وُجد، وإلا من عنوان الـ label داخل الكارت.
            var labelText = ($hidden.data('label') || '').toString().trim();
            if (!labelText) {
                var $label = $(input).closest('.pdf-card').find('label.form-label').first();
                if ($label.length) labelText = ($label.text() || '').trim();
            }
            if ($hidden.length) {
                $hidden.val(itemId + '|' + name + '|' + labelText);
            }

            // المعاينة
            try {
                var url = URL.createObjectURL(file);
                if ($iframe.length) $iframe.attr('src', url);
                if ($preview.length) $preview.show();
            } catch (e) {
                console.warn('Preview failed:', e);
            }
        }

        // ====== استبدال الدالة: clearPdfPreview ======
        function clearPdfPreview(previewDivId, inputId, fileNameId, iframeId, hiddenFileNameId) {
            var $preview = $('#' + previewDivId);
            var $iframe = $('#' + iframeId);
            var $fileName = $('#' + fileNameId);
            var $input = $('#' + inputId);

            // جرّب الـ id الممرَّر، ولو مش موجود استخدم أقرب كارت
            var $hidden = $('#' + hiddenFileNameId);
            if (!$hidden.length && $input.length) {
                var $card = $input.closest('.pdf-card');
                if ($card.length) {
                    var $alt = $card.find('input[type="hidden"][name="AttachInfo"][id*="file-name-hidden-"]').first();
                    if ($alt.length) $hidden = $alt;
                }
            }

            if ($iframe.length) $iframe.attr('src', '');
            if ($preview.length) $preview.hide();
            if ($fileName.length) $fileName.text('');
            if ($input.length) $input.val('');
            if ($hidden.length) $hidden.val('');
        }
    </script>


