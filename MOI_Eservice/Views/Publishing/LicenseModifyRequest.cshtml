                        @using System.Globalization
                        @{
                            // Culture for currency formatting
                            // var ci = new CultureInfo("ar-KW");

                            // Selected operation type IDs coming from the model
                            var typeIds = Model?.TypeIds?.Distinct()?.ToList() ?? new List<int>();

                            // Lookup list for names as a fallback if an ID isn't in the switch
                            var txList = Model?.transactionVm ?? new List<TransactionTypesLookupVM>();

                            // Fees source: use whichever is available on the model
                            RequestFessVM fvm = Model?.RequestFessVM ?? Model?.RequestFessVM ?? new RequestFessVM();

                            // Friendly names by ID (fallback to lookup -> NameAr -> "طلب #id")
                            Func<int, string> getName = id => id switch
                            {
                                1 => "تغيير اسم الشركة",
                                2 => "تغيير الاسم التجاري",
                                3 => "دخول/خروج الشركاء",
                                4 => "تغيير العنوان",
                                9 => "تغيير المدير المسؤول",
                                11 => "تغيير النشاط",
                                12 => "بدل فاقد",
                                17 => "تجديد الترخيص",
                                // 55 => "تجديد الترخيص",
                                18 => "طلب تنازل",
                                66 => "طلب إنهاء الترخيص",
                                // 77 => "طلب تنازل",
                                _ => txList.FirstOrDefault(t => t.Id == id)?.NameAr ?? $"طلب #{id}"
                            };

                            // Fees by ID (cast ints from RequestFessVM to decimal for formatting)
                            Func<int, decimal> getFee = id => id switch
                            {
                                4 => (decimal)fvm.ChangeAddessFees,
                                17 => (decimal)fvm.RenewFees,
                                // 55 => (decimal)fvm.RenewFees,
                                12 => (decimal)fvm.ReplaceOfLostFees,
                                3 => (decimal)fvm.ChangePartnerFees,
                                1 => (decimal)fvm.changeCompanyNameFess,
                                2 => (decimal)fvm.ChangeCommercialNameFees,
                                11 => (decimal)fvm.ChangeActivityFees,
                                9 => (decimal)fvm.ChangeManagerFees,
                                18 => (decimal)fvm.RenouncementFees,
                                // 77 => (decimal)fvm.RenouncementFees,
                                66 => 0m, // عدِّلها إن كان هناك رسوم لإنهاء الترخيص
                                _ => 0m
                            };

                            decimal totalFee = 0m;
                        }

                        <section class="ops-card paper-v6 mt-3" dir="rtl" aria-label="ملخص العمليات والرسوم">
                            <!-- Ribbon -->
                            <div class="paper-v6__ribbon">
                                <div class="paper-v6__ribbon-chip"><i class="ri-list-check"></i></div>
                                <div class="paper-v6__title">الطلبات المختارة</div>
                                <div class="paper-v6__meta">@typeIds.Count عملية</div>
                            </div>

                            <!-- NEW: flat divider line (distinctive line) -->
                            <div class="paper-v6__divider" aria-hidden="true"></div>

                            <!-- Body -->
                            <div class="paper-v6__sheet">
                                <div class="paper-v6__holes" aria-hidden="true"><span></span><span></span><span></span></div>
                                <span class="paper-v6__margin" aria-hidden="true"></span>

                                <div class="ops-list ops-two-cols paper-v6__list">
                                    @for (int i = 0; i < typeIds.Count; i++)
                                    {
                                        var id = typeIds[i];
                                        var name = getName(id);
                                        var fee = getFee(id);
                                        totalFee += fee;

                                        <div class="ops-row paper-v6__row" data-type-id="@id">
                                            <!-- NEW: tiny index badge -->
                                            <span class="row-index-badge">@(i + 1)</span>

                                            <div class="ops-name">
                                                <div class="title">@name</div>
                                            </div>

                                            <div class="ops-fee">
                                                <span class="price-chip">
                                                    <span class="num">@fee.ToString("0.000", ci)</span>
                                                    <span class="cur">د.ك</span>
                                                </span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- NEW FOOTER (distinct, flat, sticky inside card) -->
                            <footer class="paper-v6__foot paper-v6__foot--flat">
                                <div class="foot-left">
                                    <div class="label">
                                        <span class="icon"><i class="ri-calculator-line"></i></span>
                                        <span class="txt">الإجمالي</span>
                                    </div>
                                    <!-- optional note -->
                                    <small class="foot-note">يشمل كل الرسوم المحددة أعلاه</small>
                                </div>

                                <div class="foot-right">
                                    <span class="total-chip" aria-label="المبلغ الإجمالي">
                                        <span class="amount">@totalFee.ToString("0.000", ci)</span>
                                        <span class="currency">د.ك</span>
                                    </span>
                                </div>

                                <!-- bottom accent bar -->
                                <span class="foot-accent" aria-hidden="true"></span>
                            </footer>
                        </section>





                        @functions {
                            string GroupTitle(int t) => t switch
