    <script>
        $(function () {
            var $form = $('#myform');
            if (!$form.length || !$.validator) return;

            /* ================== Helpers ================== */
            function toAsciiDigits(str) {
                return String(str || '')
                    .replace(/[\u0660-\u0669]/g, d => d.charCodeAt(0) - 0x0660)
                    .replace(/[\u06F0-\u06F9]/g, d => d.charCodeAt(0) - 0x06F0);
            }
            function parseLocalYMD(ymd) {
                if (!ymd || typeof ymd !== 'string') return null;
                var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(ymd);
                if (!m) return null;
                var dt = new Date(+m[1], +m[2] - 1, +m[3]);
                dt.setHours(0, 0, 0, 0);
                return dt;
            }

            /* ================== Custom rules ================== */
            if (!$.validator.methods.notFutureDate) {
                $.validator.addMethod('notFutureDate', function (value) {
                    if (!value) return true;
                    var v = parseLocalYMD(value);
                    if (!v) return false;
                    var today = new Date(); today.setHours(0, 0, 0, 0);
                    return v.getTime() <= today.getTime();
                }, 'لا يمكن اختيار تاريخ في المستقبل.');
            }

            // Define missing rule to avoid "no such method" error
            if (!$.validator.methods.notEqualToOldPaci) {
                $.validator.addMethod('notEqualToOldPaci', function (value, element) {
                    var $old = $('#CurrentAddressAutoNo, #OldAddressAutoNo, [name="AddressVM.OldAalliNo"]').first();
                    var oldVal = $old.length ? $old.val() : ($(element).data('old') || '');
                    var newVal = toAsciiDigits(String(value || '')).trim();
                    oldVal = toAsciiDigits(String(oldVal || '')).trim();
                    if (!newVal || !oldVal) return true;
                    return newVal !== oldVal;
                }, 'الرقم الآلي الجديد يجب أن يختلف عن الرقم الآلي القديم.');
            }

            /* ================== Init validator ================== */
            var validator = $form.data('validator') || $form.validate({
                ignore: [],
                errorClass: 'is-invalid',
                validClass: 'is-valid',
                errorElement: 'div',
                errorPlacement: function (error, element) {
                    error.addClass('invalid-feedback');

                    if (element.attr('id') === 'PartnersChanged') {
                        var $tbl = $('#partnersTable');
                        if ($tbl.length) { error.insertAfter($tbl); return; }
                    }

                    if (element.hasClass('select2-hidden-accessible')) {
                        var $sel = element.next('.select2');
                        if ($sel.length) { error.insertAfter($sel); return; }
                    }

                    var $wrap = element.closest('.info-value, .form-group');
                    if ($wrap.length) { $wrap.append(error); } else { error.insertAfter(element); }
                },
                highlight: function (el) {
                    var $el = $(el);
                    $el.addClass('is-invalid').removeClass('is-valid');
                    if ($el.hasClass('select2-hidden-accessible')) {
                        $el.next('.select2').find('.select2-selection')
                            .addClass('is-invalid').removeClass('is-valid');
                    }
                },
                unhighlight: function (el) {
                    var $el = $(el);
                    $el.removeClass('is-invalid').addClass('is-valid');
                    if ($el.hasClass('select2-hidden-accessible')) {
                        $el.next('.select2').find('.select2-selection')
                            .removeClass('is-invalid').addClass('is-valid');
                    }
                }
            });

            /* ================== Add rules helper ================== */
            function addRulesIfPresent($el, baseRules, messages) {
                if (!$el.length) return;
                var rules = $.extend(true, {}, baseRules);
                if ($el.is('input[type="text"], input:not([type])')) {
                    rules.normalizer = rules.normalizer || function (v) {
                        return $.trim(v || '').replace(/\s+/g, ' ');
                    };
                }
                rules.messages = messages || {};
                $el.rules('add', rules);
            }

            /* ================== De-duplicate ONLY MotletterNo/MotletterDate ================== */
            (function deDupeTradeFields() {
                var $motNo = $('[name="transaction.MotletterNo"], #transactions_MotletterNo').first();
                var $motDate = $('[name="transaction.MotletterDate"], #MotletterDate').first();

                if ($motDate.length) {
                    try { $motDate.rules('remove', 'date dateISO range max min required notFutureDate'); } catch (e) { }
                    $motDate.rules('add', {
                        notFutureDate: true,
                        messages: { notFutureDate: 'لا يمكن اختيار تاريخ في المستقبل.' }
                    });
                    $motDate.on('change', function () { $(this).valid(); });
                }

                if ($motNo.length) {
                    try { $motNo.rules('remove', 'required minlength maxlength'); } catch (e) { }
                    $motNo.rules('add', {
                        required: true,
                        minlength: 2,
                        maxlength: 50,
                        normalizer: function (v) { return (toAsciiDigits(v) || '').trim(); },
                        messages: {
                            required: 'ادخل رقم كتاب التجارة.',
                            minlength: 'الحد الأدنى 2 أحرف/أرقام.',
                            maxlength: 'الحد الأقصى 50 حرف/رقم.'
                        }
                    });
                }
            })();

            /* ================== Other business rules (unchanged) ================== */
            addRulesIfPresent(
                $('[name="CompanyNameChangeTransactionVM.NewCompanyNameDir"], #CompanyNameChangeTransactionVM_NewCompanyNameDir').first(),
                { required: true, minlength: 3, maxlength: 200 },
                { required: 'ادخل اسم الشركة الجديد.', minlength: 'الحد الأدنى 3 أحرف.', maxlength: 'الحد الأقصى 200 حرف.' }
            );
            addRulesIfPresent(
                $('[name="CommercialNameChangeTransactionVm.NewCommercialName"], #CommercialNameChangeTransactionVm_NewCommercialName').first(),
                { required: true, minlength: 3, maxlength: 200 },
                { required: 'ادخل الاسم التجاري الجديد.', minlength: 'الحد الأدنى 3 أحرف.', maxlength: 'الحد الأقصى 200 حرف.' }
            );
            addRulesIfPresent(
                $('[name="ChangeManagerTransVM.ManagerNewname"], #ChangeManagerTransVM_ManagerNewname').first(),
                { required: true, minlength: 3, maxlength: 200 },
                { required: 'ادخل اسم المدير الجديد.', minlength: 'الحد الأدنى 3 أحرف.', maxlength: 'الحد الأقصى 200 حرف.' }
            );

            (function () {
                var $activity = $('#ActivityTypeId, [name="ActivityTypeId"]').first();
                if (!$activity.length) return;
                addRulesIfPresent($activity, { required: true }, { required: 'اختر النشاط.' });
                $activity.on('change', function () { $(this).valid(); });
                if ($.fn.select2) { $activity.on('select2:close', function () { $(this).valid(); }); }
            })();

            (function () {
                var $newPaci = $('#RequestNewAddressAutoNo, [name="AddressVM.AalliNo"]').first();
                if (!$newPaci.length) return;
                var $govId = $('#CompanyGovId, [name="AddressVM.GovernateId"]').first();
                var $areaId = $('#CompanyAreaId, [name="AddressVM.AreaId"]').first();
                var $noData = $('#no-address-icon');

                addRulesIfPresent($newPaci, {
                    required: true, digits: true, minlength: 6, maxlength: 15, notEqualToOldPaci: true,
                    normalizer: function (value) { return toAsciiDigits(value).trim(); }
                }, {
                    required: 'ادخل الرقم الآلي الجديد.',
                    digits: 'الرقم الآلي يجب أن يكون أرقاماً فقط.',
                    minlength: 'الرقم الآلي قصير جداً.',
                    maxlength: 'الرقم الآلي طويل جداً.'
                });

                if ($govId.length) {
                    addRulesIfPresent($govId, {
                        required: function () { return $.trim($newPaci.val()).length > 0; }
                    }, { required: 'يجب تحديد المحافظة بعد جلب العنوان.' });
                }
                if ($areaId.length) {
                    addRulesIfPresent($areaId, {
                        required: function () { return $.trim($newPaci.val()).length > 0; }
                    }, { required: 'يجب تحديد المنطقة بعد جلب العنوان.' });
                }

                $newPaci.on('keyup change', function () {
                    if ($.trim(this.value).length && $noData.length) { $noData.addClass('d-none'); }
                });

                $form.on('invalid-form.validate', function (e, v) {
                    try {
                        var name = $newPaci.attr('name');
                        var paciInvalid = v && v.invalid && name && v.invalid[name];
                        if (paciInvalid && $noData.length) { $noData.removeClass('d-none'); }
                    } catch (_) { }
                });
            })();

            (function () {
                var $reason = $('#ReasonID, [name="ReasonID"]').first();
