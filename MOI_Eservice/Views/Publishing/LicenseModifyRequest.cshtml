                                                           asp-for="ChangeManagerTransVM.ManagerNewbirthdate"
                                                           name="ChangeManagerTransVM.ManagerNewbirthdate" />
                                                </div>

                                                <!-- Nationality -->
                                                <div class="col">
                                                    <label class="form-label">جنسية المدير الجديد <span class="required">*</span></label>
                                                    <select class="form-control select2 shadow-sm"
                                                            asp-for="ChangeManagerTransVM.ManagerNewcountryid"
                                                            name="ChangeManagerTransVM.ManagerNewcountryid"
                                                            id="ChangeManagerTransVM_ManagerNewcountryid">
                                                        <option value="">اختر الجنسية</option>
                                                        @if (Model.countriesLookupVM != null)
                                                        {
                                                            foreach (var country in Model.countriesLookupVM)
                                                            {
                                                                <option value="@country.Id">@country.Name</option>
                                                            }
                                                        }
                                                    </select>
                                                </div>

                                                <!-- Qualification -->
