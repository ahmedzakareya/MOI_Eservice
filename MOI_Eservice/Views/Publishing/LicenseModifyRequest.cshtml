                        @* ========= Helpers لتسمية المجموعات ========= *@
                        @functions {
                            public string GetAttachGroupTitle(int? t)
                            {
                                if (!t.HasValue) return "مرفقات عامة";
                                switch (t.Value)
                                {
                                    case 1: return "تغيير اسم الشركة";
                                    case 2: return "تغيير الاسم التجاري";
                                    case 3: return "دخول/خروج الشركاء";
                                    case 4: return "تغيير العنوان";
                                    case 9: return "تغيير المدير";
                                    case 11: return "تغيير النشاط";
                                    case 17: return "التجديد";
                                    case 19: return "إنهاء الترخيص";
                                    case 77: return "التنازل";
                                    default: return "مرفقات عامة";
                                }
                            }
                        }

                        @{
                            // تقسيم المرفقات إلى مجموعات حسب TransactionTypeId
                            var allRules = Model.attachRules ?? new List<Business.ViewModel.AttachRuleVM>();

                            var groups = allRules
                            .Where(a => a.TransactionTypeId.HasValue)
                            .GroupBy(a => a.TransactionTypeId!.Value)
                            .OrderBy(g => g.Key)
