                                <div class="icon bg-light text-danger rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                                    <i class="ri-attachment-line" style="font-size: 24px;"></i>
                                </div>
                                <div>
                                    <h5 class="mb-1 fw-bold text-primary">مرفقات الطلب</h5>
                                    <span class="text-danger small fw-bold">الملفات بصيغه PDF بحد أقصى 2MB</span>
                                </div>
                            </div>
                            <div>
                                <i class="ri-bookmark-line text-danger fs-5 me-2 hover-opacity" style="cursor: pointer;"></i>
                                <i class="ri-bookmark-fill text-danger fs-5 d-none hover-opacity" style="cursor: pointer;"></i>
                            </div>
                        </div>

                        <hr class="mt-2 mb-3 border-danger opacity-25">

                        <div class="row">
                            @foreach (var item in Model.attachRules)
                            {
                                var inputId = $"file-{item.Id}";
                                var fileNameId = $"file-name-{item.Id}";
                                var previewDivId = $"pdf-preview-{item.Id}";
                                var iframeId = $"pdf-iframe-{item.Id}";
                                var errorId = $"error-{item.Id}";
                                var hiddenFileNameId = $"file-name-hidden-{item.Id}";

                                <div class="col-md-6">
                                    <div class="mb-4">
                                        <label class="form-label fw-bold text-muted">
                                            @item.AttachName <span class="text-danger">*</span>
                                        </label>

                                        <div class="custom-file-upload">
                                            <input type="file"
                                                   id="@inputId"
                                                   name="UploadedFiles"
                                                   class="form-control-file d-none"
                                                   accept=".pdf"
                                            @(item.IsMandatory == true ? "required" : "")
                                                   onchange="handleFileUpload(this, '@previewDivId', '@iframeId', '@fileNameId', '@errorId', '@item.Id', @(item.IsMandatory.ToString().ToLower()))" />


                                            <label for="@inputId" class="btn btn-outline-primary w-100">
                                                <i class="ri-upload-cloud-line me-2"></i> اختر ملف PDF
                                            </label>

                                            <div id="@fileNameId" class="file-name-display mt-2 small text-muted"></div>

                                            <div id="@errorId" class="text-danger small mt-1" style="display:none;">
                                                يجب اختيار ملف PDF فقط
                                            </div>

                                            <div id="@previewDivId" class="pdf-preview-container mt-3" style="display:none;">
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="fw-bold">معاينة الملف:</span>
                                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                                            onclick="clearPdfPreview('@previewDivId', '@inputId', '@fileNameId', '@iframeId', '@hiddenFileNameId')">
                                                        <i class="ri-close-line"></i> إزالة
                                                    </button>
                                                </div>
                                                <iframe id="@iframeId" class="w-100 border rounded" style="height:300px;" frameborder="0"></iframe>
                                            </div>

                                            <input type="hidden" name="FileNames" id="@hiddenFileNameId" />
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>


                    </div>
                </div>
            </div>
        </div>






        @section Scripts {
            <script>
                function handleFileUpload(input, previewDivId, iframeId, fileNameId, errorId, itemId, isMandatory) {
                    const file = input.files[0];
                    const errorEl = document.getElementById(errorId);
                    const fileNameEl = document.getElementById(fileNameId);
                    const previewDiv = document.getElementById(previewDivId);
                    const iframe = document.getElementById(iframeId);
                    const hiddenInput = document.getElementById("file-name-hidden-" + itemId);

                    const maxSize = 2 * 1024 * 1024; // 2MB

                    if (!file) {
                        if (isMandatory) {
                            errorEl.textContent = "هذا الملف مطلوب";
                            errorEl.style.display = "block";
                        } else {
                            errorEl.style.display = "none";
                        }
                        fileNameEl.innerText = "";
                        previewDiv.style.display = "none";
                        iframe.src = "";
                        hiddenInput.value = "";
                        return;
                    }

                    if (file.type !== "application/pdf") {
                        errorEl.textContent = "يجب اختيار ملف بصيغة PDF فقط";
                        errorEl.style.display = "block";
                        return;
                    }

                    if (file.size > maxSize) {
                        errorEl.textContent = "حجم الملف يجب ألا يتجاوز 2 ميجابايت";
                        errorEl.style.display = "block";
                        return;
                    }

                    // ملف صحيح
                    errorEl.style.display = "none";
                    fileNameEl.innerText = file.name;
                    hiddenInput.value = file.name;

                    const reader = new FileReader();
                    reader.onload = function (e) {
                        iframe.src = e.target.result;
                        previewDiv.style.display = "block";
                    };
                    reader.readAsDataURL(file);
                }

                function handleFileUpload(input, previewDivId, iframeId, fileNameId, errorId, itemId) {
                    const file = input.files[0];
                    const errorEl = document.getElementById(errorId);
                    const fileNameEl = document.getElementById(fileNameId);
                    const previewDiv = document.getElementById(previewDivId);
                    const iframe = document.getElementById(iframeId);
                    const hiddenInput = document.getElementById("file-name-hidden-" + itemId);

                    if (!file || file.type !== "application/pdf") {
                        errorEl.style.display = "block";
                        fileNameEl.innerText = "";
                        previewDiv.style.display = "none";
                        iframe.src = "";
                        hiddenInput.value = "";
                        return;
                    }

                    errorEl.style.display = "none";
                    fileNameEl.innerText = file.name;
                    hiddenInput.value = file.name;

                    const reader = new FileReader();
                    reader.onload = function (e) {
                        iframe.src = e.target.result;
                        previewDiv.style.display = "block";
                    };
                    reader.readAsDataURL(file);
                }

                function clearPdfPreview(previewDivId, inputId, fileNameId, iframeId, hiddenInputId) {
                    document.getElementById(previewDivId).style.display = "none";
                    document.getElementById(fileNameId).innerText = "";
                    document.getElementById(iframeId).src = "";
                    document.getElementById(hiddenInputId).value = "";
                    document.getElementById(inputId).value = ""; 
                }
            </script>
        }

            <div class="col-lg-12 col-md-12">
                <button type="submit" class="default-btn"> إرسال الطلب  <i class="ri-edit-box-line"></i></button>
            </div>
        </>
    </form>
</div>

<div class="modal fade" id="pdfModal" tabindex="-1" aria-labelledby="pdfModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="pdfModalLabel"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body">
                <iframe id="modalPdfViewer" width="100%" height="600px" frameborder="0"></iframe>
            </div>
        </div>
    </div>
</div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<!-- End Company Profile Area -->
<script>
    let rowCount = 1;
    let channelsPersonsFiles = [];

    document.addEventListener("DOMContentLoaded", function () {
        $('.select2').select2();

        const addBtn = document.getElementById("addTempBtn");
        if (addBtn) {
            addBtn.addEventListener("click", function (e) {
                e.preventDefault();
                addTempRow();
            });
        }

        document.getElementById("tempTableBody").addEventListener("click", function (e) {
            if (e.target.closest(".delete-btn")) {
                e.preventDefault();
                const row = e.target.closest("tr");
                const index = row.rowIndex - 1;
                channelsPersonsFiles.splice(index, 1);
                row.remove();
            }
        });

        document.addEventListener("click", function (e) {
            if (e.target.closest(".view-pdf-btn")) {
                e.preventDefault();
                const pdfUrl = e.target.closest(".view-pdf-btn").getAttribute("data-pdf-url");
                previewPdf(pdfUrl);
            }
        });

        $('.select2').on('change', function () {
            $(this).valid();
        });

        function isValidKuwaitiCivilId(civilId) {
            if (!/^\d{12}$/.test(civilId)) return false;
            const multipliers = [2, 1, 6, 3, 7, 9, 10, 5, 8, 4, 2];
            let sum = 0;
            for (let i = 0; i < 11; i++) {
                sum += parseInt(civilId[i]) * multipliers[i];
            }
            const checkDigit = (11 - (sum % 11)) % 11;
            return checkDigit === parseInt(civilId[11]);
        }

        $.validator.addMethod("validCivilId", function (value, element) {
            return this.optional(element) || isValidKuwaitiCivilId(value);
        }, "رقم مدني غير صحيح");

        $("#myform").validate({
            rules: {
                Licname: { required: true, maxlength: 100 },
                LicLocation: { required: true, maxlength: 100 },
                LicNationality: { required: true, min: 1 },
                LicLanguage: { required: true, maxlength: 50 },
                RequestNewAddressAutoNo: { required: true, maxlength: 50 }, // هذه ستبقى لكنها لن تعتمد
                "person.CivilId": {
                    required: true,
                    digits: true,
                    minlength: 12,
                    maxlength: 12,
                    validCivilId: true
                },
                "person.personName": { required: true, maxlength: 100 },
                "person.NationalityId": { required: true, min: 1 },
                "person.BirthDate": { required: true }
            },
            messages: {
                Licname: { required: "حقل مطلوب", maxlength: "يجب ألا يتجاوز الاسم 100 حرف" },
                LicLocation: { required: "حقل مطلوب", maxlength: "يجب ألا يتجاوز العنوان 100 حرف" },
                LicNationality: { required: "حقل مطلوب", min: "يجب اختيار جنسية صالحة" },
                LicLanguage: { required: "حقل مطلوب", maxlength: "يجب ألا يتجاوز النص 50 حرف" },
                RequestNewAddressAutoNo: { required: "حقل مطلوب" },
                "person.CivilId": {
                    required: "حقل مطلوب",
                    digits: "يجب أن يحتوي على أرقام فقط",
                    minlength: "يجب أن يتكون الرقم المدني من 12 رقمًا",
                    maxlength: "يجب أن يتكون الرقم المدني من 12 رقمًا",
                    validCivilId: "رقم مدني غير صحيح"
                },
                "person.personName": { required: "حقل مطلوب", maxlength: "يجب ألا يتجاوز الاسم 100 حرف" },
                "person.NationalityId": { required: "حقل مطلوب", min: "يجب اختيار جنسية صالحة" } ,
                "person.BirthDate": { required: "حقل مطلوب", min: "يجب اختيار تاريخ ميلاد المدير" },
            },
            errorElement: 'span',
            errorClass: 'text-danger small',
            errorPlacement: function (error, element) {
                if (element.hasClass('select2-hidden-accessible')) {
                    error.insertAfter(element.next('.select2-container'));
                } else {
                    error.insertAfter(element);
                }
            },
            highlight: function (element) {
                $(element).addClass('is-invalid');
                if ($(element).hasClass('select2-hidden-accessible')) {
                    $(element).next('.select2-container').addClass('is-invalid');
                }
            },
            unhighlight: function (element) {
                $(element).removeClass('is-invalid');
                if ($(element).hasClass('select2-hidden-accessible')) {
                    $(element).next('.select2-container').removeClass('is-invalid');
                }
            },
            submitHandler: function (form) {
                // ✅ تحقق يدوي من حقل الرقم الآلي باستخدام Swal
                const addressValue = document.getElementById("RequestNewAddressAutoNo").value.trim();
                if (!addressValue) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'تنبيه',
                        text: 'الرجاء تعبئة الرقم الآلي للعنوان قبل إرسال الطلب',
                        confirmButtonText: 'حسناً'
                    });
                    return false;
                }

                submitFormData(form);
                return false;
            }
        });
    });

    function addTempRow() {
        const fullName = document.getElementById("fullName").value.trim();
        const civilId = document.getElementById("civilId").value.trim();
        const passport = document.getElementById("passport").value.trim();
        const workFile = document.getElementById("employee-list").files[0];
        const criminalFile = document.getElementById("additional-file").files[0];

        if (!fullName || !civilId || !passport || !workFile || !criminalFile) {
            Swal.fire({
                icon: 'warning',
                title: 'تنبيه',
                text: 'الرجاء تعبئة جميع الحقول واختيار الملفات',
                confirmButtonText: 'حسناً'
            });
            return;
        }

        const workFileURL = URL.createObjectURL(workFile);
        const criminalFileURL = URL.createObjectURL(criminalFile);

        const tableBody = document.getElementById("tempTableBody");
        const newRow = document.createElement("tr");
        newRow.className = rowCount % 2 === 0 ? 'bg-light' : 'bg-white';
        newRow.innerHTML = `
                <td>${rowCount}</td>
                <td>${fullName}</td>
                <td>${civilId} / ${passport}</td>
                <td><button class="btn btn-sm p-0 border-0 bg-transparent view-pdf-btn" data-pdf-url="${workFileURL}"><i class="ri-eye-line text-primary fs-5"></i></button></td>
                <td><button class="btn btn-sm p-0 border-0 bg-transparent view-pdf-btn" data-pdf-url="${criminalFileURL}"><i class="ri-eye-line text-primary fs-5"></i></button></td>
                <td class="text-end"><button class="delete-btn btn btn-sm p-0 border-0 bg-transparent"><i class="ri-delete-bin-line text-danger fs-5"></i></button></td>
            `;

        tableBody.appendChild(newRow);
        channelsPersonsFiles.push({ fullName, civilId, passport, workFile, criminalFile });
        rowCount++;

        document.getElementById("fullName").value = "";
        document.getElementById("civilId").value = "";
        document.getElementById("passport").value = "";
        document.getElementById("employee-list").value = "";
        document.getElementById("additional-file").value = "";
        document.getElementById("pdf-preview1").style.display = "none";
        document.getElementById("pdf-preview2").style.display = "none";
        document.getElementById("file-name1").textContent = "";
        document.getElementById("file-name2").textContent = "";
    }

    function submitFormData(form) {
        if (channelsPersonsFiles.length === 0) {
            Swal.fire({
                icon: 'warning',
                title: 'تنبيه',
                text: 'الرجاء إضافة بيانات الأشخاص قبل إرسال النموذج.',
                confirmButtonText: 'حسناً'
            });
            return;
        }

        const formData = new FormData(form);

        channelsPersonsFiles.forEach((item, index) => {
            formData.append(`channelsPersons[${index}].Name`, item.fullName);
            formData.append(`channelsPersons[${index}].civilId`, item.civilId);
            formData.append(`channelsPersons[${index}].passport`, item.passport);
            formData.append(`channelsPersons[${index}].workFile`, item.workFile);
            formData.append(`channelsPersons[${index}].criminalFile`, item.criminalFile);
        });

        $.ajax({
            url: $(form).attr('action'),
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            headers: {
                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
            },
            beforeSend: function () {
                Swal.fire({
                    title: 'جاري ارسال الطلب',
                    html: 'الرجاء الانتظار...',
                    allowOutsideClick: false,
                    didOpen: () => Swal.showLoading()
                });
            },
            success: function (response) {
                Swal.close();
                if (response.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'تم بنجاح',
                        text: response.message,
                        confirmButtonText: 'حسناً'
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'خطأ',
                        text: response.message || 'حدث خطأ غير متوقع',
                        confirmButtonText: 'حسناً'
                    });
                }
            },
            error: function (xhr) {
                Swal.close();
                Swal.fire({
                    icon: 'error',
                    title: 'خطأ في الاتصال',
                    text: 'حدث خطأ أثناء الإرسال: ' + xhr.statusText,
                    confirmButtonText: 'حسناً'
                });
            }
        });
    }

    function handleFileSelect(event, fileNameElementId, errorElementId, previewContainerId, iframeId) {
        const file = event.target.files[0];
        const fileNameElement = document.getElementById(fileNameElementId);
        const errorElement = document.getElementById(errorElementId);
        const previewContainer = document.getElementById(previewContainerId);
        const pdfIframe = document.getElementById(iframeId);

        if (file) {
            const isValid = file.type === 'application/pdf' || file.name.toLowerCase().endsWith('.pdf');
            if (!isValid) {
                errorElement.style.display = 'block';
                fileNameElement.textContent = '';
                event.target.value = '';
                previewContainer.style.display = 'none';
            } else {
                errorElement.style.display = 'none';
                fileNameElement.textContent = 'تم اختيار الملف: ' + file.name;
                const fileURL = URL.createObjectURL(file);
                pdfIframe.src = fileURL;
                previewContainer.style.display = 'block';
            }
        }
    }

    function clearPdfPreview(previewId, inputId, fileNameId) {
        document.getElementById(inputId).value = '';
        document.getElementById(fileNameId).textContent = '';
        document.getElementById(previewId).style.display = 'none';
        document.getElementById(previewId.replace('preview', 'iframe')).src = '';
    }

    function previewPdf(fileUrl) {
        const modalViewer = document.getElementById("modalPdfViewer");
        modalViewer.src = fileUrl;
        const modal = new bootstrap.Modal(document.getElementById("pdfModal"));
        modal.show();
    }

    ['employee-list', 'additional-file'].forEach((id, idx) => {
        document.getElementById(id).addEventListener('change', function (e) {
            handleFileSelect(e, `file-name${idx + 1}`, `error-message${idx + 1}`, `pdf-preview${idx + 1}`, `pdf-iframe${idx + 1}`);
        });
    });

    Array.from(document.querySelectorAll('.remove-pdf-btn')).forEach(button => {
        button.addEventListener('click', function (e) {
            e.preventDefault();
            clearPdfPreview(this.getAttribute('data-preview'), this.getAttribute('data-input'), this.getAttribute('data-file'));
        });
    });
</script>










        <script>
    function get_Amount(ID) {
        var address = $("#AddressAutoNo").val();

        Swal.fire({
            title: '<span style="font-size: 20px; color: #2471a3;">جاري تحميل البيانات</span>',
            html: `
            <div style="margin-top: 20px;">
                <svg class="spinner" width="50px" height="50px" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
                    <circle class="path" fill="none" stroke-width="6" stroke-linecap="round" cx="33" cy="33" r="30"></circle>
                </svg>
                <br><br><span class="wait-text">يرجى الانتظار قليلاً...</span>
            </div>
        `,
            allowOutsideClick: false,
            showConfirmButton: false
        });





        $.ajax({
            type: 'GET',
            dataType: 'json',
            url: '@Url.Action("GetAddressDataFromPaci", "Account", new { area = "Admin" })',
            data: { id: ID },
            success: function (data) {
                Swal.close();

                if (data) {
                    $('#RequestNewAddressGovName').val(data.governoratearabic || '');
                    $('#RequestNewBlookName').val(data.blockarabic || '');
                    $('#RequestNewAreaName').val(data.neighborhoodarabic || '');
                    $('#CompanyAreaId').val(data.neighborhoodid || '');
                    $('#CompanyGovId').val(data.governorateid || '');
                    $('#RequestNewParcelOrFloor').val("وحدة : " + (data.unit_no || '') + " الدور : " + (data.floor_no || ''));
                    $('#RequestNewStreetName').val(data.streetarabic || '');
                    $('#RequestNewBulding').val(data.parcelarabic || '');
                    $('#RequestLicowner').val(data.buildingnamearabic || '');
                    $('#RequestNewAddressAutoNo').val(address);
                    $('#latitude').val(data.latitude || '');
                    $('#longitude').val(data.longitude || '');

                    retrieveCoordinates(data.lon, data.lat, "map");

                    $("#no-address-icon").fadeOut(200, function () {
                        $("#address-fields").fadeIn(200).removeClass('d-none');
                    });

                    $("#AddressAutoNo").val('');
                } else {
                    showError();
                }
            },
            error: function () {
                Swal.close();
                showError();
            }
        });

        function showError() {
            // فقط إظهار الأيقونة وإخفاء الحقول دون تنبيه SweetAlert
            $("#address-fields").fadeOut(200, function () {
                $("#no-address-icon").fadeIn(300).removeClass('d-none');
            });

            // تفريغ الحقول
            $('#RequestNewAddressAutoNo').val('');
            $('#RequestNewAddressGovName').val('');
            $('#RequestNewAreaName').val('');
            $('#RequestNewBlookName').val('');
            $('#RequestNewStreetName').val('');
            $('#RequestNewBulding').val('');
            $('#RequestLicowner').val('');
            $('#RequestNewParcelOrFloor').val('');
            $('#AddressAutoNo').val('');
            $("#map").empty();
        }

        return false;
    }






    function retrieveCoordinates(longitude, latitude, mapContainerId) {
        require([
            "esri/tasks/Locator",
            "esri/Map",
            "esri/views/MapView",
            "esri/Graphic"
        ], function (Locator, Map, MapView, Graphic) {
            var map = new Map({
                basemap: "topo-vector"
            });
            var view = new MapView({
                container: mapContainerId,
                map: map,
                center: [longitude, latitude],
                zoom: 17
            });
            var point = {
                type: "point",
                longitude: longitude,
                latitude: latitude
            };
            var simpleMarkerSymbol = {
                type: "simple-marker",
                color: [226, 119, 40], 
                outline: {
                    color: [255, 255, 255], 
                    width: 1
                }
            };
            var pointGraphic = new Graphic({
                geometry: point,
                symbol: simpleMarkerSymbol
            });
            view.graphics.removeAll();
            view.graphics.add(pointGraphic);
        });
    }

        </script>

