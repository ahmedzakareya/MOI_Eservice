                                                class="btn search-btn"
                                                onclick="return get_Amount($('#AddressAutoNo').val())">
                                            <i class="ri-search-line fs-5"></i>
                                        </button>
                                        <ul id="suggestionList"
                                            class="autocomplete-suggestions list-unstyled position-absolute w-100 bg-white border border-top-0 rounded-bottom shadow mt-1 z-3 d-none">
                                            <!-- العناصر المقترحة تظهر هنا -->
                                        </ul>
                                    </div>

                                    <!-- Address Fields -->
                                    <!-- Address Fields Wrapper -->
                                    <div id="address-section">
                                        <div class="card shadow-sm border-0 mb-4" id="address-fields">
                                            <div class="card-body">
                                                <div class="row g-3">
                                                    <!-- الرقم الآلي -->
                                                    <div class="col-md-6">
                                                        <div class="header">
                                                            <span>الرقم الآلي للعنوان</span>
                                                            <i class="ri-barcode-box-line"></i>
                                                        </div>
                                                        <div class="content">
                                                            @Html.TextBoxFor(m => m.address.AalliNo, new { @class = "form-control border-0 bg-transparent fw-bold", @readonly = "readonly", @id = "RequestNewAddressAutoNo" })
                                                        </div>
                                                    </div>

                                                    <!-- المحافظة -->
                                                    <div class="col-md-6">
                                                        <div class="header">
                                                            <span>المحافظة</span>
                                                            <i class="ri-government-line"></i>
                                                        </div>
                                                        <div class="content">
                                                            <input type="text" readonly id="RequestNewAddressGovName" class="form-control border-0 bg-transparent fw-bold" />
                                                            @Html.TextBoxFor(m => m.address.GovernateId, new { @class = "d-none", @id = "CompanyGovId", @readonly = "readonly" })
                                                        </div>
                                                    </div>

                                                    <!-- المنطقة -->
                                                    <div class="col-md-6">
                                                        <div class="header">
                                                            <span>المنطقة</span>
                                                            <i class="ri-community-line"></i>
                                                        </div>
                                                        <div class="content">
                                                            <input type="text" readonly id="RequestNewAreaName" class="form-control border-0 bg-transparent fw-bold" />
                                                            @Html.TextBoxFor(m => m.address.AreaId, new { @class = "d-none", @id = "CompanyAreaId", @readonly = "readonly" })
                                                        </div>
                                                    </div>

                                                    <!-- القطعة -->
                                                    <div class="col-md-6">
                                                        <div class="header">
                                                            <span>القطعة</span>
                                                            <i class="ri-grid-line"></i>
                                                        </div>
                                                        <div class="content">
                                                            @Html.TextBoxFor(m => m.address.BlockArabic, new { @class = "form-control border-0 bg-transparent fw-bold", @readonly = "readonly", @id = "RequestNewBlookName" })
                                                        </div>
                                                    </div>

                                                    <!-- المبنى -->
                                                    <div class="col-md-12">
                                                        <div class="header">
                                                            <span>المبنى</span>
                                                            <i class="ri-building-4-line"></i>
                                                        </div>
                                                        <div class="content">
                                                            @Html.TextBoxFor(m => m.address.BuildingNo, new { @class = "form-control border-0 bg-transparent fw-bold", @readonly = "readonly", @id = "RequestNewBulding" })
                                                        </div>
                                                    </div>

                                                    <!-- الشارع -->
                                                    <div class="col-md-12">
                                                        <div class="header">
                                                            <span>الشارع</span>
                                                            <i class="ri-road-map-line"></i>
                                                        </div>
                                                        <div class="content">
                                                            @Html.TextBoxFor(m => m.address.StreetArabic, new { @class = "form-control border-0 bg-transparent fw-bold", @readonly = "readonly", @id = "RequestNewStreetName" })
                                                        </div>
                                                    </div>

                                                    <!-- المالك -->
                                                    <div class="col-md-12">
                                                        <div class="header">
                                                            <span>المالك</span>
                                                            <i class="ri-user-3-line"></i>
                                                        </div>
                                                        <div class="content">
                                                            @Html.TextBoxFor(m => m.address.BuildingName, new { @class = "form-control border-0 bg-transparent fw-bold", @readonly = "readonly", @id = "RequestLicowner" })
                                                        </div>
                                                    </div>

                                                    <!-- الدور - المحل -->
                                                    <div class="col-md-12">
                                                        <div class="header">
                                                            <span>الدور - المحل</span>
                                                            <i class="ri-store-3-line"></i>
                                                        </div>
                                                        <div class="content">
                                                            @Html.TextBoxFor(m => m.address.FloorNo, new { @class = "form-control border-0 bg-transparent fw-bold", @readonly = "readonly", @id = "RequestNewParcelOrFloor" })
                                                        </div>
                                                    </div>
                                                </div>


                                            </div>
                                        </div>


                                        <div id="no-address-icon" class="d-none mt-5">
                                            <div class="wrapper-notebook">
                                                <div class="notebook-page text-center">
                                                    <div class="icon-container">
                                                        <i class="ri-error-warning-line" style="font-size: 36px;"></i>
                                                    </div>
                                                    <div class="note-text">
                                                        <h5 class="fw-bold text-danger">لم يتم العثور على بيانات</h5>
                                                        <p class="text-muted mb-0">الرقم الآلي المدخل غير صحيح</p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>

                                <!-- Map Section -->
                                <div class="col-lg-8">
                                    <div class="p-4 h-100 d-flex flex-column bg-white rounded-4 border border-light-subtle shadow-sm">

                                        <!-- بانر أزرق عصري -->
                                        <!-- Header -->
                                        <div class="bg-primary text-white px-4 py-3 d-flex align-items-center rounded">
                                            <div class="bg-white text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                                <i class="ri-road-map-line fs-5"></i>
                                            </div>
                                            <div>
                                                <h6 class="mb-0 fw-bold" style="color:aliceblue">الموقع على الخريطة</h6>
                                            </div>
                                        </div>

                                        <!-- خريطة -->
                                        <div id="map"
                                             style="
                width: 100%;
                flex-grow: 1;
                border-radius: 16px;
                overflow: hidden;
                border: 1px solid #e0e0e0;
                margin-top: 16px;">
                                            <!-- يمكنك تعديل هذه المسافة حسب الحاجة -->
                                        </div>
                                    </div>
                                </div>




                            </div>
                           
                        </div>
                    </div>
                </div>
            </div>

           



            <!-- ESRI ArcGIS CSS -->
            <link rel="stylesheet" href="https://js.arcgis.com/4.11/esri/css/main.css">


            <!-- Start Checkout Area -->
            <div class="checkout-area ptb-100">
                <div class="container">
                    <div class="user-actions">
                        <i class="ri-team-line"></i>
                        <span class="fw-bold">كشف او بيان باسماء العاملين في المكتب</span>
                    </div>

                  
                        <div class="row">
                            <div class="col-lg-12 col-md-12">
                                <div class="billing-details">
                                    <h3 class="title">البيانات</h3>

                                    <div class="row">
                                        <div class="col-lg-12 col-md-12">
                                            <div class="form-group">
                                            <label>الإسم <span class="required">*</span></label>
                                            <input type="text" class="form-control" id="fullName" placeholder="الإسم">
                                        </div>
                                        </div>

                                        <div class="col-lg-6 col-md-6">
                                            <div class="form-group">
                                            <label>  البطاقة المدنية <span class="required">*</span></label>
                                            <input type="text" class="form-control" id="civilId" placeholder="البطاقة المدنية">
                                        </div>
                                        </div>

                                        <div class="col-lg-6 col-md-6">
                                            <div class="form-group">
                                            <label>  جواز السفر <span class="required">*</span></label>
                                            <input type="text" class="form-control" id="passport" placeholder="جواز السفر">
                                            </div>
                                        </div>


                                    <div class="row mb-3">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="form-label fw-bold text-primary">عقد العمل أو الهوية الصادرة من الرئيس للقناه (pdf) <span class="required">*</span></label>
                                                <div class="custom-file-upload">
                                                    <input type="file" id="employee-list" name="employee-list" class="form-control-file d-none" accept=".pdf">
                                                    <label for="employee-list" class="file-upload-label bg-primary text-white">
                                                        <i class="ri-upload-cloud-line text-white"></i> اختر ملف PDF
                                                    </label>
                                                    <div id="file-name1" class="file-name-display mt-2"></div>
                                                    <div id="error-message1" class="text-danger small" style="display:none;">يجب اختيار ملف PDF فقط</div>

                                                    <!-- معاينة PDF -->
                                                    <div id="pdf-preview1" class="pdf-preview-container mt-3" style="display:none;">
                                                        <div class="pdf-preview-header d-flex justify-content-between align-items-center mb-2">
                                                            <span class="fw-bold">معاينة الملف:</span>
                                                            <button class="btn btn-sm btn-outline-danger remove-pdf-btn" data-preview="pdf-preview1" data-input="employee-list" data-file="file-name1">
                                                                <i class="ri-close-line"></i> إزالة
                                                            </button>
                                                        </div>
                                                        <iframe id="pdf-iframe1" class="pdf-preview-iframe" frameborder="0"></iframe>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="form-label fw-bold text-primary">شهادة الصحيفة الجنائية (pdf) <span class="required">*</span></label>
                                                <div class="custom-file-upload">
                                                    <input type="file" id="additional-file" name="additional-file" class="form-control-file d-none" accept=".pdf">
                                                    <label for="additional-file" class="file-upload-label bg-primary text-white">
                                                        <i class="ri-upload-cloud-line text-white"></i> اختر ملف PDF
                                                    </label>
                                                    <div id="file-name2" class="file-name-display mt-2"></div>
                                                    <div id="error-message2" class="text-danger small" style="display:none;">يجب اختيار ملف PDF فقط</div>

                                                    <!-- معاينة PDF -->
                                                    <div id="pdf-preview2" class="pdf-preview-container mt-3" style="display:none;">
                                                        <div class="pdf-preview-header d-flex justify-content-between align-items-center mb-2">
                                                            <span class="fw-bold">معاينة الملف:</span>
                                                            <button class="btn btn-sm btn-outline-danger remove-pdf-btn" data-preview="pdf-preview2" data-input="additional-file" data-file="file-name2">
                                                                <i class="ri-close-line"></i> إزالة
                                                            </button>
                                                        </div>
                                                        <iframe id="pdf-iframe2" class="pdf-preview-iframe" frameborder="0"></iframe>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>


                                    <button id="addTempBtn" type="button" class="default-btn">
                                        إضافة إسم <i class="ri-arrow-down-line"></i>
                                    </button>




                                    </div>
                                </div>
                            </div>


                       

                        <div class="col-12">
                            <div class="card border-0 shadow-sm rounded-3">
                                <div class="card-body">
                                    <div class="d-flex align-items-center justify-content-between mb-4">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-light text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                                                <i class="ri-list-check-2 fs-4"></i>
                                            </div>
                                            <div>
                                                <h5 class="mb-0 fw-bold text-primary">قائمة الأسماء</h5>
                                                <small class="text-muted">عرض معلومات الأفراد والمرفقات</small>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="table-responsive">
                                        <table class="table align-middle mb-0">
                                            <thead class="bg-light">
                                                <tr class="text-secondary fw-semibold border-bottom">
                                                    <th>#</th>
                                                    <th>الاسم</th>
                                                    <th>الرقم المدني / جواز السفر</th>
                                                    <th>عقد العمل / الهوية</th>
                                                    <th>الصحيفة الجنائية</th>
                                                    <th class="text-end">حذف</th>
                                                </tr>
                                            </thead>
                                            <tbody id="tempTableBody" class="text-dark">
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                       
                        </div>
                    
                </div>
            </div>
        </div>
        <div class="row mb-4">
