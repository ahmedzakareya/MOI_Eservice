@model Business.ViewModel.MoiEserviceLicensesRequestVM

@{
    // ViewBag.Title = Model.Name;
    Layout = "~/Views/Shared/_LayoutEservice.cshtml";
  
}

<link href="~/assets/css/requeststyle.css" rel="stylesheet" />
<div id="loadingSpinner" style="display:none; position:absolute; top:50%; left:50%; transform: translate(-50%, -50%); z-index: 9999;">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<!-- Breadcrumb Area -->
<div class="breadcrumb-area">
    <!--<h1>الملف الشخصي</h1>-->
    <ol class="breadcrumb">
        <li class="item"><a href="MyAccount.html">الرئيسيه</a></li>
        <li class="item"><a href="MyAccount.html">حسابي</a></li>
        <li class="item">الملف الشخصي</li>
    </ol>
</div>
<!-- End Breadcrumb Area -->
<!-- Start Company Profile Area -->
<div class="my-profile-box">
    <h3 class="text-danger">طلب ترخيص مكتب وكالة وقناه مرئية او مسموعة أجنبية</h3>

        <form id="myform" method="post" action="@Url.Action("ChannelRepresentativeOfficeNewRequest", "Channels")">
        @Html.AntiForgeryToken()
        <div class="row align-items-center">

            <div class="row mb-4">
                <div class="col-lg-12 col-md-12">
                    <div class="card border border-1">
                        <div class="card-body">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <div class="d-flex align-items-center">
                                    <div class="icon bg-light text-danger rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                                        <i class="ri-book-3-line" style="font-size: 24px;"></i>
                                    </div>
                                    <div>
                                        <h5 class="mb-1 fw-bold text-primary">البيانات الأساسية للترخيص</h5>
                                        <div class="requirement-item mb-3">
                                            <div class="d-flex">
                                                <span class="badge bg-primary me-2">  </span>
                                                <div>
                                                    
                                                    <p class="mb-0 fw-bold text-danger">
                                                        يجب أن تكون الجهة الإعلامية الأجنبية التي ترغب في فتح مكتب إعلامي لها داخل دولة الكويت مرخصة بالخارج ومستمرة في العمل لمدة لا تقل عن <u >سنة</u> حتى تاريخ تقديم الطلب.
                                                        <br>
                                                        <small class="fw-bold  text-danger">(يشترط تصديق أوراق الترخيص من سفارة دولة الكويت في الدولة المصدرة)</small>
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                       
                                    </div>
                                </div>
                                <div>
                                    <i class="ri-bookmark-line text-danger fs-5 me-2 hover-opacity" style="cursor: pointer;"></i>
                                    <i class="ri-bookmark-fill text-danger fs-5 d-none hover-opacity" style="cursor: pointer;"></i>
                                </div>
                            </div>

                            <hr class="mt-2 mb-3 border-danger opacity-25">

                            <div class="row">

                                <div class="col-xl-12 col-lg-12 col-md-12">
                                    <div class="form-group">
                                        <label>إسم الوكالة أو القناه أو المحطة <span class="required">*</span></label>
                                        <input asp-for="Licname" name="Licname" class="form-control" placeholder="إسم الوكالة أو القناه أو المحطة" />
                                    </div>
                                </div>

                                <div class="col-xl-4 col-lg-12 col-md-12">
                                    <div class="form-group">
                                        <label>مركزها الرئيسى <span class="required">*</span></label>
                                        <input asp-for="LicLocation" name="LicLocation" type="text" class="form-control" placeholder="مركزها الرئيسى">
                                    </div>
                                </div>

                                <div class="col-xl-4 col-lg-12 col-md-12">
                                    <div class="form-group">
                                        <label>الجنسية <span class="required">*</span></label>
                                        <select class="form-control select2" id="nationality" name="LicNationality">
                                            <option value="">اختر الجنسية</option>
                                            @if (Model.countriesLookups != null)
                                            {
                                                foreach (var country in Model.countriesLookups)
                                                {
                                                    <option value="@country.Id">@country.Name</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="col-xl-4 col-lg-12 col-md-12">
                                    <div class="form-group">
                                        <label>بيان اللغة التي سيتم البث بها <span class="required">*</span></label>
                                        <input type="text" class="form-control" placeholder="بيان اللغة التي سيتم البث بها" asp-for="LicLanguage" name="LicLanguage">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>





         
            <div class="row mb-4">
                <div class="col-lg-12 col-md-12">
                    <div class="card border border-1">
                        <div class="card-body">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <div class="d-flex align-items-center">
                                    <div class="icon bg-light text-danger rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                                        <i class="ri-file-user-line" style="font-size: 24px;"></i>
                                    </div>
                                    <div>
                                        <h5 class="mb-1 fw-bold text-primary">بيانات المدير المسئول</h5>
@*                                         <span class="text-danger small fw-bold"> الملفات بصيغه pdf باقصي حجم 2 MB</span>
 *@                                    </div>
                                </div>
                                <div>
                                    <i class="ri-bookmark-line text-danger fs-5 me-2 hover-opacity" style="cursor: pointer;"></i>
                                    <i class="ri-bookmark-fill text-danger fs-5 d-none hover-opacity" style="cursor: pointer;"></i>
                                </div>
                            </div>

                            <!-- الخط الفاصل هنا -->
                            <hr class="mt-2 mb-3 border-danger opacity-25">

                            <div class="row">
                                <div class="col-xl-3 col-lg-12 col-md-12">
                                    <div class="form-group">
                                        <label>الرقم المدني للمدير <span class="required">*</span></label>
                                        <input type="text" class="form-control" placeholder="الرقم المدني للمدير"
                                               asp-for="person.CivilId" name="person.CivilId">
                                    </div>
                                </div>

                                <div class="col-xl-3 col-lg-12 col-md-12">
                                    <div class="form-group">
                                        <label>إسم المدير <span class="required">*</span></label>
                                        <input type="text" class="form-control" placeholder="إسم المدير"
                                               asp-for="person.personName" name="person.personName">
                                    </div>
                                </div>

                                <div class="col-xl-3 col-lg-12 col-md-12">
                                    <div class="form-group">
                                        <label>الجنسية <span class="required">*</span></label>
                                        <select class="form-control select2"
                                                asp-for="person.NationalityId"
                                                name="person.NationalityId"
                                                id="person_nationality">
                                            <option value="">اختر الجنسية</option>
                                            @if (Model.countriesLookups != null)
                                            {
                                                foreach (var country in Model.countriesLookups)
                                                {
                                                    <option value="@country.Id">@country.Name</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xl-3 col-lg-12 col-md-12">
                                    <div class="form-group">
                                        <label>تاريخ ميلاد المدير  <span class="required">*</span></label>
                                        <input type="date" class="form-control" placeholder="تاريخ ميلاد المدير" asp-for="person.BirthDate" name="person.BirthDate">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-lg-12 col-md-12">
                    <div class="card border border-1">
                        <div class="card-body">

                            <div class="row g-0">

                                <!-- Sidebar (Search and Info) -->
                                <div class="col-lg-4 bg-white p-4" style="border-inline-end: 1px solid #eee;">
                                    <!-- Header -->
                                    <div class="bg-primary text-white px-4 py-3 d-flex align-items-center rounded">
                                        <div class="bg-white text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                            <i class="ri-map-pin-line fs-5"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-bold" style="color:aliceblue">البحث بالرقم الآلي</h6>
                                            <small class="text-white-50">عنوان داخل الكويت</small>
                                        </div>
                                    </div>

                                    <!-- Search Box -->
                                    <div class="search-container position-relative w-100 mb-4 mt-3">
                                        <input type="text"
                                               class="form-control search-input text-center"
                                               id="AddressAutoNo"
                                               placeholder="ابحث بالرقم الآلي"
                                               autocomplete="off"
                                               onkeyup="autoSuggest()" />
