            $('.select2-container').css('width', '100%');

            $(function loadImage() {

                var alertTitle = '@TempData["AlertTitle"]';
                var msg = '@TempData["Message"]';
                var alertType = '@TempData["AlertType"]';
                var url = '@TempData["RedirectUrl"]';

                if (alertType != null && msg != null && alertTitle != null) {
                    if (url != null && url != '#') {


                    if (alertType == 'Success') {
                        Swal.fire({
                            icon: 'success',
                            title: alertTitle,
                            text: msg,
                            confirmButtonColor: '#1657CB',
                            confirmButtonText: 'OK'
                        }).then(function () {
                            @TempData.Remove("AlertTitle");
                            @TempData.Remove("Message");
                            @TempData.Remove("AlertType");
                            @TempData.Remove("RedirectUrl");
                           
                        });

                    }
                    else if (alertType == 'error') {
                        Swal.fire({
                            icon: 'error',
                            title: alertTitle,
                            text: msg,
                            confirmButtonColor: '#1657CB',
                            confirmButtonText: 'OK'
                        }).then(function () {
                            @TempData.Remove("AlertTitle");
                            @TempData.Remove("Message");
                            @TempData.Remove("AlertType");
                            @TempData.Remove("RedirectUrl");
                           
                        });
                    };
                } else {
                    if (alertType == 'Success') {
                        Swal.fire({
                            icon: 'success',
                            title: alertTitle,
                            text: msg,
                            confirmButtonColor: '#1657CB',
                            confirmButtonText: 'OK'
                        }).then(function () {
                            @TempData.Remove("AlertTitle");
                            @TempData.Remove("Message");
                            @TempData.Remove("AlertType");
                        });

                    }
                    else if (alertType == 'error') {
                        Swal.fire({
                            icon: 'error',
                            title: alertTitle,
                            text: msg,
                            confirmButtonColor: '#1657CB',
                            confirmButtonText: 'OK'
                        }).then(function () {
                            @TempData.Remove("AlertTitle");
                            @TempData.Remove("Message");
                            @TempData.Remove("AlertType");
                        });
                    };
                }
                }
            });
        });
        $(function () {
            $("input[type='file']").on("change", function () {

                var regex = "(.PDF|.pdf)$";
                          //"([a-zA-Z0-9\s_\\.\-:])+(.PDF|.pdf)$"
                var value = $(this).val();
                var status = ValidateRegeex(regex, value);
                if (status != true) {
                    $(this).val("");
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'نوع الملف فقط بصيغة PDF',
                        confirmButtonColor: '#7FB3D5',
                        confirmButtonText: 'Ok'
                    });
                }

                var fileSize = this.files[0].size
                fileSize = fileSize / 1024 / 1024;
                fileSize = fileSize.toFixed(2);
                if (this.files[0].size > 2097152) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'حجم الصوره "' + fileSize + '" ميجا ، يجب ان لايزيد عن 2 ميجا',
                        confirmButtonColor: '#7FB3D5',
                        confirmButtonText: 'Ok'
                    });
                    $(this).val('');

                }
            });
        });
    </script>
