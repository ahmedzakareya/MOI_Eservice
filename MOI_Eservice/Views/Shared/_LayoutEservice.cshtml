        function ValidateRegeex(regex, value) {
            var expre = new RegExp(regex);
            return expre.test(value);

        }
        $(function () {
            $("input[type='file']").on("change", function () {

                var regex = "(.PDF|.pdf)$";
                //"([a-zA-Z0-9\s_\\.\-:])+(.PDF|.pdf)$"
                //^([\\u0621-\\u064A\\s])
                var value = $(this).val();
                var status = ValidateRegeex(regex, value);
                if (status != true) {
                    $(this).val("");
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'نوع الملف فقط بصيغة PDF',
                        confirmButtonColor: '#7FB3D5',
                        confirmButtonText: 'Ok'
                    });
                }

                if ($(this).hasClass("BigFile")) {
                    var fileSize = this.files[0].size
                    fileSize = fileSize / 1024 / 1024;
                    fileSize = fileSize.toFixed(2);
                    if (this.files[0].size > 5242880) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'حجم الصوره "' + fileSize + '" ميجا ، يجب ان لايزيد عن 5 ميجا',
                            confirmButtonColor: '#7FB3D5',
                            confirmButtonText: 'Ok'
                        });
                        $(this).val('');

                    }
                } else {
                    var fileSize = this.files[0].size
                    fileSize = fileSize / 1024 / 1024;
                    fileSize = fileSize.toFixed(2);
                    if (this.files[0].size > 2097152) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'حجم الصوره "' + fileSize + '" ميجا ، يجب ان لايزيد عن 2 ميجا',
                            confirmButtonColor: '#7FB3D5',
                            confirmButtonText: 'Ok'
                        });
                        $(this).val('');

                    }
                }


            });
        });

