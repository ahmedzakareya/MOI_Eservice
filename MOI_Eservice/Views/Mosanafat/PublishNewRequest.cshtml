@model Business.ViewModel.MoiEserviceLicensesRequestVM

@{
    Layout = "~/Views/Shared/_LayoutEservice.cshtml";
}



<link href="~/assets/css/requeststyle.css" rel="stylesheet" />


<div id="loadingSpinner" style="display:none; position:absolute; top:50%; left:50%; transform: translate(-50%, -50%); z-index: 9999;">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<!-- Breadcrumb Area -->
<div class="breadcrumb-area">
    <!--<h1>الملف الشخصي</h1>-->
    <ol class="breadcrumb">
        <li class="item"><a href="MyAccount.html">الرئيسيه</a></li>
        <li class="item"><a href="MyAccount.html">حسابي</a></li>
        <li class="item">الملف الشخصي</li>
    </ol>
</div>
<!-- End Breadcrumb Area -->
<!-- Start Company Profile Area -->

<div class="my-profile-box">
    <div class="bg-primary text-white px-4 py-3 rounded-top position-relative shadow-sm" style="border-top-left-radius: 10px; border-top-right-radius: 10px;">
        <div class="d-flex justify-content-between align-items-center">
            <div class="fw-bold fs-4">طلب  اصدار ترخيص  مطبوعات ونشر </div>
            <img src="~/assets/images/MOI-ORIGINAL.png" alt="ترخيص" style="width: 58px; height: 50px;" />
        </div>

    </div>

    <form id="myform" method="post" enctype="multipart/form-data" action="@Url.Action("PressNewRequestCompany", "Mosanafat")">

        @Html.AntiForgeryToken()
        <div class="row align-items-center">

            <div class="card shadow-sm p-4 mb-5 rounded">
                <!-- Header -->
                <div class="d-flex justify-content-between align-items-center mb-4 px-3 py-3 rounded" style="background-color: #637BAD; color: #fff;  border-radius: 1rem !important;">
                    <div class="d-flex align-items-center">
                        <div class="bg-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                            <i class="ri-book-3-line text-primary" style="font-size: 20px;"></i>
                        </div>
                        <h5 class="mb-0 fw-bold text-white">البيانات الأساسية للترخيص</h5>
                    </div>
                    <div>
                        <i class="ri-bookmark-line text-white fs-5 me-2" style="cursor: pointer;"></i>
                        <i class="ri-bookmark-fill text-white fs-5 d-none" style="cursor: pointer;"></i>
                    </div>
                </div>

                <div class="px-3 mb-4">
                    <div class="card shadow-sm border-0" style="background-color: #fff8e1;">
                        <div class="card-body py-3 px-4">
                            @* <div class="d-flex align-items-center mb-2">
                                <i class="ri-alert-line text-warning fs-4 me-2"></i>
                                <h5 class="mb-0 fw-bold text-warning">تنويه</h5>
                            </div>
                            <p class="mb-0 fw-bold text-danger">
                                في حال الرغبه في اصدار ترخيص لأكثر من نشاط، يرجى تكرار الطلب على حسب كل نشاط.
                            </p> *@
                        </div>
                    </div>
                </div>


                <!-- Form Content -->
                <div class="row row-cols-1 row-cols-md-2 gy-4 px-3">
                    <div class="col">
                        <label class="form-label">نوع الترخيص <span class="required">*</span></label>
                        <input asp-for="LicenTypeName" name="LicenTypeName" type="text" class="form-control shadow-sm" readonly>
                    </div>

                    <div class="col">
                        <label class="form-label">نوع النشاط <span class="required">*</span></label>
                        <select class="form-control select2 shadow-sm" id="ActivityTypeId" name="ActivityTypeId">
                            <option value="">اختر النشاط</option>
                            @if (Model.ActivityTypes != null)
                            {
                                foreach (var item in Model.ActivityTypes)
                                {
                                    <option value="@item.Id">@item.NameAr</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col">
                        <label class="form-label">رمز النشاط <span class="required">*</span></label>
                        <input asp-for="ActivityCode" name="ActivityCode" type="text" class="form-control shadow-sm" placeholder="رمز النشاط">
                    </div>

                    <div class="col">
                        <label class="form-label">رقم كتاب التجارة <span class="required">*</span></label>
                        <input asp-for="CentralNoMoci" name="CentralNoMoci" type="text" class="form-control shadow-sm" placeholder="رقم كتاب التجارة">
                    </div>

                    <div class="col">
                        <label class="form-label">تاريخ الكتاب <span class="required">*</span></label>
                        <input type="date" class="form-control shadow-sm" placeholder="تاريخ الكتاب" asp-for="MociBookDate" name="MociBookDate">
                    </div>

                    <div class="col">
                        <label class="form-label">اسم الترخيص <span class="required">*</span></label>
                        <input type="text" class="form-control shadow-sm" placeholder="اسم الترخيص" asp-for="Licname" name="Licname">
                    </div>

                    <div class="col">
                        <label class="form-label">عقد التأسيس <span class="required">*</span></label>
                        <select class="form-control select2 shadow-sm" id="testablishContract" name="testablishContract">
                            <option value="">اختر نوع عقد التأسيس</option>
                            @if (Model.testablishContracts != null)
                            {
                                foreach (var item in Model.testablishContracts)
                                {
                                    <option value="@item.EsId">@item.EsTitle</option>
                                }
                            }
                        </select>
                    </div>
                </div>
            </div>









            <div class="row mb-4">
                <div class="col-lg-12 col-md-12">
                    <div class="card border border-1">
                        <div class="card-body">

                            <div class="row g-0">

                                <!-- Sidebar (Search and Info) -->
                                <div class="col-lg-4 bg-white p-4" style="border-inline-end: 1px solid #eee;">
                                    <!-- Header -->
                                    <div class="bg-primary text-white px-4 py-3 d-flex align-items-center rounded">
                                        <div class="bg-white text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                            <i class="ri-map-pin-line fs-5"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-bold" style="color:aliceblue">البحث بالرقم الآلي</h6>
                                            <small class="text-white-50">عنوان داخل الكويت</small>
                                        </div>
                                    </div>

                                    <!-- Search Box -->
                                    <div class="search-container position-relative w-100 mb-4 mt-3">
                                        <input type="text"
                                               class="form-control search-input text-center"
                                               id="AddressAutoNo"
                                               placeholder="ابحث بالرقم الآلي"
                                               autocomplete="off"
                                               onkeyup="autoSuggest()" />
                                        <button type="button"
                                                class="btn search-btn"
                                                onclick="return get_Amount($('#AddressAutoNo').val())">
                                            <i class="ri-search-line fs-5"></i>
                                        </button>
                                        <ul id="suggestionList"
                                            class="autocomplete-suggestions list-unstyled position-absolute w-100 bg-white border border-top-0 rounded-bottom shadow mt-1 z-3 d-none">
                                        </ul>
                                    </div>

                                    <!-- Address Fields -->
                                    <!-- ✅ تصميم عصري لحقول العنوان دون التأثير على الدوال المرتبطة -->
                                    <div id="address-section">
                                        <div class="card shadow-sm border-0 mb-4" id="address-fields">
                                            <div class="card-body">
                                                <div class="row g-3">
                                                    <div class="col-md-6">
                                                        <div class="header">
                                                            <span>الرقم الآلي للعنوان</span>
                                                            <i class="ri-barcode-box-line"></i>
                                                        </div>
                                                        <div class="content">
                                                            @Html.TextBoxFor(m => m.address.AalliNo, new { @class = "form-control border-0 bg-transparent fw-bold", @readonly = "readonly", @id = "RequestNewAddressAutoNo" })
                                                        </div>
                                                    </div>

                                                    <div class="col-md-6">
                                                        <div class="header">
                                                            <span>المحافظة</span>
                                                            <i class="ri-government-line"></i>
                                                        </div>
                                                        <div class="content">
                                                            <input type="text" readonly id="RequestNewAddressGovName" class="form-control border-0 bg-transparent fw-bold" />
                                                            @Html.TextBoxFor(m => m.address.GovernateId, new { @class = "d-none", @id = "CompanyGovId", @readonly = "readonly" })
                                                        </div>
                                                    </div>

                                                    <div class="col-md-6">
                                                        <div class="header">
                                                            <span>المنطقة</span>
                                                            <i class="ri-community-line"></i>
                                                        </div>
                                                        <div class="content">
                                                            <input type="text" readonly id="RequestNewAreaName" class="form-control border-0 bg-transparent fw-bold" />
                                                            @Html.TextBoxFor(m => m.address.AreaId, new { @class = "d-none", @id = "CompanyAreaId", @readonly = "readonly" })
                                                        </div>
                                                    </div>

                                                    <div class="col-md-6">
                                                        <div class="header">
                                                            <span>القطعة</span>
                                                            <i class="ri-grid-line"></i>
                                                        </div>
                                                        <div class="content">
                                                            @Html.TextBoxFor(m => m.address.BlockArabic, new { @class = "form-control border-0 bg-transparent fw-bold", @readonly = "readonly", @id = "RequestNewBlookName" })
                                                        </div>
                                                    </div>

                                                    <div class="col-md-12">
                                                        <div class="header">
                                                            <span>المبنى</span>
                                                            <i class="ri-building-4-line"></i>
                                                        </div>
                                                        <div class="content">
                                                            @Html.TextBoxFor(m => m.address.BuildingNo, new { @class = "form-control border-0 bg-transparent fw-bold", @readonly = "readonly", @id = "RequestNewBulding" })
                                                        </div>
                                                    </div>

                                                    <div class="col-md-12">
                                                        <div class="header">
                                                            <span>الشارع</span>
                                                            <i class="ri-road-map-line"></i>
                                                        </div>
                                                        <div class="content">
                                                            @Html.TextBoxFor(m => m.address.StreetArabic, new { @class = "form-control border-0 bg-transparent fw-bold", @readonly = "readonly", @id = "RequestNewStreetName" })
                                                        </div>
                                                    </div>

                                                    <div class="col-md-12">
                                                        <div class="header">
                                                            <span>المالك</span>
                                                            <i class="ri-user-3-line"></i>
                                                        </div>
                                                        <div class="content">
                                                            @Html.TextBoxFor(m => m.address.BuildingName, new { @class = "form-control border-0 bg-transparent fw-bold", @readonly = "readonly", @id = "RequestLicowner" })
                                                        </div>
                                                    </div>

                                                    <div class="col-md-12">
                                                        <div class="header">
                                                            <span>الدور - المحل</span>
                                                            <i class="ri-store-3-line"></i>
                                                        </div>
                                                        <div class="content">
                                                            @Html.TextBoxFor(m => m.address.FloorNo, new { @class = "form-control border-0 bg-transparent fw-bold", @readonly = "readonly", @id = "RequestNewParcelOrFloor" })
                                                        </div>
                                                    </div>

                                                    <div class="col-md-12">
                                                        <label for="PhoneNo" class="form-label">تليفون  <span class="required">*</span> </label>
                                                        @Html.TextBoxFor(m => m.Company.PhoneNo, new { @class = "form-control", @id = "PhoneNo" })
                                                    </div>

                                                    <div class="col-md-12">
                                                        <label for="FaxNo" class="form-label">فاكس</label>
                                                        @Html.TextBoxFor(m => m.Company.FaxNo, new { @class = "form-control", @id = "FaxNo" })
                                                    </div>

                                                </div>
                                            </div>
                                        </div>

                                        <div id="no-address-icon" class="d-none mt-5">
                                            <div class="wrapper-notebook">
                                                <div class="notebook-page text-center">
                                                    <div class="icon-container">
                                                        <i class="ri-error-warning-line" style="font-size: 36px;"></i>
                                                    </div>
                                                    <div class="note-text">
                                                        <h5 class="fw-bold text-danger">لم يتم العثور على بيانات</h5>
                                                        <p class="text-muted mb-0">الرقم الآلي المدخل غير صحيح</p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>

                                <!-- Map Section -->
                                <div class="col-lg-8">
                                    <div class="p-4 h-100 d-flex flex-column bg-white rounded-4 border border-light-subtle shadow-sm">

                                        <!-- Header -->
                                        <div class="bg-primary text-white px-4 py-3 d-flex align-items-center rounded">
                                            <div class="bg-white text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                                <i class="ri-road-map-line fs-5"></i>
                                            </div>
                                            <div>
                                                <h6 class="mb-0 fw-bold" style="color:aliceblue">الموقع على الخريطة</h6>
                                            </div>
                                        </div>

                                        <!-- خريطة -->
                                        <div id="map"
                                             style="
                width: 100%;
                flex-grow: 1;
                border-radius: 16px;
                overflow: hidden;
                border: 1px solid #e0e0e0;
                margin-top: 16px;">
                                        </div>
                                    </div>
                                </div>




                            </div>

                        </div>
                    </div>
                </div>
            </div>



            <div class="card shadow-sm p-4 mb-5 rounded">
                <!-- Header -->
                <div class="d-flex justify-content-between align-items-center mb-4 px-3 py-3 rounded" style="background-color: #637BAD; color: #fff;">
                    <div class="d-flex align-items-center">
                        <div class="bg-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                            <i class="ri-file-user-line text-primary" style="font-size: 20px;"></i>
                        </div>
                        <h5 class="mb-0 fw-bold text-white">بيانات صاحب الترخيص</h5>
                    </div>
                    <div>
                        <i class="ri-bookmark-line text-white fs-5 me-2" style="cursor: pointer;"></i>
                        <i class="ri-bookmark-fill text-white fs-5 d-none" style="cursor: pointer;"></i>
                    </div>
                </div>

                <!-- Form Content -->
                <div class="row row-cols-1 row-cols-md-2 gy-4 px-3">
                    <div class="col">
                        <label class="form-label">الصفة <span class="required">*</span></label>
                        <select class="form-control select2 shadow-sm" asp-for="person.PersonTypeId" name="person.PersonTypeId" id="person_PersonTypeId">
                            <option value="">اختر الصفة</option>
                            @if (Model.countriesLookups != null)
                            {
                                foreach (var type in Model.pesronTypeLookUp)
                                {
                                    <option value="@type.Id">@type.Descr</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col">
                        <label class="form-label">الرقم المدني لصاحب الترخيص <span class="required">*</span></label>
                        <div class="position-relative">
                            <input type="text" class="form-control shadow-sm" placeholder="الرقم المدني لصاحب الترخيص"
                                   asp-for="person.CivilId" name="person.CivilId" id="CivilIdOwner" />
                            <img src="~/assets/images/KNMID_Logo.png" alt="أيقونة"
                                 style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); width: 28px; height: 28px;" />
                        </div>
                    </div>

                    <div class="col">
                        <label class="form-label">إسم صاحب الترخيص <span class="required">*</span></label>
                        <input type="text" class="form-control shadow-sm" placeholder="إسم صاحب الترخيص"
                               asp-for="person.personName" name="person.personName">
                    </div>

                    <div class="col">
                        <label class="form-label">تاريخ ميلاد صاحب الترخيص <span class="required">*</span></label>
                        <input type="date" class="form-control shadow-sm" placeholder="تاريخ ميلاد صاحب الترخيص"
                               asp-for="person.BirthDate" name="person.BirthDate">
                    </div>

                    <div class="col">
                        <label class="form-label">المؤهل الدراسي <span class="required">*</span></label>
                        <select class="form-control select2 shadow-sm" asp-for="person.QualificationId" name="person.NationalityId" id="person_QualificationId">
                            <option value="">اختر المؤهل</option>
                            @if (Model.countriesLookups != null)
                            {
                                foreach (var item in Model.qualificationsLookups)
                                {
                                    <option value="@item.Id">@item.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col">
                        <label class="form-label">بلد المؤهل <span class="required">*</span></label>
                        <select class="form-control select2 shadow-sm" asp-for="person.QualificationCountryId" name="person.QualificationCountryId" id="person_QualificationCountryId">
                            <option value="">اختر بلد المؤهل</option>
                            @if (Model.countriesLookups != null)
                            {
                                foreach (var country in Model.countriesLookups)
                                {
                                    <option value="@country.Id">@country.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col">
                        <label class="form-label">تاريخ المؤهل <span class="required">*</span></label>
                        <input type="date" class="form-control shadow-sm" placeholder="تاريخ المؤهل"
                               asp-for="person.QualificationDate" name="person.QualificationDate">
                    </div>


                </div>
            </div>



            <div class="card shadow-sm p-4 mb-5 rounded">
                <!-- Header -->
                <div class="d-flex justify-content-between align-items-center mb-4 px-3 py-3 rounded" style="background-color: #637BAD; color: #fff;">
                    <div class="d-flex align-items-center">
                        <div class="bg-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                            <i class="ri-file-user-line text-primary" style="font-size: 20px;"></i>
                        </div>
                        <h5 class="mb-0 fw-bold text-white">بيانات المدير المسئول</h5>
                    </div>
                    <div>
                        <i class="ri-bookmark-line text-white fs-5 me-2" style="cursor: pointer;"></i>
                        <i class="ri-bookmark-fill text-white fs-5 d-none" style="cursor: pointer;"></i>
                    </div>
                </div>

                <!-- Form Content -->
                <div class="row row-cols-1 row-cols-md-2 gy-4 px-3">
                    <div class="col">
                        <label class="form-label">الرقم المدني لمدير الترخيص <span class="required">*</span></label>
                        <div class="position-relative">
                            <input type="text" class="form-control shadow-sm" placeholder="الرقم المدني لصاحب الترخيص"
                                   asp-for="manager.CivilId" name="manager.CivilId" />
                            <img src="~/assets/images/KNMID_Logo.png" alt="أيقونة"
                                 style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); width: 28px; height: 28px;" />
                        </div>
                    </div>

                    <div class="col">
                        <label class="form-label">إسم المدير <span class="required">*</span></label>
                        <input type="text" class="form-control shadow-sm" placeholder="إسم المدير" asp-for="manager.personName" name="manager.personName">
                    </div>

                    <div class="col">
                        <label class="form-label">الجنسية <span class="required">*</span></label>
                        <select class="form-control select2 shadow-sm" asp-for="manager.NationalityId" name="manager.NationalityId" id="manager_nationality">
                            <option value="">اختر الجنسية</option>
                            @if (Model.countriesLookups != null)
                            {
                                foreach (var country in Model.countriesLookups)
                                {
                                    <option value="@country.Id">@country.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col">
                        <label class="form-label">تاريخ ميلاد المدير <span class="required">*</span></label>
                        <input type="date" class="form-control shadow-sm" placeholder="تاريخ ميلاد المدير" asp-for="manager.BirthDate" name="manager.BirthDate">
                    </div>

                    <div class="col">
                        <label class="form-label">المؤهل الدراسي <span class="required">*</span></label>
                        <select class="form-control select2 shadow-sm" asp-for="manager.QualificationCountryId" name="manager.QualificationCountryId" id="manager_QualificationCountryId">
                            <option value="">اختر المؤهل الدراسي</option>
                            @if (Model.qualificationsLookups != null)
                            {
                                foreach (var country in Model.qualificationsLookups)
                                {
                                    <option value="@country.Id">@country.Name</option>
                                }
                            }
                        </select>
                    </div>
                </div>
            </div>


            <div class="card shadow-sm p-4 mb-5 rounded">
                <div class="d-flex justify-content-between align-items-center mb-4 px-3 py-3 rounded" style="background-color: #637BAD; color: #fff;">
                    <div class="d-flex align-items-center">
                        <div class="bg-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                            <i class="ri-user-add-line text-primary" style="font-size: 20px;"></i>
                        </div>
                        <h5 class="mb-0 fw-bold text-white">الشركاء</h5>
                    </div>
                    <div>
                        <i class="ri-bookmark-line text-white fs-5 me-2" style="cursor: pointer;"></i>
                        <i class="ri-bookmark-fill text-white fs-5 d-none" style="cursor: pointer;"></i>
                    </div>
                </div>

                <div class="partner-input-wrapper mb-3 mx-3">
                    <input type="text" id="partnerInput" placeholder="أدخل اسم الشريك" class="form-control text-secondary">
                    <button type="button" onclick="addPartner()">
                        <i class="ri-add-line"></i>
                    </button>
                </div>

                <div class="px-3">
                    <div class="card border-0 shadow-sm rounded-3" style="background-color: #f9f9f9;">
                        <!-- Header -->
                        <div class="d-flex align-items-center px-4 py-3" style="background-color: #BED0F4; border-top-left-radius: 0.5rem; border-top-right-radius: 0.5rem;">
                            <div class="bg-white text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 35px; height: 35;">
                                <i class="ri-team-line fs-5"></i>
                            </div>
                            <h6 class="mb-0 text-white fw-bold">قائمة الشركاء</h6>
                        </div>

                        <!-- Content -->
                        <div class="card-body py-3 px-4">
                            <div class="row row-cols-1 row-cols-md-2 g-3" id="partnersList" style="direction: rtl;">
                            </div>
                        </div>
                    </div>
                </div>


            </div>

            <script>
                function addPartner() {
                    const input = document.getElementById("partnerInput");
                    const name = input.value.trim();

                    if (!name) return;

                    const li = document.createElement("li");
                    li.className = "list-group-item d-flex justify-content-between align-items-center shadow-sm mb-2 rounded partner-item";
                    li.dataset.name = name;

                    li.innerHTML = `
                                            <span class="fw-bold text-primary">${name}</span>
                                            <button type="button" class="btn btn-sm btn-danger rounded-circle d-flex align-items-center justify-content-center"
                                                style="width: 30px; height: 30px;" onclick="removePartner(this)">
                                                <i class="ri-close-line" style="font-size: 18px;"></i>
                                            </button>
                                        `;

                    document.getElementById("partnersList").appendChild(li);
