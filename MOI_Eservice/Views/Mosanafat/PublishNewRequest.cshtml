                                        <p class="text-muted small">يرجى التأكد من رفع جميع المرفقات المطلوبة قبل الاستمرار.</p>
                                    </div>
                                `,
                        confirmButtonText: 'موافق',
                        width: '800px',
                        heightAuto: false
                    });

                    return false;
                }

                const isAddressFilled = $('#RequestNewAddressAutoNo').val().trim() !== '';
                const isErrorVisible = !$("#no-address-icon").hasClass("d-none");

                if (!isAddressFilled || isErrorVisible) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'تنبيه',
                        text: 'يرجى التأكد من إدخال رقم آلي صحيح واكتمال بيانات العنوان.',
                        confirmButtonText: 'موافق'
                    });
                    return false;
                }

                Swal.fire({
                    title: '<span style="font-size: 20px; color: #2471a3;">جاري إرسال الطلب</span>',
                    html: `
            <div style="margin-top: 20px; display: flex; flex-direction: column; align-items: center;">
