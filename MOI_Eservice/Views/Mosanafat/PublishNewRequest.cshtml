            submitHandler: function (form) {
                const partners = document.querySelectorAll("#partnersList li");
                if (partners.length === 0) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'تنبيه',
                        text: 'يرجى إضافة الشركاء.'
                    });
                    return false;
                }

                const partnerList = [];
                partners.forEach(function (item) {
                    const name = item.dataset.name;
                    if (name) {
                        partnerList.push({ Name: name });
                    }
                });

                $('<input>').attr({
                    type: 'hidden',
                    name: 'PartnersJson',
                    value: JSON.stringify(partnerList)
                }).appendTo(form);

                let allValid = true;
                let attachmentsHtml = "";

                $("[data-label]").each(function () {
                    const value = $(this).val().trim();
                    const label = $(this).data("label");
                    const isRequired = $(this).data("required") === true || $(this).data("required") === "true";
                    const isValid = value !== "";

                    const icon = isValid
                        ? '<i class="ri-check-double-line text-success"></i>'
                        : '<i class="ri-close-circle-line text-danger"></i>';

                    const className = isValid ? "success" : "danger";

                    const badge = !isValid
                        ? (isRequired
                            ? '<span class="badge bg-danger text-white ms-2" style="font-size: 10px;">مطلوب</span>'
                            : '<span class="badge bg-primary text-white ms-2" style="font-size: 10px;">اختياري</span>')
                        : '';

                    attachmentsHtml += `
