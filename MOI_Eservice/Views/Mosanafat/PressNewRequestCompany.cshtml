@model Business.ViewModel.MoiEserviceLicensesRequestVM

@{
    Layout = "~/Views/Shared/_LayoutEservice.cshtml";
}



<link href="~/assets/css/requeststyle.css" rel="stylesheet" />


<div id="loadingSpinner" style="display:none; position:absolute; top:50%; left:50%; transform: translate(-50%, -50%); z-index: 9999;">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<!-- Breadcrumb Area -->
<div class="breadcrumb-area">
    <!--<h1>الملف الشخصي</h1>-->
    <ol class="breadcrumb">
        <li class="item"><a href="MyAccount.html">الرئيسيه</a></li>
        <li class="item"><a href="MyAccount.html">حسابي</a></li>
        <li class="item">الملف الشخصي</li>
    </ol>
</div>
<!-- End Breadcrumb Area -->
<!-- Start Company Profile Area -->

<div class="my-profile-box">
    <div class="gov-head gov-head--flat" dir="rtl">
        <div class="gov-head__title">
            <!-- Beautiful, crisp icon (Remix Icon) -->
            <i class="ri-award-line gov-head__icon" aria-hidden="true"></i>
            <span class="gov-head__heading">طلب إصدار ترخيص : شركة</span>
        </div>

        <img class="gov-head__seal"
             src="~/assets/images/MOI-ORIGINAL.png"
             alt="ترخيص" />
    </div>


    <form id="myform" method="post" enctype="multipart/form-data" action="@Url.Action("PressNewRequestCompany", "Mosanafat")">

        @Html.AntiForgeryToken()
        <div class="row align-items-center">

            <!-- Flat License Card -->
            <div class="card license-section shadow-sm mb-5 rounded-4 border-0" dir="rtl">

                <!-- Header + Notice Combined -->
                <div class="license-header-wrapper">
                    <!-- Header -->
                    <div class="license-header d-flex justify-content-between align-items-center px-4 py-4">
                        <div class="d-flex align-items-center">
                            <div class="header-icon rounded-circle me-3">
                                <i class="ri-book-3-line"></i>
                            </div>
                            <h5 class="mb-0 fw-bold text-white fs-5">البيانات الأساسية للترخيص</h5>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="ri-bookmark-line text-white fs-5 toggle-bookmark" role="button" aria-label="bookmark"></i>
                            <i class="ri-bookmark-fill text-white fs-5 d-none toggle-bookmark" role="button" aria-label="bookmarked"></i>
                        </div>
                    </div>

                    <!-- Notice -->
                    <div class="notice-alert px-4 py-3">
                        <div class="d-flex align-items-start gap-3">
                            <div class="notice-icon"><i class="ri-error-warning-line"></i></div>
                            <div class="notice-content">
                                <h6 class="fw-bold m-0">تنويه</h6>
                                <p class="m-0 mt-1 small">
                                    في حال الرغبة في إصدار ترخيص لأكثر من نشاط، يرجى تكرار الطلب على حسب كل نشاط.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Form Fields -->
                <div class="px-4 py-4">
                    <div class="row row-cols-1 row-cols-md-2 gy-4">
                        <div class="col">
                            <label class="form-label fw-semibold">نوع الترخيص <span class="text-danger">*</span></label>
                            <input asp-for="LicenTypeName" name="LicenTypeName" type="text" class="form-control" readonly>
                        </div>

                        <div class="col">
                            <label class="form-label fw-semibold">نوع النشاط <span class="text-danger">*</span></label>
                            <select class="form-control select2" id="ActivityTypeId" name="ActivityTypeId">
                                <option value="">اختر النشاط</option>
                                @if (Model.ActivityTypes != null)
                                {
                                    foreach (var item in Model.ActivityTypes)
                                    {
                                        <option value="@item.Id">@item.NameAr</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col">
                            <label class="form-label fw-semibold">رمز النشاط <span class="text-danger">*</span></label>
                            <input asp-for="ActivityCode" name="ActivityCode" type="text" class="form-control" placeholder="رمز النشاط">
                        </div>

                        <div class="col">
                            <label class="form-label fw-semibold">رقم كتاب التجارة <span class="text-danger">*</span></label>
                            <input asp-for="CentralNoMoci" name="CentralNoMoci" type="text" class="form-control" placeholder="رقم كتاب التجارة">
                        </div>

                        <div class="col">
                            <label class="form-label fw-semibold">تاريخ الكتاب <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" asp-for="MociBookDate" name="MociBookDate" placeholder="تاريخ الكتاب">
                        </div>

                        <div class="col">
                            <label class="form-label fw-semibold">اسم الترخيص <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" asp-for="Licname" name="Licname" placeholder="اسم الترخيص">
                        </div>

                        <div class="col">
                            <label class="form-label fw-semibold">عقد التأسيس <span class="text-danger">*</span></label>
                            <select class="form-control select2" id="testablishContract" name="testablishContract">
                                <option value="">اختر نوع عقد التأسيس</option>
                                @if (Model.testablishContracts != null)
                                {
                                    foreach (var item in Model.testablishContracts)
                                    {
                                        <option value="@item.EsId">@item.EsTitle</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>

            </div>











            <!-- English comments only -->
            <div class="row mb-4 addr-ui" dir="rtl">
                <div class="col-12">
                    <div class="card addr-shell border-0">
                        <div class="card-body p-4">

                            <div class="row g-4">

                                <!-- Search + Address Panel (RIGHT) -->
                                <div class="col-lg-4 order-1 order-lg-1">
                                    <div class="addr-panel h-100">

                                        <div class="addr-panel-head">
                                            <div class="head-title">
                                                <span class="head-icon"><i class="ri-search-line"></i></span>
                                                <div class="head-text">
                                                    <div class="t1">البحث بالرقم الآلي</div>
                                                    <div class="t2">عنوان داخل الكويت</div>
                                                </div>
                                            </div>
                                            <span class="head-chip"><i class="ri-map-pin-line"></i></span>
                                        </div>

                                        <div class="addr-panel-body">

                                            <!-- Search -->
                                            <div class="addr-search">
                                                <div class="search-input-wrap">
                                                    <input type="text"
                                                           class="form-control text-center"
                                                           id="AddressAutoNo"
                                                           placeholder="ابحث بالرقم الآلي"
                                                           autocomplete="off"
                                                           onkeyup="autoSuggest()" />

                                                    <button type="button"
                                                            class="btn btn-primary search-btn"
                                                            onclick="return get_Amount($('#AddressAutoNo').val())"
                                                            aria-label="بحث">
                                                        <i class="ri-search-line"></i>
                                                    </button>

                                                    <ul id="suggestionList"
                                                        class="autocomplete-suggestions list-unstyled d-none">
                                                    </ul>
                                                </div>
                                            </div>

                                            <!-- Address Section -->
                                            <div id="address-section">

                                                <div class="addr-fields-card" id="address-fields">
                                                    <div class="row g-3">

                                                        <div class="col-md-6">
                                                            <div class="addr-item">
                                                                <div class="addr-item-head">
                                                                    <i class="ri-barcode-box-line"></i>
                                                                    <span>الرقم الآلي للعنوان</span>
                                                                </div>
                                                                <div class="addr-item-body">
                                                                    @Html.TextBoxFor(m => m.address.AalliNo, new { @class = "form-control", @readonly = "readonly", @id = "RequestNewAddressAutoNo" })
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="col-md-6">
                                                            <div class="addr-item">
                                                                <div class="addr-item-head">
                                                                    <i class="ri-government-line"></i>
                                                                    <span>المحافظة</span>
                                                                </div>
                                                                <div class="addr-item-body">
                                                                    <input type="text" readonly id="RequestNewAddressGovName" class="form-control" />
                                                                    @Html.TextBoxFor(m => m.address.GovernateId, new { @class = "d-none", @id = "CompanyGovId", @readonly = "readonly" })
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="col-md-6">
                                                            <div class="addr-item">
                                                                <div class="addr-item-head">
                                                                    <i class="ri-community-line"></i>
                                                                    <span>المنطقة</span>
                                                                </div>
                                                                <div class="addr-item-body">
                                                                    <input type="text" readonly id="RequestNewAreaName" class="form-control" />
                                                                    @Html.TextBoxFor(m => m.address.AreaId, new { @class = "d-none", @id = "CompanyAreaId", @readonly = "readonly" })
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="col-md-6">
                                                            <div class="addr-item">
                                                                <div class="addr-item-head">
                                                                    <i class="ri-grid-line"></i>
                                                                    <span>القطعة</span>
                                                                </div>
                                                                <div class="addr-item-body">
                                                                    @Html.TextBoxFor(m => m.address.BlockArabic, new { @class = "form-control", @readonly = "readonly", @id = "RequestNewBlookName" })
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="col-md-12">
                                                            <div class="addr-item">
                                                                <div class="addr-item-head">
                                                                    <i class="ri-building-4-line"></i>
                                                                    <span>المبنى</span>
                                                                </div>
                                                                <div class="addr-item-body">
                                                                    @Html.TextBoxFor(m => m.address.BuildingNo, new { @class = "form-control", @readonly = "readonly", @id = "RequestNewBulding" })
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="col-md-12">
                                                            <div class="addr-item">
                                                                <div class="addr-item-head">
                                                                    <i class="ri-road-map-line"></i>
                                                                    <span>الشارع</span>
                                                                </div>
                                                                <div class="addr-item-body">
                                                                    @Html.TextBoxFor(m => m.address.StreetArabic, new { @class = "form-control", @readonly = "readonly", @id = "RequestNewStreetName" })
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="col-md-12">
                                                            <div class="addr-item">
                                                                <div class="addr-item-head">
                                                                    <i class="ri-user-3-line"></i>
                                                                    <span>المالك</span>
                                                                </div>
                                                                <div class="addr-item-body">
                                                                    @Html.TextBoxFor(m => m.address.BuildingName, new { @class = "form-control", @readonly = "readonly", @id = "RequestLicowner" })
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="col-md-12">
                                                            <div class="addr-item">
                                                                <div class="addr-item-head">
                                                                    <i class="ri-store-3-line"></i>
                                                                    <span>الدور - المحل</span>
                                                                </div>
                                                                <div class="addr-item-body">
                                                                    @Html.TextBoxFor(m => m.address.FloorNo, new { @class = "form-control", @readonly = "readonly", @id = "RequestNewParcelOrFloor" })
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="col-md-12">
                                                            <label for="PhoneNo" class="form-label fw-semibold">تليفون <span class="text-danger">*</span></label>
                                                            @Html.TextBoxFor(m => m.Company.PhoneNo, new { @class = "form-control", @id = "PhoneNo" })
                                                        </div>

                                                        <div class="col-md-12">
                                                            <label for="FaxNo" class="form-label fw-semibold">فاكس</label>
                                                            @Html.TextBoxFor(m => m.Company.FaxNo, new { @class = "form-control", @id = "FaxNo" })
                                                        </div>

                                                    </div>
                                                </div>

                                                <!-- No results state (IDs preserved) -->
                                                <div id="no-address-icon" class="d-none mt-4">
                                                    <div class="addr-empty">
                                                        <div class="addr-empty-ic">
                                                            <i class="ri-error-warning-line"></i>
                                                        </div>
                                                        <div class="addr-empty-txt">
                                                            <h5 class="fw-bold text-danger mb-1">لم يتم العثور على بيانات</h5>
                                                            <p class="text-muted mb-0">الرقم الآلي المدخل غير صحيح</p>
                                                        </div>
                                                    </div>
                                                </div>

                                            </div><!-- /address-section -->

                                        </div><!-- /addr-panel-body -->
                                    </div>
                                </div>

                                <!-- Map Panel (LEFT) -->
                                <div class="col-lg-8 order-2 order-lg-2">
                                    <div class="addr-panel h-100">

                                        <div class="addr-panel-head">
                                            <div class="head-title">
                                                <span class="head-icon"><i class="ri-road-map-line"></i></span>
                                                <div class="head-text">
                                                    <div class="t1">الموقع على الخريطة</div>
                                                    <div class="t2">عرض الموقع وتحديده</div>
                                                </div>
                                            </div>
                                            <span class="head-chip"><i class="ri-map-pin-line"></i></span>
                                        </div>

                                        <div class="addr-panel-body">
                                            <div id="map" class="addr-map"></div>
                                        </div>

                                    </div>
                                </div>

                            </div><!-- /row -->
                        </div>
                    </div>
                </div>
            </div>





            <div class="card shadow-sm p-4 mb-5 rounded">
                <!-- Header -->
                <div class="d-flex justify-content-between align-items-center mb-4 px-3 py-3 rounded" style="background-color: #637BAD; color: #fff;">
                    <div class="d-flex align-items-center">
                        <div class="bg-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                            <i class="ri-file-user-line text-primary" style="font-size: 20px;"></i>
                        </div>
                        <h5 class="mb-0 fw-bold text-white">بيانات صاحب الترخيص</h5>
                    </div>
                    <div>
                        <i class="ri-bookmark-line text-white fs-5 me-2" style="cursor: pointer;"></i>
                        <i class="ri-bookmark-fill text-white fs-5 d-none" style="cursor: pointer;"></i>
                    </div>
                </div>

                <!-- Form Content -->
                <div class="row row-cols-1 row-cols-md-2 gy-4 px-3">
                    <div class="col">
                        <label class="form-label">الصفة <span class="required">*</span></label>
                        <select class="form-control select2 shadow-sm" asp-for="person.PersonTypeId" name="person.PersonTypeId" id="person_PersonTypeId">
                            <option value="">اختر الصفة</option>
                            @if (Model.countriesLookups != null)
                            {
                                foreach (var type in Model.pesronTypeLookUp)
                                {
                                    <option value="@type.Id">@type.Descr</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col">
                        <label class="form-label">الرقم المدني لصاحب الترخيص <span class="required">*</span></label>
                        <div class="position-relative">
                            <input type="text" class="form-control shadow-sm" placeholder="الرقم المدني لصاحب الترخيص"
                                   asp-for="person.CivilId" name="person.CivilId" id="CivilIdOwner" />
                            <img src="~/assets/images/KNMID_Logo.png" alt="أيقونة"
                                 style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); width: 28px; height: 28px;" />
                        </div>
                    </div>

                    <div class="col">
                        <label class="form-label">إسم صاحب الترخيص <span class="required">*</span></label>
                        <input type="text" class="form-control shadow-sm" placeholder="إسم صاحب الترخيص"
                               asp-for="person.personName" name="person.personName">
                    </div>
                    <div class="col">
                        <label class="form-label">الجنسية <span class="required">*</span></label>
                        <select class="form-control select2 shadow-sm" asp-for="person.NationalityId" name="person.NationalityId" id="person_nationality">

                            <option value="">اختر الجنسية</option>
                            @if (Model.countriesLookups != null)
                            {
                                foreach (var country in Model.countriesLookups)
                                {
                                    <option value="@country.Id">@country.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col">
                        <label class="form-label">تاريخ ميلاد صاحب الترخيص <span class="required">*</span></label>
                        <input type="date" class="form-control shadow-sm" placeholder="تاريخ ميلاد صاحب الترخيص"
                               asp-for="person.BirthDate" name="person.BirthDate">
                    </div>

                    <div class="col">
                        <label class="form-label">المؤهل الدراسي <span class="required">*</span></label>
                        <select class="form-control select2 shadow-sm" asp-for="person.QualificationId" name="person.QualificationId" id="person_QualificationId">
                            <option value="">اختر المؤهل</option>
                            @if (Model.countriesLookups != null)
                            {
                                foreach (var item in Model.qualificationsLookups)
                                {
                                    <option value="@item.Id">@item.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col">
                        <label class="form-label">بلد المؤهل <span class="required">*</span></label>
                        <select class="form-control select2 shadow-sm" asp-for="person.QualificationCountryId" name="person.QualificationCountryId" id="person_QualificationCountryId">
                            <option value="">اختر بلد المؤهل</option>
                            @if (Model.countriesLookups != null)
                            {
                                foreach (var country in Model.countriesLookups)
                                {
                                    <option value="@country.Id">@country.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col">
                        <label class="form-label">تاريخ المؤهل <span class="required">*</span></label>
                        <input type="date" class="form-control shadow-sm" placeholder="تاريخ المؤهل"
                               asp-for="person.QualificationDate" name="person.QualificationDate">
                    </div>


                </div>
            </div>



            <div class="card shadow-sm p-4 mb-5 rounded">
                <!-- Header -->
                <div class="d-flex justify-content-between align-items-center mb-4 px-3 py-3 rounded" style="background-color: #637BAD; color: #fff;">
                    <div class="d-flex align-items-center">
                        <div class="bg-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                            <i class="ri-file-user-line text-primary" style="font-size: 20px;"></i>
                        </div>
                        <h5 class="mb-0 fw-bold text-white">بيانات المدير المسئول</h5>
                    </div>
                    <div>
                        <i class="ri-bookmark-line text-white fs-5 me-2" style="cursor: pointer;"></i>
                        <i class="ri-bookmark-fill text-white fs-5 d-none" style="cursor: pointer;"></i>
                    </div>
                </div>

                <!-- Form Content -->
                <div class="row row-cols-1 row-cols-md-2 gy-4 px-3">
                    <div class="col">
                        <label class="form-label">الرقم المدني لمدير الترخيص <span class="required">*</span></label>
                        <div class="position-relative">
                            <input type="text" class="form-control shadow-sm" placeholder="الرقم المدني لصاحب الترخيص"
                                   asp-for="manager.CivilId" name="manager.CivilId" />
                            <img src="~/assets/images/KNMID_Logo.png" alt="أيقونة"
                                 style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); width: 28px; height: 28px;" />
                        </div>
                    </div>

                    <div class="col">
                        <label class="form-label">إسم المدير <span class="required">*</span></label>
                        <input type="text" class="form-control shadow-sm" placeholder="إسم المدير" asp-for="manager.personName" name="manager.personName">
                    </div>

                    <div class="col">
                        <label class="form-label">الجنسية <span class="required">*</span></label>
                        <select class="form-control select2 shadow-sm" asp-for="manager.NationalityId" name="manager.NationalityId" id="manager_nationality">

                            <option value="">اختر الجنسية</option>
                            @if (Model.countriesLookups != null)
                            {
                                foreach (var country in Model.countriesLookups)
                                {
                                    <option value="@country.Id">@country.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col">
                        <label class="form-label">تاريخ ميلاد المدير <span class="required">*</span></label>
                        <input type="date" class="form-control shadow-sm" placeholder="تاريخ ميلاد المدير" asp-for="manager.BirthDate" name="manager.BirthDate">
                    </div>

                    <div class="col">
                        <label class="form-label">المؤهل الدراسي <span class="required">*</span></label>
                        <select class="form-control select2 shadow-sm" asp-for="manager.QualificationId" name="manager.QualificationId" id="manager_QualificationId">
                            
                            <option value="">اختر المؤهل الدراسي</option>
                            @if (Model.qualificationsLookups != null)
                            {
                                foreach (var country in Model.qualificationsLookups)
                                {
                                    <option value="@country.Id">@country.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col">
                        <label class="form-label">بلد المؤهل <span class="required">*</span></label>
                        <select class="form-control select2 shadow-sm" asp-for="manager.QualificationCountryId" name="manager.QualificationCountryId" id="manager_QualificationCountryId">
                            <option value="">اختر بلد المؤهل</option>
                            @if (Model.countriesLookups != null)
                            {
                                foreach (var country in Model.countriesLookups)
                                {
                                    <option value="@country.Id">@country.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col">
                        <label class="form-label">تاريخ المؤهل <span class="required">*</span></label>
                        <input type="date" class="form-control shadow-sm" placeholder="تاريخ المؤهل"
                               asp-for="manager.QualificationDate" name="manager.QualificationDate">
                    </div>

                </div>
            </div>
            

            <div class="card shadow-sm p-4 mb-5 rounded">
                <div class="d-flex justify-content-between align-items-center mb-4 px-3 py-3 rounded" style="background-color: #637BAD; color: #fff;">
                    <div class="d-flex align-items-center">
                        <div class="bg-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                            <i class="ri-user-add-line text-primary" style="font-size: 20px;"></i>
                        </div>
                        <h5 class="mb-0 fw-bold text-white">الشركاء</h5>
                    </div>
                    <div>
                        <i class="ri-bookmark-line text-white fs-5 me-2" style="cursor: pointer;"></i>
                        <i class="ri-bookmark-fill text-white fs-5 d-none" style="cursor: pointer;"></i>
                    </div>
                </div>

                <div class="partner-input-wrapper mb-3 mx-3">
                    <input type="text" id="partnerInput" placeholder="أدخل اسم الشريك" class="form-control text-secondary" style="border-color:white !important">
                    <button type="button" onclick="addPartner()">
