            <script>
                function syncPartners() {
                    const data = [...document.querySelectorAll('#partnersList li')].map(li => ({
                        Name: li.dataset.name  
                    }));
                    document.getElementById('PartnersJson').value = JSON.stringify(data);
                }

                function addPartner() {
                    const input = document.getElementById("partnerInput");
                    const name = input.value.trim();
                    if (!name) return;

                    const li = document.createElement("li");
                    li.className = "list-group-item d-flex justify-content-between align-items-center shadow-sm mb-2 rounded partner-item";
                    li.dataset.name = name;
                    li.innerHTML = `
                    <span class="fw-bold text-primary">${name}</span>
                    <button type="button" class="btn btn-sm btn-danger rounded-circle d-flex align-items-center justify-content-center"
                            style="width:30px;height:30px;" onclick="removePartner(this)">
                      <i class="ri-close-line" style="font-size:18px;"></i>
                    </button>`;
                    document.getElementById("partnersList").appendChild(li);
                    input.value = "";
                    syncPartners();
                }

                function removePartner(btn) {
                    btn.closest('li').remove();
                    syncPartners();
                }

                document.getElementById('partnerInput').addEventListener('keydown', function (e) {
                    if (e.key === 'Enter') { e.preventDefault(); addPartner(); }
                });

                document.querySelector('form')?.addEventListener('submit', function () {
                    syncPartners();
                });
            </script>




