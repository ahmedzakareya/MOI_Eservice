                                                </div>

                                                <div class="att-preview">
                                                    @if (!string.IsNullOrEmpty(item.AttachPath) && item.AttachPath.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <iframe src="@fileUrl"></iframe>
                                                    }
                                                    else if (!string.IsNullOrEmpty(item.AttachPath) &&
                                                    (item.AttachPath.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) ||
                                                    item.AttachPath.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase) ||
                                                    item.AttachPath.EndsWith(".png", StringComparison.OrdinalIgnoreCase) ||
                                                    item.AttachPath.EndsWith(".webp", StringComparison.OrdinalIgnoreCase)))
                                                    {
                                                        <img src="@fileUrl" alt="@item.AttachName" />
                                                    }
                                                    else
                                                    {
                                                        <object data="@fileUrl" type="application/pdf"></object>
                                                    }
                                                </div>

                                                @if (Model.RequestVM.RequestStatusId != (int)RequestStatusEnum.FinalLicenseIssued && item.IsApproved == false)
                                                {
                                                    <div class="mt-2">
                                                        <input type="file"
                                                               name="NamedFile.File"
                                                               class="form-control"
                                                               id="fileInput_@item.AttachId"
                                                               data-field="@item.AttachFlag"
                                                               data-label="@item.AttachName"
                                                               data-required="@item.IsMandatory" />
                                                        <input type="hidden" name="NamedFile.FieldName" value="@item.AttachFlag" />
                                                        <input type="hidden" name="NamedFile.LabelName" value="@item.AttachName" />
                                                        <input type="hidden" name="NamedFile.IsRequired" value="@item.IsMandatory" />

                                                        <div class="d-flex justify-content-end mt-2">
                                                            <button type="button"
                                                                    class="btn btn-success btn-sm"
                                                                    onclick="updateAttachment(event, @item.AttachId, '@Model.RequestVM.Reqno', @item.AttachRequestid)">
                                                                تحديث المرفق
                                                            </button>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>

                                        <div class="att-status">
                                            <span>الحالة</span>
                                            @if (item.IsApproved)
                                            {
                                                <span class="badge-chip badge-approved">✔ معتمد</span>
                                            }
                                            else
                                            {
                                                <span class="badge-chip badge-pending">بانتظار الاعتماد</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>


                    </div>
                </div> <!-- /#Attachements -->
            </div> <!-- /.tab-content -->
        </div> <!-- /.profile-authentication-tabs -->

        <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

        @section Scripts
        {
            <script>
                // Update existing attachment
                async function updateAttachment(event, attachId, reqNo, requestId) {
                    event.preventDefault();
                    const fileInput = document.getElementById(`fileInput_${attachId}`);
                    const file = fileInput?.files[0];
                    if (!file) { Swal.fire("يرجى اختيار ملف قبل الإرسال", "", "warning"); return; }

                    const parent = fileInput.closest('.form-group, .row');
                    const fieldName = parent.querySelector('[name="NamedFile.FieldName"]')?.value;
                    const labelName = parent.querySelector('[name="NamedFile.LabelName"]')?.value;
                    const isRequired = parent.querySelector('[name="NamedFile.IsRequired"]')?.value === "True";

                    const formData = new FormData();
                    formData.append("file.File", file);
                    formData.append("file.FieldName", fieldName);
                    formData.append("file.LabelName", labelName);
                    formData.append("file.IsRequired", isRequired);
                    formData.append("attachId", attachId);
                    formData.append("reqNo", reqNo);
                    formData.append("RequestId", requestId);

                    try {
                        const response = await fetch(`/Elaw/UpdateAttachment`, { method: "POST", body: formData });
                        if (response.ok) {
                            const result = await response.json();
                            Swal.fire("تم التحديث بنجاح", result.message || "", "success").then(() => location.reload());
                        } else {
                            const errorText = await response.text();
                            Swal.fire("فشل التحديث", errorText, "error");
                        }
                    } catch (error) {
                        console.error("Error uploading attachment:", error);
                        Swal.fire("خطأ", "حدث خطأ أثناء رفع الملف", "error");
                    }
                }

                // Upload new required attachment
                async function uploadCustomAttachment(button) {
                    const parent = button.closest(".row");
                    const fileInput = parent.querySelector('input[type="file"]');
                    const file = fileInput?.files[0];
                    if (!file) { Swal.fire("يرجى اختيار ملف قبل الإرسال", "", "warning"); return; }

                    const fieldName = parent.querySelector('[name="NamedFile.FieldName"]').value;
                    const labelName = parent.querySelector('[name="NamedFile.LabelName"]').value;
                    const isRequired = parent.querySelector('[name="NamedFile.IsRequired"]').value === "True";

                    const reqNo = "@Model.RequestVM.Reqno";
                    const requestId = "@Model.RequestVM.RequestId";

                    const formData = new FormData();
                    formData.append("file.File", file);
                    formData.append("file.FieldName", fieldName);
                    formData.append("file.LabelName", labelName);
                    formData.append("file.IsRequired", isRequired);
                    formData.append("reqNo", reqNo);
                    formData.append("RequestId", requestId);

                    try {
                        const response = await fetch("/Elaw/UploadNewAttachment", { method: "POST", body: formData });
                        if (response.ok) {
                            const result = await response.json();
                            Swal.fire("تم الحفظ", result.message || "تم رفع المرفق", "success")
                                .then(() => window.location.reload());
                        } else {
                            const errorText = await response.text();
                            Swal.fire("فشل", errorText, "error");
                        }
                    } catch (err) {
                        console.error(err);
                        Swal.fire("خطأ", "حدث خطأ أثناء رفع الملف", "error");
                    }
                }
            </script>

        <script>
            // Create / move the teal sliding block to match the active tab
            (function () {
                // Get the tabs container
                const tabs = document.querySelector('.profile-authentication-tabs .nav-tabs');
                if (!tabs) return;

                // Ensure indicator exists
                let indicator = tabs.querySelector('.tab-indicator');
                if (!indicator) {
                    indicator = document.createElement('span');
                    indicator.className = 'tab-indicator';
                    tabs.prepend(indicator);
                }

                function moveIndicator(activeLink) {
                    if (!activeLink) return;
                    const tabRect = tabs.getBoundingClientRect();
                    const linkRect = activeLink.getBoundingClientRect();
                    const left = linkRect.left - tabRect.left + tabs.scrollLeft; // works LTR/RTL visually
                    indicator.style.width = linkRect.width + 'px';
                    indicator.style.transform = 'translateX(' + left + 'px)';
                }

                // Initial position (on load)
                const initial = tabs.querySelector('.nav-link.active') || tabs.querySelector('.nav-link');
                moveIndicator(initial);

                // On Bootstrap tab shown
                document.addEventListener('shown.bs.tab', function (e) {
                    moveIndicator(e.target);
                });

                // Recalculate on resize (responsive)
                window.addEventListener('resize', function () {
                    const current = tabs.querySelector('.nav-link.active');
                    moveIndicator(current);
                });
            })();
        </script>
        }
    }
</div>
 