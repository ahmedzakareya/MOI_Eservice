                                                                DateTime? dtNewExpiryDate = Model.RenewRequest.NewExpiryDate;
                                                                string datePartNewExpiry = dtNewExpiryDate.HasValue ? dtNewExpiryDate.Value.ToString("yyyy/MM/dd", ci) : "-";


