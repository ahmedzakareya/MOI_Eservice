<!-- ====== CARD: Change Manager (RTL) ====== -->
<div class="col-12 mt-3">
  <section class="dc-card" dir="rtl" aria-labelledby="changeManagerTitle">
    <span class="dc-ribbon" aria-hidden="true"></span>

    <!-- Main header -->
    <header class="dt-card__head">
      <i class="ri-file-list-3-line info-request-icon" aria-hidden="true"></i>
      <span class="dt-card__title" id="changeManagerTitle">بيانات طلب تغيير المدير المسئول</span>
    </header>

    <div class="dc-sep"></div>

    <div class="dc-body dc-body--gov">
      <!-- ========== OLD (RED) ========== -->
      <section class="dc-mini-card dc-mini--old dc-mini--gov" dir="rtl" aria-labelledby="oldManagerTitle">
        <header class="dc-mini__head gov-head gov-head--old" role="group" aria-labelledby="oldManagerTitle">
          <span class="gov-pill">قديم</span>
          <h5 class="gov-title" id="oldManagerTitle">بيانات المدير القديم</h5>
          <span class="gov-icon" aria-hidden="true"><i class="ri-user-line"></i></span>
        </header>

        <div class="dc-mini__divider"></div>

        <div class="dc-mini__brand">
          <div class="dc-mini__brand-title">البيانات الأساسية</div>
        </div>

        <ul class="dc-mini__list">
          <li class="dc-mini__item">
            <i class="ri-id-card-line dc-icon" aria-hidden="true"></i>
            <div class="dc-mini__text">
              <div class="dc-mini__primary">
                @(!string.IsNullOrWhiteSpace(Model?.ChangeManagerTransVM?.ManagerOldcivilid) ? Model.ChangeManagerTransVM.ManagerOldcivilid : "—")
