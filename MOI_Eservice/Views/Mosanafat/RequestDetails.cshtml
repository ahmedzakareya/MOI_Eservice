                                                            string amountText = amt.HasValue ? string.Format(cii, "{0:N3}", amt) : "—";
                                                            bool isPaid = string.Equals(Model?.RenewRequest?.RequestDetailsVM?.RequestDVM?.Licpaystatus?.Trim(), "1");
                                                        }

                                                        <div class="info-kv">
                                                            <div class="info-label">حالة الدفع</div>
                                                            <div class="info-value">
                                                                <span class="pill @(isPaid ? "pill--success" : "pill--danger")">
                                                                    @(isPaid ? "تم الدفع" : "لم يتم الدفع")
