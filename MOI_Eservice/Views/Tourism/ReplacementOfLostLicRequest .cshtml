@section Scripts {
<script type="text/javascript">
    async function submitFormViaAjax() {
        const uploadedFiles = new FormData();

        // 🟢 1. Add all normal text inputs (non-file)
        $('#RequestForm').serializeArray().forEach(function (input) {
            uploadedFiles.append(input.name, input.value);
        });
        var ActivityTypeId = $('#ActivitiList').val();  // Get selected value from the dropdown
        uploadedFiles.append('ActivityTypeId', ActivityTypeId);
        console.log('Selected Activity Value:', ActivityTypeId);
       
        console.log('Selected Activity Value:', ReasonId);

       

        let fileIndex = 0;

        // 🟢 2. Add file inputs with dynamic names like ContractDocuments[FieldName]
        const dynamicFileInputs = document.querySelectorAll('#RequestForm input[type="file"]');

        dynamicFileInputs.forEach((input) => {
            const files = input.files;

            const formGroup = input.closest('.form-group');
            const hiddenInput = formGroup.querySelector('input[type="hidden"][name$=".FieldName"]');
            const labelInput = formGroup.querySelector('input.field-label');

            const fieldName = hiddenInput ? hiddenInput.value : `UnknownField_${fileIndex}`;
            const labelName = labelInput ? labelInput.value : '';
            const isRequired = input.hasAttribute('required');

            if (files.length > 0) {
                for (let i = 0; i < files.length; i++) {
                    uploadedFiles.append(`NamedFile[${fileIndex}].FieldName`, fieldName);
                    uploadedFiles.append(`NamedFile[${fileIndex}].LabelName`, labelName); // ✅ here
                    uploadedFiles.append(`NamedFile[${fileIndex}].File`, files[i]);
                    uploadedFiles.append(`NamedFile[${fileIndex}].IsRequired`, isRequired ? "true" : "false");
                    fileIndex++;
                }
            } else {
                console.warn(`⚠️ No file selected for field: ${fieldName}`);
            }
        });

        // 🟡 Optional: Debug output
        for (let [key, value] of uploadedFiles.entries()) {
            console.log(`${key}:`, value);
        }

        
        try {
                const response = await fetch('/Tourism/HandleRequest', {
                method: 'POST',
                body: uploadedFiles
            });

            if (response.ok) {
                Swal.fire('تم بنجاح', 'تم إرسال البيانات', 'success');
            } else {
                Swal.fire('خطأ', 'حدث خطأ في المعالجة', 'error');
            }
        } catch (error) {
            console.error('Upload error:', error);
            Swal.fire('خطأ', 'فشل الإرسال: ' + error.message, 'error');
        }
    }
</script>

<script type="text/javascript">
    function ValidateRegeex(regex, value) {
        var expre = new RegExp(regex);
        return expre.test(value);
    }
    $(function () {
        $("[id$=FullNameAr]").on('change', function () {

            var regex = "^[\\u0621-\\u064A\\s]+$";
            var value = $(this).val();
            var status = ValidateRegeex(regex, value);
            if (status != true) {
                $(this).val("");
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'برجاء كتابة  الاسم باللغة العربية',
                    confirmButtonColor: '#7FB3D5',
                    confirmButtonText: 'Ok'
                });
                // alert("برجاء كتابة اسم الصحيفة باللغة العربية");
            }

        });
    });

    $(function () {
        $("[id$=CivilID]").on('change', function () {
            var regex = "^[1-3][0-9][0-9]((0[13578]|[1][02])(0[1-9]|[12][0-9]|3[01])|(0[469]|(11))(0[1-9]|[12][0-9]|30)|(02)(0[1-9]|1[0-9]|2[0-8]))[0-9]{5}$|(^[1-3](04|08|[2468][048]|[13579][26])|(300))(0229)[0-9]{5}$";
            var value = $(this).val();
            var status = ValidateRegeex(regex, value);
            if (status != true) {
                $(this).val("");
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'الرقم المدني غير صحيح',
                    confirmButtonColor: '#7FB3D5',
                    confirmButtonText: 'Ok'
                });
                // alert("برجاء كتابة اسم الصحيفة باللغة العربية");
            }
            // var CivilId = JSON.stringify({ CivilID: $(this).val() });
            console.log(JSON.stringify({ CivilID: $(this).val() }));
            $.ajax({
                url: '/Account/GetUserDataPACI',
                type: "POST",
                data: { CivilID: $(this).val() }, // use JSON.stringify for proper formatting
                // dataType: "json",
                //contentType: "application/json; charset=utf-8",
                success: function (response) {
                    // Check if the response was successful
                    if (response.success) {
                        // Populate the fields with data from the server
                        $('#NewUserName').val(response.data.arFullName);
                        $('#NewEmail').val(response.data.email);
                        $('#NewMobile').val(response.data.mobile);
                        $('#error-message').hide();

                    } else {
                        // Display error message if CivilID is invalid
                        $('#error-message').text(response.message).show();
                    }
                },
                error: function (xhr, status, error) {
                    console.log("Error: " + error);

                    console.log("Response Text: ", xhr.responseText);
                }
            });

        });
    });
    </script>
