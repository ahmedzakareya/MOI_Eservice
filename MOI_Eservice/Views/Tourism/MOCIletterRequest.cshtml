    async function submitFormViaAjax() {
        const uploadedFiles = new FormData();

        // 🟢 1. Add all normal text inputs (non-file)
        $('#MOCIletterRequest').serializeArray().forEach(function (input) {
            uploadedFiles.append(input.name, input.value);
        });
        var ActivityTypeId = $('#ActivitiList').val();  // Get selected value from the dropdown
        uploadedFiles.append('ActivityTypeId', ActivityTypeId);
        console.log('Selected Activity Value:', ActivityTypeId);

        let fileIndex = 0;

        // 🟢 2. Add file inputs with dynamic names like ContractDocuments[FieldName]
        const dynamicFileInputs = document.querySelectorAll('#MOCIletterRequest input[type="file"]');

        dynamicFileInputs.forEach((input) => {
            const files = input.files;

            // 🔍 ابحث عن hidden input يلي الملف مباشرة ويحتوي على اسم الحقل
          
                     const formGroup = input.closest('.form-group');
            const hiddenInput = formGroup.querySelector('input[type="hidden"][name$=".FieldName"]');
            const labelInput = formGroup.querySelector('input.field-label');

            const fieldName = hiddenInput ? hiddenInput.value : `UnknownField_${fileIndex}`;
            const labelName = labelInput ? labelInput.value : '';
            const isRequired = input.hasAttribute('required');

            if (files.length > 0) {
                for (let i = 0; i < files.length; i++) {
                    uploadedFiles.append(`NamedFile[${fileIndex}].FieldName`, fieldName);
                    uploadedFiles.append(`NamedFile[${fileIndex}].LabelName`, labelName); // ✅ here
                    uploadedFiles.append(`NamedFile[${fileIndex}].File`, files[i]);
                    uploadedFiles.append(`NamedFile[${fileIndex}].IsRequired`, isRequired ? "true" : "false");
                    fileIndex++;
                }
            }
            else {
                console.warn(`⚠️ No file selected for field: ${fieldName}`);
            }
        });

        // 🟡 Optional: Debug output
        for (let [key, value] of uploadedFiles.entries()) {
            console.log(`${key}:`, value);
        }

        // 🔵 3. Submit using fetch
        try {
                const response = await fetch('/Tourism/MOCIletterRequest', {
                method: 'POST',
                body: uploadedFiles
            });

            if (response.ok) {
                    Swal.fire('تم بنجاح', 'تم إرسال البيانات', 'success').then(() => {
                        window.location.href = '/Home/GetAllRequest';  // Redirect to the 'GetAllRequest' page
                    });

            } else {
                Swal.fire('خطأ', 'حدث خطأ في المعالجة', 'error');
            }
        } catch (error) {
            console.error('Upload error:', error);
            Swal.fire('خطأ', 'فشل الإرسال: ' + error.message, 'error');
        }
    }



