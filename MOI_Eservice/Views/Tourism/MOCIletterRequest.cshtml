@model MoicRequestVM


@{
    ViewBag.Title = "MOCIletterRequest";
    Layout = "~/Views/Shared/_LayoutEservice.cshtml";

    var isAdd = Model.ReqTypeId == (int)RequestTypeEnum.AddMoIC;
    var isEdit = Model.ReqTypeId == (int)RequestTypeEnum.ChangeAddressMOIC || Model.ReqTypeId == (int)RequestTypeEnum.RenewOrChangeMOIC;
    var isRenewEdit = Model.ReqTypeId == (int)RequestTypeEnum.DeleteMOIC || Model.ReqTypeId == (int)RequestTypeEnum.RenewMOIC;

    string required = isAdd ? "Required" : "";
    string display = isAdd ? "" : "d-none";

    string requiredContractRent = (isAdd || isEdit || isRenewEdit) ? "Required" : "";
    string displayContractRent = (isAdd || isEdit || isRenewEdit) ? "" : "d-none";
    var token = Context.Session.GetString("UserToken");
    var userId = Context.Session.GetString("UserId");
    var userName = Context.Session.GetString("UserUserName");
    var civilId = Context.Session.GetString("UserCivilId");
