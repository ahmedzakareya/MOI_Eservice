@model MOICDropdownVM



@{
    
    ViewBag.Title = "ChooseMOCIRequest";
    Layout = "~/Views/Shared/_LayoutEservice.cshtml";
}
<style>
    .copyrights-area {
        position: fixed;
        right: 310px;
        bottom: 0;
        left: 300px;
        width: 100%;
    }

</style>

<div class="my-profile-box">
    <h3>طلب إبداء الرأي للتجارة - تحديد نوع الطلب </h3>
    <div class="container-fluid">
        @using (Html.BeginForm())

        {
            @Html.AntiForgeryToken()

            <div class="form-horizontal py-3">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="row align-items-center">
                    <div class="col-xl-4 col-md-6 col-sm-12">
                        <div class="form-group">
                            <label class="pb-3">يرجى إختيار نوع النشاط</label>
                            <select name="ActivityTypeId" required id="ActivityTypeId" class="form-control">
                                <option value="" disabled selected hidden>--- اختر نوع النشاط---</option>
                                @foreach (var item in Model.ActivityTypes)

                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="col-xl-4 col-md-6 col-sm-12">
                        <div class="form-group">
                            <label class="pb-3">يرجى إختيار نوع الطلب</label>
                            <select name="RequestTypeId" required id="RequestTypeId" class="form-control">
                                <option value="" disabled selected hidden>--- اختر نوع الطلب---</option>
                                @foreach (var item in Model.RequestTypes)

                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="col-xl-4 col-md-6 col-sm-12" id="LicListDiv" style="display: none">
                        <div class="form-group">
                            <label class=" pb-3">يرجي إختيار الترخيص </label>
                            <select name="LicList" required id="LicList" class="form-control">
                            </select>
                            <p id="LicID" class="d-none"></p>
                        </div>
                    </div>

                    <div class="col-lg-12 col-md-12 mt-4">
                        <button type="button" class="default-btn" id="letterRequestBtn"
                                style="border-bottom: solid 10px #6460ed; margin-left: 10px">
                            اصدار طلب التجارة (موافقة ابداء الرأي)
                            <i class="flaticon-plus"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<script>

    const addMoicId = '@((int)RequestTypeEnum.AddMoIC)';

    $('#RequestTypeId').change(function () {
        var selectedReqType = $(this).val();
        var selectedActivityId = $('#ActivityTypeId').val();

        if (!selectedActivityId) {
            Swal.fire({
                icon: 'warning',
                title: 'تحذير',
                text: 'يرجى اختيار نوع النشاط أولاً',
            });
            $(this).val(""); // Reset selection
            return;
        }

        if (selectedReqType != addMoicId) {
            $('#LicListDiv').show();

            $.ajax({
                url: '/Tourism/GetLicencesListDropDown',
                type: 'GET',
                data: { reqType: selectedReqType, ActivityID: selectedActivityId },
                success: function (data) {
                    $('#LicList').empty().append('<option value="" disabled selected hidden>--- اختر ---</option>');
                    $.each(data, function (i, item) {
                        $('#LicList').append(new Option(item.text, item.value));
                    });
                },
                error: function () {
                    console.log('Error loading license options.');
                }
            });
        } else {
            $('#LicListDiv').hide();
            $('#LicList').empty();
        }
    });

    $('#LicList').change(function () {
        var selectedVal = $(this).val();
        $.ajax({
            url: '/TourismRequests/GetLicID',
            type: 'GET',
            data: { selectedValue: selectedVal },
            success: function (data) {
                $('#LicID').text(data);
            },
            error: function () {
                console.log('Error occurred while fetching license ID');
            }
        });
    });

    $('#RequestTypeId, #LicList').change(function () {
        var selectedReqType = $('#RequestTypeId').val();
        var selectedLicId = $('#LicList').val();
        var selectedActivityId = $('#ActivityTypeId').val();


        var targetUrl = '@Url.Action("MOCIletterRequest", "Tourism")' +
            '?ReqType=' + selectedReqType +
            '&ActivitiID=' + selectedActivityId;

        if (selectedReqType !== addMoicId && selectedLicId) {
            targetUrl += '&LicID=' + selectedLicId;
        }

        $('#letterRequestBtn').attr('onclick', 'location.href="' + targetUrl + '"');
    });

    
     

</script>
