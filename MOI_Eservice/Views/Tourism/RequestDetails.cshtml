    </form>
</div>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
@section Scripts
{
    <script>
        async function updateAttachment(event, attachId, reqNo, requestId) {
            event.preventDefault();

            const fileInput = document.getElementById(`fileInput_${attachId}`);
            const file = fileInput?.files[0];

            if (!file) {
                Swal.fire("يرجى اختيار ملف قبل الإرسال", "", "warning");
                return;
            }

            // Find associated hidden input values near the file input
            const parent = fileInput.closest('.form-group, .row');
            const fieldName = parent.querySelector('[name="NamedFile.FieldName"]')?.value;
            const labelName = parent.querySelector('[name="NamedFile.LabelName"]')?.value;
            const isRequired = parent.querySelector('[name="NamedFile.IsRequired"]')?.value === "True";

            // Build FormData
            const formData = new FormData();
            formData.append("file.File", file);
            formData.append("file.FieldName", fieldName);
            formData.append("file.LabelName", labelName);
            formData.append("file.IsRequired", isRequired);
            formData.append("attachId", attachId);
            formData.append("reqNo", reqNo);
            formData.append("RequestId", requestId);

            try {
                const response = await fetch(`/Tourism/UpdateAttachment`, {
                    method: "POST",
                    body: formData
                });

                if (response.ok) {
                    const result = await response.json();
                    Swal.fire("تم التحديث بنجاح", result.message || "", "success").then(() => {
                        location.reload(); // Refresh to reflect changes
                    });
                } else {
                    const errorText = await response.text();
                    Swal.fire("فشل التحديث", errorText, "error");
                }
            } catch (error) {
                console.error("Error uploading attachment:", error);
                Swal.fire("خطأ", "حدث خطأ أثناء رفع الملف", "error");
            }
        }
    </script>
    <script>

        $(function () {
            $("[id$=AaliNumber]").on('change', function () {
                var regex = "^[0-9]+$";
                var value = $(this).val();
                var status = ValidateRegeex(regex, value);
                if (status !== true) {
                    $(this).val("");
                    Swal.fire({
                        icon: 'error',
                        title: 'خطأ',
                        text: 'أرقام فقط',
                        confirmButtonColor: '#7FB3D5',
                        confirmButtonText: 'موافق'
                    });
                    return;
                }

                get_Amount(value);
            });
        });

        async function get_Amount(ID) {
            try {
                const response = await $.ajax({
                    type: "POST",
                    url: "/Tourism/getAddressDataFromPaci",
                    data: { ID: ID },
                    dataType: "json"
                });

                $('#Governrate').val(response.governoratearabic || "");
                $('#Area').val(response.neighborhoodarabic || "");
                $('#BlockNo').val(response.blockarabic || "");
                $('#Street').val(response.streetarabic || "");
                $('#BuildingName').val(response.buildingnamearabic || "");
                $('#UnitNo').val(response.unit_no || "");
                $('#FloorNo').val(response.floor_no || "");
                $('#BuildingNo').val(response.parcelarabic || "");
            } catch (error) {
                $('#AaliNumber, #Governrate, #Area, #BlockNo, #Street, #BuildingNo, #UnitNo, #FloorNo, #BuildingName').val("");
                Swal.fire({
                    icon: 'error',
                    title: 'خطأ...',
                    text: 'عفوا , الرقم الآلي غير صحيح!',
                    confirmButtonText: "موافق"
                });
            }
        }

        function ValidateRegeex(regex, value) {
            var pattern = new RegExp(regex);
            return pattern.test(value);
        }
    </script>

