            text: 'يرجى التأكد من صحة بيانات المنشأة بالكامل وتحديث المرفقات في حال انتهاء صلاحيتها.',
        });
    });

    $(document).ready(function () {
        $('form').submit(function () {
            // Disable the submit button
            $(':submit', this).prop('disabled', true);
            $(this).append('<div class="preloader-area"> ' +
                '<div class="spinner">' +
                '   <div class="inner">' +
                '      <div class="disc"></div>' +
                '   <div class="disc"></div>' +
                '     <div class="disc"></div>' +
                '  </div>' +
                ' </div>' +
                '</div>');
            // Optionally, you can show a loading spinner or perform other actions
            $('.preloader-area').fadeOut(15000);
            // Continue with form submission
            return true;
        });
    });




    function get_sbu() {
        var id = $('#ActivitiList').find(":selected").attr('value');
        $.ajax({
            type: "POST",
            url: "/Tourism/GetActivity",
            data: "id=" + id,
            success: function (data) {
                console.log(data[1]);
                if (id != "0") {
                    if (data.length > 0) {
                        $('#ActivitiID').val(data[1].value);
                        $('#ActivitiName').val(data[1].text);
                    } else {
                        $('#ActivitiID').val('');
                        $('#ActivitiName').val('');
                    }
                }

            }
        });
    }

    //---------- sweet alert  ------------

    $(function loadImage() {

        var errorMsg = '@ViewBag.test'
        var msg = '@ViewBag.Message'

        if (msg == 'Success') {
            Swal.fire({
                icon: 'success',
                title: 'تأكـيد',
                text: 'تم حفظ البيانات بنجاح',
                confirmButtonColor: '#7FB3D5',
                confirmButtonText: 'الانتقال لقائمة الطلبات !'
            }).then(function () { window.location = '../TourismHome/RequestsList'; });

        }
        else if (msg == 'error') {
            Swal.fire({
                icon: 'error',
                title: 'تأكـيد',
                text: errorMsg,
                confirmButtonColor: '#7FB3D5',
                confirmButtonText: 'الانتقال لقائمة الطلبات !'
            }).then(function () { window.location = 'PreApprovRequest'; });
        };


    });

    /*---------- TextBox Validation ----------*/

    function ValidateRegeex(regex, value) {
        var expre = new RegExp(regex);
        return expre.test(value);
    }

    $(function () {
        $("[id$=UserCivilID]").on('change', function () {

            var regex = "^[1-3][0-9][0-9]((0[13578]|[1][02])(0[1-9]|[12][0-9]|3[01])|(0[469]|(11))(0[1-9]|[12][0-9]|30)|(02)(0[1-9]|1[0-9]|2[0-8]))[0-9]{5}$|(^[1-3](04|08|[2468][048]|[13579][26])|(300))(0229)[0-9]{5}$";
            var value = $(this).val();
            var status = ValidateRegeex(regex, value);
            if (status != true) {
                $(this).val("");
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'الرقم المدني غير صحيح',
                    confirmButtonColor: '#7FB3D5',
                    confirmButtonText: 'Ok'
                });
                // alert("برجاء كتابة اسم الصحيفة باللغة العربية");
            }

        });
    });



    $(function () {
        $("[id$=AaliNumber]").on('change', function () {

            var regex = "^[0-9]+$";
            var value = $(this).val();
            var status = ValidateRegeex(regex, value);
            if (status != true) {
                $(this).val("");
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'أرقام فقط',
                    confirmButtonColor: '#7FB3D5',
                    confirmButtonText: 'Ok'
                });
            }

            //alert(value);
            get_Amount(value);
        });
    });

    async function get_Amount(ID) {
        try {
            const response = await $.ajax({
                type: "POST",
                url: "/Tourism/getAddressDataFromPaci",
                data: { ID: ID },
                dataType: "json"  // Ensure the response is expected in JSON format
            });

            // Update form fields with the data returned from the server
            $('#Governrate').val(response.governoratearabic || "");
            $('#Area').val(response.neighborhoodarabic || "");
            $('#BlockNo').val(response.blockarabic || "");
            $('#Street').val(response.streetarabic || "");
            $('#BuildingName').val(response.buildingnamearabic || "");
            $('#UnitNo').val(response.unit_no || "");
            $('#FloorNo').val(response.floor_no || "");
            $('#BuildingNo').val(response.parcelarabic || "");

        } catch (error) {
            // Reset the fields if an error occurs
