            @{
                var encodedId = MyCrypto.Encode(Model.LicId?.ToString());
                string queryString = $"?id={encodedId}&requestTypeId={Model.ReqTypeId}";

                if (Model.SelectedTransactionTypeIds != null && Model.SelectedTransactionTypeIds.Any())
                {
                    var selectedTransactionTypeIds = string.Join("&", Model.SelectedTransactionTypeIds.Select(t => $"selectedTransactionTypeIds={t}"));
                    queryString += "&" + selectedTransactionTypeIds;
                }

                var safeUrl = Model.Url.StartsWith("/") ? Model.Url : "/" + Model.Url;
                var fullUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{safeUrl}{queryString}";
                // var safeUrl = Model.Url.StartsWith("/") ? Model.Url : "/" + Model.Url;

                // // Build the full absolute URL
                // var fullUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{safeUrl}";
            }
            <div class="mt-5 text-center">
                <a href="@fullUrl"  class="btn btn-primary btn-lg px-5">
                    <i class="bi bi-play-circle-fill me-2"></i> إبدأ الخدمة
                </a>

                @* <a href="@fullUrl" class="btn btn-primary btn-lg px-5">
