                // Update form fields with the data returned from the server
                $('#Governrate').val(response.governoratearabic || "");
                $('#Area').val(response.neighborhoodarabic || "");
                $('#BlockNo').val(response.blockarabic || "");
                $('#Street').val(response.streetarabic || "");
                $('#BuildingName').val(response.buildingnamearabic || "");
                $('#UnitNo').val(response.unit_no || "");
                $('#FloorNo').val(response.floor_no || "");
                $('#BuildingNo').val(response.parcelarabic || "");

            } catch (error) {
                // Reset the fields if an error occurs
                $('#AaliNumber').val("");
                $('#Governrate').val("");
                $('#Area').val("");
                $('#BlockNo').val("");
                $('#Street').val("");
