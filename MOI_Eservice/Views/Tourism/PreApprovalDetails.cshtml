    <script>
        let customAttachCounter = 0;

        function addCustomAttachment() {
            customAttachCounter++;

            const container = document.getElementById("custom-attachments");

            const wrapper = document.createElement("div");
            wrapper.className = "row align-items-center mb-3 border p-2 bg-light rounded";
            wrapper.innerHTML = `
                    <div class="col-md-5">
                        <input type="file"
                               name="NamedFile.File"
                               class="form-control"
                               id="fileInput_custom_${customAttachCounter}"
                               data-field="CustomField_${customAttachCounter}"
                               data-label="مرفق مخصص ${customAttachCounter}"
                               data-required="false" />
                        <input type="hidden" name="NamedFile.FieldName" value="CustomField_${customAttachCounter}" />
                        <input type="hidden" name="NamedFile.LabelName" value="مرفق مخصص ${customAttachCounter}" />
                        <input type="hidden" name="NamedFile.IsRequired" value="false" />
                    </div>
                    <div class="col-md-4">
                        <button type="button" class="btn btn-success me-2" onclick="uploadCustomAttachment(this)">رفع</button>
                        <button type="button" class="btn btn-danger" onclick="this.closest('.row').remove()">حذف</button>
                    </div>
                `;

            container.appendChild(wrapper);
        }

        async function uploadCustomAttachment(button) {
            const parent = button.closest(".row");
            const fileInput = parent.querySelector('input[type="file"]');
            const file = fileInput?.files[0];

            if (!file) {
                Swal.fire("يرجى اختيار ملف قبل الإرسال", "", "warning");
                return;
            }

            const fieldName = parent.querySelector('[name="NamedFile.FieldName"]').value;
            const labelName = parent.querySelector('[name="NamedFile.LabelName"]').value;
            const isRequired = parent.querySelector('[name="NamedFile.IsRequired"]').value === "True";

            const reqNo = "@Model.RequestVM.Reqno";
            const requestId = "@Model.RequestVM.RequestId";

            const formData = new FormData();
            formData.append("file.File", file);
            formData.append("file.FieldName", fieldName);
            formData.append("file.LabelName", labelName);
            formData.append("file.IsRequired", isRequired);
            formData.append("reqNo", reqNo);
            formData.append("RequestId", requestId);

            try {
                const response = await fetch("/Tourism/UploadNewAttachment", {
                    method: "POST",
                    body: formData
                });

                if (response.ok) {
                    const result = await response.json();
                    Swal.fire("تم الحفظ", result.message || "تم رفع المرفق", "success")
                        .then(() => window.location.reload());
                } else {
                    const errorText = await response.text();
                    Swal.fire("فشل", errorText, "error");
                }
            } catch (err) {
                console.error(err);
                Swal.fire("خطأ", "حدث خطأ أثناء رفع الملف", "error");
            }
        }
    </script>


