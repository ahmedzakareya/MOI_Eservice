@section Scripts
{
    <script>
        async function updateAttachment(event, attachId, reqNo, requestId) {
            event.preventDefault();

            const fileInput = document.getElementById(`fileInput_${attachId}`);
            const file = fileInput?.files[0];

            if (!file) {
                Swal.fire("يرجى اختيار ملف قبل الإرسال", "", "warning");
                return;
            }

            // Find associated hidden input values near the file input
            const parent = fileInput.closest('.form-group, .row');
            const fieldName = parent.querySelector('[name="NamedFile.FieldName"]')?.value;
            const labelName = parent.querySelector('[name="NamedFile.LabelName"]')?.value;
            const isRequired = parent.querySelector('[name="NamedFile.IsRequired"]')?.value === "True";

            // Build FormData
            const formData = new FormData();
            formData.append("file.File", file);
            formData.append("file.FieldName", fieldName);
            formData.append("file.LabelName", labelName);
            formData.append("file.IsRequired", isRequired);
            formData.append("attachId", attachId);
            formData.append("reqNo", reqNo);
            formData.append("RequestId", requestId);

            try {
                const response = await fetch(`/Tourism/UpdateAttachment`, {
                    method: "POST",
                    body: formData
                });

                if (response.ok) {
                    const result = await response.json();
                    Swal.fire("تم التحديث بنجاح", result.message || "", "success").then(() => {
                        // location.reload(); // Refresh to reflect changes
                        window.location.href = "/Home/GetAllRequest";
                    });
                } else {
                    const errorText = await response.text();
                    Swal.fire("فشل التحديث", errorText, "error");
                }
            } catch (error) {
                console.error("Error uploading attachment:", error);
                Swal.fire("خطأ", "حدث خطأ أثناء رفع الملف", "error");
            }
        }



        $(function () {
