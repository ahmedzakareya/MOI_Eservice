@section Scripts {
    <script>
        async function submitFormViaAjax() {
            const uploadedFiles = new FormData();

            // 🟢 1. Add all normal text inputs (non-file)
            $('#RequestForm').serializeArray().forEach(function (input) {
                uploadedFiles.append(input.name, input.value);
            });
            var ActivityTypeId = $('#ActivitiList').val();  // Get selected value from the dropdown
            uploadedFiles.append('ActivityTypeId', ActivityTypeId);
            console.log('Selected Activity Value:', ActivityTypeId);
            // $('input[name="SelectedTransactionTypeIds"]').each(function () {
            //     uploadedFiles.append('SelectedTransactionTypeIds', $(this).val());
            //     console.log
            // });

            let fileIndex = 0;

            // 🟢 2. Add file inputs with dynamic names like ContractDocuments[FieldName]
            const dynamicFileInputs = document.querySelectorAll('#RequestForm input[type="file"]');

            dynamicFileInputs.forEach((input) => {
                const files = input.files;

                const formGroup = input.closest('.form-group');
                const hiddenInput = formGroup.querySelector('input[type="hidden"][name$=".FieldName"]');
                const labelInput = formGroup.querySelector('input.field-label');

                const fieldName = hiddenInput ? hiddenInput.value : `UnknownField_${fileIndex}`;
                const labelName = labelInput ? labelInput.value : '';
                const isRequired = input.hasAttribute('required');

                if (files.length > 0) {
                    for (let i = 0; i < files.length; i++) {
                        uploadedFiles.append(`NamedFile[${fileIndex}].FieldName`, fieldName);
                        uploadedFiles.append(`NamedFile[${fileIndex}].LabelName`, labelName); // ✅ here
                        uploadedFiles.append(`NamedFile[${fileIndex}].File`, files[i]);
                        uploadedFiles.append(`NamedFile[${fileIndex}].IsRequired`, isRequired ? "true" : "false");
                        fileIndex++;
                    }
                } else {
                    console.warn(`⚠️ No file selected for field: ${fieldName}`);
                }
            });

            // 🟡 Optional: Debug output
            for (let [key, value] of uploadedFiles.entries()) {
                console.log(`${key}:`, value);
            }

            // 🔵 3. Submit using fetch
            try {
                const response = await fetch('/Tourism/HandleRequest', {
                    method: 'POST',
                    body: uploadedFiles
                });

                if (response.ok) {
                    Swal.fire('تم بنجاح', 'تم إرسال البيانات', 'success').then(() => {
                        window.location.href = '/Home/GetAllRequest';  // Redirect to the 'GetAllRequest' page
                    });
                } else {
                    Swal.fire('خطأ', 'حدث خطأ في المعالجة', 'error');
                }
            } catch (error) {
                console.error('Upload error:', error);
                Swal.fire('خطأ', 'فشل الإرسال: ' + error.message, 'error');
            }
        }


        $(function () {
            $("[id$=AaliNumber]").on('change', function () {

                var regex = "^[0-9]+$";
                var value = $(this).val();
                var status = ValidateRegeex(regex, value);
                if (status != true) {
                    $(this).val("");
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'أرقام فقط',
                        confirmButtonColor: '#7FB3D5',
                        confirmButtonText: 'Ok'
                    });
                }

                //alert(value);
                get_Amount(value);
            });
        });

        async function get_Amount(ID) {
            try {
                const response = await $.ajax({
                    type: "POST",
                    url: "/Tourism/getAddressDataFromPaci",
                    data: { ID: ID },
                    dataType: "json"  // Ensure the response is expected in JSON format
                });

                // Update form fields with the data returned from the server
                $('#Governrate').val(response.governoratearabic || "");
                $('#Area').val(response.neighborhoodarabic || "");
                $('#BlockNo').val(response.blockarabic || "");
                $('#Street').val(response.streetarabic || "");
                $('#BuildingName').val(response.buildingnamearabic || "");
                $('#UnitNo').val(response.unit_no || "");
                $('#FloorNo').val(response.floor_no || "");
                $('#BuildingNo').val(response.parcelarabic || "");

            } catch (error) {
                // Reset the fields if an error occurs
                $('#AaliNumber').val("");
                $('#Governrate').val("");
                $('#Area').val("");
                $('#BlockNo').val("");
                $('#Street').val("");
                $('#BuildingNo').val("");
                $('#UnitNo').val("");
                $('#FloorNo').val("");
                $('#BuildingName').val("");

                // Display error message using SweetAlert
                Swal.fire({
                    icon: 'error',
                    title: 'خطأ...',
                    text: 'عفوا , الرقم الالي غير صحيح!',
                    cancelButtonText: "Speed Case?"
                });
            }
        }
    </script>
}