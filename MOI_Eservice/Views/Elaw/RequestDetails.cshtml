                    <!-- Upload New Required Files Section -->
                   @if (Model.fileUploadConfigs?.Any() == true)
{
    <div class="col-12 mb-4">
        <h5 class="fw-bold text-gray-800 mb-3">📎 المستندات المطلوبة الجديدة</h5>
        <div class="row g-4">
            @foreach (var config in Model.fileUploadConfigs)
            {
                <div class="col-md-6">
                    <div class="form-group mb-3 border rounded p-3 shadow-sm bg-light">
                        <label class="form-label fw-semibold">@config.AttachName 
                            @if (config.IsMandatory)
                            {
                                <span class="text-danger">*</span>
                            }
                        </label>
                        
                        <div class="row align-items-center">
                            <div class="col-8">
                                <input type="file" class="form-control shadow-sm" required="@config.IsMandatory" accept="@config.AllowedFileTypes" />
