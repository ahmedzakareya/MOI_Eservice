    </div>
}
                    <!-- Existing Attachments Table -->
                    <div class="col-12">
                        <div class="card border shadow-sm">
                            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                                <h6 class="mb-0 fw-bold">📂 المرفقات الحالية</h6>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-bordered align-middle mb-0">
                                        <thead class="table-light text-center">
                                            <tr>
                                                <th width="40%">اسم المرفق</th>
                                                <th width="10%">عرض المرفق</th>
                                                <th width="50%">تحديث المرفق</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model.attachVMs)
                                            {
                                                <tr>
                                                    <td><span class="fw-medium">@item.AttachName</span></td>
                                                    <td class="text-center">
                                                        <button class="btn btn-icon btn-light-primary btn-sm"
                                                                data-bs-toggle="tooltip" title="عرض"
                                                                onclick="window.open('@Url.Content($"~/{ViewBag.PathAttachment}{item.AttachPath}")')">
                                                            <i class="ri-eye-line"></i>
                                                        </button>
                                                    </td>
                                                    <td>
                                                        @if (Model.RequestVM.RequestStatusId != (int)RequestStatusEnum.FinalLicenseIssued && item.IsApproved == false)
                                                        {
                                                            <div class="row align-items-center">
                                                                <div class="col-md-8 mb-2 mb-md-0">
                                                                    <input type="file"
                                                                           name="NamedFile.File"
                                                                           class="form-control"
                                                                           id="fileInput_@item.AttachId"
                                                                           data-field="@item.AttachFlag"
                                                                           data-label="@item.AttachName"
                                                                           data-required="@item.IsMandatory" />
                                                                    <input type="hidden" name="NamedFile.FieldName" value="@item.AttachFlag" />
                                                                    <input type="hidden" name="NamedFile.LabelName" value="@item.AttachName" />
                                                                    <input type="hidden" name="NamedFile.IsRequired" value="@item.IsMandatory" />
                                                                </div>
                                                                <div class="col-md-4 text-end">
                                                                    <button type="button"
                                                                            class="btn btn-success"
                                                                            onclick="updateAttachment(event, @item.AttachId, '@Model.RequestVM.Reqno', @item.AttachRequestid)">
                                                                        تحديث المرفق
                                                                    </button>
                                                                </div>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-success">✔ معتمد</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>



