@section Scripts {
    <script>

        $("[id$=AaliNumberManager]").on('change', function () {
            var regex = "^[0-9]+$";
            var value = $(this).val();
            var status = ValidateRegeex(regex, value);
            if (!status) {
                $(this).val("");
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'أرقام فقط',
                    confirmButtonColor: '#7FB3D5',
                    confirmButtonText: 'Ok'
                });
                return;
            }
            Swal.showLoading();

            get_Amount(value, true); // true = manager
        });
        $("[id$=AaliNumber]").on('change', function () {
            var regex = "^[0-9]+$";
            var value = $(this).val();
            var status = ValidateRegeex(regex, value);
            if (!status) {
                $(this).val("");
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'أرقام فقط',
                    confirmButtonColor: '#7FB3D5',
                    confirmButtonText: 'Ok'
                });
                return;
            }
            Swal.showLoading();

            get_Amount(value, false); // true = manager
        });
        async function get_Amount(ID, isManager) {
            try {
                const response = await $.ajax({
                    type: "POST",
                    url: "/Tourism/getAddressDataFromPaci",
                    data: { ID: ID },
                    dataType: "json"
                });
                Swal.close();

                const suffix = isManager ? "Manager" : "";
                $(`#Governrate${suffix}`).val(response.governoratearabic || "");
                $(`#Area${suffix}`).val(response.neighborhoodarabic || "");
                $(`#BlockNo${suffix}`).val(response.blockarabic || "");
                $(`#Street${suffix}`).val(response.streetarabic || "");
                $(`#BuildingName${suffix}`).val(response.buildingnamearabic || "");
                $(`#UnitNo${suffix}`).val(response.unit_no || "");
                $(`#FloorNo${suffix}`).val(response.floor_no || "");
                $(`#BuildingNo${suffix}`).val(response.parcelarabic || "");

            } catch (error) {
                Swal.close();

                const suffix = isManager ? "Manager" : "";
                $(`#AaliNumber${suffix}`).val("");
                $(`#Governrate${suffix}`).val("");
                $(`#Area${suffix}`).val("");
                $(`#BlockNo${suffix}`).val("");
                $(`#Street${suffix}`).val("");
                $(`#BuildingNo${suffix}`).val("");
                $(`#UnitNo${suffix}`).val("");
                $(`#FloorNo${suffix}`).val("");
                $(`#BuildingName${suffix}`).val("");

                Swal.fire({
                    icon: 'error',
                    title: 'خطأ...',
                    text: 'عفوا , الرقم الالي غير صحيح!',
                    cancelButtonText: "Speed Case?"
                });
            }
        }
        $(function () {
            $("[id$=NewLicencesName]").on('change', function () {
                var nameValue = $(this).val();

                $.ajax({
                    url: '/Elaw/CheckMediaName',
                    type: "GET",
                    data: { medianame: nameValue },
                    success: function (response) {
                        if (response.exists) {
                            $('#NewLicencesNameValidation').html('يوجد وسيلة اعلامية بهذا الاسم <b><u>' + nameValue + '</u></b>').show();
                            $('#NewLicencesName').val('');
                        } else {
                            $('#NewLicencesNameValidation').html('').hide();
                        }
                    },
                    error: function () {
                        $('#NewLicencesNameValidation').html('حدث خطأ في التحقق من اسم الوسيلة');
                    }
                });
            });
        });
        $(function () {
            $("[id$=NewLicencesName]").on('change', function () {

                var regex = "^[\\u0621-\\u064A\\s]+$";
                var value = $(this).val();
                var status = ValidateRegeex(regex, value);
                if (status != true) {
                    $(this).val("");
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'برجاء كتابة اسم الوسيلة الاعلامية باللغة العربية',
                        confirmButtonColor: '#7FB3D5',
                        confirmButtonText: 'Ok'
                    });
                    // alert("برجاء كتابة اسم الصحيفة باللغة العربية");
                }

            });
        });
        async function submitFormViaAjax() {
            const uploadedFiles = new FormData();

            // 🟢 1. Add all normal text inputs (non-file)
            $('#RequestForm').serializeArray().forEach(function (input) {
                uploadedFiles.append(input.name, input.value);
            });
            var ActivityTypeId = $('#ActivitiList').val();  // Get selected value from the dropdown
            uploadedFiles.append('ActivityTypeId', ActivityTypeId);
            console.log('Selected Activity Value:', ActivityTypeId);
            // $('input[name="SelectedTransactionTypeIds"]').each(function () {
            //     uploadedFiles.append('SelectedTransactionTypeIds', $(this).val());
            // });

            let fileIndex = 0;
            const selectedLicTypeId = $('input[name="NewLicencesTpeId"]:checked').val();
            const qualificationApplicantId = $('#QualificationList').val(); // for applicant
            //const qualificationManagerId = $('#QualificationListManager').val(); // for manager
            const qualificationManagerId = $('#QualificationListManager').val();
            uploadedFiles.append('QualificationManagerId', qualificationManagerId);
            uploadedFiles.append('QualificationApplicantId', qualificationApplicantId);
            //uploadedFiles.append('QualificationManagerId', qualificationManagerId);

            console.log('Applicant Qualification ID:', qualificationApplicantId);
            console.log('Manager Qualification ID:', qualificationManagerId);
            if (selectedLicTypeId) {
                uploadedFiles.append('NewLicencesTpeId', selectedLicTypeId);
                console.log("✅ Selected Licence Type:", selectedLicTypeId);
            } else {
                console.warn("⚠️ No licence type selected.");
            }
            // 🟢 2. Add file inputs with dynamic names like ContractDocuments[FieldName]
            const dynamicFileInputs = document.querySelectorAll('#RequestForm input[type="file"]');

            dynamicFileInputs.forEach((input) => {
                const files = input.files;

                const formGroup = input.closest('.form-group');
                const hiddenInput = formGroup.querySelector('input[type="hidden"][name$=".FieldName"]');
                const labelInput = formGroup.querySelector('input.field-label');

                const fieldName = hiddenInput ? hiddenInput.value : `UnknownField_${fileIndex}`;
                const labelName = labelInput ? labelInput.value : '';
                const isRequired = input.hasAttribute('required');

                if (files.length > 0) {
                    for (let i = 0; i < files.length; i++) {
                        uploadedFiles.append(`NamedFile[${fileIndex}].FieldName`, fieldName);
                        uploadedFiles.append(`NamedFile[${fileIndex}].LabelName`, labelName); // ✅ here
                        uploadedFiles.append(`NamedFile[${fileIndex}].File`, files[i]);
                        uploadedFiles.append(`NamedFile[${fileIndex}].IsRequired`, isRequired ? "true" : "false");
                        fileIndex++;
                    }
                } else {
                    console.warn(`⚠️ No file selected for field: ${fieldName}`);
                }
            });

            // 🟡 Optional: Debug output
            for (let [key, value] of uploadedFiles.entries()) {
                console.log(`${key}:`, value);
            }

            // 🔵 3. Submit using fetch
            try {
                const response = await fetch('/Elaw/HandleRequest', {
                    method: 'POST',
                    body: uploadedFiles
                });

                if (response.ok) {
                    Swal.fire('تم بنجاح', 'تم إرسال البيانات', 'success').then(() => {
                        window.location.href = '/Home/GetAllRequest';  // Redirect to the 'GetAllRequest' page
                    });
                } else {
                    Swal.fire('خطأ', 'حدث خطأ في المعالجة', 'error');
                }
            } catch (error) {
                console.error('Upload error:', error);
                Swal.fire('خطأ', 'فشل الإرسال: ' + error.message, 'error');
            }
        }
    </script>
}