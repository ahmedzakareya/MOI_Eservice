@model RequestLicPerPerson


@{
    ViewBag.Title = "LicRequestPerPerson";
    Layout = "~/Views/Shared/_LayoutEservice.cshtml";
    var token = Context.Session.GetString("UserToken");
    var userId = Context.Session.GetString("UserId");
    var userName = Context.Session.GetString("UserUserName");
    var civilId = Context.Session.GetString("UserCivilId");
    var fullName = Context.Session.GetString("UserFullName");
    var accountTypeId = Context.Session.GetString("UserAccouuntTypeId");
    string entityLabel = Model.LicencesInfoVM.LicTypeId switch
    {
        (int)LicTypeEnum.Media_Organization_Company => "إسم الشركة",
        (int)LicTypeEnum.Government_Entity => "إسم الجهة الحكومية",
        (int)LicTypeEnum.Public_Benefit_Association => "إسم جمعية النفع العام",

        (int)LicTypeEnum.PrintedNewspapersAndLicensedAVChannels => "إسم الصحيفة أو القناة",
        _ => "الاسم"
    };
    string licenseTitle = Model.LicencesInfoVM.LicTypeId switch
    {
        (int)LicTypeEnum.Media_Organization_Company => "طلب إصدار ترخيص إعلام إلكتروني للشركات",
        (int)LicTypeEnum.Government_Entity => "طلب إصدار ترخيص إعلام إلكتروني للجهات الحكومية",
        (int)LicTypeEnum.Public_Benefit_Association => "طلب إصدار ترخيص إعلام إلكتروني لجمعيات النفع العام",

        (int)LicTypeEnum.PrintedNewspapersAndLicensedAVChannels => "طلب إصدار ترخيص للصحف الورقية والقنوات المرئية والمسموعة المرخصة",
        _ => "طلب إصدار ترخيص إعلام إلكتروني"
    };

    string entityTitle = Model.LicencesInfoVM.LicTypeId switch
    {
        (int)LicTypeEnum.Media_Organization_Company => "بيانات الشركة",
        (int)LicTypeEnum.Government_Entity => "بيانات الجهة الحكومية",
        (int)LicTypeEnum.Public_Benefit_Association => "بيانات جمعية النفع العام",

        (int)LicTypeEnum.PrintedNewspapersAndLicensedAVChannels => "بيانات الصحيفة أو القناة",
        _ => "بيانات الجهة"
    };
}

