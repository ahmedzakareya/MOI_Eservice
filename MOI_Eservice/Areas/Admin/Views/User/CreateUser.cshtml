    <script src="https://cdnjs.cloudflare.com/ajax/libs/crypto-js/4.1.1/crypto-js.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#createUserForm').submit(function (e) {
                e.preventDefault(); // Prevent the default form submission

                // Encryption example
                var password = $('#passwordInput').val();
                var secretKey = 'MySecretKey12345'; // Example secret key
                var encryptedPassword = CryptoJS.AES.encrypt(password, secretKey).toString();
                var serviceId = $('input[name="User.ServiceId"]:checked').val();
                //var status = $('input[name="User.Status""]:checked').val();
                var statusValue = document.querySelector('input[name="User.Status"]:checked').value;

                // Convert the string to a boolean value
                var status = (statusValue === 'true');


                // Collect user data
                var userData = {
                    User: {
                        CivilId: $('#civilIdInput').val(),
                        Username: $('#civilIdInput').val(),
                        Name: $('#fullName').val(),
                        Mobile: $('#mobile').val(),
                        Email: $('#email').val(),
                        Password: $('#passwordInput').val(),
                        UserPasswordEncrypted: encryptedPassword,
                        SectorId: $('#sectorId').val(),
                        DepId: $('#departId').val(),
                        MuraqabaId: $('#muraqabaId').val() || null,
                        QismId: $('#qismId').val() || null,
                        ServiceId: parseInt(serviceId) ||null,
                        status:status,
                    }
                };

                // API Base URL from server-side ViewBag
                var apiBaseUrl = '@ViewBag.ApiBaseUrl';

                // Create User
                $.ajax({
                    url: apiBaseUrl + 'Create/',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(userData),
                    success: function (response) {
                        alert(response.message);

                        // After user is successfully created, get UserId to assign roles and permissions
                        var userId = response.userId; // Assuming response contains userId

                        // Call the function to assign permissions and roles sequentially
                        assignRoles(userId)
                            
                            .then(() => {
                                // Redirect to User List Page after everything is done
                                window.location.href = '@Url.Action("Index", "User", new { area = "Admin" })';
                            })
                            .catch((error) => {
                                console.log("An error occurred while assigning permissions or roles:", error);
                            });
                    },
                    error: function (xhr, status, error) {
                        console.log(xhr.responseText);
                        alert("Failed to create user: " + xhr.responseText);
                    }
                });

                

                // Assign Roles to User
                function assignRoles(userId) {
                    return new Promise((resolve, reject) => {
                        // Collect all selected role IDs into an array
                        var selectedRoleIds = [];
                        $('input[name="SelectedRoleIds"]:checked').each(function () {
                            selectedRoleIds.push($(this).val());
                        });

                        // Send the array of role IDs in a single AJAX request
                        $.ajax({
                            url: apiBaseUrl + 'AssignRoles/',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify({ UserId: userId, RoleIds: selectedRoleIds }),
                            success: function () {
                                console.log("Roles assigned successfully.");
                                resolve(); // Resolve the promise
                            },
                            error: function (xhr, status, error) {
                                console.log("Failed to assign roles: " + xhr.responseText);
                                reject(xhr.responseText); // Reject the promise on error
                            }
                        });
                    });
                }
            });
        });
    </script>


  


    <script>
        $(document).ready(function () {
            loadRoles();

            function loadRoles() {
                var apiBaseUrl = '@ViewBag.ApiBaseUrl';
                $.ajax({
                    url: apiBaseUrl + 'GetAllRoles/',
                    method: 'GET',
                    success: function (data) {
                        // Ensure to use the correct function to populate roles
                        populateRoles(data.$values);
                    },
                    error: function (xhr, status, error) {
                        console.error("Error fetching Roles:", error);
                    }
                });
            }

            function populateRoles(roles) {
                const RolesContainer = $('#RolesContainer');
                RolesContainer.empty();  // Clear any existing roles

                let row;
                $.each(roles, function (index, role) {
                    if (index % 3 === 0) {
                        row = $('<div class="row mb-2"></div>'); // Create a new row for every 3 roles
                        RolesContainer.append(row);
                    }

                    const checkbox = `
                                    <div class="col-md-4">
                                        <div class="form-check">
                                                            <input class="form-check-input" type="checkbox" name="SelectedRoleIds" value="${role.roleId}" id="role-${index}">
                                            <label class="form-check-label text-dark fs-5" for="role-${index}">
                                                        ${role.roleName}
                                            </label>
                                        </div>
                                    </div>`;

                    row.append(checkbox); // Append the checkbox to the current row
                });
            }
        });
    </script>


