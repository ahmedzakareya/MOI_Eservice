@section Scripts {

    <script>

        $(document).ready(function () {
            var apiBaseUrl = '@ViewBag.ApiBaseUrl'; // Get the dynamic base URL

            $('#sectorId').change(function () {
                var sectorId = $(this).val();
                $.ajax({
                    url: apiBaseUrl + 'GetDepartments/' + sectorId, // Construct the URL
                    type: 'GET',
                    success: function (data) {
                        $('#departId').empty().append('<option value="">Select Department</option>'); // Clear the dropdown
                        console.log(data);
                        // Log data to console


                        if (data && Array.isArray(data.$values)) {
                            $.each(data.$values, function (i, item) {
                                console.log("Adding option:", item.value, item.text); // Log for debugging
                                $('#departId').append('<option value="' + item.value + '">' + item.text + '</option>');
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("Failed to fetch departments:", error);
                        $('#departId').empty().append('<option value="">Error fetching departments</option>');
                    }
                });
            });

            $('#departId').change(function () {
                var departmentId = $(this).val();
                $.get(apiBaseUrl + 'getMoraqaba/' + departmentId, function (data) {
                    $('#muraqabaId').empty().append('<option value="">Select Moraqaba</option>');

                    if (data.$values && data.$values.length > 0) {
                        // Populate options and show the dropdown if data exists
                        $.each(data.$values, function (i, item) {
                            $('#muraqabaId').append('<option value="' + item.value + '">' + item.text + '</option>');
                        });
                        $('#muraqabaId').show(); // Show the dropdown
                    } else {
                        $('#muraqabaId').hide(); // Hide the dropdown if no data
                    }
                });
            });

            $('#muraqabaId').change(function () {
                var moraqabaId = $(this).val();
                $.get(apiBaseUrl + 'getQism/' + moraqabaId, function (data) {
                    $('#qismId').empty().append('<option value="">Select Qism</option>');

                    if (data.$values && data.$values.length > 0) {
                        // Populate options and show the dropdown if data exists
                        $.each(data.$values, function (i, item) {
                            $('#qismId').append('<option value="' + item.value + '">' + item.text + '</option>');
                        });
                        $('#qismId').show(); // Show the dropdown
                    } else {
                        $('#qismId').hide(); // Hide the dropdown if no data
                    }
                });
            });

        });
