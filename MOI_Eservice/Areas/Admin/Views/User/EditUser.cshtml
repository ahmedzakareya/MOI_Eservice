@section Scripts {

    <script>
        function showLoader() {
            $('#loader').show(); // Assuming you have a loader element
        }

        function hideLoader() {
            $('#loader').hide();
        }

        $(document).ready(function () {
            var apiBaseUrl = '@ViewBag.ApiBaseUrl'; // Get the dynamic base URL
            document.addEventListener("DOMContentLoaded", function () {
                fetchSectors();
            });

            function fetchSectors() {
                $.ajax({
                    url: apiBaseUrl + 'GetSectors',
                    type: 'GET',
                    success: function (data) {
                        var sectorDropdown = $('#sectorId');
                        sectorDropdown.empty(); // Clear existing options

                        sectorDropdown.append('<option disabled selected="selected">--إختر القطاع--</option>');

                        // Check if data is valid
                        if (data && Array.isArray(data.$values)) {
                            $.each(data.$values, function (i, item) {
                                sectorDropdown.append('<option value="' + item.value + '">' + item.text + '</option>');
                            });
                        } else {
                            console.error("Data format is incorrect or no sectors found");
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("Failed to fetch sectors:", error);
                        $('#sectorId').append('<option value="">Error fetching sectors</option>');
                    }
                });
            }

            // Handle Sector dropdown change
            $('#sectorId').change(function () {
                var sectorId = $(this).val();
                $('#departId').empty().append('<option value="">Select Department</option>');
                $('#muraqabaId').empty().append('<option value="">Select Muraqaba</option>');
                $('#qismId').empty().append('<option value="">Select Qism</option>');
                $.ajax({
                    url: apiBaseUrl + 'GetDepartments/' + sectorId,
                    type: 'GET',
                    success: function (data) {
                        $('#departId').empty().append('<option value="">Select Department</option>'); // Clear Department dropdown
                        if (data && Array.isArray(data.$values)) {
                            $.each(data.$values, function (i, item) {
                                $('#departId').append('<option value="' + item.value + '">' + item.text + '</option>');
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("Failed to fetch departments:", error);
                        $('#departId').empty().append('<option value="">Error fetching departments</option>');
                    }
                });
            });

            // Handle Department dropdown change
            $('#departId').change(function () {
                var departmentId = $(this).val();
                $.get(apiBaseUrl + 'getMoraqaba/' + departmentId, function (data) {
                    $('#muraqabaId').empty().append('<option value="">Select Moraqaba</option>'); // Clear Moraqaba dropdown

                    if (data.$values && data.$values.length > 0) {
                        $.each(data.$values, function (i, item) {
                            $('#muraqabaId').append('<option value="' + item.value + '">' + item.text + '</option>');
                        });
                        $('#muraqabaId').show(); // Show if data exists
                    } else {
                        $('#muraqabaId').hide(); // Hide if no data
                    }
                }).fail(function () {
                    console.error("Failed to fetch moraqaba.");
                    $('#muraqabaId').empty().append('<option value="">Error fetching moraqaba</option>').hide();
                });
            });

            // Handle Moraqaba dropdown change
            $('#muraqabaId').change(function () {
                var moraqabaId = $(this).val();
                $.get(apiBaseUrl + 'getQism/' + moraqabaId, function (data) {
                    $('#qismId').empty().append('<option value="">Select Qism</option>'); // Clear Qism dropdown

                    if (data.$values && data.$values.length > 0) {
                        $.each(data.$values, function (i, item) {
                            $('#qismId').append('<option value="' + item.value + '">' + item.text + '</option>');
                        });
                        $('#qismId').show(); // Show if data exists
                    } else {
                        $('#qismId').hide(); // Hide if no data
                    }
                }).fail(function () {
                    console.error("Failed to fetch qism.");
                    $('#qismId').empty().append('<option value="">Error fetching qism</option>').hide();
                });
            });

            let checkboxId = `permission_${id}`;
            let checkbox = document.getElementById(checkboxId);
            console.log(checkboxId);
            console.log(checkbox);
            if (checkbox) {
                // Perform actions with the checkbox
                checkbox.checked = true; // or false, depending on what you want to do
            }
        });



    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/crypto-js/4.1.1/crypto-js.min.js"></script>

    <script>
        $(document).ready(function () {
            // Form submission handler
            $('#EditUserForm').submit(function (e) {
                e.preventDefault(); // Prevent default form submission

                // Collect user data from the form
                var userData = {
                    User: {
                        UserId: $("#userId").val(),
                        CivilId: $('#civilIdInput').val(),
                        Username: $('#civilIdInput').val(), // Assuming CivilId as Username
                        Name: $('#fullName').val(),
                        Mobile: $('#mobile').val(),
                        Email: $('#email').val(),
                        SectorId: $('#sectorId').val(),
                        DepId: $('#departId').val(),
                        MuraqabaId: $('#muraqabaId').val() || null, // Handle optional fields
                        QismId: $('#qismId').val() || null // Handle optional fields
                    }
                };

                // API Base URL from ViewBag
                var apiBaseUrl = '@ViewBag.ApiBaseUrl';

                // Step 1: Edit User
                $.ajax({
                    url: apiBaseUrl + 'Edit/',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(userData),
                    success: function (response) {
                        alert(response.message);

                        // Step 2: Assign Permissions and Roles after editing the user
                        var userId = response.userId; // Assuming the response contains userId
                        if (userId) {
                            assignPermissionsAndRoles(userId, apiBaseUrl);
                        } else {
                            alert("User ID not found in the response.");
                        }
                    },
                    error: function (xhr) {
                        console.error("Failed to edit user:", xhr.responseText);
                        alert("Failed to edit user: " + xhr.responseText);
                    }
                });
            });

            // Function to assign permissions and roles
            function assignPermissionsAndRoles(userId, apiBaseUrl) {
                // Collect selected role IDs
                var selectedRoleIds = [];
                $('input[name="SelectedRoleIds"]:checked').each(function () {
                    selectedRoleIds.push($(this).val());
                });

                // Prepare the data for the API call
                var dataToSend = {
                    UserId: userId,
                    RoleIds: selectedRoleIds
                };

                // Step 3: Assign roles to the user
                $.ajax({
                    url: apiBaseUrl + 'EditAssignRoleToUser/',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(dataToSend),
                    success: function () {
                        console.log("Roles assigned successfully.");
                        alert("Roles assigned successfully.");
                        // Redirect to the User List page
                        setTimeout(function () {
                            window.location.href = '@Url.Action("Index", "User", new { area = "Admin" })';
                        }, 2000); // Delay for better UX
                    },
                    error: function (xhr) {
                        console.error("Failed to assign roles:", xhr.responseText);
                        alert("Failed to assign roles: " + xhr.responseText);
                    }
                });
            }
        });
    </script>


    @* Updated script to load and check permissions and roles *@
    <script>
        $(document).ready(function () {

            loadRoles();





            // Load roles from the API
            function loadRoles() {
                var apiBaseUrl = '@ViewBag.ApiBaseUrl';
                $.ajax({
                    url: apiBaseUrl + 'GetAllRoles/',
                    method: 'GET',
                    success: function (data) {
                        const selectedRoles = @Html.Raw(Json.Serialize(Model.SelectedRolesIds));
                        populateRoles(data.$values, selectedRoles);
                    },
                    error: function (xhr, status, error) {
                        console.error("Error fetching roles:", error);
                    }
                });
            }

            // Populate roles and check if they are already selected
            function populateRoles(roles, selectedRoles) {
                const rolesContainer = $('#RolesContainer');
                rolesContainer.empty();

                let row;
                $.each(roles, function (index, role) {
                    if (index % 3 === 0) {
                        row = $('<div class="row mb-2"></div>');
                        rolesContainer.append(row);
                    }

                    const isChecked = selectedRoles.includes(role.roleId);

                    const checkbox = `
                                    <div class="col-md-4">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="SelectedRoleIds" value="${role.roleId}" id="role-${index}" ${isChecked ? 'checked' : ''}>
                                            <label class="form-check-label text-dark fs-5" for="role-${index}">
                                                ${role.roleName}
                                            </label>
                                        </div>
                                    </div>`;

                    row.append(checkbox);
                });
            }
        });
    </script>


