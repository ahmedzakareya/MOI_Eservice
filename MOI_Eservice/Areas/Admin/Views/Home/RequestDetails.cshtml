@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>


    <script>
        document.addEventListener('DOMContentLoaded', function () {
            console.log('Page Loaded: Initializing scripts.');

            const initialStatusId = parseInt('@(Model.RequestDVM.RequestStatusId)');
            console.log('Initial Status ID:', initialStatusId);

            initializePage(initialStatusId);
        });

        // Initialize the page based on the initial status ID
        function initializePage(statusId) {
            checkInitialStatusForUploadFile(statusId);
            checkStatusAndShowUploadForAttachment(statusId);
            updateLicenseContent(statusId, '@(Model.RequestDVM.Licno ?? "N/A")');
            disableButtonForWaitingPayment(statusId);
            hideButtonsForCertainStatuses(statusId);
            hideRefuseButtonForCertainStatuses(statusId);
        }

        // Handle moving to the next status
        async function moveToNextStatus(element) {
            try {
                const requestId = element.getAttribute('data-request-id');
                const serviceId = element.getAttribute('data-service-id');
                const activityTypeId = element.getAttribute('data-activity-type-id');
                const currentStatusId = parseInt(element.getAttribute('data-status-id'));
                const reqTypeId = element.getAttribute('data-reqtype-id');
                // const actionText = element.textContent.trim();
                // const isRefuseAction = currentStatusId === 9;

                const reqNo = element.getAttribute('data-reqno');
                const note = document.getElementById("RequestNote").value.trim();

                if (currentStatusId === 9 && note === "") {
                    alert('Please enter a reason for refusal.');
                    return;
                }

                const isRefuseAction = currentStatusId === 9
                    ? "Are you sure you want to refuse this request?"
                    : `Move to the next step?`;
                if (!confirm(isRefuseAction)) return;

                const formData = createFormData(requestId, currentStatusId, reqTypeId, activityTypeId, reqNo, note);

                // Handle file upload if required
                if (currentStatusId === 7) {
                    if (!handleFileUpload(formData)) return;
                }

                // Call the API to update the status
                const response = await fetch('SaveData/', {
                    method: 'POST',
                    body: formData,
                });

                if (!response.ok) throw new Error('Failed to modify request status');

                const result = await response.json();
                if (typeof result.updatedRequest === 'string') {
                    result.updatedRequest = JSON.parse(result.updatedRequest);
                }

                console.log(result);
                console.log(result.updatedRequest);
                const nextStatusId = result.updatedRequest.statusid; // Updated status ID
                const nextStatusName = result.updatedRequest.statusname || "Unknown Status";
                const statusElement = document.querySelector(`#RequestStatusbutton[data-request-id="${requestId}"]`);
                element.textContent = isRefuseAction ? "Request Refused" : nextStatusName;
                element.setAttribute("data-status-id", nextStatusId);

                updateStatusUI(result.updatedRequest);

                alert(result.message || "Status updated successfully.");
            } catch (error) {
                console.error("Error updating status:", error);
                alert("An error occurred while updating the status.");
            }
        }

        // Create form data for API submission
        function createFormData(requestId, currentStatusId, reqTypeId, activityTypeId, reqNo, note) {
            const formData = new FormData();
            formData.append("RequestId", requestId);
            formData.append("ReqStatusId", currentStatusId);
            formData.append("ReqTypeId", reqTypeId);
            formData.append("ActivityTypeId", activityTypeId);
            formData.append("ReqNo", reqNo);
            formData.append("Note", note);
            return formData;
        }

        // Handle file upload for specific statuses
        function handleFileUpload(formData) {
            const fileInput = document.getElementById('pdfFileInput');
            const fileNameInput = document.getElementById('fileNameInput');
            if (fileInput && fileInput.files.length > 0) {
                const file = fileInput.files[0];
                const filename = fileNameInput ? fileNameInput.value : file.name;

                formData.append('pdfFile', file);
                formData.append('fileName', filename);

                console.log('File to be uploaded:', file);
                createAttachmentCard(file, filename);
                return true;
            } else {
                alert('Please select a PDF file to upload.');
                return false;
            }
        }

        // Show the upload section for the initial status
        function checkInitialStatusForUploadFile(statusId) {
            const uploadSection = document.getElementById('uploadSection');
            if (uploadSection) {
                uploadSection.style.display = statusId === 7 ? 'block' : 'none';
            }
        }

        // Show or hide the attachment section based on status
        function checkStatusAndShowUploadForAttachment(statusId) {
            const attachmentSection = document.getElementById('attachmentsSection');
            if (attachmentSection) {
                attachmentSection.style.display = statusId === 7 || statusId === 8 ? 'block' : 'none';
            }
        }

        // Hide buttons for certain statuses
        function hideButtonsForCertainStatuses(statusId) {
            const statusButtons = document.getElementById('statusButtons');
            if (statusButtons) {
                statusButtons.style.display = statusId === 9 || statusId === 8 ? 'none' : 'block';
            }
        }

        // Disable button when status is "Waiting for Payment" (5)
        function disableButtonForWaitingPayment(statusId) {
            const statusButtons = document.getElementById('statusButtons');
            if (statusId === 5 && statusButtons) {
                statusButtons.disabled = true;
                statusButtons.style.pointerEvents = "none";
                statusButtons.textContent = "Payment Pending";
                statusButtons.style.backgroundColor = "#f8d7da"; // Light red background
                statusButtons.style.color = "#721c24"; // Dark red text
                statusButtons.style.borderColor = "#f5c6cb"; // Light red border
                statusButtons.style.cursor = "not-allowed";
            }
        }

        // Hide refuse button for certain statuses
        function hideRefuseButtonForCertainStatuses(statusId) {
            const refuseButton = document.getElementById('RefuseRequestbutton');
            if (statusId === 7 || statusId === 8 || statusId === 11) {
                refuseButton.style.display = "none";
            }
        }

        // Update the status UI dynamically
        function updateStatusUI(updatedRequestData) {
            const updatedStatusId = updatedRequestData.statusid;
            const updatedStatusName = updatedRequestData.statusname;

            let statusColorClass = '';
            switch (updatedStatusId) {
                case 1: statusColorClass = 'badge badge-lg badge-light-primary d-inline'; break;
                case 2: statusColorClass = 'badge badge-lg badge-light-info d-inline'; break;
                case 3: statusColorClass = 'badge badge-lg badge-info d-inline'; break;
                case 4: statusColorClass = 'badge badge-lg badge-light-warning d-inline'; break;
                case 5: statusColorClass = 'badge badge-lg badge-light-info d-inline'; break;
                case 6: statusColorClass = 'badge badge-lg badge-light-success d-inline'; break;
                case 7: statusColorClass = 'badge badge-lg badge-light-success d-inline'; break;
                case 8: statusColorClass = 'badge badge-lg badge-light-danger d-inline'; break;
                default: statusColorClass = 'badge badge-lg badge-light-default d-inline'; break;
            }

            const statusMainRequest = document.getElementById("RequestStatusMain");
            const buttonText = document.getElementById('RequestStatusbutton');
            const buttonStatus2 = document.getElementById('status4');
            const buttonStatus3 = document.getElementById('statusname3');


            if (statusMainRequest) {
                statusMainRequest.textContent = updatedStatusName;
                buttonStatus2.textContent = updatedStatusName;
                buttonStatus3.textContent = updatedStatusName;
                statusMainRequest.className = statusColorClass;


                if (buttonText) {
                    buttonText.textContent = updatedStatusName;
                    buttonText.className = `btn ${statusColorClass}`;
                }
            }

            checkStatusAndShowUploadForAttachment(updatedStatusId);
            checkInitialStatusForUploadFile(updatedStatusId);
            disableButtonForWaitingPayment(updatedStatusId);
            updateLicenseContent(updatedStatusId, updatedRequestData.licno);
        }

        // Create an attachment card dynamically
        function createAttachmentCard(file, fileName) {
            const attachmentSection = document.getElementById('attachmentsSection');
            const newCard = document.createElement('div');
            newCard.classList.add('card', 'shadow-sm', 'pt-4', 'mb-6', 'mb-xl-9');
            newCard.innerHTML = `
                            <div class="card-header collapsible cursor-pointer rotate" data-bs-toggle="collapse" data-bs-target="#newAttach">
                                <div class="card-title flex-column">
                                    <span class="d-inline-block position-relative ms-2">
                                        <span class="d-inline-block mb-2 fw-bold">${fileName}</span>
                                        <span class="d-inline-block position-absolute h-3px bottom-0 end-0 start-0 bg-primary translate rounded"></span>
                                    </span>
                                </div>
                                <div class="card-toolbar rotate-180">
                                    <i class="ki-duotone ki-down fs-1"></i>
                                </div>
                            </div>
                            <div id="newAttach" class="collapse">
                                <div class="card-body">
                                    <iframe src="${URL.createObjectURL(file)}" style="width: 100%; height: 500px;"></iframe>
                                </div>
                                <div class="card-footer">
                                    <a href="${URL.createObjectURL(file)}" class="btn btn-light-primary btn-sm" target="_blank">
                                        <i class="ki-outline ki-book-open fs-3"></i> Open in a new tab
                                    </a>
                                </div>
                            </div>
                        `;
            attachmentSection.appendChild(newCard);
        }

        // Update license content dynamically
        function updateLicenseContent(statusId, licensesNo) {
            const licenseCell = document.getElementById('licenseCell');
            if (licenseCell) {
                licenseCell.innerHTML = statusId === 7 || statusId === 8
                    ? `<span class="text-gray-800 badge badge-light-success">${licensesNo}</span>`
                    : "";
            }
        }
    </script>





}
