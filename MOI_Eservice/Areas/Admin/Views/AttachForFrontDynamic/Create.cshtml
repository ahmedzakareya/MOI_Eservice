@model FileUploadConfigurationsFront

@{
    ViewBag.Title = "File Upload Configurations";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutEserviceTourism.cshtml";
}


<!--begin::Content wrapper-->
<div class="d-flex flex-column flex-column-fluid">
    <!--begin::Toolbar-->
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2">
        <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex align-items-stretch">
            <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
                <div class="page-title d-flex flex-column justify-content-center gap-1 me-3">
                    <h1 class="page-heading d-flex flex-column justify-content-center text-gray-900 fw-bold fs-3 m-0">Add File Upload Configuration</h1>
                    <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                        <li class="breadcrumb-item text-muted">
                            <a asp-action="Index" asp-controller="Admin" class="text-muted text-hover-primary">Home</a>
                        </li>
                        <li class="breadcrumb-item">
                            <span class="bullet bg-gray-500 w-5px h-2px"></span>
                        </li>
                        <li class="breadcrumb-item text-muted">Add File Upload Configuration</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
    <!--end::Toolbar-->

    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div id="kt_app_content_container" class="app-container container-fluid">
            <div class="card">
                <div class="card-body p-lg-10">
                    <form class="form" id="createFileConfigForm" method="post" asp-action="Create">
                        <div class="row">
                            <div class="col-md-6 mb-7 fv-row">
                                <label class="fs-6 fw-semibold mb-2">Field Name</label>
                                <input type="text" class="form-control form-control-solid" asp-for="FieldName" required />
                            </div>

                            <div class="col-md-6 mb-7 fv-row">
                                <label class="fs-6 fw-semibold mb-2">Label</label>
                                <input type="text" class="form-control form-control-solid" asp-for="Label" required />
                            </div>
                        </div>
                        <div class="col-md-6 mb-7 fv-row">
                            <label class="fs-6 fw-semibold mb-2">حالة الطلب</label>
                            <select asp-for="ReqStatusId" asp-items="ViewBag.StatusList" class="form-select form-select-solid">
                                <option value="">-- اختر حالة الطلب --</option>
                            </select>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-7 fv-row">
                                <label class="fs-6 fw-semibold mb-2">Max File Size (MB)</label>
                                <input type="number" class="form-control form-control-solid" asp-for="MaxFileSize" />
                            </div>

                            <div class="col-md-6 mb-7 fv-row">
                                <label class="fs-6 fw-semibold mb-2">Allowed File Types</label>
                                <input type="text" class="form-control form-control-solid" asp-for="AllowedFileTypes" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-7 fv-row">
                                <label class="fs-6 fw-semibold mb-2">Required</label>
                                <input type="checkbox" class="form-check-input" asp-for="IsRequired" />
                            </div>

                            <div class="col-md-6 mb-7 fv-row">
                                <label class="fs-6 fw-semibold mb-2">View Type</label>
                                <input type="text" class="form-control form-control-solid" asp-for="ViewType" required />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 fv-row">
                                <button type="submit" class="btn btn-primary">Save</button>
                                <a asp-action="Index" class="btn btn-secondary">Back</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<!--end::Content wrapper-->
