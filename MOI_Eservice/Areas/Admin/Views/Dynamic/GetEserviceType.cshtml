@model IEnumerable<EserviceTypesLookup>

@{
    ViewBag.Title = "Eservice Types Management";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutEserviceTourism.cshtml";
}

<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">
        <div class="card card-flush">
            <div class="card-header mt-6">
                <div class="card-title">
                    <div class="d-flex align-items-center position-relative my-1 me-5">
                        <i class="ki-outline ki-magnifier fs-3 position-absolute ms-5"></i>
                        <input type="text" id="eserviceTypeSearch" class="form-control form-control-solid w-250px ps-13" placeholder="Search Eservice Types" />
                    </div>
                </div>
                <div class="card-toolbar">
                    <button type="button" class="btn btn-light-primary" data-bs-toggle="modal" data-bs-target="#kt_modal_add_eservice_type">
                        <i class="ki-outline ki-plus-square fs-3"></i>Add Eservice Type
                    </button>
                </div>
            </div>
            <div class="card-body pt-0">
                <table class="table align-middle table-row-dashed fs-6 gy-5 mb-0" id="eserviceTypesTable">
                    <thead>
                        <tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase gs-0">
                            <th>#</th>
                            <th>Name (AR)</th>
                            <th>Name (EN)</th>
                            <th>URL</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="fw-semibold text-gray-600">
                        @if (Model != null && Model.Any())
                        {
                            int serial = 0;
                            foreach (var type in Model)
                            {
                                serial++;
                                <tr>
                                    <td>@serial</td>
                                    <td>@type.EserviceTypeAr</td>
                                    <td>@type.EserviceTypeEn</td>
                                    <td>@type.Url</td>
                                    <td class="text-end">
                                        <button class="btn btn-icon btn-active-light-primary w-30px h-30px me-3 edit-eservice-type" data-id="@type.Id" data-bs-toggle="modal" data-bs-target="#kt_modal_edit_eservice_type">
                                            <i class="ki-outline ki-setting-3 fs-3"></i>
                                        </button>
                                        <button class="btn btn-icon btn-active-light-primary w-30px h-30px delete-eservice-type" data-id="@type.Id">
                                            <i class="ki-outline ki-trash fs-3"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" class="text-center text-muted">No eservice types available.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add Modal -->
<div class="modal fade" id="kt_modal_add_eservice_type" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="fw-bold">Add Eservice Type</h2>
                <div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal">
                    <i class="ki-outline ki-cross fs-1"></i>
                </div>
            </div>
            <div class="modal-body scroll-y mx-5 my-7">
                <form id="addEserviceTypeForm">
                    <div class="fv-row mb-7">
                        <label class="form-label">Name (Ar)</label>
                        <input class="form-control form-control-solid" id="EserviceTypeAr" required />
                    </div>
                    <div class="fv-row mb-7">
                        <label class="form-label">Name (En)</label>
                        <input class="form-control form-control-solid" id="EserviceTypeEn" required />
                    </div>
                    <div class="fv-row mb-7">
                        <label class="form-label">URL</label>
                        <input class="form-control form-control-solid" id="EserviceTypeUrl" />
                    </div>
                    <div class="text-center pt-15">
                        <button type="button" class="btn btn-primary" id="submitEserviceType">Submit</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="kt_modal_edit_eservice_type" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="fw-bold">Edit Eservice Type</h2>
                <div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal">
                    <i class="ki-outline ki-cross fs-1"></i>
                </div>
            </div>
            <div class="modal-body scroll-y mx-5 my-7">
                <form id="editEserviceTypeForm">
                    <input type="hidden" id="editEserviceTypeId" />
                    <div class="fv-row mb-7">
                        <label class="form-label">Name (Ar)</label>
                        <input class="form-control form-control-solid" id="editEserviceTypeAr" required />
                    </div>
                    <div class="fv-row mb-7">
                        <label class="form-label">Name (En)</label>
                        <input class="form-control form-control-solid" id="editEserviceTypeEn" required />
                    </div>
                    <div class="fv-row mb-7">
                        <label class="form-label">URL</label>
                        <input class="form-control form-control-solid" id="editEserviceTypeUrl" />
                    </div>
                    <div class="text-center pt-15">
                        <button type="button" class="btn btn-primary" id="submitEditEserviceType">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const apiBaseUrl = '@ViewBag.ApiBaseUrl';

        document.getElementById("submitEserviceType").addEventListener("click", async function () {
            const data = {
                EserviceTypeAr: document.getElementById("EserviceTypeAr").value,
                EserviceTypeEn: document.getElementById("EserviceTypeEn").value,
                Url: document.getElementById("EserviceTypeUrl").value
            };
            const response = await fetch(`${apiBaseUrl}CreateEserviceTypes`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(data)
            });
            if (response.ok) location.reload();
            else alert("Failed to add");
        });

        document.querySelectorAll(".edit-eservice-type").forEach(btn => {
            btn.addEventListener("click", async () => {
                const id = btn.getAttribute("data-id");
                const res = await fetch(`${apiBaseUrl}GetByIdEserviceTypes?id=${id}`);
                const data = await res.json();
                document.getElementById("editEserviceTypeId").value = data.id;
                document.getElementById("editEserviceTypeAr").value = data.eserviceTypeAr;
                document.getElementById("editEserviceTypeEn").value = data.eserviceTypeEn;
                document.getElementById("editEserviceTypeUrl").value = data.url;
            });
        });

        document.getElementById("submitEditEserviceType").addEventListener("click", async () => {
            const data = {
                Id: document.getElementById("editEserviceTypeId").value,
                EserviceTypeAr: document.getElementById("editEserviceTypeAr").value,
                EserviceTypeEn: document.getElementById("editEserviceTypeEn").value,
                Url: document.getElementById("editEserviceTypeUrl").value
            };
            const response = await fetch(`${apiBaseUrl}UpdateEserviceTypes?id=${data.Id}`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(data)
            });
            if (response.ok) location.reload();
            else alert("Failed to update");
        });

        document.querySelectorAll(".delete-eservice-type").forEach(button => {
            button.addEventListener("click", async () => {
                if (!confirm("Are you sure you want to delete this eservice type?")) return;
                const id = button.getAttribute("data-id");
                const response = await fetch(`${apiBaseUrl}DeleteEserviceTypes?id=${id}`, { method: "POST" });
                if (response.ok) location.reload();
                else alert("Failed to delete");
            });
        });

        document.getElementById("eserviceTypeSearch").addEventListener("keyup", function () {
            const searchText = this.value.toLowerCase();
            document.querySelectorAll("#eserviceTypesTable tbody tr").forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(searchText) ? "" : "none";
            });
        });
    </script>
}
