@model EserviceTypeBranch

@{
    ViewBag.Title = "Edit Eservice Type Branch";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutEserviceTourism.cshtml";
}

<div class="container-fluid mt-5">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Edit Eservice Type Branch</h3>
        </div>
        <div class="card-body">
            <form id="branchForm">
                <input type="hidden" id="Id" value="@Model.Id" />

                <div class="mb-4">
                    <label for="EserviceTypeBranchAr" class="form-label">Branch Name (AR)</label>
                    <input type="text" class="form-control" id="EserviceTypeBranchAr" value="@Model.EserviceTypeBranchAr" />
                </div>

                <div class="mb-4">
                    <label for="EserviceTypeBranchEn" class="form-label">Branch Name (EN)</label>
                    <input type="text" class="form-control" id="EserviceTypeBranchEn" value="@Model.EserviceTypeBranchEn" />
                </div>

                <div class="mb-4">
                    <label for="ActivityTypesId" class="form-label">Activity Type</label>
                    @Html.DropDownList("ActivityTypesId", ViewBag.ActivityTypes as List<SelectListItem>, Model.ActivityTypesId.ToString(), new { @class = "form-select" })
                </div>

                <div class="mb-4">
                    <label for="RequestTypeId" class="form-label">Request Type</label>
                    @Html.DropDownList("RequestTypeId", ViewBag.RequestTypes as List<SelectListItem>, Model.RequestTypeId.ToString(), new { @class = "form-select" })
                </div>

                <div class="mb-4">
                    <label for="Url" class="form-label">URL</label>
                    <input type="text" class="form-control" id="Url" value="@Model.Url" />
                </div>

                <div class="mb-4">
                    <label for="Fees" class="form-label">Fees</label>
                    <input type="number" step="0.001" class="form-control" id="Fees" value="@Model.Fees" />
                </div>

                <div class="mb-4">
                    <label for="Sort" class="form-label">Sort Order</label>
                    <input type="number" class="form-control" id="Sort" value="@Model.Sort" />
                </div>

                <div class="mb-4">
                    <label for="Status" class="form-label">Status</label>
                    @Html.DropDownList("Status", new List<SelectListItem> {
                    new SelectListItem { Text = "Active", Value = "true", Selected = Model.Status },
                    new SelectListItem { Text = "Inactive", Value = "false", Selected = !Model.Status }
                    }, new { @class = "form-select" })
                </div>

                <div class="text-end">
                    <button type="submit" class="btn btn-primary">Update</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("branchForm").addEventListener("submit", async function (e) {
            e.preventDefault();

            const data = {
                Id: parseInt(document.getElementById("Id").value),
                EserviceTypeBranchAr: document.getElementById("EserviceTypeBranchAr").value,
                EserviceTypeBranchEn: document.getElementById("EserviceTypeBranchEn").value,
                Url: document.getElementById("Url").value,
                Fees: parseFloat(document.getElementById("Fees").value),
                Sort: parseInt(document.getElementById("Sort").value) || 0,
                ActivityTypesId: parseInt(document.getElementById("ActivityTypesId").value),
                RequestTypeId: parseInt(document.getElementById("RequestTypeId").value),
                Status: document.getElementById("Status").value === "true",
                IsDeleted: false,
                CreatedOn: new Date().toISOString()
            };
            console.log(data);
            const response = await fetch('@ViewBag.ApiBaseUrl' + "UpdateTypeBranch?Id =" + data.Id, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            if (response.ok) {
                alert("Updated successfully!");
                window.location.href = '/Admin/dynamic/GetEserviceTypeBranch';
            } else {
                alert("Failed to update.");
            }
        });
    </script>
}
