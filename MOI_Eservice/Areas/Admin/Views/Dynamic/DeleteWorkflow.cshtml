@model WorkFlowVM

@{
    ViewBag.Title = "Delete Workflow";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutEserviceTourism.cshtml";
}

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2">
        <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex align-items-stretch">
            <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
                <div class="page-title d-flex flex-column justify-content-center gap-1 me-3">
                    <h1 class="page-heading d-flex flex-column justify-content-center text-gray-900 fw-bold fs-3 m-0">Delete Workflow</h1>
                    <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                        <li class="breadcrumb-item text-muted">
                            <a asp-action="Index" asp-controller="Home" class="text-muted text-hover-primary">Home</a>
                        </li>
                        <li class="breadcrumb-item">
                            <span class="bullet bg-gray-500 w-5px h-2px"></span>
                        </li>
                        <li class="breadcrumb-item text-muted">Delete Workflow</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div id="kt_app_content_container" class="app-container container-fluid">
            <div class="card">
                <div class="card-body p-lg-10">
                    <div class="alert alert-warning">
                        Are you sure you want to delete this workflow? This action cannot be undone.
                    </div>

                    <div class="row mb-7">
                        <div class="col-md-6">
                            <div class="fs-6 fw-bold mb-2">Service:</div>
                            <div class="text-gray-600">@Model.ServiceName</div>
                        </div>
                        @* <div class="col-md-6">
                            <div class="fs-6 fw-bold mb-2">Activity Type:</div>
                            <div class="text-gray-600">@Model.ActivityTypeName</div>
                        </div> *@
                    </div>

                    <div class="row mb-7">
                        <div class="col-md-6">
                            <div class="fs-6 fw-bold mb-2">Request Type:</div>
                            <div class="text-gray-600">@Model.RequestTypeName</div>
                        </div>
                        <div class="col-md-6">
                            <div class="fs-6 fw-bold mb-2">Current Status:</div>
                            <div class="text-gray-600">@Model.CurrentStatusName</div>
                        </div>
                    </div>

                    <div class="row mb-7">
                        <div class="col-md-6">
                            <div class="fs-6 fw-bold mb-2">Next Status:</div>
                            <div class="text-gray-600">@Model.NextStatusName</div>
                        </div>
                    </div>

                    <form id="DeleteWorkflowForm" method="post" asp-action="DeleteWorkflow">
                        <input type="hidden" name="Id" value="@Model.Id" />
                        <div class="d-flex justify-content-start gap-3">
                            <button type="submit" class="btn btn-danger">Delete</button>
                            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#DeleteWorkflowForm').submit(function (e) {
                e.preventDefault(); // Prevent default form submission

                if (!confirm("Are you sure you want to delete this workflow?")) {
                    return;
                }

                // Get the Workflow ID
                var workflowId = $("input[name='Id']").val();
                var apiBaseUrl = '@ViewBag.ApiBaseUrl';

                // Call the API to delete the workflow
                $.ajax({
                    url: apiBaseUrl + 'DeleteWorkflow/' + workflowId,
                    type: 'POST',
                    success: function (response) {
                        alert(response.message || "Workflow deleted successfully.");
                        window.location.href = '@Url.Action("GetAllWorkFlows", "Dynamic", new { area = "Admin" })';
                    },
                    error: function (xhr) {
                        console.error("Error deleting workflow:", xhr.responseText);
                        alert("Failed to delete workflow. Please try again.");
                    }
                });
            });
        });
    </script>
}
