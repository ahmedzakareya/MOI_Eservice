@model IEnumerable<MoiEserviceLicenseInfo>

@{
    ViewBag.Title = "License Info List";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutEserviceTourism.cshtml";
}

<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">
        <div class="card card-flush">
            <div class="card-header mt-6">
                <div class="card-title">
                    <div class="d-flex align-items-center position-relative my-1 me-5">
                        <i class="ki-outline ki-magnifier fs-3 position-absolute ms-5"></i>
                        <input type="text" id="licenseInfoSearch" class="form-control form-control-solid w-250px ps-13" placeholder="Search License Info" />
                    </div>
                </div>
                <div class="card-toolbar">
                    <a href="@Url.Action("CreateLicencesInfo", "Dynamic", new { area = "Admin" })" class="btn btn-light-primary">
                        <i class="ki-outline ki-plus-square fs-3"></i> Add License Info
                    </a>
                </div>
            </div>
            <div class="card-body pt-0">
                <table class="table align-middle table-row-dashed fs-6 gy-5 mb-0" id="licenseInfoTable">
                    <thead>
                        <tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase gs-0">
                            <th>#</th>
                            <th>Name</th>
                            <th>Activity</th>
                            <th>Request Type</th>
                           

                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="fw-semibold text-gray-600">
                        @if (Model != null && Model.Any())
                        {
                            int serial = 0;
                            foreach (var item in Model)
                            {
                                serial++;
                                <tr>
                                    <td>@serial</td>
                                    <td>@item.Name</td>
                                    <td>@item.ActivityTypesLookup?.NameAr</td>
                                    <td>@item.RequestsTypesLookup?.NameAr</td>
                                   
                                    

                                    <td class="text-end">
                                        <a href="@Url.Action("EditLicencesInfo", "dynamic", new { area = "Admin", id = item.Id })" class="btn btn-icon btn-active-light-primary w-30px h-30px me-3">
                                            <i class="ki-outline ki-setting-3 fs-3"></i>
                                        </a>
                                        <button class="btn btn-icon btn-active-light-danger w-30px h-30px delete-license-info" data-id="@item.Id">
                                            <i class="ki-outline ki-trash fs-3"></i>
                                        </button>
                                        <form asp-action="CloneAndSave" asp-controller="Dynamic" asp-route-id="@item.Id" method="post" style="display:inline;">
                                            <button type="submit" class="btn btn-sm btn-outline-primary">
                                                <i class="fa fa-copy"></i> نسخ
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" class="text-center text-muted">No license info available.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const apiBaseUrl = '@ViewBag.ApiBaseUrl';
        document.getElementById("licenseInfoSearch").addEventListener("keyup", function () {
            const searchText = this.value.toLowerCase();
            document.querySelectorAll("#licenseInfoTable tbody tr").forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(searchText) ? "" : "none";
            });
        });

        document.querySelectorAll(".delete-license-info").forEach(btn => {
            btn.addEventListener("click", async () => {
                if (!confirm("Are you sure you want to delete this license info?")) return;
                const id = btn.dataset.id;
                const response = await fetch(apiBaseUrl + "DeleteLicenseInfo?id=" + id, { method: 'POST' });
                if (response.ok) {
                    alert("Deleted successfully");
                    location.reload();
                } else {
                    alert("Failed to delete");
                }
            });
        });
    </script>
}
