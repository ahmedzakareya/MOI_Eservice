@model WorkFlowActionButtonVM

@{
    ViewBag.Title = "تحديث زر الإجراء";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutEserviceTourism.cshtml";
}

<div class="d-flex flex-column flex-column-fluid">
    <!--begin::Toolbar-->
    <div class="app-toolbar pt-6 pb-2">
        <div class="app-container container-fluid d-flex align-items-stretch">
            <div class="d-flex flex-stack flex-wrap gap-4 w-100">
                <div class="page-title d-flex flex-column justify-content-center gap-1 me-3">
                    <h1 class="text-gray-900 fw-bold fs-3 m-0">تحديث زر الإجراء</h1>
                    <ul class="breadcrumb fw-semibold fs-7 my-0">
                        <li class="breadcrumb-item text-muted">
                            <a asp-action="Index" asp-controller="Home" class="text-hover-primary">الرئيسية</a>
                        </li>
                        <li class="breadcrumb-item">
                            <span class="bullet bg-gray-500"></span>
                        </li>
                        <li class="breadcrumb-item text-muted">تحديث زر</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!--begin::Content-->
    <div class="app-content flex-column-fluid">
        <div class="app-container container-fluid">
            <div class="card">
                <div class="card-body p-lg-10">
                    <form id="updateButtonForm" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="row mb-7">
                            <div class="col-md-6">
                                <label class="required">النص الظاهر على الزر</label>
                                <input asp-for="ButtonText" class="form-control form-control-solid" />
                            </div>

                            <div class="col-md-6">
                                <label class="required">رمز الإجراء (ActionKey)</label>
                                <input asp-for="ActionKey" class="form-control form-control-solid" />
                            </div>
                        </div>

                        <div class="row mb-7">
                            <div class="col-md-6">
                                <label>رمز الصلاحية (PermissionKey)</label>
                                <input asp-for="PermissionKey" class="form-control form-control-solid" />
                            </div>

                            <div class="col-md-6">
                                <label class="required">المسار (WorkFlow)</label>
                                <select asp-for="WorkFlowId" asp-items="Model.WorkFlows" class="form-select form-select-solid">
                                    <option disabled selected>-- اختر المسار --</option>
                                </select>
                            </div>
                        </div>

                        <div class="d-flex justify-content-start gap-3">
                            <button type="submit" class="btn btn-primary">تحديث</button>
                            <a asp-action="GetAllWorkFlowActionButtons" class="btn btn-secondary">العودة</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
