@model IEnumerable<ValidEserviceCombinations>

@{
    ViewBag.Title = "Valid eService Combinations";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutEserviceTourism.cshtml";
}

<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">
        <div class="card card-flush">
            <div class="card-header mt-6">
                <div class="card-title">
                    <div class="d-flex align-items-center position-relative my-1 me-5">
                        <i class="ki-outline ki-magnifier fs-3 position-absolute ms-5"></i>
                        <input type="text" id="combinationSearch" class="form-control form-control-solid w-250px ps-13" placeholder="Search Combination" />
                    </div>
                </div>
                <div class="card-toolbar">
                    <a href="@Url.Action("CreateValidEserviceCombinations", "Dynamic", new { area = "Admin" })" class="btn btn-light-primary">
                        <i class="ki-outline ki-plus-square fs-3"></i> Add Combination
                    </a>
                </div>
            </div>
            <div class="card-body pt-0">
                <table class="table align-middle table-row-dashed fs-6 gy-5 mb-0" id="combinationTable">
                    <thead>
                        <tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase gs-0">
                            <th>#</th>
                            <th>Activity Type</th>
                            <th>Request Type</th>
                            <th>Licence Type</th>
                            <th>Is Allowed</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="fw-semibold text-gray-600">
                        @if (Model != null && Model.Any())
                        {
                            int serial = 1;
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@serial++</td>
                                    <td>@item.ActivityTypesLookup?.NameAr</td>
                                    <td>@item.RequestsTypesLookup?.NameAr</td>
                                    <td>@item.LicenceTypesLookup?.NameAr</td>
                                    <td>
                                        @if (item.IsAllowed)
                                        {
                                            <span class="badge badge-light-success">Allowed</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-light-danger">Not Allowed</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a href="@Url.Action("EditValidEserviceCombinations", "Dynamic", new { area = "Admin", id = item.Id })" class="btn btn-icon btn-active-light-primary w-30px h-30px me-3">
                                            <i class="ki-outline ki-setting-3 fs-3"></i>
                                        </a>
                                        <button class="btn btn-icon btn-active-light-danger w-30px h-30px delete-combination" data-id="@item.Id">
                                            <i class="ki-outline ki-trash fs-3"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted">No combinations found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const apiBaseUrl = '@ViewBag.ApiBaseUrl';

        document.getElementById("combinationSearch").addEventListener("keyup", function () {
            const search = this.value.toLowerCase();
            document.querySelectorAll("#combinationTable tbody tr").forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(search) ? "" : "none";
            });
        });

        document.querySelectorAll(".delete-combination").forEach(button => {
            button.addEventListener("click", async () => {
                if (!confirm("Are you sure you want to delete this combination?")) return;

                const id = button.dataset.id;
                const response = await fetch(apiBaseUrl + "DeleteConfirmedValidCombination?id=" + id, {
                    method: 'POST'
                });

                if (response.ok) {
                    alert("Deleted successfully.");
                    location.reload();
                } else {
                    alert("Failed to delete combination.");
                }
            });
        });
    </script>
}
