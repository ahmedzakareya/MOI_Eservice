@model IEnumerable<Eservice>

@{
    ViewBag.Title = "Eservice Management";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutEserviceTourism.cshtml";
}

<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">
        <div class="card card-flush">
            <div class="card-header mt-6">
                <div class="card-title">
                    <div class="d-flex align-items-center position-relative my-1 me-5">
                        <i class="ki-outline ki-magnifier fs-3 position-absolute ms-5"></i>
                        <input type="text" id="eserviceSearch" class="form-control form-control-solid w-250px ps-13" placeholder="Search Eservices" />
                    </div>
                </div>
                <div class="card-toolbar">
                    <button type="button" class="btn btn-light-primary" data-bs-toggle="modal" data-bs-target="#kt_modal_add_eservice">
                        <i class="ki-outline ki-plus-square fs-3"></i>Add Eservice
                    </button>
                </div>
            </div>
            <div class="card-body pt-0">
                <table class="table align-middle table-row-dashed fs-6 gy-5 mb-0" id="eserviceTable">
                    <thead>
                        <tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase gs-0">
                            <th>#</th>
                            <th>Name</th>
                            <th>Arabic Name</th>
                            <th>URL</th>
                            <th>Service ID</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="fw-semibold text-gray-600">
                        @if (Model != null && Model.Any())
                        {
                            int serial = 0;
                            foreach (var item in Model)
                            {
                                serial++;
                                <tr>
                                    <td>@serial</td>
                                    <td>@item.EserviceName</td>
                                    <td>@item.EserviceNameAr</td>
                                    <td>@item.Url</td>
                                    <td>@item.ServiceId</td>
                                    <td class="text-end">
                                        <button class="btn btn-icon btn-active-light-primary w-30px h-30px me-3 edit-eservice" data-id="@item.Id" data-bs-toggle="modal" data-bs-target="#kt_modal_edit_eservice">
                                            <i class="ki-outline ki-setting-3 fs-3"></i>
                                        </button>
                                        <button class="btn btn-icon btn-active-light-primary w-30px h-30px delete-eservice" data-id="@item.Id">
                                            <i class="ki-outline ki-trash fs-3"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="6" class="text-center text-muted">No Eservices available.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add Modal -->
<div class="modal fade" id="kt_modal_add_eservice" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="fw-bold">Add Eservice</h2>
                <div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal">
                    <i class="ki-outline ki-cross fs-1"></i>
                </div>
            </div>
            <div class="modal-body scroll-y mx-5 my-7">
                <form id="addEserviceForm">
                    <div class="fv-row mb-7">
                        <label class="fs-6 fw-semibold form-label mb-2">Name</label>
                        <input class="form-control form-control-solid" id="EserviceName" placeholder="Enter name" required />
                    </div>
                    <div class="fv-row mb-7">
                        <label class="fs-6 fw-semibold form-label mb-2">Arabic Name</label>
                        <input class="form-control form-control-solid" id="EserviceNameAr" placeholder="Enter Arabic name" required />
                    </div>
                    <div class="fv-row mb-7">
                        <label class="fs-6 fw-semibold form-label mb-2">URL</label>
                        <input class="form-control form-control-solid" id="Url" placeholder="Enter URL" required />
                    </div>
                    <div class="fv-row mb-7">
                        <label class="fs-6 fw-semibold form-label mb-2">Service ID</label>
                        <input class="form-control form-control-solid" id="ServiceId" placeholder="Enter service ID" required />
                    </div>
                    <div class="text-center pt-15">
                        <button type="button" class="btn btn-primary" id="submitEservice">Submit</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="kt_modal_edit_eservice" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="fw-bold">Edit Eservice</h2>
                <div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal">
                    <i class="ki-outline ki-cross fs-1"></i>
                </div>
            </div>
            <div class="modal-body scroll-y mx-5 my-7">
                <form id="editEserviceForm">
                    <input type="hidden" id="editEserviceId" />
                    <div class="fv-row mb-7">
                        <label class="fs-6 fw-semibold form-label mb-2">Name</label>
                        <input class="form-control form-control-solid" id="editEserviceName" required />
                    </div>
                    <div class="fv-row mb-7">
                        <label class="fs-6 fw-semibold form-label mb-2">Arabic Name</label>
                        <input class="form-control form-control-solid" id="editEserviceNameAr" required />
                    </div>
                    <div class="fv-row mb-7">
                        <label class="fs-6 fw-semibold form-label mb-2">URL</label>
                        <input class="form-control form-control-solid" id="editUrl" required />
                    </div>
                    <div class="fv-row mb-7">
                        <label class="fs-6 fw-semibold form-label mb-2">Service ID</label>
                        <input class="form-control form-control-solid" id="editServiceId" required />
                    </div>
                    <div class="text-center pt-15">
                        <button type="button" class="btn btn-primary" id="submitEditEservice">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const apiBaseUrl = '@ViewBag.ApiBaseUrl';

        document.getElementById("submitEservice").addEventListener("click", async function () {
            const data = {
                Id: crypto.randomUUID(),
                EserviceName: document.getElementById("EserviceName").value,
                EserviceNameAr: document.getElementById("EserviceNameAr").value,
                Url: document.getElementById("Url").value,
                ServiceId: parseInt(document.getElementById("ServiceId").value)
            };
            console.log("Sending to:", `${apiBaseUrl}CreateEservice`);
            console.log("Data:", data);
            const response = await fetch(`${apiBaseUrl}CreateEservice`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(data)
            });
            if (response.ok) location.reload();
        });

        document.querySelectorAll(".edit-eservice").forEach(button => {
            button.addEventListener("click", async function () {
                const id = button.getAttribute("data-id");
                const response = await fetch(`${apiBaseUrl}GetByIdEservice?id=${id}`);
                const eservice = await response.json();
                document.getElementById("editEserviceId").value = eservice.id;
                document.getElementById("editEserviceName").value = eservice.eserviceName;
                document.getElementById("editEserviceNameAr").value = eservice.eserviceNameAr;
                document.getElementById("editUrl").value = eservice.url;
                document.getElementById("editServiceId").value = eservice.serviceId;
            });
        });

        document.getElementById("submitEditEservice").addEventListener("click", async function () {
            const data = {
                Id: document.getElementById("editEserviceId").value,
                EserviceName: document.getElementById("editEserviceName").value,
                EserviceNameAr: document.getElementById("editEserviceNameAr").value,
                Url: document.getElementById("editUrl").value,
                ServiceId: parseInt(document.getElementById("editServiceId").value),
                CreatedOn: new Date().toISOString(),
                IsDeleted: false
            };
            const id = document.getElementById("editEserviceId").value;
            const response = await fetch(`${apiBaseUrl}UpdateEservice?id=${id}`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(data)
            });
            if (response.ok) location.reload();
        });

        document.querySelectorAll(".delete-eservice").forEach(button => {
            button.addEventListener("click", async function () {
                if (!confirm("Are you sure you want to delete this Eservice?")) return;
                const id = button.getAttribute("data-id");
                const response = await fetch(`${apiBaseUrl}DeleteEservice?id=${id}`, { method: "POST" });
                if (response.ok) location.reload();
            });
        });

        document.getElementById("eserviceSearch").addEventListener("keyup", function () {
            const search = this.value.toLowerCase();
            document.querySelectorAll("#eserviceTable tbody tr").forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(search) ? "" : "none";
            });
        });
    </script>
}
