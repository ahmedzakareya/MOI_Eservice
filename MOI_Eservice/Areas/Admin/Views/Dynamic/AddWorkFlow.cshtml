@model WorkFlowVM
@{
    ViewBag.Title = "Add Workflow";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutEserviceTourism.cshtml";
}

<!--begin::Content wrapper-->
<div class="d-flex flex-column flex-column-fluid">
    <!--begin::Toolbar-->
    <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2">
        <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex align-items-stretch">
            <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
                <div class="page-title d-flex flex-column justify-content-center gap-1 me-3">
                    <h1 class="page-heading d-flex flex-column justify-content-center text-gray-900 fw-bold fs-3 m-0">Add Workflow</h1>
                    <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                        <li class="breadcrumb-item text-muted">
                            <a asp-action="Index" asp-controller="Home" class="text-muted text-hover-primary">Home</a>
                        </li>
                        <li class="breadcrumb-item">
                            <span class="bullet bg-gray-500 w-5px h-2px"></span>
                        </li>
                        <li class="breadcrumb-item text-muted">Add Workflow</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
    <!--end::Toolbar-->
    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div id="kt_app_content_container" class="app-container container-fluid">
            <div class="card">
                <div class="card-body p-lg-10">
                    <div class="d-flex flex-column flex-lg-row mb-17">
                        <div class="flex-lg-row-fluid me-0">
                            <form class="form" id="createWorkflowForm" method="post" asp-action="AddWorkflow">
                                <div class="row">
                                    <div class="col-md-6 mb-7 fv-row">
                                        <label class="fs-6 fw-semibold mb-2">
                                            <span class="required">Service</span>
                                        </label>
                                        <select id="serviceDropdown" name="serviceId" asp-items="Model.Services"
                                                class="form-select form-select-solid fw-bold"
                                                onchange="fetchActivityTypes(this.value)" required>
                                            <option value="" disabled selected>--Select Service--</option>
                                        </select>
                                    </div>
                                    @* <div class="col-md-6 mb-7 fv-row">
                                        <label class="fs-6 fw-semibold mb-2">
                                            <span class="required">Activity Type</span>
                                        </label>
                                        <select id="activityDropdown" name="activityTypeId"
                                                class="form-select form-select-solid fw-bold" required>
                                            <option value="" disabled selected>--Select Activity Type--</option>
                                        </select>
                                    </div> *@
                                </div>
                                <div class="row">
                                    <div class="col-md-6 mb-7 fv-row">
                                        <label class="fs-6 fw-semibold mb-2">
                                            <span class="required">Request Type</span>
                                        </label>
                                        <select id="requestTypeDropdown" name="requestTypeId" asp-items="Model.RequestTypes"
                                                class="form-select form-select-solid fw-bold" required>
                                            <option value="" disabled selected>--Select Request Type--</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6 mb-7 fv-row" id="transactionTypeContainer" style="display: none;">
                                        <label class="fs-6 fw-semibold mb-2">
                                            <span class="required">Transaction Type</span>
                                        </label>
                                        <select id="transactionTypeDropdown" name="transactionTypeId" class="form-select form-select-solid fw-bold">
                                            <option value="" disabled selected>--Select Transaction Type--</option>
                                            <!-- Populate with transaction types dynamically -->
                                        </select>
                                    </div>

                                </div>
                                <div class="row">
                                    <div class="col-md-6 mb-7 fv-row">
                                        <label class="fs-6 fw-semibold mb-2">
                                            <span class="required">Next Status</span>
                                        </label>
                                        <select id="nextstatusDropdown" name="nextStatusId" asp-items="Model.RequestStatus"
                                                class="form-select form-select-solid fw-bold" required>
                                            <option value="" disabled selected>--Select Status--</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6 mb-7 fv-row">
                                        <label class="fs-6 fw-semibold mb-2">
                                            <span class="required">Current Status</span>
                                        </label>
                                        <select id="currentstatusDropdown" name="currentStatusId" asp-items="Model.RequestStatus"
                                                class="form-select form-select-solid fw-bold" required>
                                            <option value="" disabled selected>--Select Status--</option>
                                        </select>
                                    </div>

                                </div>


                                <div class="row">

                                    <!--begin::Col-->
                                    <div class="col-md-6 mb-7 fv-row">
                                        <!--begin::Label-->
                                        <label class="required fs-6 fw-semibold mb-2">Flag</label>
                                        <!--end::Label-->
                                        <!--begin::Input-->
                                        <input class="form-control form-control-solid" placeholder="" asp-for="FlagRequestStatus" id="Flag" />
                                        <!--end::Input-->
                                    </div>
                                    <!--end::Col-->
                                    <!--begin::Col-->
                                    <div class="col-md-6">
                                        <label>الشروط</label>
                                        <textarea class="form-control form-control-solid" asp-for="Conditions"></textarea>
                                    </div>
                                    <!--end::Col-->


                                </div>
                                <div class="row">

                                    <div class="col-md-6 mb-7 fv-row">
                                        <label class="fs-6 fw-semibold mb-2">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       id="IsPermissionRequired"
                                                       name="IsPermissionRequired"
                                                @(Model.IsPermissionRequired ? "checked" : "") />
                                                <label class="form-check-label" for="IsPermissionRequired">هل يتطلب صلاحيات؟</label>
                                                @* </div> *@
                                            </div>
                                        </label>
                                    </div>

                                    

                                </div>

                                <div class="col-md-6 fv-row">
                                    <button type="button" class="btn btn-primary" onclick="submitWorkflow()">Submit</button>
                                    <a asp-action="Index" class="btn btn-secondary">Back</a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
