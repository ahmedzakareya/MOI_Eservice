            //function to delete row
            async function deleteWorkflow(id) {
                if (!confirm("Are you sure you want to delete this workflow?")) {
                    return;
                }

                try {
                    const response = await fetch(`${apiBaseUrl}DeleteWorkflow/${id}`, {
                        method: 'DELETE',
                    });

                    if (!response.ok) throw new Error(`Failed to delete workflow: ${response.status}`);

                    const result = await response.json();
                    if (result.success) {
                        alert(result.message);
                        fetchAndUpdateTable(); // Refresh the table
                    } else {
                        alert("Error deleting workflow");
                    }
                } catch (error) {
                    console.error('Error deleting workflow:', error);
                }
            }
            // Fetch Transaction Types dynamically
      


            // Handle Request Type change event
            document.getElementById('requestTypeDropdown').addEventListener('change', function () {
                const selectedRequestTypeId = this.value; // Get the selected value (ID)
                const transactionTypeContainer = document.getElementById('transactionTypeContainer');
                const transactionTypeDropdown = document.getElementById('transactionTypeDropdown');
                const ChangeData = @((int)RequestTypeEnum.ChangeData)
                            if (selectedRequestTypeId === ChangeData) { // Replace "123" with the ID for 'تعديل'
                    transactionTypeContainer.style.display = 'block';

                    // Fetch Transaction Types dynamically if needed
                    fetchTransactionTypes();
                } else {
                    transactionTypeContainer.style.display = 'none';
                    transactionTypeDropdown.innerHTML = '<option value="" disabled selected>--Select Transaction Type--</option>';
                }
            });

            // Fetch Transaction Types dynamically
            function fetchTransactionTypes() {
                const apiBaseUrl = '@ViewBag.ApiBaseUrl'; // API base URL

                fetch(`${apiBaseUrl}GetTransactionTypes`) // Update the API endpoint as per your requirements
                    .then(response => {
                        if (!response.ok) throw new Error(`Failed to fetch transaction types: ${response.status}`);
                        return response.json();
                    })
                    .then(data => {

                        const transactionTypeDropdown = document.getElementById('transactionTypeDropdown');
                        transactionTypeDropdown.innerHTML = '<option value="" disabled selected>--Select Transaction Type--</option>';
                        console.log(data);

                        // Assuming data is an array of transaction types
                        if (data && Array.isArray(data.$values)) {
                            data.$values.forEach(type => {
                                transactionTypeDropdown.innerHTML += `<option value="${type.id}">${type.name}</option>`;
                            });
                        } else {
                            console.warn("Unexpected response format:", data); // Debugging log
                            $('#transactionTypeDropdown').append('<option value="" disabled>Error loading Transaction Type</option>');
                        }
                    })
                    .catch(error => {
                        console.error('Error fetching transaction types:', error);
                    });
            }




