                        <input type="text" class="form-control form-control-solid ps-10" name="search" value="" placeholder="Search" />
                    </div>
                    <!--end::Input group-->
                    <!--begin:Action-->
                    <div class="d-flex align-items-center">
                        <button type="submit" class="btn btn-primary me-5">Search</button>
