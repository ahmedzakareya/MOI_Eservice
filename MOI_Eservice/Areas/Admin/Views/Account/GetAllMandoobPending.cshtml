@model List<PendingDelegationVM>


@{
    ViewBag.Title = "File Upload Configurations";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutEserviceTourism.cshtml";
}

<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2">
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex align-items-stretch">
        <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
            <div class="page-title d-flex flex-column justify-content-center gap-1 me-3">
                <h1 class="page-heading d-flex flex-column justify-content-center text-gray-900 fw-bold fs-3 m-0">طلبات تفويض قيد الموافقة</h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                    <li class="breadcrumb-item text-muted"><a href="/Admin/Index" class="text-muted text-hover-primary">الشاشة الرئيسة</a></li>
                    <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                    <li class="breadcrumb-item text-muted">تفويض التراخيص</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!--end::Toolbar-->
<!--begin::Content-->
<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">
        <div class="card">
            <div class="card-header border-0 pt-6">
                <div class="card-title">
                    <div class="d-flex align-items-center position-relative my-1">
                        <i class="ki-outline ki-magnifier fs-3 position-absolute ms-5"></i>
                        <input type="text" class="form-control form-control-solid w-250px ps-12" placeholder="بحث عن تفويض" />
                    </div>
                </div>
            </div>
            <div class="card-body pt-0">
                <!--begin::Table-->
                <table class="table align-middle table-row-dashed fs-6 gy-5">
                    <thead>
                        <tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0">
                            <th class="min-w-150px">الترخيص</th>
                            <th class="min-w-150px">اسم المفوض</th>
                            <th class="min-w-150px">المستخدم الأساسي</th>
                            <th class="min-w-150px">المرفق</th>
                            <th class="min-w-150px">الإجراء</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.LicenseName</td>
                                <td>@item.DelegateName</td>
                                <td>@item.MainUserName</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.AttachmentUrl))
                                    {
                                        <a href="@item.AttachmentUrl" class="btn btn-sm btn-light-primary" target="_blank">عرض</a>
                                    }
                                    else
                                    {
                                        <span class="badge badge-light">لا يوجد</span>
                                    }
                                </td>
                                @* <td>
                                    <form asp-action="ApproveMandoobDelegation" asp-controller="Account" asp-area="Admin" method="post" class="d-flex gap-2">
                                        <input type="hidden" name="aspnetuserLic" value="@item.Id" />
                                        <button name="approve" value="true" type="submit" class="btn btn-sm btn-success">قبول</button>
                                        <button name="approve" value="false" type="submit" class="btn btn-sm btn-danger">رفض</button>
                                    </form>
                                </td> *@

                                <td>
                                    <a asp-action="ViewDelegationDetails" asp-controller="Account" asp-area="Admin" asp-route-id="@item.Id" class="btn btn-sm btn-primary">
                                        <i class="ki-outline ki-eye fs-5"></i> عرض التفاصيل
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <!--end::Table-->
            </div>
        </div>
    </div>
</div>
<!--end::Content-->