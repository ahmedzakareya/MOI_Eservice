@model ContactUsVM
@{
    ViewBag.Title = "تفاصيل طلب اتصل بنا";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutEserviceTourism.cshtml";
}

<div class="card card-flush shadow-sm mb-10">
    <div class="card-header border-0 pt-8">
        <div class="card-title">
            <h2 class="fw-bold fs-2 text-gray-800">تفاصيل طلب اتصل بنا</h2>
        </div>
    </div>

    <div class="card-body pt-0">
        <div class="row mb-6">
            <div class="col-md-6">
                <div class="d-flex flex-column">
                    <span class="text-gray-600 fw-semibold">الاسم:</span>
                    <span class="fs-6 text-dark fw-bold">@Model.FullNameAr</span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="d-flex flex-column">
                    <span class="text-gray-600 fw-semibold">البريد الإلكتروني:</span>
                    <a href="mailto:@Model.Email" class="fs-6 fw-bold text-primary">@Model.Email</a>
                </div>
            </div>
        </div>

        <div class="row mb-6">
            <div class="col-md-6">
                <div class="d-flex flex-column">
                    <span class="text-gray-600 fw-semibold">رقم الهاتف:</span>
                    <span class="fs-6 text-dark fw-bold">@Model.Mobile</span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="d-flex flex-column">
                    <span class="text-gray-600 fw-semibold">تاريخ الطلب:</span>
                    <span class="fs-6 text-dark fw-bold">@Model.CreatedOn?.ToString("dd/MM/yyyy hh:mm tt")</span>
                </div>
            </div>
        </div>

        <div class="separator my-6"></div>

        <div class="mb-6">
            <span class="text-gray-600 fw-semibold">الرسالة:</span>
            <div class="alert alert-secondary fw-semibold text-black mt-2">
                @Model.Message
            </div>
        </div>

        <form asp-action="UpdateNote" asp-area="Admin" asp-controller="Account" method="post">
            @Html.AntiForgeryToken()
            @Html.HiddenFor(x => x.Id)

            <div class="mb-6">
                <label class="form-label fw-semibold">ملاحظات</label>
                @Html.TextAreaFor(x => x.Message, new { @class = "form-control form-control-solid", rows = 4, placeholder = "أدخل ملاحظاتك هنا..." })
                @Html.ValidationMessageFor(x => x.Note, "", new { @class = "text-danger" })
            </div>

            <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-danger fw-bold">
                    <i class="ki-outline ki-refresh-left fs-2"></i> تحديث الملاحظات
                </button>
            </div>
        </form>
    </div>
</div>
