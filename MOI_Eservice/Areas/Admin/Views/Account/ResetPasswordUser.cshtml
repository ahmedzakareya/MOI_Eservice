@model ResetUserPasswordVM

@{
    ViewBag.Title = "تفاصيل إعادة تعيين كلمة السر";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutEserviceTourism.cshtml";
}

<div class="card card-flush shadow-sm py-5 px-8">
    <div class="card-header border-bottom">
        <h2 class="card-title fw-bold text-dark">تفاصيل إعادة تعيين كلمة السر</h2>
    </div>

    <div class="card-body">
        <div class="row mb-5">
            <div class="col-md-4">
                <div class="mb-3">
                    <label class="form-label fw-semibold">الرقم المدني:</label>
                    <input type="text" class="form-control form-control-solid" value="@Model.UserCivilID" readonly />
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label class="form-label fw-semibold">البريد الإلكتروني:</label>
                    <input type="text" class="form-control form-control-solid" value="@Model.UserEmail" readonly />
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label class="form-label fw-semibold">رقم الهاتف:</label>
                    <input type="text" class="form-control form-control-solid" value="@Model.Mobile" readonly />
                </div>
            </div>
        </div>

        <div class="mb-5">
            <label class="form-label fw-semibold mb-2">البطاقة المدنية:</label>
            <div class="border rounded p-3 bg-light d-flex justify-content-center">
                <img src="@Url.Content("~/" + ViewBag.ResetPasswordPath + Model.FilePath)"
                     class="rounded border shadow-sm"
                     style="max-width: 250px; height: auto;"
                     alt="صورة البطاقة" />
            </div>
        </div>

        <form asp-action="UpdateResetRequest" method="post" class="mt-5">
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)
           
            @Html.HiddenFor(m => m.UserCivilID)
            @Html.HiddenFor(m => m.UserEmail)
            @Html.HiddenFor(m => m.Mobile)
            @Html.HiddenFor(m => m.FilePath)
            @Html.HiddenFor(m=>m.UserNewPass)
            @Html.HiddenFor(m => m.DateAdded)

            <div class="mb-5">
                <label class="form-label fw-bold">ملاحظات</label>
                @Html.TextAreaFor(m => m.Note, new { @class = "form-control form-control-solid", rows = 5, placeholder = "أدخل ملاحظاتك هنا..." })
                @Html.ValidationMessageFor(m => m.Note, "", new { @class = "text-danger mt-2" })
            </div>

            <div class="d-flex justify-content-end gap-3">
                <button type="submit" name="Status" value="Accepted" class="btn btn-success">
                    <i class="ki-outline ki-check fs-5"></i> تأكيد الطلب
                </button>
                <button type="submit" name="Status" value="Rejected" class="btn btn-danger">
                    <i class="ki-outline ki-cross fs-5"></i> رفض الطلب
                </button>
            </div>
        </form>
    </div>
</div>
