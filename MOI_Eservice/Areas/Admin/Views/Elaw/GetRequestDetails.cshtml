        function hideButtonsForCertainStatuses(statusId) {
            const statusButtons = document.getElementById('statusButtons');

            // Define the statuses that should hide the buttons
            const statusesToHide = [RequestDeclined, FinalLicenseIssued, CorrectData, WaitingBankGuarantee, CriminalCase];

            // Check if the statusId is in the array of statuses to hide
            if (statusButtons) {
                statusButtons.style.display = statusesToHide.includes(statusId) ? 'none' : 'block';
            }
