            if (statusId === FinalLicenseIssuingProcessing || statusId === FinalLicenseIssued || statusId === PaymentAndFinalLicencesIssued) {
                refuseButton.style.display = "none";
                notifyButton.style.display = "none";
            }
        }
        function hideCorrectButtonForCertainStatuses(statusId) {
            const notifyButton = document.getElementById('CorrectData');

            // Check if the button exists and if the statusId is not 2
            if (notifyButton) {
