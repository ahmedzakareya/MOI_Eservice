        const CriminalCase = @((int)RequestStatusEnum.CriminalCase);


        // Handle moving to the next status
        async function moveToNextStatus(element) {
            try {
                handleButtonClick(element);  // This will update selectedAttachments, uncheckedAttachments, etc.
                const requestId = element.getAttribute('data-request-id');
                const serviceId = element.getAttribute('data-service-id');
                const activityTypeId = element.getAttribute('data-activity-type-id');
                const currentStatusId = parseInt(element.getAttribute('data-status-id'));
                const requestTypeId = element.getAttribute('data-reqtype-id');
                const reqNo = element.getAttribute('data-reqno');
                const note = document.getElementById("RequestNote").value.trim();

                logUserAction('Button Click', element.id, { requestId, action: currentStatusId === RequestDeclined ? "Refuse" : "Move to next step", selectedAttachments, note });

                trackNoteChangesbeforAfter();
                if (currentStatusId === RequestDeclined && note === "") {
                    alert('من فضلك أدخل سبب الرفض .');
                    return;
                }

                const isRefuseAction = currentStatusId === RequestDeclined
                    ? "Are you sure you want to refuse this request?"
                    : `Move to the next step?`;
                if (!confirm(isRefuseAction)) return;

                //const formData = createFormData(requestId, currentStatusId, reqTypeId, activityTypeId, reqNo, note);
                console.log(selectedAttachments);
                console.log(uncheckedAttachments);
                console.log(action);
                console.log(allAttachmentsState);

                const uploadedFiles = new FormData();
                // Collect all file inputs dynamically based on their unique naming convention
                const dynamicFileInputs = document.querySelectorAll('input[type="file"][name^="AttachmentFiles-"]');

                dynamicFileInputs.forEach((input, index) => {
                    if (input.files.length > 0) {
                        const checkboxes = document.querySelectorAll('input[name="attachmentsToUpload"]');


                        const file = input.files[0]; // Handle the first file

                        let fileName = input.getAttribute("data-filename") || associatedLabel.textContent.trim(); // Get filename
                        const isMandatory = input.getAttribute("data-mandatory") === "True"; // Must be boolean
                        const fieldName = input.getAttribute("data-fieldname") || "";

                        // Append the file and its name to `uploadedFiles` as part of the `files` array
                        uploadedFiles.append(`files[${index}].Files`, file); // Append the file
                        uploadedFiles.append(`files[${index}].filename`, fileName); // Append the filename
                        uploadedFiles.append(`files[${index}].ismandatory`, isMandatory);  // ✅ this was missing
                        uploadedFiles.append(`files[${index}].fieldname`, fieldName);
                    }
                });
                // Optionally, handle unchecked attachments directly using the following approach
                const uncheckedAttachmentsFromDOM = $("input[type='checkbox']:not(:checked)").map(function () {
                    return parseInt($(this).data('id'));  // Collect numeric ID of unchecked checkboxes
                }).get();
                // AttachmentState.forEach((attachmentState, index) => {
                //     uploadedFiles.append(`AttachmentState[${index}].AttachmentId`, attachmentState.AttachmentId);
                //     uploadedFiles.append(`AttachmentState[${index}].State`, attachmentState.State);
                // });
                const SaveDataViewModel = {
                    selectedAttachments: selectedAttachments,
                    uncheckedAttachments: uncheckedAttachments,
                    action: action,
                    note: note,
                    requestId: requestId,
                    ReqNo: reqNo,
                    activityTypeId: activityTypeId,
                    reqTypeId: requestTypeId,
                    ReqStatusId: currentStatusId,
                    changeLogs: changeLogs,
                    //files: uploadedFiles,AttachmentStates
                    allAttachmentsState: allAttachmentsState

                };
                console.log(SaveDataViewModel);
                // Add SaveDataViewModel fields to FormData
                if (!(uploadedFiles instanceof FormData)) {
                    uploadedFiles = new FormData(); // Ensure uploadedFiles is always a FormData object
                }
                // Add SaveDataViewModel fields to FormData
                for (const key in SaveDataViewModel) {
                    if (Array.isArray(SaveDataViewModel[key])) {
                        SaveDataViewModel[key].forEach((value, index) => {
                            if (key === "allAttachmentsState") {
                                // If it is the list of AttachmentState objects
                                uploadedFiles.append(`allAttachmentsState[${index}].AttachmentId`, value.attachmentId);
                                uploadedFiles.append(`allAttachmentsState[${index}].State`, value.state);
                            } else {
                                uploadedFiles.append(`${key}[${index}]`, value);
                            }
                        });
                    } else if (SaveDataViewModel[key] !== undefined && SaveDataViewModel[key] !== null) {
                        uploadedFiles.append(key, SaveDataViewModel[key]);
                    }
                }

                //uploadedFiles.append('AttachmentState', JSON.stringify(AttachmentState));
                // Submit the status update to the server
                const response = await fetch('SaveData/', {
                    method: 'POST',
                    body: uploadedFiles // Send FormDat
                    // method: 'POST',
                    // headers: {
                    //     'Content-Type': 'application/json'
                    // },
                    // body: JSON.stringify(SaveDataViewModel)
                });

                if (!response.ok) throw new Error('Failed to modify request status');

                const result = await response.json();
                if (typeof result.updatedRequest === 'string') {
                    result.updatedRequest = JSON.parse(result.updatedRequest);
                }
                console.log(result);
                console.log(result.updatedRequest);
                const nextStatusId = result.updatedRequest.statusid; // Updated status ID
                const nextStatusName = result.updatedRequest.statusname || "Unknown Status";
                const buttonSelector = `#RequestStatusbutton[data-request-id="${requestId}"]`;
                const statusElement = document.querySelector(buttonSelector);

                if (action === "RequestStatusbutton" && statusElement) {
                    statusElement.textContent = nextStatusName; // Update the button's text
                    statusElement.setAttribute("data-status-id", nextStatusId); // Update the status ID
                    console.log("RequestStatusbutton updated successfully.");
                }
                updateStatusUI(result.updatedRequest);
                // renderFileInputs(serviceId, activityTypeId, requestStatusId, requestTypeId)
                //     if (result.updatedRequest.isFinalStatus) {
                // document.getElementById('PrintFinalApproved').style.display = 'block';
                //   } else {
                // document.getElementById('PrintFinalApproved').style.display = 'none';
                //      }
                console.log(result);
               
                console.log(result.updatedRequest);
                if (result.updatedRequest) {
                    addLogRowToTable(result.updatedRequest);
                }
                location.reload();

                alert(result.message || "Status updated successfully.");
            } catch (error) {
                console.error("Error updating status:", error);
                alert("An error occurred while updating the status.");
            }
        }

 
        
