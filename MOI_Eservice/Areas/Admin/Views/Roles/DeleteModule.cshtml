@model ModuleVM

    @{
        ViewBag.Title = "Edit Menu Item";
        Layout = "~/Areas/Admin/Views/Shared/_LayoutEserviceTourism.cshtml";
    }

    <!--begin::Content wrapper-->
    <div class="d-flex flex-column flex-column-fluid">
        <!--begin::Toolbar-->
        <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2">
            <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex align-items-stretch">
                <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
                    <div class="page-title d-flex flex-column justify-content-center gap-1 me-3">
                        <h1 class="page-heading d-flex flex-column justify-content-center text-gray-900 fw-bold fs-3 m-0">Edit Menu Item</h1>
                        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                            <li class="breadcrumb-item text-muted">
                                <a asp-action="Index" asp-controller="Home" class="text-muted text-hover-primary">Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <span class="bullet bg-gray-500 w-5px h-2px"></span>
                            </li>
                            <li class="breadcrumb-item text-muted">Edit Menu Item</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <!--end::Toolbar-->
        <!--begin::Content-->
        <div id="kt_app_content" class="app-content flex-column-fluid">
            <div id="kt_app_content_container" class="app-container container-fluid">
                <div class="card">
                    <div class="card-body p-lg-10">
                    <form method="post" id="DeleteModule">
                            <input type="hidden" asp-for="Id" />

                            <div class="row">
                                <div class="col-md-6 mb-7 fv-row">
                                    <label class="fs-6 fw-semibold mb-2">
                                        <span class="required">Name (Arabic)</span>
                                    </label>
                                    <input asp-for="Name" class="form-control form-control-solid fw-bold" readonly />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>

                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-7 fv-row">
                                    <label class="fs-6 fw-semibold mb-2">Description</label>
                                    <input asp-for="Description" class="form-control form-control-solid fw-bold" readonly/>
                                </div>

                            </div>





                            <div class="d-flex justify-content-start gap-3">
                                <button type="submit" class="btn btn-primary">Delete</button>
                                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <!--end::Content-->
    </div>


    @section Scripts {
        <script>
            $(document).ready(function () {
                $('#DeleteModule').submit(function (e) {
                    e.preventDefault(); // Prevent default form submission

                    if (!confirm("Are you sure you want to Delete Module?")) {
                        return;
                    }

                    // Gather form data
                    var formData = {
                        Id: $("input[name='Id']").val(),
                        Name: $("input[name='Name']").val(),
                        //sort :$("input[name='Sort']").val(),
                    Description: $("input[name='Description']").val(),

                    };

                    // API base URL
                    var apiBaseUrl = '@ViewBag.ApiBaseUrl';

                    // Call the API to update the menu item
                    $.ajax({
                        url: apiBaseUrl + 'DeleteModule', // Update endpoint
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(formData), // Send data as JSON
                        success: function (response) {
                            alert(response.message || "Module updated successfully.");
                        window.location.href = '@Url.Action("GetModules", "Roles", new { area = "Admin" })';
                        },
                        error: function (xhr) {
                            console.error("Error updating menu item:", xhr.responseText);
                            alert("Failed to update menu item. Please try again.");
                        }
                    });
                });
            });
        </script>
    }
