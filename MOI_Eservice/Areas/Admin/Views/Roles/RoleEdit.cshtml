                if (event.target.checked) {
                    checkboxState[key] = {
                        MenuItemId: menuItemId,
                        PermissionId: permissionId,
                        ModuleId: moduleId
                    };
                } else {
                    delete checkboxState[key];
                }

                console.log("Updated checkboxState:", checkboxState);
            }
        });

