@model RoleVMV

@{
    ViewBag.Title = "Edit Role";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutEserviceTourism.cshtml";
}

<div class="modal-dialog-centered mw-750px">
    <div class="modal-content">
        <div class="modal-body scroll-y mx-lg-5 my-7">
            <form id="EditRoleForm" class="form">
                <!-- Role Name -->
                <div class="fv-row mb-10">
                    <label class="fs-5 fw-bold form-label mb-2">
                        <span class="required">Role Name</span>
                    </label>
                    <input type="text" id="roleName" class="form-control form-control-solid" value="@Model.RoleName" placeholder="Enter a role name" required />
                </div>

                <!-- Modules, Menu Items, and Permissions -->
                <div id="modulesContainer" class="fv-row">
                    <!-- Dynamically populated modules with menu items and permissions -->
                </div>

                <!-- Form Actions -->
                <div class="text-center pt-15">
                    <button type="reset" class="btn btn-light me-3" data-kt-roles-modal-action="cancel">Discard</button>
                    <button type="button" class="btn btn-primary" id="submitRole">
                        <span class="indicator-label">Submit</span>
                        <span class="indicator-progress">
                            Please wait...
                            <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                        </span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

