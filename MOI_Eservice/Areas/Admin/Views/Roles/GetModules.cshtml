@model IEnumerable<ModuleVM>
@{
    ViewBag.Title = "Modules";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutEserviceTourism.cshtml";
}

<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">
        <div class="card card-flush">
            <div class="card-header mt-6">
                <div class="card-title">
                    <div class="d-flex align-items-center position-relative my-1 me-5">
                        <i class="ki-outline ki-magnifier fs-3 position-absolute ms-5"></i>
                        <input type="text" id="workflowSearch" class="form-control form-control-solid w-250px ps-13" placeholder="Search Modules" onkeyup="filterTable()" />
                    </div>
                </div>
                <div class="card-toolbar">
                    <button type="button" class="btn btn-light-primary" data-bs-toggle="modal" data-bs-target="#kt_modal_add_module">
                        <i class="ki-outline ki-plus-square fs-3"></i>Add Module
                    </button>
                </div>
            </div>
            <div class="card-body pt-0">
                <table class="table align-middle table-row-dashed fs-6 gy-5 mb-0" id="kt_modules_table">
                    <thead>
                        <tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase gs-0">
                            <th>#</th>
                            <th class="min-w-150px">Name</th>
                            <th class="min-w-250px">Description</th>
                            <th class="text-end min-w-100px">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="fw-semibold text-gray-600">
                        @if (Model != null)
                        {
                            int serial = 0;
                            foreach (var module in Model)
                            {
                                serial++;
                                <tr>
                                    <td>@serial</td>
                                    <td>@module.Name</td>
                                    <td>@module.Description</td>
                                    <td class="text-end">
                                        <button class="btn btn-icon btn-active-light-primary w-30px h-30px me-3 edit-module-button"
                                                data-bs-toggle="modal"
                                                data-bs-target="#kt_modal_edit_module"
                                                data-id="@module.Id"
                                                data-name="@module.Name"
                                                data-description="@module.Description">
                                            <i class="ki-outline ki-setting-3 fs-3"></i>
                                        </button>
                                        <button class="btn btn-icon btn-active-light-primary w-30px h-30px delete-module-button"
                                                data-id="@module.Id">
                                            <i class="ki-outline ki-trash fs-3"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted">No modules available.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add Module Modal -->
<div class="modal fade" id="kt_modal_add_module" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="fw-bold">Add Module</h2>
                <button class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal">
                    <i class="ki-outline ki-cross fs-1"></i>
                </button>
            </div>
            <div class="modal-body">
                <form id="AddModuleForm">
                    <div class="fv-row mb-7">
                        <label class="fs-6 fw-semibold mb-2">Name</label>
                        <input type="text" class="form-control form-control-solid" id="AddName" placeholder="Enter module name" />
                    </div>
                    <div class="fv-row mb-7">
                        <label class="fs-6 fw-semibold mb-2">Description</label>
                        <input type="text" class="form-control form-control-solid" id="AddDescription" placeholder="Enter description" />
                    </div>
                    <div class="text-center">
                        <button type="button" class="btn btn-primary" id="submitAddModule">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Edit Module Modal -->
<div class="modal fade" id="kt_modal_edit_module" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="fw-bold">Edit Module</h2>
                <button class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal">
                    <i class="ki-outline ki-cross fs-1"></i>
                </button>
            </div>
            <div class="modal-body">
                <form id="EditModuleForm">
                    <input type="hidden" id="EditId" />
                    <div class="fv-row mb-7">
                        <label class="fs-6 fw-semibold mb-2">Name</label>
                        <input type="text" class="form-control form-control-solid" id="EditName" />
                    </div>
                    <div class="fv-row mb-7">
                        <label class="fs-6 fw-semibold mb-2">Description</label>
                        <input type="text" class="form-control form-control-solid" id="EditDescription" />
                    </div>
                    <div class="text-center">
                        <button type="button" class="btn btn-primary" id="submitEditModule">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const apiBaseUrl = '@ViewBag.ApiBaseUrl';

        document.getElementById("submitAddModule").addEventListener("click", async function () {
            try {
                const data = {
                    Name: document.getElementById("AddName").value,
                    Description: document.getElementById("AddDescription").value
                };

                const response = await fetch(`${apiBaseUrl}AddModule`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(data)
                });

                if (!response.ok) throw new Error("Failed to add module");

                alert("Module added successfully!");
                location.reload();
            } catch (error) {
                alert("Failed to add module. Try again.");
                console.error(error);
            }
        });

        document.getElementById("submitEditModule").addEventListener("click", async function () {
            try {
                const data = {
                    Id: document.getElementById("EditId").value,
                    Name: document.getElementById("EditName").value,
                    Description: document.getElementById("EditDescription").value
                };

                const response = await fetch(`${apiBaseUrl}EditModule`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(data)
                });

                if (!response.ok) throw new Error("Failed to update module");

                alert("Module updated successfully!");
                location.reload();
            } catch (error) {
                alert("Failed to update module. Try again.");
                console.error(error);
            }
        });

        document.querySelectorAll(".delete-module-button").forEach(button => {
            button.addEventListener("click", async function () {
                const moduleId = this.getAttribute("data-id");

                if (!confirm("Are you sure you want to delete this module?")) return;

                try {
                    const response = await fetch(`${apiBaseUrl}DeleteModule`, {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ Id: moduleId })
                    });

                    if (!response.ok) throw new Error("Failed to delete module");

                    alert("Module deleted successfully!");
                    location.reload();
                } catch (error) {
                    alert("Failed to delete module. Try again.");
                    console.error(error);
                }
            });
        });

        document.querySelectorAll(".edit-module-button").forEach(button => {
            button.addEventListener("click", function () {
                document.getElementById("EditId").value = this.getAttribute("data-id");
                document.getElementById("EditName").value = this.getAttribute("data-name");
                document.getElementById("EditDescription").value = this.getAttribute("data-description");
            });
        });
    </script>
}
