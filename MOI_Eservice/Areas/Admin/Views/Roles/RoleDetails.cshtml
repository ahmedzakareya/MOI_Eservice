@model RoleVMV
@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutEserviceTourism.cshtml";
}
<!--begin::Main-->
<div class="app-main flex-column flex-row-fluid" id="kt_app_main">
    <!--begin::Content wrapper-->
    <div class="d-flex flex-column flex-column-fluid">
        <!--begin::Toolbar-->
        <div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2">
            <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex align-items-stretch">
                <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
                    <div class="page-title d-flex flex-column justify-content-center gap-1 me-3">
                        <h1 class="page-heading text-gray-900 fw-bold fs-3 m-0">تفاصيل الدور</h1>
                        <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                            <li class="breadcrumb-item text-muted"><a href="/Admin/Home/Index" class="text-muted text-hover-primary">الرئيسية</a></li>
                            <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                            <li class="breadcrumb-item text-muted">إدارة المستخدمين</li>
                            <li class="breadcrumb-item"><span class="bullet bg-gray-500 w-5px h-2px"></span></li>
                            <li class="breadcrumb-item text-muted">الأدوار</li>
                        </ul>
                    </div>
                    <div class="d-flex align-items-center gap-2 gap-lg-3">
                        <a href="#" class="btn btn-light-primary" data-bs-toggle="modal" data-bs-target="#kt_modal_add_user">إضافة مستخدم</a>
                        <a href="#" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#kt_modal_create_campaign">حملة جديدة</a>
                    </div>
                </div>
            </div>
        </div>
        <!--end::Toolbar-->
        <!--begin::Content-->
        <div id="kt_app_content" class="app-content flex-column-fluid">
            <div id="kt_app_content_container" class="app-container container-fluid">
                <div class="row">
                    <!--begin::Role Info-->
                    <div class="col-lg-4">
                        <div class="card card-flush">
                            <div class="card-header">
                                <h2 class="card-title mb-0">@Model.RoleName</h2>
                            </div>

                            <div class="card-body">
                                <h6 class="text-dark fw-bold mb-2">الوحدات:</h6>
                                @foreach (var module in Model.Modules)
                                {
                                    <div class="mb-4">
                                        <h6 class="text-primary">@module.Name</h6>
                                        <ul class="list-unstyled ps-3">
                                            @foreach (var menuItem in module.MenuItems)
                                            {
                                                <li class="mb-1">
                                                    <strong>القائمة:</strong> @menuItem.Name
                                                    <a href="@menuItem.Url" class="ms-2 text-muted fs-8" target="_blank">(عرض)</a>
                                                    <div>
                                                        @foreach (var permission in menuItem.Permissions)
                                                        {
                                                            <span class="badge badge-light-success me-1 mb-1">@permission.NameAr</span>
                                                        }
                                                    </div>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </div>

                            <div class="card-footer">
                                <button class="btn btn-light btn-active-primary w-100" data-bs-toggle="modal" data-bs-target="#kt_modal_update_role">تعديل الدور</button>
                            </div>
                        </div>
                    </div>
                    <!--end::Role Info-->
                    <!--begin::Assigned Users-->
                    <div class="col-lg-8">
                        <div class="card card-flush mb-6">
                            <div class="card-header">
                                <h3 class="card-title fw-bold">المستخدمون المعينون</h3>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-hover table-rounded table-row-bordered">
                                        <thead class="fw-bold fs-7 text-gray-600">
                                            <tr>
                                                <th>ID</th>
                                                <th>الاسم</th>
                                                <th>البريد الإلكتروني</th>
                                                <th>تاريخ الإنشاء</th>
                                                <th>آخر دخول</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var user in Model.userVMs)
                                            {
                                                <tr>
                                                    <td>@user.SysUserId</td>
                                                    <td>@user.Name</td>
                                                    <td>@user.Email</td>
                                                    <td>@user.CreateDate?.ToString("yyyy-MM-dd")</td>
                                                    <td>@user.LastLoginDate?.ToString("yyyy-MM-dd")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!--end::Assigned Users-->
                </div>
            </div>
        </div>
        <!--end::Content-->
    </div>
</div>
<!--end::Main-->
