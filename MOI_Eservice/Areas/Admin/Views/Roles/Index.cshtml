@model IEnumerable<RoleVMV>
@{
    ViewBag.Title = "Roles and Permissions";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutEserviceTourism.cshtml";
}

<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2">
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex align-items-stretch">
        <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
            <div class="page-title d-flex flex-column justify-content-center gap-1 me-3">
                <h1 class="page-heading d-flex flex-column justify-content-center text-gray-900 fw-bold fs-3 m-0">قائمة الصلاحيات</h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                    <li class="breadcrumb-item text-muted">
                        <a asp-action="Index" asp-controller="Home" class="text-muted text-hover-primary">الرئيسية</a>
                    </li>
                    <li class="breadcrumb-item">
                        <span class="bullet bg-gray-500 w-5px h-2px"></span>
                    </li>
                    <li class="breadcrumb-item text-muted">الصلاحيات</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!--end::Toolbar-->

<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-5 g-xl-9">
            @foreach (var role in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <h5 class="card-title text-primary mb-7">@role.RoleName</h5>
                            <div class="fw-bold text-gray-600 mb-5">عدد المستخدمين: @role.UserCount</div>

                            <!-- Modules Section -->
                            <h6 class="text-dark fw-bold">الوحدات:</h6>
                            <ul class="list-unstyled mb-4">
                                @foreach (var module in role.Modules)
                                {
                                    <li>
                                        <i class="bi bi-dot text-primary"></i> @module.Name
                                        <!-- Menu Items Section -->
                                       @*  <ul class="list-unstyled ms-4">
                                            @foreach (var menuItem in module.MenuItems)
                                            {
                                                <li>
                                                    <i class="bi bi-circle text-success"></i> @menuItem.Name
                                                    <a href="@menuItem.Url" target="_blank" class="ms-2 small text-muted">(عرض)</a>
                                                    <!-- Permissions Section -->
                                                    <ul class="list-unstyled ms-4">
                                                        @foreach (var permission in menuItem.Permissions)
                                                        {
                                                            <li>
                                                                <i class="bi bi-check text-warning"></i> @permission.NameAr
                                                            </li>
                                                        }
                                                    </ul>
                                                </li>
                                            }
                                        </ul> *@
                                    </li>
                                }
                            </ul>

                            <div class="d-flex justify-content-between">
                                <a asp-action="RoleDetails" asp-area="Admin" asp-controller="Roles" asp-route-id="@role.RoleId" class="btn btn-light btn-active-primary my-1 me-2">
                                    عرض
                                </a>
                               
                                <a asp-action="RoleEdit" asp-area="Admin" asp-controller="Roles" asp-route-id="@role.RoleId" class="btn btn-light btn-active-light-primary my-1">
                                    تعديل الصلاحية
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</div>
