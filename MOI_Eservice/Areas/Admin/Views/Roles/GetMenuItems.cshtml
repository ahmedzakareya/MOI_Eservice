@model List<AddMenuItemVM>

@{
    ViewBag.Title = "Menu Items Management";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutEserviceTourism.cshtml";
}

<!--begin::Content-->
<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">
        <!--begin::Card-->
        <div class="card card-flush">
            <!--begin::Card header-->
            <div class="card-header mt-6">
                <!--begin::Card title-->
                <div class="card-title">
                    <!-- Search -->
                    <div class="d-flex align-items-center position-relative my-1 me-5">
                        <i class="ki-outline ki-magnifier fs-3 position-absolute ms-5"></i>
                        <input type="text" id="menuSearch" class="form-control form-control-solid w-250px ps-13" placeholder="Search Menu Items" onkeyup="filterTable()" />
                    </div>
                </div>
                <!--end::Card title-->
                <!--begin::Card toolbar-->
                <div class="card-toolbar">
                    <button type="button" class="btn btn-light-primary" data-bs-toggle="modal" data-bs-target="#kt_modal_add_menu_item">
                        <i class="ki-outline ki-plus-square fs-3"></i>Add Menu Item
                    </button>
                </div>
                <!--end::Card toolbar-->
            </div>
            <!--end::Card header-->
            <!--begin::Card body-->
            <div class="card-body pt-0">
                <!--begin::Table-->
                <table class="table align-middle table-row-dashed fs-6 gy-5 mb-0" id="menuItemsTable">
                    <thead>
                        <tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase gs-0">
                            <th>#</th>
                            <th>Name</th>
                            <th>Module</th>
                            <th>URL</th>
                           
                            <th>Visible</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="fw-semibold text-gray-600">
                        @if (Model != null && Model.Count > 0)
                        {
                            int serial = 0;
                            foreach (var item in Model)
                            {
                                serial++;
                                <tr data-visible="@item.IsVisible">
                                    <td>@serial</td>
                                    <td>@item.Name</td>
                                    <td>@item.ModuleName</td>
                                    <td>@item.Url</td>
                                   
                                    <td>
                                        <input type="checkbox" class="form-check-input visibility-toggle" data-id="@item.Id" @(item.IsVisible ? "checked" : "") />
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-icon btn-active-light-primary w-30px h-30px me-3 edit-menu-item" data-id="@item.Id" data-bs-toggle="modal" data-bs-target="#kt_modal_edit_menu_item">
                                            <i class="ki-outline ki-setting-3 fs-3"></i>
                                        </button>
                                        <button class="btn btn-icon btn-active-light-primary w-30px h-30px delete-menu-item" data-id="@item.Id">
                                            <i class="ki-outline ki-trash fs-3"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted">No menu items available.</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <!--end::Table-->
            </div>
            <!--end::Card body-->
        </div>
        <!--end::Card-->
    </div>
</div>
<!--end::Content-->
<!-- Add Menu Item Modal -->
<div class="modal fade" id="kt_modal_add_menu_item" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="fw-bold">Add Menu Item</h2>
                <div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal">
                    <i class="ki-outline ki-cross fs-1"></i>
                </div>
            </div>
            <div class="modal-body scroll-y mx-5 my-7">
                <form id="addMenuItemForm">
                    <div class="fv-row mb-7">
                        <label class="fs-6 fw-semibold form-label mb-2">Name</label>
                        <input class="form-control form-control-solid" id="Name" placeholder="Enter menu item name" required />
                    </div>
                    <div class="fv-row mb-7">
                        <label class="fs-6 fw-semibold form-label mb-2">URL</label>
                        <input class="form-control form-control-solid" id="Url" placeholder="Enter menu item URL" required />
                    </div>
                    <div class="fv-row mb-7">
                        <label class="fs-6 fw-semibold form-label mb-2">Module</label>
                        <select id="ModuleDropdown" class="form-select form-select-solid"></select>
                    </div>
                    <div class="fv-row mb-7">
                        <label class="form-check form-check-custom form-check-solid">
                            <input class="form-check-input" type="checkbox" id="IsVisible" />
                            <span class="form-check-label">Visible</span>
                        </label>
                    </div>
                    <div class="text-center pt-15">
                        <button type="button" class="btn btn-primary" id="submitMenuItem">Submit</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Edit Menu Item Modal -->
<div class="modal fade" id="kt_modal_edit_menu_item" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="fw-bold">Edit Menu Item</h2>
                <div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal">
                    <i class="ki-outline ki-cross fs-1"></i>
                </div>
            </div>
            <div class="modal-body scroll-y mx-5 my-7">
                <form id="editMenuItemForm">
                    <input type="hidden" id="editMenuItemId" />
                    <div class="fv-row mb-7">
                        <label class="fs-6 fw-semibold form-label mb-2">Name</label>
                        <input class="form-control form-control-solid" id="editName" placeholder="Enter menu item name" required />
                    </div>
                    <div class="fv-row mb-7">
                        <label class="fs-6 fw-semibold form-label mb-2">URL</label>
                        <input class="form-control form-control-solid" id="editUrl" placeholder="Enter menu item URL" required />
                    </div>
                    <div class="fv-row mb-7">
                        <label class="fs-6 fw-semibold form-label mb-2">Module</label>
                        <select id="editModuleDropdown" class="form-select form-select-solid"></select>
                    </div>
                    <div class="fv-row mb-7">
                        <label class="form-check form-check-custom form-check-solid">
                            <input class="form-check-input" type="checkbox" id="editIsVisible" />
                            <span class="form-check-label">Visible</span>
                        </label>
                    </div>
                    <div class="text-center pt-15">
                        <button type="button" class="btn btn-primary" id="submitEditMenuItem">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        const apiBaseUrl = '@ViewBag.ApiBaseUrl';

        // Fetch and populate modules
        async function populateModules(dropdownId, selectedModuleId = null) {
            try {
                const response = await fetch(`${apiBaseUrl}GetModules`);
                if (!response.ok) throw new Error("Failed to fetch modules");

                const modules = await response.json();
                const dropdown = document.getElementById(dropdownId);
                dropdown.innerHTML = '<option value="" disabled selected>-- Select Module --</option>';
                modules.$values.forEach(module => {
                    const option = document.createElement("option");
                    option.value = module.id;
                    option.textContent = module.name;
                    if (selectedModuleId && module.id === selectedModuleId) option.selected = true;
                    dropdown.appendChild(option);
                });
            } catch (error) {
                console.error("Error populating modules:", error);
            }
        }

        // Add Menu Item
        document.getElementById("submitMenuItem").addEventListener("click", async function () {
            try {
                const data = {
                    Name: document.getElementById("Name").value,
                    Url: document.getElementById("Url").value,
                    ModuleId: document.getElementById("ModuleDropdown").value,
                    IsVisible: document.getElementById("IsVisible").checked
                };
                const response = await fetch(`${apiBaseUrl}AddMenuItem`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(data)
                });
                if (!response.ok) throw new Error("Failed to add menu item");
                alert("Menu item added successfully!");
                location.reload();
            } catch (error) {
                alert("Failed to add menu item. Try again.");
                console.error(error);
            }
        });

        // Edit Menu Item
        document.querySelectorAll(".edit-menu-item").forEach(button => {
            button.addEventListener("click", async function () {
                const id = button.getAttribute("data-id");
                const response = await fetch(`${apiBaseUrl}GetMenuItemById/${id}`);
                const menuItem = await response.json();
                document.getElementById("editMenuItemId").value = menuItem.id;
                document.getElementById("editName").value = menuItem.name;
                document.getElementById("editUrl").value = menuItem.url;
                document.getElementById("editIsVisible").checked = menuItem.isVisible;
                await populateModules("editModuleDropdown", menuItem.moduleId);
            });
        });

        document.getElementById("submitEditMenuItem").addEventListener("click", async function () {
            try {
                const data = {
                    Id: document.getElementById("editMenuItemId").value,
                    Name: document.getElementById("editName").value,
                    Url: document.getElementById("editUrl").value,
                    ModuleId: document.getElementById("editModuleDropdown").value,
                    IsVisible: document.getElementById("editIsVisible").checked
                };
                const response = await fetch(`${apiBaseUrl}EditMenuItem`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(data)
                });
                if (!response.ok) throw new Error("Failed to edit menu item");
                alert("Menu item updated successfully!");
                location.reload();
            } catch (error) {
                alert("Failed to update menu item. Try again.");
                console.error(error);
            }
        });

        // Delete Menu Item
        document.querySelectorAll(".delete-menu-item").forEach(button => {
            button.addEventListener("click", async function () {
                if (!confirm("Are you sure you want to delete this menu item?")) return;
                const id = button.getAttribute("data-id");
                try {
                    const response = await fetch(`${apiBaseUrl}DeleteMenuItem/${id}`, { method: "POST" });
                    if (!response.ok) throw new Error("Failed to delete menu item");
                    alert("Menu item deleted successfully!");
                    location.reload();
                } catch (error) {
                    alert("Failed to delete menu item. Try again.");
                    console.error(error);
                }
            });
        });

        // Filter Menu Items
        document.getElementById("menuSearch").addEventListener("keyup", function () {
            const searchText = this.value.toLowerCase();
            document.querySelectorAll("#menuItemsTable tbody tr").forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(searchText) ? "" : "none";
            });
        });

        // Populate Add Modal Modules on Load
        document.addEventListener("DOMContentLoaded", async function () {
            await populateModules("ModuleDropdown");
        });
    </script>
}
