@model List<SystemOptionVM>

@{
    ViewBag.Title = "System Options Management";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutEserviceTourism.cshtml";
}

<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2">
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex align-items-stretch">
        <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
            <div class="page-title d-flex flex-column justify-content-center gap-1 me-3">
                <h1 class="page-heading d-flex flex-column justify-content-center text-gray-900 fw-bold fs-3 m-0">System Options Management</h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                    <li class="breadcrumb-item text-muted">
                        <a asp-action="Index" asp-controller="Home" class="text-muted text-hover-primary">Home</a>
                    </li>
                    <li class="breadcrumb-item">
                        <span class="bullet bg-gray-500 w-5px h-2px"></span>
                    </li>
                    <li class="breadcrumb-item text-muted">System Options</li>
                </ul>
            </div>
            <div class="d-flex align-items-center gap-2 gap-lg-3">
                <a asp-action="CreateSystemOptions" asp-controller="SystemOption" asp-area="Admin" class="btn btn-primary">Add System Option</a>
            </div>
        </div>
    </div>
</div>
<!--end::Toolbar-->
<!--begin::Content-->
<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-fluid">
        <div class="card">
            <div class="card-header border-0 pt-6">
                <div class="card-title">
                    <div class="d-flex align-items-center position-relative my-1">
                        <i class="ki-outline ki-magnifier fs-3 position-absolute ms-5"></i>
                        <input type="text" id="systemOptionSearch" class="form-control form-control-solid w-250px ps-12" placeholder="Search System Options" onkeyup="filterTable()" />
                    </div>
                </div>
                <div class="card-toolbar">
                    <div class="d-flex justify-content-end">
                        <label class="me-3">
                            <input type="checkbox" id="toggleVisibility" onchange="toggleVisibilityFilter()" />
                            Show Only Active Options
                        </label>
                    </div>
                </div>
            </div>

            <div class="card-body pt-0">
                <table class="table align-middle table-row-dashed fs-6 gy-5" id="systemOptionTable">
                    <thead>
                        <tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0">
                            <th>#</th>
                            <th>Arabic Name</th>
                            <th>English Name</th>
                            <th>Code</th>

                            <th>Category (Arabic)</th>
                            <th>Category (English)</th>
                            <th>Control Type</th>
                            <th>Is Active</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="text-gray-600 fw-semibold">
                        @if (Model != null && Model.Count > 0)
                        {
                            int serial = 0;
                            foreach (var item in Model)
                            {
                                serial++;
                                <tr>
                                    <td>@serial</td>
                                    <td>@item.NameArabic</td>
                                    <td>@item.NameEnglish</td>
                                    <td>@item.Code</td>

                                    <td>@item.CategoryNameAr</td>
                                    <td>@item.CategoryNameEn</td>
                                    <td>@item.ControlType</td>
                                    <td>
                                        <input type="checkbox" class="form-check-input visibility-toggle" data-id="@item.Id" @(item.IsActive ? "checked" : "") />
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="EditSystemOptions" asp-route-id="@item.Id" asp-area="Admin" class="btn btn-icon btn-active-light-primary">
                                            <i class="ki-outline ki-setting-3 fs-3"></i>
                                        </a>
                                        <a href="javascript:void(0);" class="btn btn-icon btn-active-light-primary delete-SystemOption" data-id="@item.Id">
                                         <i class="ki-outline ki-trash fs-3"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted">No system options available.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<!--end::Content-->
@section Scripts
{
    <script>
        // Filter Table
        function filterTable() {
            const searchInput = document.getElementById("systemOptionSearch").value.toLowerCase();
            const rows = document.querySelectorAll("#systemOptionTable tbody tr");
            rows.forEach(row => {
                const cells = row.querySelectorAll("td");
                let match = false;
                cells.forEach(cell => {
                    if (cell.textContent.toLowerCase().includes(searchInput)) {
                        match = true;
                    }
                });
                row.style.display = match ? "" : "none";
            });
        }

        // Toggle visibility filter
        function toggleVisibilityFilter() {
            const isChecked = document.getElementById("toggleVisibility").checked;
            const rows = document.querySelectorAll("#systemOptionTable tbody tr");
            rows.forEach(row => {
                const visibilityToggle = row.querySelector(".visibility-toggle");
                if (isChecked && !visibilityToggle.checked) {
                    row.style.display = "none";
                } else {
                    row.style.display = "";
                }
            });
        }
    </script>
    <script>
        const apiBaseUrl = '@ViewBag.ApiBaseUrl';
   document.querySelectorAll(".delete-SystemOption").forEach(button => {
    button.addEventListener("click", async function () {
        if (!confirm("Are you sure you want to delete this SystemOption?")) return;

        const id = button.getAttribute("data-id");  // Get the ID of the system option
        const requestData = {
            ActionType: 'delete',  // Action type is delete
            Data: { Id: id }       // Pass the id in the Data object
        };

        try {
            // Make a POST request to delete the system option by ID
            const response = await fetch(`${apiBaseUrl}HandlePost`, {
                method: "POST",
                headers: {
                    'Content-Type': 'application/json'  // Send JSON data
                },
                body: JSON.stringify(requestData)  // Send the action type and data in the body
            });

            if (!response.ok) throw new Error("Failed to delete System Option");

            // If the delete is successful, remove the row from the table
            const row = button.closest('tr');
            row.remove();

            alert("SystemOption deleted successfully!");
        } catch (error) {
            alert("Failed to delete SystemOption. Try again.");
            console.error(error);
        }
    });
});
</script>

}
