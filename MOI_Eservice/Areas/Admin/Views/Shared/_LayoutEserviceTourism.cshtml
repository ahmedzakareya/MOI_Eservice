@using Newtonsoft.Json
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration;
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var userDataJson = HttpContextAccessor.HttpContext.Session.GetString("UserData");
    //var url = HttpContextAccessor.HttpContext.Session.GetString("url");
    // Check if the session data is not null or empty
    string? username = null;
    if (!string.IsNullOrEmpty(userDataJson))
    {
        // Deserialize the JSON string to a `SysUserVM` object
        var userData = JsonConvert.DeserializeObject<SysUserVM>
    (userDataJson);

    // Access the `UserId` property from the `SysUserVM` object
    username= userData?.Username;
    }
    }
