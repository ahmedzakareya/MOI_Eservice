<div class="card">
    <div class="card-header">
        <h5 class="card-title">إضافة مرفق</h5>
    </div>
    <div class="card-body">
        <form id="attachmentUploadForm" method="post" enctype="multipart/form-data">
            <input type="hidden" name="RequestId" value="@ViewBag.RequestId" />
            <input type="hidden" name="ReqNo" value="@ViewBag.ReqNo" />
            <input type="hidden" id="uploadUrl" value="@ViewBag.UploadUrl" />

            <div id="attachmentFields">
                @if (ViewBag.AttachmentRules != null)
                {
                  int fileIndex = 0; 
@foreach (var rule in ViewBag.AttachmentRules)
{
    <div class="row mb-3">
        <div class="col-md-10">
            <label>
                @rule.AttachName
                @if (rule.IsMandatory)
                {
                    <span class="text-danger">* (إجباري)</span>
                }
            </label>
            <input type="file"
                   name="AttachmentFiles-@fileIndex"
                   class="form-control"
                   data-mandatory="@rule.IsMandatory"
                   data-filename="@rule.AttachName"
                    data-fieldname="@rule.FieldName"
                   @(rule.IsMandatory ? "required" : "") />
        </div>
        @* <div class="col-md-2">
            <button type="button" class="btn btn-danger removeField">إزالة</button>
        </div> *@
    </div>
    fileIndex++;
}
                }
            </div>
            <button type="button" class="btn btn-success"  data-bs-toggle="modal" data-bs-target="#attachmentModal">
                + إضافة مرفقات أخري
            </button>
@*             <button type="button" class="btn btn-success"  id="addAttachmentField"  data-bs-toggle="modal" data-bs-target="#addAttachmentField">+  إضافة مرفقات أخري</button>
 *@@*             <button type="button" class="btn btn-primary submitAttachmentButton"  id="submitAttachmentButton">إرسال</button>
 *@        </form>
    </div>
</div>



<div class="modal fade" id="attachmentModal" tabindex="-1" aria-labelledby="attachmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="fw-bold">إضافة مرفق</h2>
                <div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal">
                    <i class="ki-outline ki-cross fs-1"></i>
                </div>
            </div>
            <div class="modal-body scroll-y mx-5 my-7">
                <form id="attachmentUploadForm" method="post" enctype="multipart/form-data">
                    <div id="attachmentFieldsModal">
                        <!-- Dynamic file inputs will be added here -->
                    </div>
                    <button type="button" class="btn btn-success" id="addMoreFields">إضافة مرفق جديد</button>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إغلاق</button>
                <button type="button" class="btn btn-primary" id="submitAttachmentButton">إرسال</button>
            </div>
        </div>
    </div>
</div>
