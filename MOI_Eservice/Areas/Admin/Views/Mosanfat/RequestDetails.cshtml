                                                                        @* كارت مرفقات الطلب *@
                                                                        <div class="card h-xl-100 mt-6" id="requestAttachmentsCard">
                                                                            <div class="card-header border-0 pt-5">
                                                                                <div class="card-title">
                                                                                    <div class="d-flex align-items-center">
                                                                                        <div class="symbol symbol-circle symbol-35px ms-3">
                                                                                            <div class="symbol-label bg-light-primary">
                                                                                                <i class="ki-outline ki-folder-down fs-2 text-primary"></i>
                                                                                            </div>
                                                                                        </div>
                                                                                        <div class="d-flex flex-column">
                                                                                            <span class="card-label fw-bold text-gray-900 fs-4">
                                                                                                مرفقات الطلب
                                                                                            </span>
                                                                                            <span class="text-muted fw-semibold fs-8 mt-1">
                                                                                                يمكنك الضغط على أي مرفق لعرضه داخل النظام في نافذة مستقلة
                                                                                            </span>
                                                                                        </div>
                                                                                    </div>
                                                                                </div>

                                                                                @if (Model.attachVMs != null && Model.attachVMs.Any())
                                                                                {
                                                                                    <div class="card-toolbar">
                                                                                        <span class="badge badge-light-primary fw-semibold fs-8">
                                                                                            @Model.attachVMs.Count() ملف
                                                                                        </span>
                                                                                    </div>
                                                                                }
                                                                            </div>

                                                                            <div class="card-body pt-6">
                                                                                <div class="attachments-body">
                                                                                    @if (Model.attachVMs != null && Model.attachVMs.Any())
                                                                                    {
                                                                                        foreach (var item in Model.attachVMs)
                                                                                        {
                                                                                            var fileUrl = Url.Content("~/" + ViewBag.PathAttachment + item.AttachPath);
                                                                                            var name = item.AttachName ?? "مرفق";
                                                                                            var extRaw = item.AttachPath ?? string.Empty;
                                                                                            var ext = System.IO.Path.GetExtension(extRaw).ToLower();

                                                                                            string fileTypeLabel;
                                                                                            string iconClass;
                                                                                            string bgClass;
                                                                                            string textClass;
                                                                                            string badgeClass;

                                                                                            if (ext == ".pdf")
                                                                                            {
                                                                                                fileTypeLabel = "ملف PDF";
                                                                                                iconClass = "ki-outline ki-file";
                                                                                                bgClass = "bg-light-danger";
                                                                                                textClass = "text-danger";
                                                                                                badgeClass = "badge-light-danger";
                                                                                            }
                                                                                            else if (ext == ".jpg" || ext == ".jpeg" || ext == ".png" || ext == ".gif")
                                                                                            {
                                                                                                fileTypeLabel = "صورة";
                                                                                                iconClass = "ki-outline ki-picture";
                                                                                                bgClass = "bg-light-success";
                                                                                                textClass = "text-success";
                                                                                                badgeClass = "badge-light-success";
                                                                                            }
                                                                                            else if (ext == ".doc" || ext == ".docx")
                                                                                            {
                                                                                                fileTypeLabel = "ملف Word";
                                                                                                iconClass = "ki-outline ki-file";
                                                                                                bgClass = "bg-light-primary";
                                                                                                textClass = "text-primary";
                                                                                                badgeClass = "badge-light-primary";
                                                                                            }
                                                                                            else if (ext == ".xls" || ext == ".xlsx")
                                                                                            {
                                                                                                fileTypeLabel = "ملف Excel";
                                                                                                iconClass = "ki-outline ki-file";
                                                                                                bgClass = "bg-light-success";
                                                                                                textClass = "text-success";
                                                                                                badgeClass = "badge-light-success";
                                                                                            }
                                                                                            else
                                                                                            {
                                                                                                fileTypeLabel = "ملف مرفق";
                                                                                                iconClass = "ki-outline ki-file";
                                                                                                bgClass = "bg-light-secondary";
                                                                                                textClass = "text-gray-700";
                                                                                                badgeClass = "badge-light-secondary";
                                                                                            }

                                                                                            <div class="d-flex align-items-center justify-content-between border rounded p-3 mb-3 attachment-item cursor-pointer"
                                                                                                 data-attach-name="@name"
                                                                                                 data-attach-url="@fileUrl"
                                                                                                 data-attach-key="@extRaw">
                                                                                                <div class="d-flex align-items-center flex-grow-1 overflow-hidden">
                                                                                                    <div class="symbol symbol-40px ms-3 flex-shrink-0">
                                                                                                        <div class="symbol-label @bgClass">
                                                                                                            <i class="@iconClass fs-2 @textClass"></i>
                                                                                                        </div>
                                                                                                    </div>

                                                                                                    <div class="d-flex flex-column flex-grow-1 overflow-hidden">
                                                                                                        <span class="fw-bold text-gray-900 text-hover-primary text-truncate"
                                                                                                              style="max-width: 260px;"
                                                                                                              title="@name">
                                                                                                            @name
                                                                                                        </span>

                                                                                                        <div class="d-flex align-items-center gap-2 mt-1">
                                                                                                            <span class="badge @badgeClass fw-semibold fs-8">
                                                                                                                @fileTypeLabel
                                                                                                            </span>
                                                                                                            @if (!string.IsNullOrEmpty(ext))
                                                                                                            {
                                                                                                                <span class="text-muted fs-8">
                                                                                                                    @(ext.ToUpper().Replace(".", ""))
                                                                                                                </span>
                                                                                                            }
                                                                                                        </div>
                                                                                                    </div>
                                                                                                </div>

                                                                                                <div class="d-flex align-items-center flex-shrink-0 ms-3">
                                                                                                    <button type="button"
                                                                                                            class="btn btn-sm btn-icon btn-light btn-active-light-primary rounded-circle"
                                                                                                            title="فتح المرفق">
                                                                                                        <i class="ki-outline ki-book-open fs-2"></i>
                                                                                                    </button>
                                                                                                </div>
                                                                                            </div>
                                                                                        }
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <div class="text-muted text-center py-4 fs-8">
                                                                                            لا توجد مرفقات
                                                                                        </div>
                                                                                    }
                                                                                </div>
                                                                            </div>
                                                                        </div>

                                                                    </div>

                                                                    <!-- العمود الأيسر: محتوى التابات + ملاحظات -->
                                                                    <div class="col-lg-8">
                                                                        <div class="row mt-10">
                                                                            <div class="col-lg-12">
                                                                                <div class="tab-content rounded h-100 bg-light p-10">
                                                                                    <!-- قبول الطلب -->
                                                                                    <div class="tab-pane fade show active" id="kt_upgrade_plan_startup">
