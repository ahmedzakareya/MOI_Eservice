                                                                                                /* ===================== STATS (Metronic-ish) ===================== */
#attachNormalWrap .attach-stats{
    background:#fff;
    border:1px solid #eef2f7;
    border-radius:18px;
    padding:16px 18px;
    box-shadow:0 10px 26px rgba(15,23,42,.06);
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:14px;
}

#attachNormalWrap .attach-stat{
    flex:1 1 0;
    min-width:0;
    padding:8px 8px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
}

#attachNormalWrap .attach-stat-sep{
    width:1px;
    align-self:stretch;
    background:linear-gradient(to bottom, transparent, rgba(15,23,42,.10), transparent);
    margin:0 6px;
}

/* left side: label + small icon chip */
#attachNormalWrap .attach-stat-label{
    display:flex;
    align-items:center;
    gap:10px;
    font-weight:800;
    font-size:13px;
    color:#7E8AA3; /* Metronic muted */
    letter-spacing:.1px;
}

#attachNormalWrap .attach-stat-label .stat-ic{
    width:38px;
    height:38px;
    border-radius:12px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    background:#f5f8ff;
    border:1px solid #e7efff;
}

/* make KeenIcons visible + sized */
#attachNormalWrap .attach-stat-label .stat-ic i{
    font-size:18px;
    line-height:1;
}

/* right side: number */
#attachNormalWrap .attach-stat-value{
    font-size:28px;
    font-weight:900;
    line-height:1;
    letter-spacing:.2px;
}

/* color variations */
#attachNormalWrap .attach-stat.stat-available .attach-stat-value{ color:#1d85d6; }  /* primary-ish */
#attachNormalWrap .attach-stat.stat-selected  .attach-stat-value{ color:#22c55e; }  /* success */

/* subtle bottom hint like Metronic badge */
#attachNormalWrap .attach-stat .stat-badge{
    display:inline-flex;
    align-items:center;
    gap:6px;
    font-size:11px;
    font-weight:900;
    padding:6px 10px;
    border-radius:999px;
    white-space:nowrap;
    border:1px solid transparent;
    background:#f7faff;
    color:#6b7a99;
}

#attachNormalWrap .attach-stat.stat-available .stat-badge{
    background:rgba(29,133,214,.08);
    border-color:rgba(29,133,214,.16);
    color:#1d85d6;
}
#attachNormalWrap .attach-stat.stat-selected .stat-badge{
    background:rgba(34,197,94,.10);
    border-color:rgba(34,197,94,.18);
    color:#16a34a;
}

@@media (max-width: 992px){
    #attachNormalWrap .attach-stats{ flex-direction:column; }
    #attachNormalWrap .attach-stat-sep{ width:100%; height:1px; }
    #attachNormalWrap .attach-stat{ width:100%; }
}

