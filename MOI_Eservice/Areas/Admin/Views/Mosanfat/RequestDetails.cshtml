        --b-navy-1:#1b2b78;
        --b-navy-2:#243a93;
        --b-navy-3:#2b46ad;
        --b-sky:#2ea6ff;
        --b-mint:#22c55e;

        --b-white:#ffffff;
        --b-soft:#f6f8ff;

        --b-text:#0f172a;
        --b-muted:#7b8aa6;

        --b-shadow: 0 18px 40px rgba(15, 23, 42, .16);
