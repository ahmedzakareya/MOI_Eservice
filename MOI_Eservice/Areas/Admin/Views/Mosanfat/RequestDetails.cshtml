        width: 100%;             /* ✅ stretch full container */
        max-width: 100%;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: var(--b-shadow);
        background: var(--b-navy-2);
        border: 1px solid rgba(255,255,255,.10);
        position: relative;
    }

    /* ===================== TOP BAR (tighter) ===================== */
    .ku-topbar{
        display:flex;
        align-items:flex-start;
        gap: 10px;
        padding: 12px 14px 8px 14px; /* ✅ reduced */
        background: var(--b-navy-1);
        border-bottom: 1px solid rgba(255,255,255,.10);
    }

    .ku-top-ic{
        width: 34px;
        height: 34px;
        border-radius: 10px;
        border: 1px solid rgba(255,255,255,.14);
        background: rgba(255,255,255,.08);
