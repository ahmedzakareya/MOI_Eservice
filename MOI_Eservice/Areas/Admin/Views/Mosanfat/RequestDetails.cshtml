    }

    #attachNormalWrap .note-counter {
        font-size: 12px;
        font-weight: 800;
        color: #7ea6c6;
    }

    #attachNormalWrap .dnd-note textarea {
        width: 100%;
        min-height: 80px;
        resize: vertical;
        border: 1px solid rgba(46,166,255,.16);
