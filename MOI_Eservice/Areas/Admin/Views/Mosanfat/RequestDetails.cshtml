<style>
    /* ===================== Invoice Styles (بدون تغيير) ===================== */
    #invoice {
        font-family: 'Courier New', Courier, monospace;
        direction: rtl;
        margin: 0;
        padding: 20px;
    }

    .invoice-wrapper {
        max-width: 350px;
        margin: auto;
        background-color: #ffffff;
        padding: 20px;
        border: 1px dashed #333;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }

    .invoice-banner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

        .invoice-banner img {
            max-height: 50px;
        }

    .invoice-details-box {
        border-top: 1px dashed #333;
        border-bottom: 1px dashed #333;
        padding: 10px 0;
        background-color: #fff;
    }

    .invoice-details {
        width: 100%;
        margin: 0 auto;
        font-size: 14px;
    }

        .invoice-details p {
            margin: 5px 0;
        }

    .invoice-total {
        font-size: 16px;
        font-weight: bold;
        margin-top: 10px;
        border-top: 1px dashed #333;
        padding-top: 10px;
    }

    .invoice-info {
        margin-top: 10px;
        font-size: 12px;
    }

    .invoice-print-btn {
        margin: 20px auto;
        padding: 10px 20px;
        background-color: #007bff;
        color: #ffffff;
        border: none;
        cursor: pointer;
        font-size: 14px;
        text-align: center;
        display: inline-block;
    }

        .invoice-print-btn:hover {
            background-color: #0056b3;
        }

    /* ===================== Attachments list inside change-status modal ===================== */

    .attachment-item {
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

        .attachment-item:hover {
            background-color: #f5f8fa;
        }

    /* Scroll داخلي لكارت المرفقات داخل مودال تغيير حالة الطلب */
    #kt_modal_stacked_1 #requestAttachmentsCard .attachments-body {
        max-height: 320px;
        overflow-y: auto;
    }

    /* ===================== Floating Preview Window (Metronic-like) ===================== */
    /*
                - نافذة مستقلة لكل مرفق
                - بدون Backdrop
                - قابلة للتحريك (JS)
                - قابلة لتغيير الحجم في كل الاتجاهات (resize: both)
            */

    .attachment-preview-window {
        position: fixed;
        top: 80px; /* نقطة البداية رأسياً */
        left: 50%; /* منتصف الشاشة أفقياً */
        transform: translateX(-50%); /* توسيط مبدئي */
        width: 360px; /* عرض مبدئي */
        height: 360px; /* ارتفاع مبدئي */
        min-width: 260px;
        min-height: 260px;
        max-width: 90vw;
        max-height: 90vh;
        background: #ffffff;
        border-radius: 0.75rem;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.35); /* قريب من ستايل Metronic */
        display: flex;
        flex-direction: column;
        resize: both; /* المستخدم يقدر يوسع ويصغّر في كل الاتجاهات */
        overflow: hidden;
        z-index: 1080; /* JS هيزود القيمة لما تفتح نافذة جديدة */
    }

    /* الهيدر (الهاندل اللي بيتسحب منه) */
    .attachment-preview-window-header {
        padding: 0.55rem 0.9rem;
        border-bottom: 1px solid #eff2f5; /* نفس لون البوردَر تقريباً في Metronic */
        background-color: #f9fafb;
        cursor: move; /* علشان المستخدم يفهم إنها قابلة للسحب */
    }

    .attachment-preview-title {
        font-size: 0.9rem;
        font-weight: 600;
        color: #181c32; /* نص غامق زي العناوين في Metronic */
    }

    .attachment-preview-window-header .btn,
    .attachment-preview-window-header .btn-close {
        font-size: 0.75rem;
    }

    /* الجسم الذي يحتوي على الـ iframe */
    .attachment-preview-window-body {
        flex: 1 1 auto;
        padding: 0;
    }

        .attachment-preview-window-body iframe {
            width: 100%;
            height: 100%;
            border: none;
            display: block;
        }


    /* Scroll داخلي لقائمة المرفقات داخل الكارد في مودال تغيير حالة الطلب */
    #kt_modal_stacked_1 #requestAttachmentsCard .attachments-body {
        max-height: 320px; /* ارتفاع الكارد جوه المودال */
        overflow-y: auto; /* Scroll لو زاد عدد المرفقات */
    }
    /* لا تسمح لمحتوى مودال تغيير حالة الطلب أن يتخطى ارتفاع الشاشة */
    #kt_modal_stacked_1 .modal-dialog {
        max-width: 1140px; /* نفس حجم modal-xl تقريبًا */
        margin: 1.75rem auto;
    }

    #kt_modal_stacked_1 .modal-content {
        max-height: calc(100vh - 3rem); /* المودال كله أقل من ارتفاع الشاشة */
        display: flex;
        flex-direction: column;
    }

    #kt_modal_stacked_1 .modal-body {
        overflow-y: auto; /* لو المحتوى طويل -> Scroll داخل المودال */
    }
    /* داخل مودال تغيير حالة الطلب فقط: خلي ارتفاع الكروت طبيعي */
    #kt_modal_stacked_1 .h-xl-100 {
        height: auto !important;
    }

    #requestsCardsRow .request-card .card-header {
        cursor: grab; /* when hover: show grab hand */
    }

        #requestsCardsRow .request-card .card-header:active {
            cursor: grabbing; /* while dragging */
        }
    /* Make dropzone look closer to the screenshot */
    .extra-dropzone {
        transition: background 0.2s ease, border-color 0.2s ease;
    }

        .extra-dropzone:hover {
            background-color: rgba(59, 130, 246, 0.06); /* light blue */
            border-color: #3b82f6;
        }

    /* File button inside table */
    .extra-file-btn {
        border-radius: 0.5rem;
    }

    /* Small text for file name */
    .extra-file-name {
        max-width: 180px;
        display: inline-block;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* ===================== MOI Floating Input (Metronic-friendly) ===================== */
    /* (Edited فقط هنا: زدنا الارتفاع + حلّينا ظهور calendar indicator لتاريخ السجل) */
    .moi-float {
        position: relative;
        border: 1px solid #d0d7e2;
        border-radius: 14px;
        overflow: hidden;
        background: #fff;
        /* ✅ زيادة بسيطة في الارتفاع */
        min-height: 54px;
    }

        /* Left icon segment */
        .moi-float .moi-ico {
            position: absolute;
            top: 0;
            left: 0;
            height: 100%;
            width: 46px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-left: 1px solid #e6ebf2;
            background: #fff;
            z-index: 3;
            color: #4b5675;
        }

        .moi-float .form-control {
            border: 0 !important;
            box-shadow: none !important;
            background: #fff !important;
            /* ✅ نفس الارتفاع الجديد */
            height: 54px;
            line-height: 54px;
            padding-left: 58px; /* icon width + spacing */
            padding-right: 14px;
            /* ✅ مساحة للفلوّت */
            padding-top: 20px;
            padding-bottom: 8px;
        }

        /* Floating label */
        .moi-float label {
            position: absolute;
            /* ✅ ضبط مكان الليبل بحيث لا يدخل فوق الايقون */
            left: 58px;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            font-weight: 700; /* bold */
            color: #6c757d;
            background: #fff;
            padding: 0 6px;
            pointer-events: none;
            transition: 0.15s ease;
            z-index: 4;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* When focused or has value -> float up */
        .moi-float .form-control:focus + label,
        .moi-float .form-control:not(:placeholder-shown) + label,
        .moi-float .form-control.has-value + label {
            top: 10px;
            transform: none;
            font-size: 12px;
            color: #0d6efd;
        }

        /* ✅ تاريخ السجل: نخلي مساحة للـ calendar icon + نخليه ظاهر وقابل للضغط */
        .moi-float input[type="date"].form-control {
            padding-right: 44px; /* مساحة للـ indicator */
            line-height: normal; /* أفضل للـ date */
        }

        .moi-float input[type="date"]::-webkit-calendar-picker-indicator {
            opacity: 0.9;
            cursor: pointer;
            margin-right: 8px;
        }

        /* Optional: focus border highlight */
        .moi-float:has(.form-control:focus) {
            border-color: #b7cffb;
        }

    /* ===================== Legacy helpers (بدون تغيير) ===================== */
    .moci-ig {
        border: 1px solid #d0d7e2;
        border-radius: 14px;
        overflow: hidden;
        background: #fff;
    }

    .moci-ig-icon {
        border: 0;
        background: #fff;
        min-width: 46px;
        justify-content: center;
        border-left: 1px solid #e6ebf2;
    }

    .moci-ig-input {
        border: 0 !important;
        box-shadow: none !important;
        background: #fff !important;
    }

    /* Floating label: keep it away from the icon area */
    .moci-float {
        position: relative;
    }

    .moci-float-label {
        padding-inline-start: 60px;
    }

    .moci-float .form-control:focus ~ .moci-float-label,
    .moci-float .form-control:not(:placeholder-shown) ~ .moci-float-label {
        opacity: .9;
    }

    .flatpickr-calendar {
        z-index: 99999 !important;
    }

    .moi-float .form-control {
        height: 60px;
        line-height: 60px;
        padding-top: 24px;
        padding-bottom: 10px;
    }

    .moi-float {
        min-height: 60px;
    }

    
</style>





