                        border: 1px solid #E4E6EF;
                        z-index: 9999;
                        transition: box-shadow 0.3s ease, transform 0.2s ease;
                        display: flex;
                        flex-direction: column;
                        animation: fadeInUp 0.3s ease-out;
                    }

