                                                                        @* كارت مرفقات الطلب *@
                                                                        <div class="card h-xl-100 mt-6 shadow-sm" id="requestAttachmentsCard" dir="rtl">
                                                                            <div class="card-header border-0 pt-5 pb-4">
                                                                                <div class="card-title">
                                                                                    <div class="d-flex align-items-center">
                                                                                        <div class="symbol symbol-circle symbol-35px ms-3">
                                                                                            <div class="symbol-label bg-light-primary">
                                                                                                <i class="ki-outline ki-folder-down fs-2 text-primary"></i>
                                                                                            </div>
                                                                                        </div>
                                                                                        <div class="d-flex flex-column">
                                                                                            <span class="card-label fw-bold text-gray-900 fs-4">مرفقات الطلب</span>
                                                                                            <span class="text-muted fw-semibold fs-8 mt-1">
                                                                                                يمكنك الضغط على أي مرفق لعرضه داخل النظام في نافذة مستقلة
                                                                                            </span>
                                                                                        </div>
                                                                                    </div>
                                                                                </div>

                                                                                @if (Model.attachVMs != null && Model.attachVMs.Any())
                                                                                {
                                                                                    <div class="card-toolbar">
                                                                                        <span class="badge badge-light-primary fw-semibold fs-8">
                                                                                            @Model.attachVMs.Count() ملف
                                                                                        </span>
                                                                                    </div>
                                                                                }
                                                                            </div>

                                                                            <div class="card-body pt-6">
                                                                                @if (Model.attachVMs != null && Model.attachVMs.Any())
                                                                                {
                                                                                    <div class="row g-4">
                                                                                        @foreach (var item in Model.attachVMs)
                                                                                        {
                                                                                            var fileUrl = Url.Content("~/" + ViewBag.PathAttachment + item.AttachPath);
                                                                                            var name = item.AttachName ?? "مرفق";
                                                                                            var extRaw = item.AttachPath ?? string.Empty;
                                                                                            var ext = System.IO.Path.GetExtension(extRaw).ToLower();

                                                                                            string fileTypeLabel;
                                                                                            string iconClass;
                                                                                            string bgClass;
                                                                                            string textClass;
                                                                                            string badgeClass;

                                                                                            if (ext == ".pdf")
                                                                                            {
                                                                                                fileTypeLabel = "PDF";
                                                                                                iconClass = "ki-outline ki-file";
                                                                                                bgClass = "bg-light-danger";
                                                                                                textClass = "text-danger";
                                                                                                badgeClass = "badge-light-danger";
                                                                                            }
                                                                                            else if (ext == ".jpg" || ext == ".jpeg" || ext == ".png" || ext == ".gif")
                                                                                            {
                                                                                                fileTypeLabel = "صورة";
                                                                                                iconClass = "ki-outline ki-picture";
                                                                                                bgClass = "bg-light-success";
                                                                                                textClass = "text-success";
                                                                                                badgeClass = "badge-light-success";
                                                                                            }
                                                                                            else if (ext == ".doc" || ext == ".docx")
                                                                                            {
                                                                                                fileTypeLabel = "Word";
                                                                                                iconClass = "ki-outline ki-file";
                                                                                                bgClass = "bg-light-primary";
                                                                                                textClass = "text-primary";
                                                                                                badgeClass = "badge-light-primary";
                                                                                            }
                                                                                            else if (ext == ".xls" || ext == ".xlsx")
                                                                                            {
                                                                                                fileTypeLabel = "Excel";
                                                                                                iconClass = "ki-outline ki-file";
                                                                                                bgClass = "bg-light-success";
                                                                                                textClass = "text-success";
                                                                                                badgeClass = "badge-light-success";
                                                                                            }
                                                                                            else
                                                                                            {
                                                                                                fileTypeLabel = "مرفق";
                                                                                                iconClass = "ki-outline ki-file";
                                                                                                bgClass = "bg-light-secondary";
                                                                                                textClass = "text-gray-700";
                                                                                                badgeClass = "badge-light-secondary";
                                                                                            }

                                                                                            <!-- ✅ كل عنصر في صف (Full Row) -->
                                                                                            <div class="col-12">
                                                                                                <div class="card border border-gray-200 shadow-sm rounded-4 h-100 attachment-item cursor-pointer"
                                                                                                     data-attach-name="@name"
                                                                                                     data-attach-url="@fileUrl"
                                                                                                     data-attach-key="@extRaw">

                                                                                                    <div class="card-body p-3 p-lg-4">

                                                                                                        <!-- ONE CLEAN HORIZONTAL ROW (no overlap) -->
                                                                                                        <div class="att-row d-flex align-items-center justify-content-between gap-3">

                                                                                                            <div class="att-left d-flex align-items-center gap-3 flex-grow-1">
                                                                                                                <div class="symbol symbol-40px flex-shrink-0">
                                                                                                                    <div class="symbol-label @bgClass">
                                                                                                                        <i class="@iconClass fs-2 @textClass"></i>
                                                                                                                    </div>
                                                                                                                </div>

                                                                                                                <span class="badge @badgeClass fw-semibold fs-8 flex-shrink-0">
                                                                                                                    @fileTypeLabel
                                                                                                                </span>

                                                                                                                <!-- التعديل هنا - السماح بسطرين فقط -->
                                                                                                                <div class="att-name fw-semibold fs-7 text-gray-900 flex-grow-1"
                                                                                                                     title="@name"
                                                                                                                     style="
                                                 display: -webkit-box;
                                                 -webkit-line-clamp: 2;
                                                 -webkit-box-orient: vertical;
                                                 overflow: hidden;
                                                 text-overflow: ellipsis;
                                                 line-height: 1.4;
                                                 max-height: 2.8em; /* 2 lines * line-height */
                                                     ">
                                                                                                                    @name
                                                                                                                </div>
                                                                                                            </div>

                                                                                                            <button type="button"
                                                                                                                    class="btn btn-sm btn-icon btn-light-primary btn-active-primary rounded-circle flex-shrink-0"
                                                                                                                    title="فتح المرفق">
                                                                                                                <i class="ki-outline ki-book-open fs-4"></i>
                                                                                                            </button>
                                                                                                        </div>

                                                                                                        <div class="separator my-3"></div>

                                                                                                        <!-- SECOND ROW (small meta) -->
                                                                                                        <div class="d-flex align-items-center justify-content-between">
                                                                                                            <span class="text-muted fs-9">اضغط لفتح المرفق</span>
                                                                                                            <span class="badge badge-light fw-semibold fs-9">
                                                                                                                @(string.IsNullOrWhiteSpace(ext) ? "FILE" : ext.Trim('.').ToUpperInvariant())
                                                                                                            </span>
                                                                                                        </div>

                                                                                                    </div>
                                                                                                </div>
                                                                                            </div>
                                                                                        }
                                                                                    </div>

                                                                                    <style>
                                                                                        /* حل مشكلة النص المقطوع */
                                                                                        #requestAttachmentsCard .att-left {
                                                                                            min-width: 0;
                                                                                            width: 100%;
                                                                                        }

                                                                                        #requestAttachmentsCard .att-name {
                                                                                            min-width: 0;
                                                                                            flex-grow: 1;
                                                                                            /* السماح بسطرين فقط */
                                                                                            display: -webkit-box;
                                                                                            -webkit-line-clamp: 2;
                                                                                            -webkit-box-orient: vertical;
                                                                                            overflow: hidden;
                                                                                            text-overflow: ellipsis;
                                                                                            line-height: 1.4;
                                                                                            max-height: 2.8em;
                                                                                        }

                                                                                        /* دعم للمتصفحات الأخرى */
                                                                                        #requestAttachmentsCard .att-name {
                                                                                            display: block;
                                                                                            line-height: 1.4;
                                                                                            max-height: 2.8em;
                                                                                            overflow: hidden;
                                                                                            position: relative;
                                                                                        }

                                                                                        /* Hover */
                                                                                        #requestAttachmentsCard .attachment-item {
                                                                                            transition: transform .12s ease, box-shadow .12s ease;
                                                                                        }

                                                                                            #requestAttachmentsCard .attachment-item:hover {
                                                                                                transform: translateY(-2px);
                                                                                                box-shadow: 0 10px 24px rgba(0,0,0,.08);
                                                                                            }

                                                                                        /* Fixed open button size */
                                                                                        #requestAttachmentsCard .btn.btn-icon {
                                                                                            width: 34px;
                                                                                            height: 34px;
                                                                                            flex-shrink: 0;
                                                                                        }

                                                                                        /* Vertical scroll for the attachments list */
                                                                                        #requestAttachmentsCard .card-body {
                                                                                            max-height: 520px;
                                                                                            overflow-y: auto;
                                                                                            overflow-x: hidden;
                                                                                        }

                                                                                        /* Optional: smoother scrolling */
                                                                                        #requestAttachmentsCard .card-body {
                                                                                            scroll-behavior: smooth;
                                                                                        }

                                                                                            /* Optional: nice scrollbar (Chrome/Edge) */
                                                                                            #requestAttachmentsCard .card-body::-webkit-scrollbar {
                                                                                                width: 10px;
                                                                                            }

                                                                                            #requestAttachmentsCard .card-body::-webkit-scrollbar-track {
                                                                                                background: #F5F8FA;
                                                                                                border-radius: 10px;
                                                                                            }

                                                                                            #requestAttachmentsCard .card-body::-webkit-scrollbar-thumb {
                                                                                                background: #C9D2E3;
                                                                                                border-radius: 10px;
                                                                                                border: 2px solid #F5F8FA;
                                                                                            }

                                                                                                #requestAttachmentsCard .card-body::-webkit-scrollbar-thumb:hover {
                                                                                                    background: #AEBBD2;
                                                                                                }
                                                                                    </style>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <div class="text-muted text-center py-4 fs-8">لا توجد مرفقات</div>
                                                                                }
                                                                            </div>



                                                                        </div>




                                                                    </div>

                                                                    <!-- العمود الأيسر: محتوى التابات + ملاحظات -->
                                                                    <div class="col-lg-8">
                                                                        <div class="row mt-10">
                                                                            <div class="col-lg-12">
                                                                                <div class="tab-content rounded h-100 bg-light p-10">

