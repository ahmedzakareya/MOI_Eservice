<script>
    // Attach modal header update based on clicked button
    document.addEventListener('DOMContentLoaded', function () {
        var modalEl = document.getElementById('kt_modal_stacked_1');
        if (!modalEl) return;

        var modalReqTypeEl = document.getElementById('modalRequestTypeText');
        var modalReqNoEl = document.getElementById('modalRequestNoText');

        modalEl.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            if (!button) return;

            var typeText = button.getAttribute('data-request-type');
            var reqNo = button.getAttribute('data-request-no');

            if (typeText && modalReqTypeEl) {
                modalReqTypeEl.textContent = typeText;
            }

            if (reqNo && modalReqNoEl) {
                modalReqNoEl.textContent = reqNo;
            }
        });
    });
</script>
<script>
    (function () {
        'use strict';

        var windowsByKey = {};
        var topZ = 1080;

        // Load Font Awesome
        function ensureFontAwesome() {
            if (document.querySelector('link[href*="font-awesome"]') ||
                document.querySelector('link[href*="fontawesome"]')) return;

            var link = document.createElement('link');
            link.rel = 'stylesheet';
            link.href = 'https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css';
            link.integrity = 'sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==';
            link.crossOrigin = 'anonymous';
            link.referrerPolicy = 'no-referrer';
            document.head.appendChild(link);
        }

        // Make window draggable
        function makeDraggable(winEl, handleEl) {
            if (!winEl || !handleEl) return;

            var dragging = false;
            var startX = 0, startY = 0;
            var startLeft = 0, startTop = 0;

            handleEl.addEventListener('mousedown', function (e) {
                if (e.target.closest('.no-drag')) return;

                e.preventDefault();
                dragging = true;

                var rect = winEl.getBoundingClientRect();
                startLeft = rect.left;
                startTop = rect.top;
                startX = e.clientX;
                startY = e.clientY;

                winEl.classList.add('dragging');
                winEl.style.transition = 'none';

                document.addEventListener('mousemove', onMouseMove);
                document.addEventListener('mouseup', onMouseUp);
            });

            function onMouseMove(e) {
                if (!dragging) return;

                var dx = e.clientX - startX;
                var dy = e.clientY - startY;

                var newLeft = startLeft + dx;
                var newTop = startTop + dy;

                var vw = window.innerWidth;
                var vh = window.innerHeight;
                var rect = winEl.getBoundingClientRect();
                var maxLeft = vw - rect.width;
                var maxTop = vh - rect.height;

                var margin = 20;
                if (newLeft < margin) newLeft = margin;
                if (newTop < margin) newTop = margin;
                if (newLeft > maxLeft - margin) newLeft = maxLeft - margin;
                if (newTop > maxTop - margin) newTop = maxTop - margin;

                winEl.style.left = newLeft + 'px';
                winEl.style.top = newTop + 'px';
                winEl.style.transform = '';
            }

            function onMouseUp() {
                if (!dragging) return;
                dragging = false;
                winEl.classList.remove('dragging');
                winEl.style.transition = '';
                document.removeEventListener('mousemove', onMouseMove);
                document.removeEventListener('mouseup', onMouseUp);
            }
        }

        // Inject preview CSS
        function ensurePreviewCss() {
