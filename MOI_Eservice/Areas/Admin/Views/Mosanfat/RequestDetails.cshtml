<script>
(function () {
    const availableZone = document.getElementById('dndAvailableZone');
    const selectedZone  = document.getElementById('dndSelectedZone');

    const availablePlaceholder = document.getElementById('availablePlaceholder');
    const selectedPlaceholder  = document.getElementById('selectedPlaceholder');

    const availableCount = document.getElementById('availableCount');
    const selectedCount  = document.getElementById('selectedCount');

    const resetBtn = document.getElementById('resetAll');
    const saveBtn  = document.getElementById('saveAttachments');

    const data = [
        { id: 'cbMotBook', text: 'كتاب وزارة التجارة - يجب أن يكون مصدقاً من الغرفة التجارية' },
        { id: 'cbCivilID', text: 'البطاقات المدنية لجميع الشركاء والمؤسسين في الشركة' },
        { id: 'cbQualification', text: 'المؤهل الدراسي لمدير الشركة مصدقاً من الجهات المختصة' },
        { id: 'cbRentReceipt', text: 'عقد الإيجار الحالي مع وصل الإيجار لآخر ثلاثة أشهر' },
        { id: 'cbMotRecord', text: 'السجل التجاري للشركة ساري المفعول ومحدث' }
    ];

    let dragItem = null;

    function init() {
        renderItems();
        updateCounts();
        updatePlaceholders();

        setupZoneBehavior(availableZone, false);
        setupZoneBehavior(selectedZone, true);

        resetBtn.addEventListener('click', onReset);
        saveBtn.addEventListener('click', onSave);
    }

    function renderItems() {
        availableZone.innerHTML = '';
        selectedZone.innerHTML  = '';

        availableZone.appendChild(availablePlaceholder);
        selectedZone.appendChild(selectedPlaceholder);

        data.forEach(item => availableZone.appendChild(createCard(item)));
    }

    function createCard(item) {
        const el = document.createElement('div');
        el.className = 'dnd-item';
        el.draggable = true;
        el.dataset.id = item.id;

        el.innerHTML = `
            <div class="dnd-top">
                <div class="dnd-title">${item.text}</div>
            </div>

            <div class="dnd-meta">
                <div class="dnd-handle" title="سحب">⋮⋮</div>
                <span class="dnd-badge badge-available">متاح</span>
            </div>

            <div class="dnd-sep"></div>

            <div class="dnd-note">
                <div class="note-head">
                    <span class="note-label">ملاحظات</span>
                    <span class="note-counter"><span class="char-count">0</span>/200</span>
                </div>
                <textarea placeholder="أضف ملاحظاتك حول هذا العنصر..."></textarea>
            </div>
        `;

        el.addEventListener('dragstart', function (e) {
            dragItem = el;
            el.classList.add('dragging');
            e.dataTransfer.setData('text/plain', el.dataset.id);
            e.dataTransfer.effectAllowed = 'move';
        });

        el.addEventListener('dragend', function () {
            el.classList.remove('dragging');
            dragItem = null;
            document.querySelectorAll('#attachNormalWrap .dnd-zone').forEach(z => z.classList.remove('drag-over'));
        });

        const textarea = el.querySelector('textarea');
        const countEl  = el.querySelector('.char-count');

        textarea.addEventListener('input', function () {
            countEl.textContent = textarea.value.length;
        });

        return el;
    }

    function setupZoneBehavior(zone, isSelectedZone) {
        zone.addEventListener('dragover', e => {
            e.preventDefault();
            zone.classList.add('drag-over');
            e.dataTransfer.dropEffect = 'move';
        });

        zone.addEventListener('dragleave', () => zone.classList.remove('drag-over'));

        zone.addEventListener('drop', e => {
            e.preventDefault();
            zone.classList.remove('drag-over');
            if (!dragItem) return;

            zone.appendChild(dragItem);

            const badge = dragItem.querySelector('.dnd-badge');
            const note  = dragItem.querySelector('.dnd-note');

            if (isSelectedZone) {
                badge.className = 'dnd-badge badge-selected';
                badge.textContent = 'مختار';
                note.style.display = 'block';
                setTimeout(() => dragItem.querySelector('textarea')?.focus(), 60);
            } else {
                badge.className = 'dnd-badge badge-available';
                badge.textContent = 'متاح';
                note.style.display = 'none';
            }

            updateCounts();
            updatePlaceholders();
        });
    }

    function updateCounts() {
        const av = availableZone.querySelectorAll('.dnd-item').length;
        const sel = selectedZone.querySelectorAll('.dnd-item').length;

        availableCount.textContent = av;
        selectedCount.textContent  = sel;
    }

    function updatePlaceholders() {
        availablePlaceholder.style.display = availableZone.querySelectorAll('.dnd-item').length ? 'none' : 'flex';
        selectedPlaceholder.style.display  = selectedZone.querySelectorAll('.dnd-item').length ? 'none' : 'flex';
    }

    function onReset() {
        if (!confirm('هل تريد إعادة تعيين جميع العناصر؟')) return;
        renderItems();
        updateCounts();
        updatePlaceholders();
    }

    function onSave() {
        const selectedItems = selectedZone.querySelectorAll('.dnd-item');
        const payload = [];

        selectedItems.forEach(item => {
            payload.push({
                id: item.dataset.id,
                title: item.querySelector('.dnd-title')?.textContent || '',
                note: item.querySelector('textarea')?.value || ''
            });
        });

        const oldText = saveBtn.textContent;
        saveBtn.disabled = true;
        saveBtn.textContent = 'جاري الحفظ...';

        setTimeout(() => {
            alert(`تم حفظ ${payload.length} عنصر`);
            saveBtn.disabled = false;
            saveBtn.textContent = oldText;
        }, 650);

        console.log('Saved data:', payload);
    }

    init();
})();
</script>


