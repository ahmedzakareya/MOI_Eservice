                                                                                                                            <path fill="white" d="M8.29 16.29l-3-3a1 1 0 0 1 0-1.42 1 1 0 0 1 1.42 0L9 14.59l6.29-6.29a1 1 0 0 1 1.42 0 1 1 0 0 1 0 1.42l-7 7a1 1 0 0 1-1.42 0z" />
