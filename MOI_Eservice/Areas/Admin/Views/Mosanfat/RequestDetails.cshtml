                                                                                                    function buildTypeMark(fieldType) {
                                                                                                        if (isAttachment(fieldType)) {
                                                                                                            return `
                                                                                                                <span class="dnd-type-attach" title="مرفق">
                                                                                                                    <span class="dnd-type-ic">${attachIconSvg()}</span>
                                                                                                                    <span class="dnd-type-txt">مرفق</span>
                                                                                                                </span>
                                                                                                            `;
                                                                                                        }

                                                                                                        if (isPartners(fieldType)) {
                                                                                                            return `
                                                                                                                <span class="dnd-type-partners" title="شركاء">
                                                                                                                    <span class="dnd-type-ic">${partnersIconSvg()}</span>
                                                                                                                    <span class="dnd-type-txt">شركاء</span>
                                                                                                                </span>
                                                                                                            `;
                                                                                                        }

                                                                                                        if (isAddress(fieldType)) {
                                                                                                            return `
                                                                                                                <span class="dnd-type-address" title="عنوان">
                                                                                                                    <span class="dnd-type-ic">${addressIconSvg()}</span>
                                                                                                                    <span class="dnd-type-txt">عنوان</span>
