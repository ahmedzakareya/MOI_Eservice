                                                                                        <script>
                                                                                            (function () {
                                                                                                var MODAL_ID = 'kt_modal_stacked_1';
                                                                                                var TARGET_SELECTOR = '.moci-hand-target';

                                                                                                function mociExists() {
                                                                                                    // التحقق من وجود MOCI
                                                                                                    if (document.querySelector('.moci-badge-glow')) return true;

                                                                                                    var card = document.querySelector('#mociDataCardWrap');
                                                                                                    if (card && !card.classList.contains('d-none')) return true;

                                                                                                    return false;
                                                                                                }

                                                                                                function runHandHintOnce() {
                                                                                                    // التحقق من وجود MOCI أولاً
                                                                                                    if (!mociExists()) {
                                                                                                        console.log('MOCI Hand Hint: لا يوجد MOCI');
                                                                                                        return;
                                                                                                    }

                                                                                                    // البحث عن العنصر المستهدف
                                                                                                    var el = document.querySelector(TARGET_SELECTOR);
                                                                                                    if (!el) {
                                                                                                        console.warn('MOCI Hand Hint: العنصر المستهدف غير موجود ->', TARGET_SELECTOR);
                                                                                                        return;
                                                                                                    }

                                                                                                    // إظهار اليد مباشرة (بدون أي شرط تخزين)
                                                                                                    el.classList.add('show-moci-hand');
                                                                                                    console.log('MOCI Hand Hint: ✅ إظهار اليد');

                                                                                                    // إخفاء اليد بعد 30 ثانية
                                                                                                    setTimeout(function () {
                                                                                                        el.classList.remove('show-moci-hand');
                                                                                                        console.log('MOCI Hand Hint: إخفاء اليد');
                                                                                                    }, 30000);
                                                                                                }

                                                                                                // وظائف مساعدة للتطوير والاختبار
                                                                                                window.showMociHand = function () {
                                                                                                    var el = document.querySelector(TARGET_SELECTOR);
                                                                                                    if (el) {
                                                                                                        el.classList.add('show-moci-hand');
                                                                                                        console.log('✅ اليد تظهر الآن (يدوياً)');

                                                                                                        setTimeout(function () {
                                                                                                            el.classList.remove('show-moci-hand');
                                                                                                        }, 30000);
                                                                                                    } else {
                                                                                                        console.warn('❌ العنصر غير موجود');
                                                                                                    }
                                                                                                }

                                                                                                window.hideMociHand = function () {
                                                                                                    var el = document.querySelector(TARGET_SELECTOR);
                                                                                                    if (el) {
                                                                                                        el.classList.remove('show-moci-hand');
                                                                                                        console.log('✅ اليد اختفت');
                                                                                                    }
                                                                                                }

                                                                                                // البحث عن المودال وإضافة المستمع
                                                                                                var modalEl = document.getElementById(MODAL_ID);
                                                                                                if (!modalEl) {
                                                                                                    console.warn('MOCI Hand Hint: المودال غير موجود ->', MODAL_ID);
                                                                                                    return;
                                                                                                }

                                                                                                // استمع لظهور المودال
                                                                                                modalEl.addEventListener('shown.bs.modal', function () {
                                                                                                    // تأخير بسيط لضمان تحميل جميع العناصر
                                                                                                    setTimeout(runHandHintOnce, 300);
                                                                                                });

                                                                                                // رسالة تحميل
                                                                                                console.log('✅ MOCI Hand Hint جاهز - استخدم showMociHand() للاختبار');

                                                                                                // (اختياري) تشغيل تلقائي عند تحميل الصفحة إذا كان المودال مفتوحاً
                                                                                                if (modalEl.classList.contains('show')) {
                                                                                                    setTimeout(runHandHintOnce, 500);
                                                                                                }

                                                                                            })();
                                                                                        </script>

                                                                                        <script>
                                                                                            (function () {
