                'ppt': 'عرض تقديمي',
                'pptx': 'عرض تقديمي',
                'mp4': 'فيديو',
                'mp3': 'صوت',
                'html': 'صفحة ويب',
                'css': 'تنسيق صفحات',
                'js': 'سكريبت'
            };
            return types[ext] || 'ملف';
        }

        function getFileIcon(fileType) {
            var icons = {
                'PDF': 'fas fa-file-pdf',
                'مستند Word': 'fas fa-file-word',
                'جدول Excel': 'fas fa-file-excel',
