        // Make window draggable
        function makeDraggable(winEl, handleEl) {
            if (!winEl || !handleEl) return;

            var dragging = false;
            var startX = 0, startY = 0;
            var startLeft = 0, startTop = 0;

            handleEl.addEventListener('mousedown', function (e) {
                if (e.target.closest('.no-drag')) return;

                e.preventDefault();
                dragging = true;

                var rect = winEl.getBoundingClientRect();
                startLeft = rect.left;
                startTop = rect.top;
                startX = e.clientX;
                startY = e.clientY;

                winEl.classList.add('dragging');
                winEl.style.transition = 'none';

                document.addEventListener('mousemove', onMouseMove);
                document.addEventListener('mouseup', onMouseUp);
            });

            function onMouseMove(e) {
                if (!dragging) return;

                var dx = e.clientX - startX;
                var dy = e.clientY - startY;

                var newLeft = startLeft + dx;
                var newTop = startTop + dy;

                var vw = window.innerWidth;
                var vh = window.innerHeight;
                var rect = winEl.getBoundingClientRect();
                var maxLeft = vw - rect.width;
                var maxTop = vh - rect.height;

                var margin = 20;
                if (newLeft < margin) newLeft = margin;
                if (newTop < margin) newTop = margin;
                if (newLeft > maxLeft - margin) newLeft = maxLeft - margin;
                if (newTop > maxTop - margin) newTop = maxTop - margin;

                winEl.style.left = newLeft + 'px';
                winEl.style.top = newTop + 'px';
                winEl.style.transform = '';
            }

            function onMouseUp() {
                if (!dragging) return;
                dragging = false;
                winEl.classList.remove('dragging');
                winEl.style.transition = '';
                document.removeEventListener('mousemove', onMouseMove);
                document.removeEventListener('mouseup', onMouseUp);
            }
        }

