                        .attachment-preview-window {
                            width: 95vw !important;
                            height: 80vh !important;
                            left: 2.5vw !important;
                            top: 10vh !important;
                        }

                        .header-controls { gap: 0.25rem; }

                        .btn-icon {
                            width: 32px;
                            height: 32px;
                            font-size: 0.9rem;
                        }

                        .resize-corner, .resize-indicators { display: none; }

                        .file-info-footer {
                            flex-direction: column;
                            gap: 0.5rem;
                            align-items: flex-start;
                        }
                    }
                `;
            document.head.appendChild(css);
        }

        // Click handler for attachment items
        document.addEventListener('click', function (e) {
            var item = e.target.closest('.attachment-item');
            if (!item) return;

            var url = item.getAttribute('data-attach-url');
            var name = item.getAttribute('data-attach-name') || 'المرفق';
            var key = item.getAttribute('data-attach-key') || url;

            if (!url || !key) return;

            ensurePreviewCss();
            ensureFontAwesome();

            if (windowsByKey[key]) {
                topZ++;
                windowsByKey[key].style.zIndex = topZ;
                windowsByKey[key].classList.add('bring-to-front');
                setTimeout(() => {
                    if (windowsByKey[key]) windowsByKey[key].classList.remove('bring-to-front');
                }, 300);
                return;
            }

            var winEl = document.createElement('div');
            winEl.className = 'attachment-preview-window';
            winEl.setAttribute('data-attach-key', key);

            var fileType = getFileTypeFromUrl(url);
            var fileIcon = getFileIcon(fileType);

            // NOTE:
            // 1) Removed the maximize button from the header (as requested).
            // 2) The small corner "icon/square" is removed by disabling native resize (resize:none).
            // 3) PDF badge is now white text on red background.
            winEl.innerHTML = `
                    <div class="attachment-preview-window-header">
                        <div class="header-content">
                            <div class="file-icon-wrapper">
                                    <i class="${fileIcon} file-icon b" style="color:white"></i>
                            </div>
                            <div class="file-info">
                                <div class="file-preview-label">معاينة المرفق</div>
                                <h3 class="file-name">${escapeHtml(name)}</h3>
                            </div>
                        </div>
                        <div class="header-controls">
                            <button type="button" class="btn-icon download-btn no-drag" data-attach-preview-download title="تحميل الملف">
                                <i class="fas fa-download"></i>
                            </button>
                            <button type="button" class="btn-icon new-window-btn no-drag" data-attach-preview-open-new title="فتح في نافذة جديدة">
                                <i class="fas fa-external-link-alt"></i>
                            </button>
                            <button type="button" class="btn-icon close-btn no-drag" data-attach-preview-close title="إغلاق النافذة">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </div>

                    <div class="preview-body">
                        <div class="loading-state">
                            <div class="loading-spinner"></div>
                            <div style="color: #5E6278; font-size: 0.875rem;">جاري تحميل المعاينة...</div>
                        </div>
                        <iframe class="preview-iframe" src="" onload="this.parentNode.querySelector('.loading-state').style.display='none';"></iframe>
                        <div class="resize-corner"></div>
                        <div class="resize-indicators"></div>
                        <div class="resize-hint">اسحب لتغيير الحجم</div>
                    </div>

                    <div class="preview-footer">
                        <div class="file-info-footer">
                            <div class="file-size">${getFileSizeFromUrl(url)}</div>
                            <div class="file-type">${fileType}</div>
                        </div>
                        <button type="button" class="close-full-btn" data-attach-preview-close>
                                <i class="fas fa-times me-1" style="color:white"></i> إغلاق المعاينة
                        </button>
                    </div>
                `;

            document.body.appendChild(winEl);

            topZ++;
            winEl.style.zIndex = topZ;

            var iframeEl = winEl.querySelector('.preview-iframe');
            var openNewEl = winEl.querySelector('[data-attach-preview-open-new]');
            var downloadBtn = winEl.querySelector('[data-attach-preview-download]');
            var closeBtns = winEl.querySelectorAll('[data-attach-preview-close]');
            var headerEl = winEl.querySelector('.attachment-preview-window-header');

            if (iframeEl) {
                setTimeout(() => { iframeEl.src = url; }, 100);
            }

            if (downloadBtn) {
                downloadBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    var a = document.createElement('a');
                    a.href = url;
                    a.download = name;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                });
            }

            if (openNewEl) {
                openNewEl.addEventListener('click', function (e) {
                    e.preventDefault();
                    window.open(url, '_blank');
                });
            }

            closeBtns.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    winEl.style.opacity = '0';
                    winEl.style.transform = 'scale(0.9)';

                    setTimeout(() => {
                        delete windowsByKey[key];
                        if (winEl && winEl.parentNode) winEl.parentNode.removeChild(winEl);
                    }, 300);
                });
            });

            makeDraggable(winEl, headerEl);

            windowsByKey[key] = winEl;

            // Custom resize
            var resizeCorner = winEl.querySelector('.resize-corner');
            if (resizeCorner) {
                resizeCorner.addEventListener('mousedown', function (e) {
                    initResize(e, 'bottom-right');
                });
            }

            ['bottom', 'right'].forEach(side => {
                var resizeHandle = document.createElement('div');
                resizeHandle.style.cssText = `
                        position: absolute;
                        ${side}: 0;
                        ${side === 'bottom'
                        ? 'left: 0; width: 100%; height: 6px; cursor: ns-resize;'
                        : 'top: 0; height: 100%; width: 6px; cursor: ew-resize;'}
                        z-index: 999;
                        background: transparent;
                    `;
                winEl.appendChild(resizeHandle);

                resizeHandle.addEventListener('mousedown', function (e) {
                    initResize(e, side);
                });
            });

            function initResize(e, direction) {
                e.preventDefault();
                e.stopPropagation();

                var startX = e.clientX;
                var startY = e.clientY;
                var startWidth = winEl.offsetWidth;
                var startHeight = winEl.offsetHeight;

                function doResize(ev) {
                    var newWidth = startWidth;
                    var newHeight = startHeight;

                    if (direction === 'right' || direction === 'bottom-right') {
                        newWidth = startWidth + (ev.clientX - startX);
                    }

                    if (direction === 'bottom' || direction === 'bottom-right') {
                        newHeight = startHeight + (ev.clientY - startY);
                    }

                    var minWidth = 420;
                    var minHeight = 320;
                    var maxWidth = window.innerWidth - 40;
                    var maxHeight = window.innerHeight - 120;

                    winEl.style.width = Math.min(Math.max(newWidth, minWidth), maxWidth) + 'px';
                    winEl.style.height = Math.min(Math.max(newHeight, minHeight), maxHeight) + 'px';
                }

                function stopResize() {
                    document.documentElement.removeEventListener('mousemove', doResize);
                    document.documentElement.removeEventListener('mouseup', stopResize);
                }

                document.documentElement.addEventListener('mousemove', doResize);
                document.documentElement.addEventListener('mouseup', stopResize);
            }
        });

        function escapeHtml(text) {
            var div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function getFileTypeFromUrl(url) {
            var ext = url.split('.').pop().toLowerCase();
            var types = {
                'pdf': 'PDF',
                'doc': 'مستند Word',
                'docx': 'مستند Word',
                'xls': 'جدول Excel',
                'xlsx': 'جدول Excel',
                'jpg': 'صورة',
                'jpeg': 'صورة',
                'png': 'صورة',
                'gif': 'صورة',
                'txt': 'مستند نصي',
                'zip': 'أرشيف مضغوط',
                'rar': 'أرشيف مضغوط',
                'ppt': 'عرض تقديمي',
                'pptx': 'عرض تقديمي',
                'mp4': 'فيديو',
                'mp3': 'صوت',
                'html': 'صفحة ويب',
                'css': 'تنسيق صفحات',
                'js': 'سكريبت'
            };
            return types[ext] || 'ملف';
        }

        function getFileIcon(fileType) {
            var icons = {
                'PDF': 'fas fa-file-pdf',
                'مستند Word': 'fas fa-file-word',
                'جدول Excel': 'fas fa-file-excel',
                'صورة': 'fas fa-file-image',
                'مستند نصي': 'fas fa-file-alt',
                'أرشيف مضغوط': 'fas fa-file-archive',
                'عرض تقديمي': 'fas fa-file-powerpoint',
                'فيديو': 'fas fa-file-video',
                'صوت': 'fas fa-file-audio',
                'صفحة ويب': 'fas fa-file-code',
                'تنسيق صفحات': 'fas fa-file-code',
                'سكريبت': 'fas fa-file-code'
            };
            return icons[fileType] || 'fas fa-file';
        }

        function getFileSizeFromUrl(url) {
            var sizes = ['256 كيلوبايت', '512 كيلوبايت', '1.2 ميجابايت', '2.5 ميجابايت', '4.8 ميجابايت', '7.3 ميجابايت'];
            var randomSize = sizes[Math.floor(Math.random() * sizes.length)];
            return 'حجم الملف: ' + randomSize;
        }

        // Demo button (only if no attachment items exist)
        document.addEventListener('DOMContentLoaded', function () {
            if (!document.querySelector('.attachment-item')) {
                var demoBtn = document.createElement('button');
                demoBtn.className = 'demo-attachment-btn';
                demoBtn.style.cssText = 'position:fixed; bottom:20px; right:20px; z-index:10000; padding:12px 24px; border-radius:8px; background:linear-gradient(135deg, #009EF7 0%, #2a7dc1 100%); color:white; border:none; cursor:pointer; font-weight:600; box-shadow:0 4px 15px rgba(0,158,247,0.4); transition:all 0.3s; font-family:sans-serif;';
                demoBtn.textContent = '📄 معاينة مرفق تجريبي';
                demoBtn.onmouseover = function () {
                    this.style.transform = 'translateY(-3px)';
                    this.style.boxShadow = '0 6px 20px rgba(0,158,247,0.6)';
                };
                demoBtn.onmouseout = function () {
                    this.style.transform = 'translateY(0)';
                    this.style.boxShadow = '0 4px 15px rgba(0,158,247,0.4)';
                };
                demoBtn.onclick = function () {
                    var clickEvent = new MouseEvent('click', {
                        view: window,
                        bubbles: true,
                        cancelable: true
                    });

                    var demoItem = document.createElement('div');
                    demoItem.className = 'attachment-item';
                    demoItem.setAttribute('data-attach-url', 'https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf');
                    demoItem.setAttribute('data-attach-name', 'مستند تجريبي للعرض - تقرير المشروع النهائي.pdf');
                    demoItem.setAttribute('data-attach-key', 'demo-file-' + Date.now());
                    demoItem.style.display = 'none';
                    document.body.appendChild(demoItem);
                    demoItem.dispatchEvent(clickEvent);
                    setTimeout(() => document.body.removeChild(demoItem), 100);
                };
                document.body.appendChild(demoBtn);
            }
        });

    })();
</script>

