                        gap: 0.75rem;
                        flex-grow: 1;
                        min-width: 0;
                    }

                    .file-icon-wrapper {
                        width: 40px;
                        height: 40px;
                        border-radius: 8px;
                        background: linear-gradient(135deg, #F64E60 0%, #EE2D41 100%);
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        flex-shrink: 0;
                        box-shadow: 0px 4px 8px rgba(246, 78, 96, 0.2);
