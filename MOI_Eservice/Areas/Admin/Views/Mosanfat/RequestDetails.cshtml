                                                                                                    // ===================== Render =====================
                                                                                                    function renderItems() {
                                                                                                        availableZone.innerHTML = '';
                                                                                                        selectedZone.innerHTML = '';

                                                                                                        availableZone.appendChild(availablePlaceholder);
                                                                                                        selectedZone.appendChild(selectedPlaceholder);

                                                                                                        data.forEach(item => {
                                                                                                            availableZone.appendChild(createCard(item));
                                                                                                        });

                                                                                                        updateCounts();
                                                                                                        updatePlaceholders();
                                                                                                    }

                                                                                                    function createCard(item) {
                                                                                                        const el = document.createElement('div');
                                                                                                        el.className = 'dnd-item';
                                                                                                        el.draggable = true;

                                                                                                        el.dataset.id = safeText(item.id);
                                                                                                        el.dataset.fieldType = safeText(item.fieldType);

                                                                                                        const title = safeText(item.text);
                                                                                                        const typeMark = buildTypeMark(item.fieldType);

                                                                                                        el.innerHTML = `
                                                                                                            <div class="dnd-top">
                                                                                                                <div class="dnd-file" title="عنصر">${dragDropSvg()}</div>
                                                                                                                <div class="dnd-title">
                                                                                                                    <span class="dnd-title-text">${title}</span>
                                                                                                                    ${typeMark}
                                                                                                                </div>
                                                                                                            </div>

                                                                                                            <div class="dnd-meta">
                                                                                                                <div class="dnd-grip" title="سحب وإفلات">
                                                                                                                    
                                                                                                                    <span>سحب/إفلات</span>
                                                                                                                </div>

                                                                                                                <span class="dnd-badge badge-available">متاح</span>
                                                                                                            </div>

                                                                                                            <div class="dnd-sep"></div>

                                                                                                            <div class="dnd-note" style="display:none;">
                                                                                                                <div class="note-head">
                                                                                                                    <span class="note-label">ملاحظات</span>
                                                                                                                    <span class="note-counter"><span class="char-count">0</span>/200</span>
                                                                                                                </div>
                                                                                                                <textarea maxlength="200" placeholder="أضف ملاحظاتك حول هذا العنصر..."></textarea>
                                                                                                            </div>
                                                                                                        `;

                                                                                                        el.addEventListener('dragstart', function (e) {
                                                                                                            dragItem = el;
                                                                                                            el.classList.add('dragging');
                                                                                                            e.dataTransfer.setData('text/plain', el.dataset.id);
                                                                                                            e.dataTransfer.effectAllowed = 'move';
                                                                                                        });

                                                                                                        el.addEventListener('dragend', function () {
                                                                                                            el.classList.remove('dragging');
                                                                                                            dragItem = null;
                                                                                                            document.querySelectorAll('#attachNormalWrap .dnd-zone')
                                                                                                                .forEach(z => z.classList.remove('drag-over'));
                                                                                                        });

                                                                                                        const textarea = el.querySelector('textarea');
                                                                                                        const countEl = el.querySelector('.char-count');
                                                                                                        textarea.addEventListener('input', function () {
                                                                                                            countEl.textContent = textarea.value.length;
                                                                                                        });

                                                                                                        return el;
                                                                                                    }

                                                                                                    function setupZoneBehavior(zone, isSelectedZone) {
                                                                                                        zone.addEventListener('dragover', e => {
                                                                                                            e.preventDefault();
                                                                                                            zone.classList.add('drag-over');
                                                                                                            e.dataTransfer.dropEffect = 'move';
                                                                                                        });

                                                                                                        zone.addEventListener('dragleave', () => zone.classList.remove('drag-over'));

                                                                                                        zone.addEventListener('drop', e => {
                                                                                                            e.preventDefault();
                                                                                                            zone.classList.remove('drag-over');
                                                                                                            if (!dragItem) return;

                                                                                                            zone.appendChild(dragItem);

                                                                                                            const badge = dragItem.querySelector('.dnd-badge');
                                                                                                            const note = dragItem.querySelector('.dnd-note');

                                                                                                            if (isSelectedZone) {
                                                                                                                badge.className = 'dnd-badge badge-selected';
                                                                                                                badge.textContent = 'استكمال';
                                                                                                                note.style.display = 'block';
                                                                                                                setTimeout(() => dragItem.querySelector('textarea')?.focus(), 60);
                                                                                                            } else {
                                                                                                                badge.className = 'dnd-badge badge-available';
                                                                                                                badge.textContent = 'متاح';
                                                                                                                note.style.display = 'none';
                                                                                                            }

                                                                                                            updateCounts();
                                                                                                            updatePlaceholders();
                                                                                                        });
                                                                                                    }

                                                                                                    function updateCounts() {
                                                                                                        availableCount.textContent = availableZone.querySelectorAll('.dnd-item').length;
                                                                                                        selectedCount.textContent = selectedZone.querySelectorAll('.dnd-item').length;
                                                                                                    }

                                                                                                    function updatePlaceholders() {
                                                                                                        availablePlaceholder.style.display =
                                                                                                            availableZone.querySelectorAll('.dnd-item').length ? 'none' : 'flex';

                                                                                                        selectedPlaceholder.style.display =
                                                                                                            selectedZone.querySelectorAll('.dnd-item').length ? 'none' : 'flex';
                                                                                                    }

                                                                                                    // ===================== API Load =====================
                                                                                                    async function loadFromApi(requestId) {

                                                                                                        // ✅ EXACT: Url.Action + area + controller = Mosanfat
                                                                                                        const endpoint = '@Url.Action("LoadCompleteLookup", "Mosanfat", new { area = "Admin" })';
                                                                                                        const url = `${endpoint}?requestId=${encodeURIComponent(requestId)}`;

                                                                                                        let json = null;

                                                                                                        try {
                                                                                                            const res = await fetch(url, {
                                                                                                                method: 'GET',
                                                                                                                headers: { 'Accept': 'application/json' }
                                                                                                            });

                                                                                                            // لو 404/500… ما نوقف الدنيا: بس نظهر empty
                                                                                                            if (!res.ok) {
                                                                                                                data = [];
                                                                                                                renderItems();
                                                                                                                return;
                                                                                                            }

                                                                                                            json = await res.json();
                                                                                                        } catch (e) {
                                                                                                            // network error: same behavior
                                                                                                            data = [];
                                                                                                            renderItems();
                                                                                                            return;
                                                                                                        }

                                                                                                        if (!json || json.success !== true) {
                                                                                                            data = [];
                                                                                                            renderItems();
                                                                                                            return;
                                                                                                        }

                                                                                                        const rows = Array.isArray(json.data) ? json.data : [];

                                                                                                        data = rows
                                                                                                            .filter(x => x && safeText(x.text).trim() !== '')
                                                                                                            .map(x => ({
                                                                                                                id: x.id,
                                                                                                                text: x.text,          // ✅ FieldValue فقط
                                                                                                                fieldType: x.fieldType // ✅ Attachment / Partners / Address
                                                                                                            }));

                                                                                                        // even if empty -> render placeholders, counts
                                                                                                        renderItems();
                                                                                                    }

                                                                                                    // ===================== Actions =====================
                                                                                                    function onReset() {
                                                                                                        if (!confirm('هل تريد إعادة تعيين جميع العناصر؟')) return;

                                                                                                        // يرجع العناصر المتاحة حسب آخر data محمّل من الـ API
                                                                                                        renderItems();
                                                                                                    }

                                                                                                    function onSave() {
                                                                                                        const selectedItems = selectedZone.querySelectorAll('.dnd-item');
                                                                                                        const payload = [];

                                                                                                        selectedItems.forEach(item => {
                                                                                                            payload.push({
                                                                                                                id: item.dataset.id,
                                                                                                                title: item.querySelector('.dnd-title-text')?.textContent || '',
                                                                                                                fieldType: item.dataset.fieldType || '',
                                                                                                                note: item.querySelector('textarea')?.value || ''
                                                                                                            });
                                                                                                        });

                                                                                                        console.log('Saved data:', payload);
                                                                                                        alert(`تم حفظ ${payload.length} عنصر`);
                                                                                                    }

                                                                                                    // ===================== Boot =====================
                                                                                                    function init() {
                                                                                                        setupZoneBehavior(availableZone, false);
                                                                                                        setupZoneBehavior(selectedZone, true);

                                                                                                        resetBtn.addEventListener('click', onReset);
                                                                                                        saveBtn.addEventListener('click', onSave);

                                                                                                        // ✅ مفتاحك: data-request-id من الزر change-status-btn
                                                                                                        document.addEventListener('click', function (e) {
                                                                                                            const btn = e.target.closest('.change-status-btn');
                                                                                                            if (!btn) return;

                                                                                                            const requestId = btn.getAttribute('data-request-id');
                                                                                                            if (!requestId) return;

                                                                                                            // no annoying alerts, just render empty if nothing
                                                                                                            loadFromApi(requestId);
                                                                                                        });

                                                                                                        renderItems();
                                                                                                    }

                                                                                                    init();

                                                                                                })();
                                                                                            </script>






