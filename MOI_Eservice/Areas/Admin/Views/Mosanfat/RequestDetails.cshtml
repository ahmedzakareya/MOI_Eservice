                                                                                            <span class="text-muted fw-semibold fs-8 mt-1">
                                                                                                يمكنك الضغط على أي مرفق لعرضه داخل النظام في نافذة مستقلة
                                                                                            </span>
                                                                                        </div>
                                                                                    </div>
                                                                                </div>

                                                                                @if (Model.attachVMs != null && Model.attachVMs.Any())
                                                                                {
                                                                                    <div class="card-toolbar">
                                                                                        <span class="badge badge-light-primary fw-semibold fs-8">
                                                                                            @Model.attachVMs.Count() ملف
                                                                                        </span>
                                                                                    </div>
                                                                                }
                                                                            </div>

                                                                            <div class="card-body pt-6">
                                                                                @if (Model.attachVMs != null && Model.attachVMs.Any())
                                                                                {
                                                                                    <div class="row g-4">
                                                                                        @foreach (var item in Model.attachVMs)
                                                                                        {
                                                                                            var fileUrl = Url.Content("~/" + ViewBag.PathAttachment + item.AttachPath);
                                                                                            var name = item.AttachName ?? "مرفق";
                                                                                            var extRaw = item.AttachPath ?? string.Empty;
                                                                                            var ext = System.IO.Path.GetExtension(extRaw).ToLower();

                                                                                            string fileTypeLabel;
                                                                                            string iconClass;
                                                                                            string bgClass;
                                                                                            string textClass;
                                                                                            string badgeClass;

                                                                                            if (ext == ".pdf")
                                                                                            {
                                                                                                fileTypeLabel = "PDF";
                                                                                                iconClass = "ki-outline ki-file";
                                                                                                bgClass = "bg-light-danger";
                                                                                                textClass = "text-danger";
                                                                                                badgeClass = "badge-light-danger";
                                                                                            }
                                                                                            else if (ext == ".jpg" || ext == ".jpeg" || ext == ".png" || ext == ".gif")
                                                                                            {
                                                                                                fileTypeLabel = "صورة";
                                                                                                iconClass = "ki-outline ki-picture";
                                                                                                bgClass = "bg-light-success";
                                                                                                textClass = "text-success";
                                                                                                badgeClass = "badge-light-success";
                                                                                            }
                                                                                            else if (ext == ".doc" || ext == ".docx")
                                                                                            {
                                                                                                fileTypeLabel = "Word";
                                                                                                iconClass = "ki-outline ki-file";
                                                                                                bgClass = "bg-light-primary";
                                                                                                textClass = "text-primary";
                                                                                                badgeClass = "badge-light-primary";
                                                                                            }
                                                                                            else if (ext == ".xls" || ext == ".xlsx")
                                                                                            {
                                                                                                fileTypeLabel = "Excel";
                                                                                                iconClass = "ki-outline ki-file";
                                                                                                bgClass = "bg-light-success";
                                                                                                textClass = "text-success";
                                                                                                badgeClass = "badge-light-success";
                                                                                            }
                                                                                            else
                                                                                            {
                                                                                                fileTypeLabel = "مرفق";
                                                                                                iconClass = "ki-outline ki-file";
                                                                                                bgClass = "bg-light-secondary";
                                                                                                textClass = "text-gray-700";
                                                                                                badgeClass = "badge-light-secondary";
                                                                                            }

