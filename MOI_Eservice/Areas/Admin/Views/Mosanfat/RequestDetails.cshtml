        #attachNormalWrap .dnd-meta { flex-wrap: wrap; }
        #attachNormalWrap .dnd-badge { margin-inline-start: 0; }
    }

                                                                                                #attachNormalWrap .dnd-type-partners {
                                                                                                    border-color: rgba(34,197,94,.25);
                                                                                                    background: rgba(34,197,94,.08);
                                                                                                    color: #16a34a;
