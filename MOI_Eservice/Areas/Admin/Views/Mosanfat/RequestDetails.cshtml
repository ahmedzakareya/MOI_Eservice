            var closeBtns = winEl.querySelectorAll('[data-attach-preview-close]');
            var headerEl = winEl.querySelector('.attachment-preview-window-header');

            if (iframeEl) {
                setTimeout(() => { iframeEl.src = url; }, 100);
            }

            if (downloadBtn) {
                downloadBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    var a = document.createElement('a');
                    a.href = url;
                    a.download = name;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                });
            }

            if (openNewEl) {
                openNewEl.addEventListener('click', function (e) {
                    e.preventDefault();
                    window.open(url, '_blank');
                });
            }

            closeBtns.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    winEl.style.opacity = '0';
                    winEl.style.transform = 'scale(0.9)';

                    setTimeout(() => {
                        delete windowsByKey[key];
                        if (winEl && winEl.parentNode) winEl.parentNode.removeChild(winEl);
                    }, 300);
                });
            });

            makeDraggable(winEl, headerEl);

            windowsByKey[key] = winEl;

            // Custom resize
            var resizeCorner = winEl.querySelector('.resize-corner');
            if (resizeCorner) {
                resizeCorner.addEventListener('mousedown', function (e) {
                    initResize(e, 'bottom-right');
                });
            }

            ['bottom', 'right'].forEach(side => {
                var resizeHandle = document.createElement('div');
                resizeHandle.style.cssText = `
                        position: absolute;
                        ${side}: 0;
                        ${side === 'bottom'
                        ? 'left: 0; width: 100%; height: 6px; cursor: ns-resize;'
                        : 'top: 0; height: 100%; width: 6px; cursor: ew-resize;'}
                        z-index: 999;
                        background: transparent;
                    `;
                winEl.appendChild(resizeHandle);

                resizeHandle.addEventListener('mousedown', function (e) {
                    initResize(e, side);
                });
            });

            function initResize(e, direction) {
                e.preventDefault();
                e.stopPropagation();

                var startX = e.clientX;
                var startY = e.clientY;
                var startWidth = winEl.offsetWidth;
                var startHeight = winEl.offsetHeight;

                function doResize(ev) {
                    var newWidth = startWidth;
                    var newHeight = startHeight;

                    if (direction === 'right' || direction === 'bottom-right') {
                        newWidth = startWidth + (ev.clientX - startX);
                    }

                    if (direction === 'bottom' || direction === 'bottom-right') {
                        newHeight = startHeight + (ev.clientY - startY);
                    }

                    var minWidth = 420;
                    var minHeight = 320;
                    var maxWidth = window.innerWidth - 40;
                    var maxHeight = window.innerHeight - 120;

                    winEl.style.width = Math.min(Math.max(newWidth, minWidth), maxWidth) + 'px';
                    winEl.style.height = Math.min(Math.max(newHeight, minHeight), maxHeight) + 'px';
                }

                function stopResize() {
                    document.documentElement.removeEventListener('mousemove', doResize);
                    document.documentElement.removeEventListener('mouseup', stopResize);
                }

                document.documentElement.addEventListener('mousemove', doResize);
                document.documentElement.addEventListener('mouseup', stopResize);
            }
        });

