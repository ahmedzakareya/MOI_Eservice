<script>
    $(function () {
        $(document).on('click', '.change-status-btn', function () {
            var $btn = $(this);

            var requestType = $btn.data('request-type');
            var requestNo   = $btn.data('request-no');
            var requestId   = $btn.data('request-id');

            // Fill modal header from button
            $('#modalRequestTypeText').text(requestType || '');
            $('#modalRequestNoText').text(requestNo || '');

            // Store RequestId
            $('#hfRequestId').val(requestId || '');

            if (!requestId) {
                console.warn('No request-id on button');
                return;
            }

            $.ajax({
                url: '@Url.Action("GetFlowVM", "Mosanafat")',
                type: 'GET',
                data: { requestId: requestId },
                success: function (res) {
                    if (!res || res.success === false || !res.data) {
                        console.warn('GetFlowVM returned no data', res);
                        return;
                    }

                    var wf = res.data;

                    $('#hfTransactionTypeId').val(wf.TransactionTypeId || '');
                    $('#hfCurrentStatusId').val(wf.CurrentStatusId || '');
                    $('#hfNextStatusId').val(wf.NextStatusId || '');
                },
                error: function (xhr, status, error) {
                    console.error('GetFlowVM error:', error);
                }
            });
        });
    });
</script>


<script>
    $(document).ready(function () {

        // --- Helper: show error message (SweetAlert if available) ---
        function showAttachError(message) {
            if (window.Swal) {
                Swal.fire({
                    icon: 'warning',
                    title: 'تنبيه',
                    text: message,
                    confirmButtonText: 'حسناً'
                });
            } else {
                alert(message);
            }
        }

        // --- Helper: check if we are allowed to add a new row ---
        function canAddNewRow() {
            var $tbody = $('#extraAttachmentsBody');
            var $lastRow = $tbody.find('tr.extra-row').last();
            var titleVal = $lastRow.find('input[name="ExtraTitles"]').val().trim();

            // If title is empty -> do not allow adding a new row
            if (titleVal === '') {
                showAttachError('من فضلك أدخل اسم المرفق قبل إضافة مرفق جديد.');
                $lastRow.find('input[name="ExtraTitles"]').focus();
                return false;
            }

            return true;
        }

        // --- Helper: add new row and return the jQuery object of the row ---
        function addAttachmentRow() {
            var $tbody = $('#extraAttachmentsBody');
            var $template = $tbody.find('tr.extra-row').first();
            var $clone = $template.clone();

            // Reset values in cloned row
            $clone.find('input[name="ExtraTitles"]').val('');
            $clone.find('.extra-file-input').val('');
            $clone.find('.extra-file-name').text('لا يوجد ملف');

            $tbody.append($clone);
            return $clone;
        }

        // --- Add new row from button ---
        $('#btnAddAttachment').on('click', function () {
            // Check if we can add a new row
            if (!canAddNewRow()) {
                return;
            }

            addAttachmentRow();
        });

        // --- Delete row ---
        $(document).on('click', '.btn-delete-row', function () {
            var $row = $(this).closest('tr.extra-row');
            var $tbody = $('#extraAttachmentsBody');
            var count = $tbody.find('tr.extra-row').length;

            if (count > 1) {
                // Remove row if there is more than one
                $row.remove();
            } else {
                // If it's the only row, just clear it
                $row.find('input[name="ExtraTitles"]').val('');
                $row.find('.extra-file-input').val('');
                $row.find('.extra-file-name').text('لا يوجد ملف');
            }
        });

        // --- Open file dialog from "Content" button ---
        $(document).on('click', '.extra-file-btn', function () {
            var $row = $(this).closest('tr.extra-row');
            var $fileInput = $row.find('.extra-file-input');
            $fileInput.trigger('click');
        });

        // --- Update file name when user selects a file ---
        $(document).on('change', '.extra-file-input', function () {
            var fileInput = this;
            var $row = $(this).closest('tr.extra-row');
            var $nameSpan = $row.find('.extra-file-name');

            if (fileInput.files && fileInput.files.length > 0) {
                var file = fileInput.files[0];
                $nameSpan.text(file.name);      // show selected file name
            } else {
                $nameSpan.text('لا يوجد ملف'); // reset text
            }
        });

        // --- Dropzone click: add row (if last row has file) and open dialog ---
        $('.extra-dropzone').on('click', function () {
            var $tbody = $('#extraAttachmentsBody');
            var $rows = $tbody.find('tr.extra-row');
            var $lastRow = $rows.last();

            // If last row already has a file name -> we want to create a new row
            if ($lastRow.find('.extra-file-name').text().trim() !== 'لا يوجد ملف') {

                // Check name before creating new row
                if (!canAddNewRow()) {
                    return;
                }

                $lastRow = addAttachmentRow();
            }

            // Open file dialog for last (current) row
            $lastRow.find('.extra-file-input').trigger('click');
        });

    });
</script>

<script>
    $(function () {

        // Ajax URL (لاحظ اسم الكنترولر Mosanfat + area = Admin)
        var handleUrl = '@Url.Action("HandleRequestStatus", "Mosanfat", new { area = "Admin" })';

        // ============= 1) تعبئة الهيدن عند الضغط على أي كارد =================
        $(document).on('click', '.change-status-btn', function () {
            var $btn    = $(this);

            var reqId   = $btn.data('request-id')   || '';
            var reqType = $btn.data('request-type') || '';
            var reqNo   = $btn.data('request-no')   || '';

            // fill hidden inputs in modal
            $('#modalRequestId').val(reqId);
            $('#modalRequestType').val(reqType);
            $('#modalRequestNo').val(reqNo);

            // fill modal header
            $('#modalRequestTypeText').text(reqType);
            $('#modalRequestNoText').text(reqNo);

            console.log('card clicked, requestId =', reqId);
        });

        // ============= 2) زر "تعديل حالة الطلب" داخل المودال =================
        $(document)
            .off('click', '#btnSaveRequestStatus') // remove any old handlers
            .on('click', '#btnSaveRequestStatus', function (e) {
                e.preventDefault(); // نمنع الإرسال العادي، نشتغل Ajax فقط

                var requestId   = $('#modalRequestId').val();
                var requestType = $('#modalRequestType').val();
                var requestNo   = $('#modalRequestNo').val();
                var actionType  = $('input[name="plan"]:checked').val() || '';
                var note        = $('#floatingTextarea2').val() || '';

                console.log('save button clicked, requestId =', requestId);

                if (!requestId) {
                    if (window.Swal) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'تنبيه',
                            text: 'لم يتم تحديد رقم الطلب.',
                            confirmButtonText: 'حسناً'
                        });
                    } else {
                        alert('لم يتم تحديد رقم الطلب.');
                    }
                    return;
                }

                var dataToSend = {
                    requestId:   requestId,
                    actionType:  actionType,
                    note:        note,
                    requestType: requestType,
                    requestNo:   requestNo
                };

                // Anti-forgery token (if it exists on the page)
                var token = $('input[name="__RequestVerificationToken"]').val();
                if (token) {
                    dataToSend.__RequestVerificationToken = token;
                }

                // ======= رسالة التأكيد قبل تنفيذ Ajax =======
                if (window.Swal) {
                    Swal.fire({
                        title: 'تأكيد حفظ حالة الطلب',
                        text: 'هل أنت متأكد أنك تريد تعديل حالة هذا الطلب؟',
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonText: 'نعم، حفظ',
                        cancelButtonText: 'إلغاء'
                    }).then(function (result) {
                        if (result.isConfirmed) {
                            sendAjax(dataToSend);
                        }
                    });
                } else {
                    if (confirm('هل تريد حفظ حالة الطلب؟')) {
                        sendAjax(dataToSend);
                    }
                }
            });

        // ============= دالة مشتركة لإرسال الـ Ajax =================
        function sendAjax(dataToSend) {
            $.ajax({
                url: handleUrl,
                type: 'POST',
                data: dataToSend,
                success: function (res) {
                    console.log('Ajax success:', res);

                    if (window.Swal) {
                        if (res && res.success) {
                            // ✅ في حالة النجاح: رسالة "تم" وبعدها Refresh
                            Swal.fire({
                                icon: 'success',
                                title: 'تم الحفظ',
                                text: res.message || 'تم حفظ حالة الطلب بنجاح.',
                                confirmButtonText: 'تم'
                            }).then(function () {
                                // نحدّث الصفحة بعد ما المستخدم يضغط تم
                                location.reload();
                            });
                        } else {
                            // في حالة عدم success حقيقي لكن الرد رجع
                            Swal.fire({
                                icon: 'info',
                                title: 'تنبيه',
                                text: (res && res.message) || 'تم تنفيذ العملية، برجاء مراجعة حالة الطلب.',
                                confirmButtonText: 'حسناً'
                            }).then(function () {
                                closeModal();
                            });
                        }
                    } else {
                        // fallback لو Swal مش موجود
                        if (res && res.success) {
                            alert(res.message || 'تم حفظ حالة الطلب بنجاح.');
                            location.reload();
                        } else {
                            alert((res && res.message) || 'تم تنفيذ العملية، برجاء مراجعة حالة الطلب.');
                            closeModal();
                        }
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Ajax error:', xhr.status, error);

                    if (window.Swal) {
                        Swal.fire({
                            icon: 'error',
                            title: 'خطأ',
                            text: 'حدث خطأ غير متوقع أثناء حفظ حالة الطلب. (كود: ' + xhr.status + ')',
                            confirmButtonText: 'حسناً'
                        });
                    } else {
                        alert('حدث خطأ غير متوقع أثناء حفظ حالة الطلب. (كود: ' + xhr.status + ')');
                    }
                }
            });
        }

        function closeModal() {
            var modalEl = document.getElementById('kt_modal_stacked_1');
            var modalInstance = bootstrap.Modal.getInstance(modalEl);
            if (modalInstance) {
                modalInstance.hide();
            }
        }

    });
</script>

<style>
    /* Force hide even if Bootstrap/Metronic sets display:flex */
    .tab-force-hide {
        display: none !important;
    }
</style>


<script>
    $(function () {

        // ✅ Admin Area
        var flowUrl = '@Url.Action("LoadFlowVM", "Mosanfat", new { area = "Admin" })';
        var modalSelector = '#kt_modal_stacked_1';

        var TAB_ACCEPT = 'kt_upgrade_plan_startup';
        var TAB_ATTACH = 'kt_upgrade_plan_advanced';
        var TAB_REJECT = 'kt_upgrade_plan_enterprise';
        var TAB_EXTRA = 'kt_upgrade_plan_custom';

        function getTabLabel(tabId) {
            return document.querySelector(modalSelector + ' [data-bs-target="#' + tabId + '"]');
        }
        function getTabPane(tabId) {
            return document.querySelector(modalSelector + ' #' + tabId);
        }

        function forceHide(el) { if (el) el.classList.add('tab-force-hide'); }
        function forceShow(el) { if (el) el.classList.remove('tab-force-hide'); }

        function setTabVisible(tabId, visible) {
            var label = getTabLabel(tabId);
            var pane = getTabPane(tabId);

            if (visible) {
                forceShow(label);
                forceShow(pane);
            } else {
                if (label) label.classList.remove('active');
                if (pane) pane.classList.remove('show', 'active');
                forceHide(label);
                forceHide(pane);
            }
        }

        function activateFirstVisibleTab() {
            var labels = document.querySelectorAll(modalSelector + ' [data-bs-toggle="tab"]');
            for (var i = 0; i < labels.length; i++) {
                if (labels[i].classList.contains('tab-force-hide')) continue;
                bootstrap.Tab.getOrCreateInstance(labels[i]).show();
                return;
            }
        }

        function activateTab(tabId) {
            var label = getTabLabel(tabId);
            if (!label) return;
            bootstrap.Tab.getOrCreateInstance(label).show();
        }

        function showTabs(accept, attach, reject, extra) {
            setTabVisible(TAB_ACCEPT, !!accept);
            setTabVisible(TAB_ATTACH, !!attach);
            setTabVisible(TAB_REJECT, !!reject);
            setTabVisible(TAB_EXTRA, !!extra);
            activateFirstVisibleTab();
        }

        // ✅ Status 8 UI inside accept tab
        function showLicenseIssuedUI(show, reqNo) {
            var box = document.getElementById('licenseIssuedBox');
            var wrap = document.getElementById('acceptContentWrap');
            var reqEl = document.getElementById('licenseIssuedReqNo');

            if (reqEl) reqEl.textContent = (reqNo || '—');

            if (show) {
                if (wrap) wrap.style.display = 'none';
                if (box) box.classList.remove('d-none');
            } else {
                if (wrap) wrap.style.display = '';
                if (box) box.classList.add('d-none');
            }
        }

        // ✅ Notes card show/hide
        function toggleNotesUI(show) {
            var notesWrap = document.getElementById('requestNotesWrap');
            if (!notesWrap) return;

            if (show) {
                notesWrap.classList.remove('tab-force-hide');
                notesWrap.style.display = '';
            } else {
                notesWrap.classList.add('tab-force-hide');
                notesWrap.style.display = 'none';
            }
        }

        // ✅ Save button show/hide (the main action)
        function toggleSaveButtonUI(show) {
            var btn = document.getElementById('btnSaveRequestStatus');
            if (!btn) return;

            if (show) {
                btn.classList.remove('tab-force-hide');
                btn.style.display = '';
                btn.disabled = false;
            } else {
                btn.classList.add('tab-force-hide');
                btn.style.display = 'none';
                btn.disabled = true;
            }
        }

        // ✅ Actions row (Cancel + Save) show/hide
        function toggleActionsWrapUI(show) {
            var wrap = document.getElementById('modalActionsWrap');
            if (!wrap) return;

            if (show) {
                wrap.classList.remove('tab-force-hide');
                wrap.style.display = '';
            } else {
                wrap.classList.add('tab-force-hide');
                wrap.style.display = 'none';
            }
        }

        // ✅ MOCI Card show/hide + clear fields
        function toggleMociCardUI(show) {
            var wrap = document.getElementById('mociDataCardWrap');
            if (!wrap) return;

            if (show) {
                wrap.classList.remove('d-none');
            } else {
                wrap.classList.add('d-none');

                var ids = ['mociCivilId', 'mociTradeName', 'mociLicenseNo', 'mociRecordNo', 'mociRecordDate'];
                ids.forEach(function (id) {
                    var el = document.getElementById(id);
                    if (el) el.value = '';
                });
            }
        }

        // ✅ Attach tab: hide normal content + show waiting message (status 12)
        function toggleAttachWaitingUI(show) {
            var normal = document.getElementById('attachNormalWrap');
            var box = document.getElementById('attachWaitingReviewerBox');

            if (show) {
                if (normal) normal.style.display = 'none';
                if (box) box.classList.remove('d-none');
            } else {
                if (normal) normal.style.display = '';
                if (box) box.classList.add('d-none');
            }
        }

        // ✅ Reject tab: hide normal content + show rejected message (status 9)
        function toggleRejectFinalUI(show) {
            var normal = document.getElementById('rejectNormalWrap');
            var box = document.getElementById('rejectFinalBox');

            if (show) {
                if (normal) normal.style.display = 'none';
                if (box) box.classList.remove('d-none');
            } else {
                if (normal) normal.style.display = '';
                if (box) box.classList.add('d-none');
            }
        }

        // ✅ reset everything before each open
        function resetModalUI() {
            [TAB_ACCEPT, TAB_ATTACH, TAB_REJECT, TAB_EXTRA].forEach(function (id) {
                var label = getTabLabel(id);
                var pane = getTabPane(id);

                if (label) label.classList.remove('tab-force-hide', 'active');
                if (pane) pane.classList.remove('tab-force-hide', 'show', 'active');
            });

            showLicenseIssuedUI(false, '');
            toggleNotesUI(true);
            toggleSaveButtonUI(true);
            toggleActionsWrapUI(true);
            toggleMociCardUI(false);

            toggleAttachWaitingUI(false);
            toggleRejectFinalUI(false);
        }

        // ✅ Rules:
        // 2  => all
        // 3  => Accept + Extra
        // 5/6=> Accept only
        // 8  => Accept only (issued UI)
        // 9  => Reject only (final reject UI)
        // 12 => Attach only (waiting reviewer UI)
        function applyTabsByStatus(currentStatusId) {
            var st = parseInt(currentStatusId, 10);

            if (st === 2) { showTabs(true, true, true, true); return; }
            if (st === 3) { showTabs(true, false, false, true); return; }
            if (st === 5 || st === 6) { showTabs(true, false, false, false); return; }
            if (st === 8) { showTabs(true, false, false, false); return; }

            // ✅ Status 12: ONLY "استكمال المرفقات"
            if (st === 12) {
                showTabs(false, true, false, false);
                activateTab(TAB_ATTACH);
                return;
            }

            // ✅ Status 9: ONLY "رفض الطلب"
            if (st === 9) {
                showTabs(false, false, true, false);
                activateTab(TAB_REJECT);
                return;
            }

            showTabs(true, false, true, false);
        }

        function openModal() {
            var el = document.querySelector(modalSelector);
            bootstrap.Modal.getOrCreateInstance(el).show();
        }

        // ✅ prevent duplicate handlers
        $(document)
            .off('click', '.change-status-btn')
            .on('click', '.change-status-btn', function (e) {

                e.preventDefault();
                e.stopImmediatePropagation();

                var $btn = $(this);

                var requestType = $btn.data('request-type') || '';
                var requestNo = $btn.data('request-no') || '';
                var requestId = $btn.data('request-id') || '';

                $('#modalRequestTypeText').text(requestType);
                $('#modalRequestNoText').text(requestNo);

                $('#modalRequestId').val(requestId);
                $('#modalRequestType').val(requestType);
                $('#modalRequestNo').val(requestNo);

                if (!requestId) return;

                resetModalUI();

                $.ajax({
                    url: flowUrl,
                    type: 'GET',
                    data: { requestId: requestId },
                    success: function (res) {

                        resetModalUI();

                        if (!res || res.success !== true || !res.data) {
                            showTabs(true, false, true, false);
                            openModal();
                            return;
                        }

                        var wf = res.data;

                        var currentStatusId = (wf.CurrentStatusId != null) ? wf.CurrentStatusId : wf.currentStatusId;
                        var isMociData = (wf.IsMOCIData != null) ? wf.IsMOCIData : wf.isMOCIData;

                        var st = parseInt(currentStatusId, 10);
                        var reqNoText = $('#modalRequestNo').val() || $('#modalRequestNoText').text() || '';

                        // Status 8 UI
                        showLicenseIssuedUI(st === 8, reqNoText);

                        // ✅ Status 12: show waiting message inside Attach + lock everything
                        if (st === 12) {
                            toggleAttachWaitingUI(true);
                            toggleRejectFinalUI(false);

                            toggleNotesUI(false);
                            toggleSaveButtonUI(false);
                            toggleActionsWrapUI(false);
                            toggleMociCardUI(false);
                        }
                        // ✅ Status 9: show rejected message inside Reject + lock everything
                        else if (st === 9) {
                            toggleRejectFinalUI(true);
                            toggleAttachWaitingUI(false);

                            toggleNotesUI(false);
                            toggleSaveButtonUI(false);
                            toggleActionsWrapUI(false);
                            toggleMociCardUI(false);
                        }
                        else {
                            toggleAttachWaitingUI(false);
                            toggleRejectFinalUI(false);

                            // normal behavior for status 8 only
                            toggleNotesUI(st !== 8);
                            toggleSaveButtonUI(st !== 8);
                            toggleActionsWrapUI(st !== 8);
                        }

                        // ✅ Status 3 + IsMOCIData=false => show MOCI card in Accept tab
                        if (st === 3 && (isMociData === false || isMociData === "false" || isMociData === 0)) {
                            toggleMociCardUI(true);
                        } else {
                            toggleMociCardUI(false);
                        }

                        applyTabsByStatus(currentStatusId);
                        openModal();
                    },
                    error: function () {
                        resetModalUI();
                        showTabs(true, false, true, false);
                        openModal();
                    }
                });
            });

    });
</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const input = document.querySelector("#mociRecordDate");
        if (!input) return;

        const modal = input.closest(".modal");
        const modalBody = modal ? modal.querySelector(".modal-body") : null;

        let fpInstance = null;
        let guardOn = false;
        let lastWinY = 0;
        let lastBodyY = 0;

        function snapScroll() {
            lastWinY = window.pageYOffset || document.documentElement.scrollTop || 0;
            lastBodyY = modalBody ? modalBody.scrollTop : 0;
        }

        function restoreScroll() {
            // restore modal body scroll
            if (modalBody) modalBody.scrollTop = lastBodyY;

            // restore page scroll (in case the whole page moved)
            window.scrollTo({ top: lastWinY, left: 0, behavior: "instant" });
        }

        // Focus trap helper: keep focus without scrolling
        function focusNoScroll(el) {
            if (!el) return;
            try {
                el.focus({ preventScroll: true });
            } catch (e) {
                // fallback
                el.focus();
                restoreScroll();
            }
        }

        // Capture focusin while picker is open and prevent scroll jumps
        function onFocusInCapture(e) {
            if (!guardOn) return;
            // Any forced focus inside modal can cause jump; restore right after
            snapScroll();
            requestAnimationFrame(restoreScroll);
        }

        document.addEventListener("focusin", onFocusInCapture, true);

        if (typeof flatpickr !== "undefined") {

            fpInstance = flatpickr(input, {
                dateFormat: "Y-m-d",
                allowInput: true,
                disableMobile: true,

                onOpen: function () {
                    snapScroll();
                    guardOn = true;
                },

                onClose: function () {
                    // restore after close (Bootstrap may refocus)
                    requestAnimationFrame(() => {
                        restoreScroll();
                        guardOn = false;
                    });
                },

                onChange: function (selectedDates, dateStr, inst) {
                    // BEFORE Bootstrap refocus/scroll happens
                    snapScroll();

                    // keep value
                    input.value = dateStr;

                    // close picker first
                    inst.close();

                    // prevent scroll on focus, then restore scroll
                    setTimeout(() => {
                        focusNoScroll(input);
                        restoreScroll();
                    }, 0);
                }
            });

            // Extra: when clicking input, focus without scroll
            input.addEventListener("mousedown", function () {
                snapScroll();
                setTimeout(() => restoreScroll(), 0);
            });

            return;
        }

        // Fallback: KTFlatpickr (if used)
        if (typeof KTFlatpickr !== "undefined") {
            KTFlatpickr.createInstance("#mociRecordDate", {
                dateFormat: "Y-m-d",
                allowInput: true,
                disableMobile: true
            });
        }
    });
</script>


