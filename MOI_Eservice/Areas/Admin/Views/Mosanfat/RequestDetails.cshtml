                                                                                       <style>
                                                                                           /* ===================== MOI Floating Input - EXPANDED VERSION (FIX label clipping) ===================== */
.moi-float{
    position: relative;
    border: 1.5px solid #e2e8f0;
    border-radius: 16px;
    background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
    min-height: 70px;
    transition: all .3s cubic-bezier(.4,0,.2,1);
    box-shadow: 0 2px 4px rgba(0,0,0,.05);
    overflow: visible;
}

.moi-float:hover{
    border-color: #cbd5e1;
    box-shadow: 0 4px 12px rgba(0,0,0,.08);
    transform: translateY(-1px);
}

.moi-float:focus-within{
    border-color: #3b82f6;
    box-shadow: 0 0 0 3px rgba(59,130,246,.10);
    background: #ffffff;
}

/* Icon styling */
.moi-float .moi-ico{
    position: absolute;
    top: 28px;
    left: 20px;
    transform: none;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    color: #64748b;
    transition: all .3s ease;
    pointer-events: none;
}

.moi-float .moi-ico svg{
    width: 20px;
    height: 20px;
    filter: drop-shadow(0 1px 2px rgba(0,0,0,.10));
}

.moi-float:focus-within .moi-ico{
    color: #3b82f6;
    transform: scale(1.1);
}

/* Input field */
.moi-float .form-control{
    border: 0 !important;
    box-shadow: none !important;
    background: transparent !important;
    height: 70px;
    line-height: 1.5;
    padding: 28px 20px 12px 60px;
    font-size: 16px;
    font-weight: 500;
    color: #1e293b;
    border-radius: 16px;
    transition: all .3s ease;
}

.moi-float .form-control::placeholder{ color: transparent; }
.moi-float .form-control:focus{
    background: transparent !important;
    outline: none;
}

/* ✅ FIX: Floating label (prevent bottom clipping) */
.moi-float label{
    position: absolute;
    left: 60px;
    right: 20px;

    /* keep same layout */
    top: 50%;
    transform: translateY(-50%);

    font-weight: 600;
    color: #64748b;

    /* ✅ important: line-box + padding so descenders don't clip */
    line-height: 1.25;
    padding: 3px 10px 5px;          /* bottom padding bigger */
    display: inline-block;

    /* ✅ safer background than split gradient (gradient can "cut" lower pixels) */
    background: rgba(248,250,252,.96);

    pointer-events: none;
    transition: all .3s cubic-bezier(.4,0,.2,1);
    z-index: 2;

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;

    font-size: 16px;
    letter-spacing: .3px;

    /* optional but helps rendering */
    -webkit-font-smoothing: antialiased;
    text-rendering: geometricPrecision;
}

/* Floating animation */
.moi-float .form-control:focus + label,
.moi-float .form-control:not(:placeholder-shown) + label,
.moi-float .form-control.has-value + label{
    top: 18px;
    transform: none;

    font-size: 14px;
    color: #3b82f6;
    font-weight: 700;
    letter-spacing: .5px;

    /* ✅ keep same "cutout" feel without clipping */
    background: rgba(248,250,252,.98);
    padding: 2px 10px 4px;          /* still keep bottom breathing room */
    line-height: 1.15;
}

/* Date input specific */
.moi-float input[type="date"].form-control{
    padding-right: 50px;
    appearance: none;
}

.moi-float input[type="date"]::-webkit-calendar-picker-indicator{
    background: transparent;
    color: #64748b;
    opacity: .8;
    cursor: pointer;
    position: absolute;
    left: 20px;
    width: 24px;
    height: 24px;
    z-index: 4;
    transition: opacity .3s ease;
}
.moi-float input[type="date"]::-webkit-calendar-picker-indicator:hover{ opacity: 1; }

/* Optional focus indicator */
.moi-float::after{
    content:'';
    position:absolute;
    bottom:0;
    left:50%;
    transform: translateX(-50%) scaleX(0);
    width:0;
    height:3px;
    background: linear-gradient(90deg, #3b82f6, #60a5fa);
    border-radius:3px;
    transition: all .3s ease;
}
.moi-float:focus-within::after{
    transform: translateX(-50%) scaleX(1);
    width: calc(100% - 40px);
}

/* ===================== Responsive adjustments ===================== */
@@media (max-width: 768px){
    .moi-float{ min-height: 65px; }

    .moi-float .form-control{
        height: 65px;
        padding: 26px 16px 10px 52px;
        font-size: 15px;
    }

    .moi-float .moi-ico{
        top: 24px;
        left: 16px;
    }

    .moi-float label{
        left: 52px;
        right: 16px;
        font-size: 15px;
        line-height: 1.22;
        padding: 3px 10px 5px;
    }

    .moi-float .form-control:focus + label,
    .moi-float .form-control:not(:placeholder-shown) + label,
    .moi-float .form-control.has-value + label{
        top: 16px;
        font-size: 13px;
        padding: 2px 10px 4px;
        line-height: 1.12;
    }
}

/* ===================== مكون اليد (مع التعديلات الجديدة) ===================== */
.moci-hand-target {
    position: relative;
}

.moci-hand-target.show-moci-hand::after {
    content: "";
    position: absolute;
    /* رفعها أكثر: تغيير top من -54px إلى -70px */
    top: -70px;
    right: 18px;
    width: 72px;
    height: 72px;
    z-index: 9999;
    pointer-events: none;
    background-image: url('/assets/images/moci_hand_hint.png');
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
    opacity: 0;
    
    /* 🌈 تصميم متطور بدرجات أزرق */
    filter: 
        brightness(0) saturate(100%) 
        invert(24%) sepia(85%) saturate(1800%) hue-rotate(195deg)
        brightness(1.1) contrast(1.1)
        drop-shadow(0 6px 16px rgba(30, 64, 175, 0.25))
        drop-shadow(0 0 20px rgba(59, 130, 246, 0.35))
        drop-shadow(0 0 30px rgba(96, 165, 250, 0.25));
    
    animation: mociHandHintElegant 30s ease-in-out 1;
}

/* 🎨 أنيميشن أنيق مع رفع أعلى */
@@keyframes mociHandHintElegant {
    /* دخول أنيق من أعلى */
    0% {
        opacity: 0;
        transform: 
            translateY(20px) /* زيادة من 15px إلى 20px */
            scale(0.92) 
            rotate(-5deg);
    }
    
    /* ظهور كامل في الموقع الأعلى */
    3% {
        opacity: 1;
        transform: 
            translateY(0) 
            scale(1) 
            rotate(0deg);
    }
    
    /* حركة خفيفة للأعلى (مع رفع أكثر) */
    8% {
        transform: 
            translateY(-10px) /* زيادة من -8px إلى -10px */
            scale(1.03) 
            rotate(2deg);
    }
    
    /* استقرار في موقع أعلى */
    15% {
        transform: 
            translateY(-6px) /* زيادة من -4px إلى -6px */
            scale(1) 
            rotate(-1deg);
    }
    
    /* بداية النبض المستمر */
    20% {
        transform: 
            translateY(-7px) /* زيادة من -5px إلى -7px */
            scale(1.01) 
            rotate(0.5deg);
        filter: 
            brightness(0) saturate(100%) 
            invert(24%) sepia(85%) saturate(1800%) hue-rotate(195deg)
            brightness(1.15) contrast(1.15)
            drop-shadow(0 8px 20px rgba(30, 64, 175, 0.3))
            drop-shadow(0 0 25px rgba(59, 130, 246, 0.45))
            drop-shadow(0 0 35px rgba(96, 165, 250, 0.3));
    }
    
    /* النبض الأول */
    25% {
        transform: 
            translateY(-7px) /* زيادة من -4px إلى -7px */
            scale(0.99) 
            rotate(-0.5deg);
        filter: 
            brightness(0) saturate(100%) 
            invert(24%) sepia(85%) saturate(1800%) hue-rotate(195deg)
            brightness(1.1) contrast(1.1)
            drop-shadow(0 6px 16px rgba(30, 64, 175, 0.25))
            drop-shadow(0 0 20px rgba(59, 130, 246, 0.35))
            drop-shadow(0 0 30px rgba(96, 165, 250, 0.25));
    }
    
    /* النبض الثاني */
    35% {
        transform: 
            translateY(-9px) /* زيادة من -6px إلى -9px */
            scale(1.02) 
            rotate(1deg);
        filter: 
            brightness(0) saturate(100%) 
            invert(24%) sepia(85%) saturate(1800%) hue-rotate(195deg)
            brightness(1.15) contrast(1.15)
            drop-shadow(0 8px 20px rgba(30, 64, 175, 0.3))
            drop-shadow(0 0 25px rgba(59, 130, 246, 0.45))
            drop-shadow(0 0 35px rgba(96, 165, 250, 0.3));
    }
    
    /* النبض الثالث */
    45% {
        transform: 
            translateY(-7px) /* زيادة من -4px إلى -7px */
            scale(0.995) 
            rotate(-0.5deg);
        filter: 
            brightness(0) saturate(100%) 
            invert(24%) sepia(85%) saturate(1800%) hue-rotate(195deg)
            brightness(1.1) contrast(1.1)
            drop-shadow(0 6px 16px rgba(30, 64, 175, 0.25))
            drop-shadow(0 0 20px rgba(59, 130, 246, 0.35))
            drop-shadow(0 0 30px rgba(96, 165, 250, 0.25));
    }
    
    /* النبض الرابع */
    60% {
        transform: 
            translateY(-8px) /* زيادة من -5px إلى -8px */
            scale(1.01) 
            rotate(0.5deg);
        filter: 
            brightness(0) saturate(100%) 
            invert(24%) sepia(85%) saturate(1800%) hue-rotate(195deg)
            brightness(1.15) contrast(1.15)
            drop-shadow(0 8px 20px rgba(30, 64, 175, 0.3))
            drop-shadow(0 0 25px rgba(59, 130, 246, 0.45))
            drop-shadow(0 0 35px rgba(96, 165, 250, 0.3));
    }
    
    /* استقرار */
    75% {
        transform: 
            translateY(-6px) /* زيادة من -4px إلى -6px */
            scale(1) 
            rotate(0deg);
        filter: 
            brightness(0) saturate(100%) 
            invert(24%) sepia(85%) saturate(1800%) hue-rotate(195deg)
            brightness(1.1) contrast(1.1)
            drop-shadow(0 6px 16px rgba(30, 64, 175, 0.25))
            drop-shadow(0 0 20px rgba(59, 130, 246, 0.35))
            drop-shadow(0 0 30px rgba(96, 165, 250, 0.25));
    }
    
    /* بداية الخروج */
    90% {
        opacity: 1;
        transform: 
            translateY(-4px) /* زيادة من -2px إلى -4px */
            scale(1) 
            rotate(0deg);
    }
    
    /* اختفاء تدريجي */
    95% {
        opacity: 0.3;
        transform: 
            translateY(2px) /* تعديل من 5px إلى 2px */
            scale(0.95) 
            rotate(-3deg);
        filter: 
            brightness(0) saturate(100%) 
            invert(24%) sepia(85%) saturate(1800%) hue-rotate(195deg)
            brightness(0.9) contrast(0.9)
            drop-shadow(0 3px 10px rgba(30, 64, 175, 0.15))
            drop-shadow(0 0 10px rgba(59, 130, 246, 0.2))
            drop-shadow(0 0 15px rgba(96, 165, 250, 0.15));
    }
    
    /* نهاية */
    100% {
        opacity: 0;
        transform: 
            translateY(15px) /* تعديل من 12px إلى 15px */
            scale(0.9) 
            rotate(-5deg);
        filter: 
            brightness(0) saturate(100%) 
            invert(24%) sepia(85%) saturate(1800%) hue-rotate(195deg)
            brightness(0.8) contrast(0.8)
            drop-shadow(0 0 5px rgba(30, 64, 175, 0.1));
    }
