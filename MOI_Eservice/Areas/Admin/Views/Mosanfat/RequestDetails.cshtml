                        user-select: none;
                        cursor: move;
                        background: linear-gradient(90deg, #F8F9FA 0%, #FFFFFF 100%);
                        border-bottom: 1px solid #E4E6EF;
                        padding: 0.75rem 1.25rem;
                        display: flex;
                        align-items: center;
                        justify-content: space-between;
                        flex-shrink: 0;
                    }

