<script>
    // Attach modal header update based on clicked button
    document.addEventListener('DOMContentLoaded', function () {
        var modalEl = document.getElementById('kt_modal_stacked_1');
        if (!modalEl) return;

        var modalReqTypeEl = document.getElementById('modalRequestTypeText');
        var modalReqNoEl = document.getElementById('modalRequestNoText');

        modalEl.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            if (!button) return;

            var typeText = button.getAttribute('data-request-type');
            var reqNo = button.getAttribute('data-request-no');

            if (typeText && modalReqTypeEl) {
                modalReqTypeEl.textContent = typeText;
            }

            if (reqNo && modalReqNoEl) {
                modalReqNoEl.textContent = reqNo;
            }
        });
    });
</script>

<script>
    (function () {
        var windowsByKey = {};
        var topZ = 1080;

        function makeDraggable(winEl, handleEl) {
            if (!winEl || !handleEl) return;

            var dragging = false;
            var startX = 0, startY = 0;
            var startLeft = 0, startTop = 0;

            handleEl.addEventListener('mousedown', function (e) {
                e.preventDefault();
                dragging = true;

                var rect = winEl.getBoundingClientRect();
                startLeft = rect.left;
                startTop = rect.top;
                startX = e.clientX;
                startY = e.clientY;

                document.addEventListener('mousemove', onMouseMove);
                document.addEventListener('mouseup', onMouseUp);
            });

            function onMouseMove(e) {
                if (!dragging) return;

                var dx = e.clientX - startX;
                var dy = e.clientY - startY;

                var newLeft = startLeft + dx;
                var newTop = startTop + dy;

                var vw = window.innerWidth;
                var vh = window.innerHeight;
                var rect = winEl.getBoundingClientRect();
                var maxLeft = vw - rect.width;
                var maxTop = vh - rect.height;

                if (newLeft < 0) newLeft = 0;
                if (newTop < 0) newTop = 0;
                if (newLeft > maxLeft) newLeft = maxLeft;
                if (newTop > maxTop) newTop = maxTop;

                winEl.style.left = newLeft + 'px';
                winEl.style.top = newTop + 'px';
                winEl.style.transform = '';
            }

            function onMouseUp() {
                if (!dragging) return;
                dragging = false;
                document.removeEventListener('mousemove', onMouseMove);
                document.removeEventListener('mouseup', onMouseUp);
            }
        }

        document.addEventListener('click', function (e) {
            var item = e.target.closest('.attachment-item');
            if (!item) return;

            var url  = item.getAttribute('data-attach-url');
            var name = item.getAttribute('data-attach-name') || 'Attachment';
            var key  = item.getAttribute('data-attach-key') || url;

            if (!url || !key) return;

            if (windowsByKey[key]) {
                topZ++;
                windowsByKey[key].style.zIndex = topZ;
                return;
            }

            var winEl = document.createElement('div');
            winEl.className = 'attachment-preview-window';
            winEl.setAttribute('data-attach-key', key);

            // ========= الهيدر الجديد المتناسق مع Metronic =========
       winEl.innerHTML =
    '<div class="d-flex flex-column h-100">' +

    // HEADER (هنا التعديل في الهوامش)
