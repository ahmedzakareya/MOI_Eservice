        // Update license content dynamically with issue date and expire date
        function updateLicenseContent(statusId, licensesNo, issueDate, expireDate) {
            const licenseCell = document.getElementById('licenseCell');
            const issueDateCell = document.getElementById('issueDateCell');
            const expireDateCell = document.getElementById('expireDateCell');
            if (ReqTypeId === RequestType) {
                if (licenseCell) {
                    licenseCell.innerHTML = (statusId === FinalLicenseIssuingProcessing || statusId === FinalLicenseIssued)
                        ? `<span class="text-gray-800 badge badge-light-success">${licensesNo || 'N/A'}</span>`
                        : `<span class="text-gray-800 badge badge-light-warning">N/A</span>`;
                }
            }
            if (issueDateCell) {
                issueDateCell.innerHTML = issueDate
                    ? `<span class="badge badge-light-success">${new Date(issueDate).toLocaleDateString('ar-EG')}</span>`
                    : `<span class="badge badge-light-warning">N/A</span>`;
            }

            if (expireDateCell) {
                expireDateCell.innerHTML = expireDate
                    ? `<span class="badge badge-light-success">${new Date(expireDate).toLocaleDateString('ar-EG')}</span>`
                    : `<span class="badge badge-light-warning">N/A</span>`;
            }
        }
        function addLogRowToTable(userLog) {
            const logTableBody = document.querySelector('#logTable tbody');
            const newRow = document.createElement('tr');

            newRow.innerHTML = `

                                                                         <td>${userLog.requestTransaction.activity || '-'}</td>
                                                                        <td>${userLog.requestTransaction.operationDate ? new Date(userLog.requestTransaction.operationDate).toLocaleString() : '-'}</td>
                                                                              <td>${userLog.requestTransaction.note || '-'}</td>
                                                                               <td>${userLog.userLog.userFullName || '-'}</td>
                                                            `;

            logTableBody.prepend(newRow);
        }
