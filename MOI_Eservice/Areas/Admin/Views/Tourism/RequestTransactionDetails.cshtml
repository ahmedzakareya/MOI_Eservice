        function handleTransactionUIUpdate(updatedRequest, action) {
            const statusId = updatedRequest.statusid;
            const statusName = updatedRequest.statusname;
            const transTypeId = updatedRequest.transTypeId;

            const section = document.querySelector(`#transactionSection_${transTypeId}`);
            if (!section) return;

            const approveButton = section.querySelector('#RequestStatusbutton');
            const refuseButton = section.querySelector('#RefuseRequestbutton');
            const notifyButton = section.querySelector('#SendNotifyToUser');
            const statusContainer = section.querySelector('.status-message');

            if (statusId === RequestDeclined || statusName.includes("رفض")) {
                if (approveButton) approveButton.remove();
                if (refuseButton) refuseButton.remove();
                if (notifyButton) notifyButton.remove();

                const rejectedMessage = document.createElement("div");
                rejectedMessage.className = "text-danger fw-bold mt-2";
                rejectedMessage.textContent = "تم رفض الطلب";

                if (statusContainer) {
                    statusContainer.innerHTML = "";
                    statusContainer.appendChild(rejectedMessage);
                }
            } else if (approveButton && action === "RequestStatusbutton") {
                approveButton.textContent = statusName;
                approveButton.setAttribute("data-status-id", statusId);
                approveButton.classList.add("btn");
                approveButton.disabled = false;
            }
            if (statusId === WaitingForPayment) {
                const refuseBtn = section.querySelector('#RefuseRequestbutton');
                const notifyBtn = section.querySelector('#SendNotifyToUser');
                if (refuseBtn) refuseBtn.remove(); // or .style.display = "none";
                if (notifyBtn) notifyBtn.remove(); // or .style.display = "none";
                if (approveButton) {
                    approveButton.disabled = true;
                    approveButton.textContent = "قيد الدفع";
                    approveButton.style.pointerEvents = "none";
                    approveButton.style.backgroundColor = "#f8d7da";
                    approveButton.style.color = "#721c24";
                    approveButton.style.borderColor = "#f5c6cb";
                    approveButton.style.cursor = "not-allowed";
                }
            }
        }
