        const FinalLicenseIssuingProcessing = @((int)RequestStatusEnum.FinalLicenseIssuingProcessing);
        const FinalLicenseIssued = @((int)RequestStatusEnum.FinalLicenseIssued);
        const PaymentAndFinalLicencesIssued = @((int)RequestStatusEnum.PaymentAndFinalLicencesIssued);
