                    changeLogs: changeLogs,
                    transTypeId: transTypeId,
                    TransactionId: TransactionId,
                    //files: uploadedFiles ,
                    attachmentStates: allAttachmentsState

                };
                // Add SaveDataViewModel fields to FormData
                // if (!(uploadedFiles instanceof FormData)) {
                // Ensure uploadedFiles is always a FormData object
                // }
                // Add SaveDataViewModel fields to FormData
                for (const key in SaveDataViewModelTransactonType) {
                    if (Array.isArray(SaveDataViewModelTransactonType[key])) {
                        SaveDataViewModelTransactonType[key].forEach((value, index) => {
                            uploadedFiles.append(`${key}[${index}]`, value);
                        });
                    } else if (SaveDataViewModelTransactonType[key] !== undefined && SaveDataViewModelTransactonType[key] !== null) {
                        uploadedFiles.append(key, SaveDataViewModelTransactonType[key]);
                    }
                }

                // Call the API to update the status
                const response = await fetch('SaveDataTransaction/', {
                    method: 'POST',
                    body: uploadedFiles
                    // method: 'POST',
                    // headers: {
                    //          'Content-Type': 'application/json'
                    //           },
                    // body: JSON.stringify(SaveDataViewModel)
                });
                if (!response.ok) throw new Error('Failed to modify request status');

                const result = await response.json();
                if (typeof result.updatedRequest === 'string') {
                    result.updatedRequest = JSON.parse(result.updatedRequest);
                }

                console.log(result);
                console.log(result.updatedRequest);
                const nextStatusId = result.updatedRequest.statusid; // Updated status ID
                const nextStatusName = result.updatedRequest.statusname || "Unknown Status";
                const statusElement = document.querySelector(`#RequestStatusbutton[data-request-id="${requestId}"]`);


                // const transId = result.updatedRequest.transId;
                // const statusName = result.updatedRequest.statusname;
                // const statusId = result.updatedRequest.statusid;
                // const transTypeIdFromRequest = result.updatedRequest.transTypeId;
                // //const action = result.updatedRequest.action; // or get from your context

                // const section = document.querySelector(`#transactionSection_${transTypeIdFromRequest}`);
                // if (!section) return;

                // // Find buttons inside that transaction section
                // const approveButton = section.querySelector('#RequestStatusbutton');
                // const refuseButton = section.querySelector('#RefuseRequestbutton');
                // const notifyButton = section.querySelector('#SendNotifyToUser');
                // const statusContainer = section.querySelector('.status-message');

                // if (statusId === RequestDeclined || statusName.includes("رفض")) {
                //     if (approveButton) approveButton.remove();
                //     if (refuseButton) refuseButton.remove();
                //     if (notifyButton) notifyButton.remove();

                //     const rejectedMessage = document.createElement("div");
                //     rejectedMessage.className = "text-danger fw-bold mt-2";
                //     rejectedMessage.textContent = "تم رفض الطلب";

                //     if (statusContainer) {
                //         statusContainer.innerHTML = ""; // clear if needed
                //         statusContainer.appendChild(rejectedMessage);
                //     }
                // } else if (approveButton && action === "RequestStatusbutton") {
                //     approveButton.textContent = statusName;
                //     approveButton.setAttribute("data-status-id", statusId);
                //     //approveButton.disabled = true;
                // }else if (statusId===WaitingForPayment)
                // {
                //     if (refuseButton) refuseButton.remove();
                //     if (notifyButton) notifyButton.remove();
                //     approveButton.disabled = true;
                // }
                updateStatusUI(result.updatedRequest, action);
                console.log(result);
                console.log(result.updatedRequest);
                if (result.updatedRequest) {
                    addLogRowToTable(result.updatedRequest);
