@section Scripts
{
<script>
        $(function () {
            $(".aali-input").on('change', function () {
                var value = $(this).val();
                var regex = /^[0-9]+$/;

                if (!regex.test(value)) {
                    $(this).val("");
                    Swal.fire({
                        icon: 'error',
                        title: 'خطأ',
                        text: 'الرقم الآلي يجب أن يكون أرقام فقط',
                        confirmButtonText: 'موافق'
                    });
                    return;
                }

                // get the context to update only the related fields
                var container = $(this).closest('.card-body'); // or other parent if needed

                get_Amount(value, container);
            });
        });
        const getAddressUrl = '@Url.Action("getAddressDataFromPaci", "Account", new { area = "Admin" })';
        async function get_Amount(ID, container) {
            try {
                const response = await $.ajax({
                    type: "POST",
                    url: getAddressUrl,
                    data: { ID: ID },
                    dataType: "json"
                });

                container.find('#Governrate').val(response.governoratearabic || "");
                container.find('#Area').val(response.neighborhoodarabic || "");
                container.find('#BlockNo').val(response.blockarabic || "");
                container.find('#Street').val(response.streetarabic || "");
                container.find('#BuildingName').val(response.buildingnamearabic || "");
                container.find('#UnitNo').val(response.unit_no || "");
                container.find('#FloorNo').val(response.floor_no || "");
                container.find('#BuildingNo').val(response.parcelarabic || "");

            } catch (error) {
                container.find('.aali-input').val("");
                container.find('#Governrate, #Area, #BlockNo, #Street, #BuildingNo, #UnitNo, #FloorNo, #BuildingName').val("");

                Swal.fire({
                    icon: 'error',
                    title: 'خطأ...',
                    text: 'عفوا , الرقم الآلي غير صحيح!',
                });
            }
        }

</script>

}