@section Scripts {
    <script>
        function printDiv(InvioceContent) {
            var content = document.getElementById(InvioceContent).innerHTML;
            var printWindow = window.open('', '', 'height=400,width=800');
            printWindow.document.write('<html><head><title>Print</title></head><body>');
            printWindow.document.write(content);
            printWindow.document.write('</body></html>');
            printWindow.document.close();
            printWindow.print();
        }
    </script>
    <script>
        function modifyRequestStatus(requestId, oldStatusId, serviceId) {
            console.log('Request ID:', requestId); // Debug log
            console.log('Status ID:', oldStatusId); // Debug log
            var apiBaseUrl = '@ViewBag.ApiBaseUrl';
            var apiUrl = apiBaseUrl + '/UpdateRequestStatus?requestId=' + requestId + '&statusId=' + oldStatusId;

            const requestData = {
                requestId: requestId,
                statusId: oldStatusId
            };

            // Perform the update operation via POST request
            fetch(apiUrl, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(requestData)
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Failed to modify request status');
                    }
                    return response.json();
                })
                .then(updateData => {
                    // Step 2: After updating status, fetch the updated request details
                    console.log('Request status updated successfully:', updateData);

                    var getApiUrl = apiBaseUrl + '/GetRequestPreApprovmentById?id=' + requestId + '&serviceId=' + serviceId;
                    console.log(getApiUrl);

                    // Fetch the updated request data
                    fetch(getApiUrl)
                        .then(response => {
                            if (!response.ok) {
                                throw new Error('Failed to fetch updated request data');
                            }
                            return response.json();
                        })
                        .then(updatedRequestData => {
                            // Handle the updated request data here
                            console.log('Updated Request Details:', updatedRequestData);
                            alert('Request updated and status modified successfully!');

                            // Update the status on the page based on updated request data
                            var updatedStatusId = updatedRequestData.requestDVM.requestStatusId;


                            console.log(updatedStatusId);
                            var updatedStatusName = updatedRequestData.requestDVM.reqStatusName;

                            // Determine the new status color class based on the updated status ID
                            var statusColorClass = '';
                            switch (updatedStatusId) {
                                case 1:
                                    statusColorClass = 'badge badge-lg badge-light-primary d-inline';
                                    break;
                                case 2:
                                    statusColorClass = 'badge badge-lg badge-light-info d-inline';
                                    break;
                                case 4:
                                    statusColorClass = 'badge badge-lg badge-light-warning d-inline';
                                    break;
                                case 3:
                                    statusColorClass = 'badge badge-lg badge-info d-inline';
                                    break;
                                case 5:
                                    statusColorClass = 'badge badge-lg badge-light-info d-inline';
                                    break;
                                case 6:
                                    statusColorClass = 'badge badge-lg badge-light-success d-inline';
                                    break;
                                case 7:
                                    statusColorClass = 'badge badge-lg badge-light-success d-inline';
                                    break;
                                case 8:
                                    statusColorClass = 'badge badge-lg badge-light-danger d-inline';
                                    break;
                                case 12:
                                    statusColorClass = 'badge badge-lg badge-light-warning d-inline';
                                    break;
                                case 13:
                                    statusColorClass = 'badge badge-lg badge-light-danger d-inline';
                                    break;
                                default:
                                    break;
                            }

                            // Update the status button text with the new status name
                            var statusButton = document.querySelector("#statusButtons button");
                            var statusMainRequest = document.getElementById("RequestStatusMain");

                            if (statusButton) {
                                statusButton.textContent = updatedStatusName;
                            }

                            if (statusMainRequest) {
                                statusMainRequest.textContent = updatedStatusName; // Update text content of the badge
                                // Update the badge class with the new status color
                                statusMainRequest.className = statusColorClass; // Change the badge color class dynamically
                            }




                        })
                        .catch(error => {
                            console.error('Error fetching updated request details:', error);
                        });
                })
                .catch(error => {
                    console.error('Error modifying request status:', error);
                });
        }


        document.addEventListener("DOMContentLoaded", function () {
            const submitButtons = document.querySelectorAll(".submitAttachmentButton");

            submitButtons.forEach(button => {
                button.addEventListener("click", async function () {
                    // Call the first function
                    const filesValid = await initializeAttachmentUpload();

                    // Check if the first function passes (returns true), then call the second function
                    if (filesValid) {
                        // Call the second function if the first one is successful
                        moveToNextStatus(this);
                    }
                });
            });
        });
    </script>
    <script src="~/Admin/assets/js/attachmentUpload.js"></script>

}
