@model List<LicencesVM>

@{
    ViewBag.Title = "Tourism_AllRequest";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutEserviceTourism.cshtml";
}



<!--begin::Toolbar-->
<div id="kt_app_toolbar" class="app-toolbar pt-6 pb-2">
    <!--begin::Toolbar container-->
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex align-items-stretch">
        <!--begin::Toolbar wrapper-->
        <div class="app-toolbar-wrapper d-flex flex-stack flex-wrap gap-4 w-100">
            <!--begin::Page title-->
            <div class="page-title d-flex flex-column justify-content-center gap-1 me-3">
                <!--begin::Title-->
                <h1 class="page-heading d-flex flex-column justify-content-center text-gray-900 fw-bold fs-3 m-0">قائمة التراخيص</h1>
                <!--end::Title-->
                <!--begin::Breadcrumb-->
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0">
                    <!--begin::Item-->
                    <li class="breadcrumb-item text-muted">
                        <a href="/Mosanafat/Index" class="text-muted text-hover-primary">الشاشة الرئيسة</a>

                    </li>
                    <!--end::Item-->
                    <!--begin::Item-->
                    <li class="breadcrumb-item">
                        <span class="bullet bg-gray-500 w-5px h-2px"></span>
                    </li>
                    <!--end::Item-->
                    <!--begin::Item-->
                    <li class="breadcrumb-item text-muted">قائمة التراخيص</li>
                    <!--end::Item-->
                </ul>
                <!--end::Breadcrumb-->
            </div>
            <!--end::Page title-->
            <!--begin::Actions-->
            <div class="d-flex align-items-center gap-2 gap-lg-3">
                <a href="#" class="btn btn-flex btn-outline btn-color-gray-700 btn-active-color-primary bg-body h-40px fs-7 fw-bold" data-bs-toggle="modal" data-bs-target="#kt_modal_view_users">Add Member</a>
                <a href="#" class="btn btn-flex btn-primary h-40px fs-7 fw-bold" data-bs-toggle="modal" data-bs-target="#kt_modal_create_campaign">New Campaign</a>
            </div>
            <!--end::Actions-->
        </div>
        <!--end::Toolbar wrapper-->
    </div>
    <!--end::Toolbar container-->
</div>
<!--end::Toolbar-->
<!--begin::Content-->
<div id="kt_app_content" class="app-content flex-column-fluid">
    <!--begin::Content container-->
    <div id="kt_app_content_container" class="app-container container-fluid">
        <!--begin::Card-->
        <div class="card">
            <!--begin::Card header-->
            <div class="card-header border-0 pt-6">
                <!--begin::Card title-->
                <div class="card-title">
                    <!--begin::Search-->
                    <div class="d-flex align-items-center position-relative my-1">
                        <i class="ki-outline ki-magnifier fs-3 position-absolute ms-5"></i>
                        <input type="text" data-kt-subscription-table-filter="search" class="form-control form-control-solid w-250px ps-12" placeholder="Search Subscriptions" />
                    </div>
                    <!--end::Search-->
                </div>
                <!--begin::Card title-->
                <!--begin::Card toolbar-->
                <div class="card-toolbar">
                    <!--begin::Toolbar-->
                    <div class="d-flex justify-content-end" data-kt-subscription-table-toolbar="base">
                        <!--begin::Filter-->
                    
                        <!--end::Menu 1-->
                        <!--end::Filter-->
                        <!--begin::Export-->
                        <button type="button" class="btn btn-light-primary" data-bs-toggle="modal" data-bs-target="#kt_modal_export">
                            <i class="ki-duotone ki-upload fs-2 me-1"></i>تصدير
                        </button>

                        <!--end::Export-->
                        <!--begin::Add subscription-->
                       
                        <!--end::Add subscription-->
                    </div>
                    <!--end::Toolbar-->
                    <!--begin::Group actions-->
                    <div class="d-flex justify-content-end align-items-center d-none" data-kt-subscription-table-toolbar="selected">
                        <div class="fw-bold me-5">
                            <span class="me-2" data-kt-subscription-table-select="selected_count"></span>Selected
                        </div>
                        <button type="button" class="btn btn-danger" data-kt-subscription-table-select="delete_selected">Delete Selected</button>
                    </div>
                    <!--end::Group actions-->
                </div>
                <!--end::Card toolbar-->
            </div>
            <!--end::Card header-->
            <!--begin::Card body-->
            <div class="card-body pt-0">
                <!--begin::Table-->
                <table class="table align-middle table-row-dashed fs-6 gy-5" id="kt_subscriptions_table">
                    <thead>
                        <tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0">
                            @*  <th class="w-10px pe-2">
                                <div class="form-check form-check-sm form-check-custom form-check-solid me-3">
                                    <input class="form-check-input" type="checkbox" data-kt-check="true" data-kt-check-target="#kt_subscriptions_table .form-check-input" value="1" />
                                </div>
                            </th> *@

                            <th class="text-start min-w-125px">م</th>
                            <th class="text-start min-w-125px">رقم الترخيص</th>
                            <th class="text-start min-w-125px">نوع النشاط</th>
                            @* <th class="text-start min-w-125px">إسم صاحب الترخيص</th> *@
                            <th class="text-start min-w-125px">الرقم المدني لصاحب الترخيص</th>
                            <th class="text-start min-w-125px">إسم الترخيص</th>
                            <th class="text-start min-w-125px">تاريخ بداية الترخيص</th>

                            <th class="text-start min-w-125px">تاريخ الانتهاء</th>

                            <th class="text-end min-w-70px">عرض</th>
                        </tr>
                    </thead>
                    <tbody class="text-gray-600 fw-semibold">

                        @{
                            int serial = 0;
                        }
                        @foreach (var item in Model)
                        {
                            serial++;
                            <tr>
                                 @* <td>
                                    <div class="form-check form-check-sm form-check-custom form-check-solid">
                                        <input class="form-check-input" type="checkbox" value="1" />
                                    </div>
                                </td> 
 *@
                                <td>
                                    <a href="apps/customers/view.html" class="text-gray-800 text-hover-primary mb-1">@serial</a>
                                </td>


                                <td>@item.LicNo</td>
                                <td>@item.ActivityTypeName</td>
                                @* <td>@item.Applicant.Name1</td> *@

                                <td>@item.ApplicantCivilId</td>
                                <td>@item.LicName</td>
                                <td>@item.IssueDate.Value.ToString("yy - MM - yyyy")</td>
                                @if (@item.ExpireDate >= DateTime.Today)
                                {
                                    <td>
                                        <span class="badge  py-3 px-4 fs-7  badge-light-danger">@item.ExpireDate.Value.ToString("yy - MM - yyyy")</span>
                                    </td>
                                }
                                else
                                {
                                    <td>
                                        @if (item.ExpireDate != null)
                                        {
                                            <span class="badge  py-3 px-4 fs-7  badge-light-success">@item.ExpireDate.Value.ToString("yy - MM - yyyy")</span>

                                        }
                                    </td>
                                }

@*                                 <td>@item.LicStatusName</td>
 *@
                                <td class="text-end">
                                    <a asp-area="Admin" asp-action="GetLicenceDetails" asp-controller="Tourism" asp-route-id="@item.LicId" class="btn btn-icon btn-sm h-auto btn-color-gray-500 btn-active-color-primary justify-content-end">
                                        <i class="ki-outline ki-exit-right-corner fs-2"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <!--end::Table-->
            </div>
            <!--end::Card body-->
        </div>
        <!--end::Card-->
        <!--begin::Modals-->
        <!--begin::Modal - Export-->
        <div class="modal fade" id="kt_modal_export" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered mw-650px">
                <div class="modal-content">
                    <form method="post" action="@Url.Action("Export", "Licenses")" id="kt_export_form">
                        <div class="modal-header">
                            <h2 class="fw-bold">تصدير التراخيص</h2>
                            <div class="btn btn-icon btn-sm btn-active-icon-primary" data-bs-dismiss="modal">
                                <i class="ki-duotone ki-cross fs-1"><span class="path1"></span><span class="path2"></span></i>
                            </div>
                        </div>

                        <div class="modal-body py-10 px-lg-17">
                            <!--begin::Input group-->
                            <div class="fv-row mb-10">
                                <label class="required form-label fs-6 mb-2">نوع التصدير</label>
                                <select name="ExportType" class="form-select form-select-solid" data-control="select2" data-hide-search="true">
                                    <option value="Excel">Excel</option>
                                    <option value="PDF">PDF</option>
                                </select>
                            </div>
                            <!--end::Input group-->
                            <!--begin::Input group-->
                            <div class="fv-row mb-10">
                                <label class="form-label fs-6 mb-2">الفترة الزمنية</label>
                                <div class="input-group">
                                    <input type="date" class="form-control form-control-solid" name="FromDate" required />
                                    <span class="input-group-text">إلى</span>
                                    <input type="date" class="form-control form-control-solid" name="ToDate" required />
                                </div>
                            </div>
                            <!--end::Input group-->
                            <!--begin::Input group-->
                           @*  <div class="fv-row mb-10">
                                <label class="form-label fs-6 mb-2">نوع النشاط</label>
                                <select name="ActivityType" class="form-select form-select-solid">
                                    <option value="">الكل</option>
                                    <option value="فندق">فندق</option>
                                    <option value="مكتب">مكتب</option>
                                    <option value="شركة">شركة</option>
                                </select>
                            </div> *@
                            <!--end::Input group-->
                        </div>

                        <div class="modal-footer flex-center">
                            <button type="reset" class="btn btn-light me-3" data-bs-dismiss="modal">إلغاء</button>
                            <button type="submit" class="btn btn-primary">
                                <span class="indicator-label">تصدير</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <!--end::Modal-->
        <!--end::Modals-->
    </div>
    <!--end::Content container-->
</div>
<!--end::Content-->
