                     reqTypeId:reqTypeId,
                    ReqStatusId: currentStatusId,
                    changeLogs: changeLogs,
                    //files: uploadedFiles ,
                    attachmentStates :allAttachmentsState,
                    HotelClassEvaluations: evaluationsData,
                    ClassificationId: ClassificationId

                };

                // Add SaveDataViewModel fields to FormData
                
                // Add SaveDataViewModel fields to FormData
                // for (const key in SaveDataClassificationViewModel) {
                //     if (Array.isArray(SaveDataClassificationViewModel[key])) {
                //         SaveDataClassificationViewModel[key].forEach((value, index) => {
                //             uploadedFiles.append(`${key}[${index}]`, value);
                //         });
                //     } else if (SaveDataClassificationViewModel[key] !== undefined && SaveDataClassificationViewModel[key] !== null) {
                //         uploadedFiles.append(key, SaveDataClassificationViewModel[key]);
                //     }
                // }

                
                // Add SaveDataViewModel fields to FormData
                // for (const key in SaveDataClassificationViewModel) {
                //     if (Array.isArray(SaveDataClassificationViewModel[key])) {
                //         SaveDataClassificationViewModel[key].forEach((value, index) => {
                //             if (key === "allAttachmentsState") {
                //                 // If it is the list of AttachmentState objects
                //                 uploadedFiles.append(`allAttachmentsState[${index}].AttachmentId`, value.attachmentId);
                //                 uploadedFiles.append(`allAttachmentsState[${index}].State`, value.state);
                //             } else {
                //                 uploadedFiles.append(`${key}[${index}]`, value);
                //             }
                //         });
                //     } else if (SaveDataClassificationViewModel[key] !== undefined && SaveDataClassificationViewModel[key] !== null) {
                //         uploadedFiles.append(key, SaveDataClassificationViewModel[key]);
                //     }
                // }
                for (const key in SaveDataClassificationViewModel) {
                    if (Array.isArray(SaveDataClassificationViewModel[key])) {
                        SaveDataClassificationViewModel[key].forEach((value, index) => {
                            if (key === "HotelClassEvaluations") {
                                uploadedFiles.append(`${key}[${index}].hotelClassId`, value.hotelClassId);
                                uploadedFiles.append(`${key}[${index}].evaluationId`, value.evaluationId);
                                uploadedFiles.append(`${key}[${index}].IsSelected`, value.isSelected);
                                    uploadedFiles.append(`${key}[${index}].classificationId`, value.classificationId); // ✅ Add this line

                            }

                            if (key === "allAttachmentsState") {
                                uploadedFiles.append(`${key}[${index}].AttachmentId`, value.attachmentId);
