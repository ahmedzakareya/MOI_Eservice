                        uploadedFiles.append(key, SaveDataClassificationViewModel[key]);
                    }
                }
                for (let pair of uploadedFiles.entries()) {
                    console.log(pair[0] + ':', pair[1]);
                }
                // Submit the status update to the server
                const response = await fetch('SaveDataClassification/', {
