@model RequestDetailsVM

@{
    ViewBag.Title = "شهادة ترخيص";
    Layout = null;
}



<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>الموافقة المبدئية</title>
    <!-- إضافة Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            font-family: 'Arial', sans-serif;
            margin: 20px;
            line-height: 1.9;
            background-color: #fff;
            color: #000;
        }

        .header-logo {
            max-width: 120px;
        }

        .header-stamp img {
            max-width: 100px;
        }

        .main-border {
            border: 6px solid #e7d987;
            border-radius: 10px;
            padding: 40px;
        }

        .footer {
            margin-top: 30px;
            border-top: 1px solid #e7d987;
            padding-top: 20px;
        }

        .custom-title {
            font-weight: bold;
            font-size: 22px;
            text-decoration: underline;
        }

        .highlight {
            font-weight: bold;
            color: #000;
        }

        .signature {
            margin-top: 40px;
            text-align: left;
            font-weight: bold;
        }

        .social-links img {
            width: 25px;
            margin-left: 10px;
        }

        .stamp-text {
            text-align: left;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="container main-border">
        <!-- Header Section -->
        <div class="row align-items-center">
            <div class="col-4">
                <img src="~/Admin/assets/Images/Logo.png" alt="Logo" class="header-logo">
            </div>
            <div class="col-4 text-center">
                <h5 class="mb-0">وزارة الإعلام</h5>
                <h6 class="mb-0">Ministry Of Information</h6>
                <p>الوكيل المساعد لقطاع السياحة</p>
            </div>
            <div class="col-4 header-stamp text-end">
                <img src="https://via.placeholder.com/100" alt="Stamp">
                <div class="stamp-text mt-2">رقم الوارد: 2024/17/03</div>
            </div>
        </div>

        <!-- Body Section -->
        <div class="mt-4">
            <p class="custom-title">السيد / مدير عام بلدية الكويت</p>
            <p>تحية طيبة وبعد،،،</p>
            <p><span class="highlight">الموضوع:</span> <strong>موافقة مبدئية على تحويل منشأة فندقية بمنطقة (@Model.RequestDVM.company.AddressNavigation.Area)</strong></p>
            <p>يهديكم قطاع السياحة بوزارة الإعلام أطيب التحية.</p>

            <p>
                بالإشارة إلى الموضوع أعلاه، يرجى العلم بأن السادة
                <span class="highlight">@Model.RequestDVM.ActivityName</span> قد تقدمت بطلب موافقة مبدئية لتحويل
                منشأة فندقية بمنطقة <span class="highlight">@Model.RequestDVM.company.AddressNavigation.BlockArabic</span>، قطعة رقم
                <span class="highlight">@Model.RequestDVM.company.AddressNavigation.UnitNo</span>، قسيمة رقم <span class="highlight">149</span> بمساحة إجمالية
                <span class="highlight">@Model.RequestDVM.company.AddressNavigation.AreaSize م2</span>.
            </p>
            <p>
                وذلك حسب المخطط السياحي رقم <span class="highlight">@Model.RequestDVM.company.AddressNavigation.AalliNo</span> والرقم الآلي للعنوان
                <span class="highlight">@Model.RequestDVM.company.AddressNavigation.AreaChartNo</span>.
            </p>
            <p>
                نحيطكم علمًا بأن قطاع السياحة ليس لديه مانع على إنشاء العقار المذكور أعلاه، وذلك وفق
                اشتراطات بلدية الكويت والجهات المعنية بهذا الشأن.
            </p>
            <p>لذا نأمل منكم الإطلاع واتخاذ كافة الإجراءات اللازمة بهذا الشأن.</p>
            <p class="text-center fw-bold">وتفضلوا بقبول فائق التقدير والاحترام،،،،</p>
        </div>

        <!-- Signature Section -->
        <div class="signature">
            <p>الوكيل المساعد لقطاع السياحة</p>
            <p>توقيع: __________________</p>
        </div>

        <!-- Footer Section -->
        <div class="footer text-center">
            <p>
                <small>ص.ب: 193 الصفاة - الرمز البريدي 13002 الكويت</small>
            </p>
            <div class="social-links">
                <a href="#"><img src="https://via.placeholder.com/25" alt="Instagram"></a>
                <a href="#"><img src="https://via.placeholder.com/25" alt="Twitter"></a>
                <a href="#"><img src="https://via.placeholder.com/25" alt="Website"></a>
            </div>
        </div>
    </div>
</body>
</html>

