        // Submit Company Change
        async function submitFormWithAjax() {
            // Create objects for CompanyVM and AddressCompanyVM
            const companyData = {};
            const addressData = {};

            // Populate CompanyVM
            const ownerCompany = document.querySelector('[name="CompanyVM.OwnerCompanyAr"]');
            const recordCommercialNo = document.querySelector('[name="CompanyVM.RecordCommercialNo"]');
            const commercialNOMOIC = document.querySelector('[name="CompanyVM.CommercialNOMOIC"]');
            const Id = document.querySelector('[name="CompanyVM.Id"]');

            if (ownerCompany) companyData.OwnerCompanyAr = ownerCompany.value || '';
            if (Id) companyData.Id = Id.value || '';

            if (recordCommercialNo) companyData.RecordCommercialNo = recordCommercialNo.value || '';
            if (commercialNOMOIC) companyData.CommercialNOMOIC = commercialNOMOIC.value || '';

            // Populate AddressCompanyVM
            const unitNo = document.querySelector('[name="CompanyVM.AddressNavigation.UnitNo"]');
            const idAddress = document.querySelector('[name="CompanyVM.AddressNavigation.Id"]');

            const floorNo = document.querySelector('[name="CompanyVM.AddressNavigation.FloorNo"]');
            const street = document.querySelector('[name="CompanyVM.AddressNavigation.StreetArabic"]');
            const blockNo = document.querySelector('[name="CompanyVM.AddressNavigation.BlockArabic"]');
            const aalliNo = document.querySelector('[name="CompanyVM.AddressNavigation.AalliNo"]');
            const governorate = document.querySelector('[name="CompanyVM.AddressNavigation.GovernorateArabic"]');
            const area = document.querySelector('[name="CompanyVM.AddressNavigation.Area"]');

            if (unitNo) addressData.UnitNo = unitNo.value || '';
            if (idAddress) addressData.Id = idAddress.value || '';

            if (floorNo) addressData.FloorNo = floorNo.value || '';
            if (street) addressData.StreetArabic = street.value || '';
            if (blockNo) addressData.BlockArabic = blockNo.value || '';
            if (aalliNo) addressData.AalliNo = aalliNo.value || '';
            if (governorate) addressData.GovernorateArabic = governorate.value || '';
            if (area) addressData.Area = area.value || '';

            // Combine into UpdateMoicViewModel
            const updateMoicViewModel = {
                CompanyVM: companyData,
                AddressCompanyVM: addressData
            };

            // Send as JSON
            const actionUrl = 'UpdateMoic/';

            try {
                const response = await fetch(actionUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(updateMoicViewModel)
                });

                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }

                const data = await response.json();
                console.log('Form submitted successfully:', data);
                // Handle success (e.g., display a success message)
            } catch (error) {
                console.error('Error submitting form:', error);
                // Handle error (e.g., display an error message)
            }
        }
