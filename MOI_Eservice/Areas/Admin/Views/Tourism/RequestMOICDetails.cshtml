        // Update license content dynamically with issue date and expire date
        function updateLicenseContent(statusId, licensesNo, issueDate, expireDate) {
            const licenseCell = document.getElementById('licenseCell');
            const issueDateCell = document.getElementById('issueDateCell');
            const expireDateCell = document.getElementById('expireDateCell');

            if (licenseCell) {
                licenseCell.innerHTML = (statusId === FinalLicenseIssuingProcessing || statusId === 8)
                    ? `<span class="text-gray-800 badge badge-light-success">${licensesNo || ''}</span>`
                    : '';
            }

            if (issueDateCell) {
                issueDateCell.innerHTML = issueDate
                    ? `<span class="badge badge-light-success">${new Date(issueDate).toLocaleDateString('ar-EG')}</span>`
                    : '';
            }

            if (expireDateCell) {
                expireDateCell.innerHTML = expireDate
                    ? `<span class="badge badge-light-success">${new Date(expireDate).toLocaleDateString('ar-EG')}</span>`
                    : '';
            }
        }
        function addLogRowToTable(userLog) {
            const logTableBody = document.querySelector('#logTable tbody');
            const newRow = document.createElement('tr');

            newRow.innerHTML = `

                                                         <td>${userLog.requestTransaction.activity || '-'}</td>
                                                        <td>${userLog.requestTransaction.operationDate ? new Date(userLog.requestTransaction.operationDate).toLocaleString() : '-'}</td>
                                                              <td>${userLog.requestTransaction.note || '-'}</td>
                                                               <td>${userLog.userLog.userFullName || '-'}</td>
                                            `;

            logTableBody.prepend(newRow);
        }

        // For Paci Address----------------

        $(function () {
            $("#AalliNumber").on('change', function () {
                const regex = /^[0-9]+$/; // Regex for numeric validation
                const value = $(this).val();

                if (!regex.test(value)) {
                    $(this).val(""); // Clear the invalid input
                    Swal.fire({
                        icon: 'error',
                        title: 'خطأ',
                        text: 'أرقام فقط مسموح بها!',
                        confirmButtonColor: '#7FB3D5',
                        confirmButtonText: 'موافق'
                    });
                    return; // Exit function if validation fails
                }

                // If validation passes, proceed to fetch data
                get_Amount(value);
            });
        });

        function get_Amount(ID) {
            $.ajax({
                type: "POST",
                url: "@Url.Action("getAddressDataFromPaci", "Tourism", new { area = "Admin" })",
                data: { ID: ID },
                success: function (data) {
                    // Populate fields with the received data
                    $('#Governorate').val(data.governoratearabic);
                    $('#Area').val(data.neighborhoodarabic);
                    $('#BlockNo').val(data.blockarabic);
                    $('#Street').val(data.streetarabic);
                    $('#BuildingNo').val(data.buildingnamearabic);
                    $('#BuildingNomber').val(data.parcelarabic);
                },
                error: function () {
                    // Clear fields on error
                    $('#AalliNumber').val("");
                    $('#Governorate').val("");
                    $('#Area').val("");
                    $('#BlockNo').val("");
                    $('#Street').val("");
                    $('#BuildingNo').val("");
                    $('#BuildingNomber').val("");
                    Swal.fire({
                        icon: 'error',
                        title: 'خطأ...',
                        text: 'عفوا، الرقم الآلي غير صحيح!',
                        confirmButtonColor: '#7FB3D5',
                        confirmButtonText: 'موافق'
                    });
                }
            });
        }
