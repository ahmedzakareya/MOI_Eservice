@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>


    <script>
        // Define the base URL for API requests
        const Dynamicurl = '@ViewBag.DynamicUrlApi';
        let cachedAttachmentRules = null;
        $(document).ready(function () {
            initializeCheckboxStates();  // Set the initial state of checkboxes
        });
        document.addEventListener("DOMContentLoaded", function () {
            const submitButtons = document.querySelectorAll(".submitAttachmentButton");

            submitButtons.forEach(button => {
                button.addEventListener("click", async function () {
                    // Call the first function
                    const filesValid = await initializeAttachmentUpload();

                    // Check if the first function passes (returns true), then call the second function
                    if (filesValid) {
                        // Call the second function if the first one is successful
                        moveToNextStatus(this);
                    }
                });
            });
        });
        document.addEventListener('DOMContentLoaded', function () {
            console.log('Page Loaded: Initializing scripts.');
            const serviceId = parseInt('@(Model.RequestDVM.ServiceId)');
            const activityTypeId = parseInt('@(Model.RequestDVM.ActivityTypeId)');
            const requestTypeId = parseInt('@(Model.RequestDVM.ReqtypeId)');
            const initialStatusId = parseInt('@(Model.RequestDVM.RequestStatusId)');
            // document.getElementById('submitButton').addEventListener('click', () => {
            //     submitFormWithAjax('companyForm');
            // });
            console.log('Searching for form with ID: companyForm');
            //const form = document.getElementById('companyForm');
            // const ownerCompany = document.getElementById('OwnerCompanyAr');
            // const ownerCompany2 = document.querySelector('[name="CompanyVM.OwnerCompanyAr"]');

            // console.log(ownerCompany);
            // console.log(ownerCompany2);


            // console.log('Form found:', form);
            console.log('Initial Status ID:', initialStatusId);

            const isFinalStatus = '@(Model.IsFinalStatus)';
            const requeststatus = '@(Model.requestStatus)';//payment
            trackNoteChangesbeforAfter(); // Call this to start tracking the note changes

            initializePage(initialStatusId);

            console.log('Initial Status ID:', initialStatusId);
            const statusButtons = document.querySelectorAll('#statusButtons button');
            statusButtons.forEach(button => {
                button.addEventListener('click', function () {
                    handleButtonClick(this);
                });
            });
            //renderFileInputs(serviceId, activityTypeId, initialStatusId, requestTypeId);


            // Attach event listeners to all buttons using event delegation

        });
        let action = '';

        // Initialize the page based on the initial status ID
        function initializePage(statusId) {
            checkInitialStatusForUploadFile(statusId);
            checkStatusAndShowUploadForAttachment(statusId);
            // submitFormWithAjax();

            updateLicenseContent(
                statusId,
                '@(Model.RequestDVM?.Licno ?? "")',
                '@(Model.RequestDVM?.LicenceNavigation?.IssueDate?.ToString("yyyy-MM-dd") ?? "")',
                '@(Model.RequestDVM?.LicenceNavigation?.ExpireDate?.ToString("yyyy-MM-dd") ?? "")'
            );
            hideButtonsForCertainStatuses(statusId);
            hideRefuseButtonForCertainStatuses(statusId);
        }
        // This function will be called on page load to set the initial states from the model
        function initializeCheckboxStates() {
            $("input[type='checkbox']").each(function () {
                const attachmentId = $(this).data('id');
                const isChecked = $(this).prop('checked');

                // Store the initial state from the model (based on whether the checkbox is checked or not)
                previousCheckboxStates[attachmentId] = isChecked;
            });
        }
        let changeLogs = [];  // Array to store change logs

        // Handle all button clicks
        function handleButtonClick(button) {
            action = button.id; // Button ID can determine the action
            console.log(`Button clicked: ${action}`);
            changeLogs.push(action);
            // Collect necessary data before performing actions
            // collectEvaluationData();  // Collect evaluation data from radio buttons
            trackCheckboxChanges();   // Track changes in checkboxes
            trackNoteChanges();       // Track changes in the note textarea
            console.log(selectedAttachments);
            console.log(uncheckedAttachments);
            console.log(note);
            // Log user action
            logUserAction(action, button.id, {
                selectedAttachments,
                uncheckedAttachments,
                note
            });

            // Send the collected data to the server
            // sendDataToServer({
            //     action: action,
            //     selectedAttachments: selectedAttachments,
            //     uncheckedAttachments: uncheckedAttachments,
            //     note: note,
            //     requestId: button.getAttribute('data-request-id'),
            //     serviceId: button.getAttribute('data-service-id'),
            //     activityTypeId: button.getAttribute('data-activity-type-id'),
            //     statusId: button.getAttribute('data-status-id'),
            //     reqTypeId: button.getAttribute('data-reqtype-id'),
            //     reqNo: button.getAttribute('data-reqno')
            // });
        }

        // Function to log user actions (for debugging or logging purposes)
        function logUserAction(action, elementId, data) {
            console.log("Action:", action);
            console.log("Element ID:", elementId);
            console.log("Data:", data);

            localStorage.setItem('userAction', JSON.stringify({ action, elementId, data }));
        }

        // Track changes in checkboxes
        function trackCheckboxChanges() {
            $("input[type='checkbox']").each(function () {
                const attachmentId = $(this).data('id');
                const isChecked = $(this).prop('checked');
                console.log("Checkbox ID:", attachmentId);  // Check the value of attachmentId

                console.log("Checkbox Checked:", isChecked);
                updateAttachmentList(isChecked, attachmentId);
            });

            // التفاعل مع التغيير في حالة الـcheckbox
            $("input[type='checkbox']").on('change', function () {
                const attachmentId = $(this).data('id');

                console.log("Checkbox ID:", attachmentId);  // Check the value of attachmentId
                const isChecked = $(this).prop('checked');
                console.log("Checkbox Checked:", isChecked);

                updateAttachmentList(isChecked, attachmentId);
            });
        }
        // Track changes in checkboxes
        const selectedAttachments = [];
        let note = '';
        let uncheckedAttachments = [];
        // Update the attachment list based on checkbox state
        function updateAttachmentList(isChecked, attachmentId) {
            if (attachmentId != null && attachmentId !== undefined) {
                if (isChecked) {
                    // Add to selected attachments
                    if (!selectedAttachments.includes(attachmentId)) {
                        selectedAttachments.push(attachmentId);
                    }
                } else {
                    // Add to unchecked attachments
                    if (!uncheckedAttachments.includes(attachmentId)) {
                        uncheckedAttachments.push(attachmentId);
                    }
                }
            } else {
                console.log("Attachment ID is null or undefined, skipping...");
            }

            console.log("Checked attachments:", selectedAttachments);
            console.log("Unchecked attachments:", uncheckedAttachments);
        }
        // Track changes in the note textarea
        function trackNoteChanges() {
            $("#RequestNote").on('input', function () {
                note = $(this).val().trim();
                console.log("Note:", note);
            });
        }



        // Object to store the previous states of the checkboxes
        let previousCheckboxStates = {};

        // Arrays to store selected and unchecked attachments

        let allAttachmentsState = [];  // To store all attachments and their states

        // Track change in the state of checkboxes
        $("input[type='checkbox']").on('change', function () {
            const attachmentId = $(this).data('id');  // Get the ID of the attachment
            const isChecked = $(this).prop('checked');  // Get the current state of the checkbox (checked or unchecked)

            // If this is the first time we are checking this attachmentId, initialize its previous state
            if (previousCheckboxStates[attachmentId] === undefined) {
                previousCheckboxStates[attachmentId] = isChecked;
            }

            // Get the old state before the change
            const oldState = previousCheckboxStates[attachmentId] ? "checked" : "unchecked";
            const newState = isChecked ? "checked" : "unchecked";

            // If the state of this checkbox has changed
            if (oldState !== newState) {
                // Log the change: from previous state to current state
                const logMessage = `Attachment ID: ${attachmentId} changed from ${oldState} to ${newState}`;
                console.log(logMessage);  // Log the change to the console

                // Store the change in the logs
                // changeLogs.push({
                //     attachmentId: attachmentId,
                //     oldState: oldState,
                //     newState: newState
                // });
                changeLogs.push(logMessage);
                // Update the previous state to the current state
                previousCheckboxStates[attachmentId] = isChecked;

                // Update selected or unchecked attachments based on the new state
                if (isChecked) {
                    if (!selectedAttachments.includes(attachmentId)) {
                        selectedAttachments.push(attachmentId);
                    }
                    // Remove from uncheckedAttachments if it was previously unchecked
                    const index = uncheckedAttachments.indexOf(attachmentId);
                    if (index !== -1) {
                        uncheckedAttachments.splice(index, 1);
                    }
                } else {
                    if (!uncheckedAttachments.includes(attachmentId)) {
                        uncheckedAttachments.push(attachmentId);
                    }
                    // Remove from selectedAttachments if it was previously checked
                    const index = selectedAttachments.indexOf(attachmentId);
                    if (index !== -1) {
                        selectedAttachments.splice(index, 1);
                    }
                }
                allAttachmentsState.push({
                    attachmentId: attachmentId,
                    state: isChecked ? 'checked' : 'unchecked'
                });
                // Log the updated array for debugging
                console.log("All Attachments State:", allAttachmentsState);
                // Log the updated lists for debugging
                console.log("Selected Attachments:", selectedAttachments);
                console.log("Unchecked Attachments:", uncheckedAttachments);
                console.log("Change Logs:", changeLogs);
            }

        });



        let newnote = '';  // The current value of the note

        let initialNote = $("#RequestNote").val().trim();  // Store the initial value of the note


        let noteChangeLogged = false;  // To ensure we log the change only once (first and last)

        function trackNoteChangesbeforAfter() {
            $("#RequestNote").on('blur', function () {
                newnote = $(this).val().trim();  // Update the current note

                // Log change when the note is different from the initial one and hasn't been logged yet
                if (!noteChangeLogged && newnote !== initialNote) {
                    const logMessage = `Note changed from "${initialNote}" to "${newnote}"`;
                    changeLogs.push(logMessage);  // Store the change in the logs

                    // Log the change
                    console.log(logMessage);

                    // Optionally, set the initial note to the new value after logging the change
                    initialNote = newnote;
                    noteChangeLogged = true;  // Mark that the note change has been logged
                }

                // Reset log when user starts editing again
                if (newnote === initialNote && noteChangeLogged) {
                    noteChangeLogged = false;  // Allow further tracking if the note returns to its initial value
                }
            });
        }
        const RequestDeclined = @((int)RequestStatusEnum.RequestDeclined);
        const FinalLicenseIssuingProcessing = @((int)RequestStatusEnum.FinalLicenseIssuingProcessing);
        const FinalLicenseIssued = @((int)RequestStatusEnum.FinalLicenseIssued);
        const PaymentAndFinalLicencesIssued = @((int)RequestStatusEnum.PaymentAndFinalLicencesIssued);
        // Handle moving to the next status
        async function moveToNextStatus(element) {

            try {
                handleButtonClick(element);  // This will update selectedAttachments, uncheckedAttachments, etc.

                const requestId = element.getAttribute('data-request-id');
                const serviceId = element.getAttribute('data-service-id');
                const activityTypeId = element.getAttribute('data-activity-type-id');
                const currentStatusId = parseInt(element.getAttribute('data-status-id'));
                const reqTypeId = element.getAttribute('data-reqtype-id');
                const note = document.getElementById("RequestNote").value.trim();
                const reqNo = element.getAttribute('data-reqno');

                logUserAction('Button Click', element.id, { requestId, action: currentStatusId === 9 ? "Refuse" : "Move to next step", selectedAttachments, note });

                trackNoteChangesbeforAfter();
                if (currentStatusId === RequestDeclined && note === "") {
                    alert('من فضلك أدخل سبب الرفض .');
                    return;
                }

